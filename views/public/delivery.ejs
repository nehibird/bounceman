<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function(){
'use strict';

/* Interpolated by the surrounding template literal, NOT by an EJS tag. EJS
   closes the outer include at the first closing delimiter it meets, so an EJS
   tag anywhere inside this string truncates the whole page. Same reason the
   zone cards above are built with template-literal interpolation. */
var ZONES = ${JSON.stringify(townsByFee)};
var TIERS = ${JSON.stringify(tiers)};
var HOME  = [36.6781,-97.3103];

/* ─── SHAPE MATH ────────────────────────────────────────────────
   The map used to scatter 35 dots inside dashed range rings. Rings are a lie
   anyway — the zones are not circles. Instead: hull the towns in each tier
   (cumulatively, so the bands nest), push the edge out past the towns, and
   round the corners. Three warm bands of territory that read like a printed
   county map rather than a radar sweep.
   ──────────────────────────────────────────────────────────────── */
function hull(pts){
  var p = pts.map(function(a){ return [a[1],a[0]]; })                // [x=lng, y=lat]
             .sort(function(a,b){ return a[0]-b[0] || a[1]-b[1]; });
  if(p.length < 3) return pts.slice();
  function cross(o,a,b){ return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0]); }
  var lower=[], upper=[], i;
  for(i=0;i<p.length;i++){
    while(lower.length>=2 && cross(lower[lower.length-2],lower[lower.length-1],p[i])<=0) lower.pop();
    lower.push(p[i]);
  }
  for(i=p.length-1;i>=0;i--){
    while(upper.length>=2 && cross(upper[upper.length-2],upper[upper.length-1],p[i])<=0) upper.pop();
    upper.push(p[i]);
  }
  lower.pop(); upper.pop();
  return lower.concat(upper).map(function(a){ return [a[1],a[0]]; });  // back to [lat,lng]
}

/* Push every vertex away from the centroid so towns sit inside the band,
   not pinned to its edge. */
function grow(ring, scale, offset){
  var cy=0, cx=0;
  ring.forEach(function(p){ cy+=p[0]; cx+=p[1]; });
  cy/=ring.length; cx/=ring.length;
  return ring.map(function(p){
    var dy=p[0]-cy, dx=p[1]-cx, d=Math.sqrt(dy*dy+dx*dx) || 1;
    return [cy + dy*scale + (dy/d)*offset, cx + dx*scale + (dx/d)*offset];
  });
}

/* Chaikin corner-cutting — turns the hard hull into a drawn-by-hand outline. */
function round(ring, passes){
  for(var k=0;k<passes;k++){
    var out=[];
    for(var i=0;i<ring.length;i++){
      var a=ring[i], b=ring[(i+1)%ring.length];
      out.push([a[0]*.75+b[0]*.25, a[1]*.75+b[1]*.25]);
      out.push([a[0]*.25+b[0]*.75, a[1]*.25+b[1]*.75]);
    }
    ring=out;
  }
  return ring;
}

/* ─── MAP ───────────────────────────────────────────────────────── */
var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var touch  = window.matchMedia && window.matchMedia('(hover: none)').matches;

var map = L.map('dmMap', {
  scrollWheelZoom:false,
  dragging:!touch,               /* re-enabled on tap; see the veil below */
  zoomControl:false,
  zoomSnap:0, zoomDelta:.5,      /* whole-number zooms overshoot badly at this
                                    aspect ratio and strand the territory in
                                    the middle of three states */
  attributionControl:false,      /* credited in the page instead; the control
                                    lands on top of the ZIP card on a phone */
  minZoom:7, maxZoom:14
});
if(!touch) L.control.zoom({position:'topright'}).addTo(map);

L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom:16 }).addTo(map);

/* Bands, widest first so free ends up on top. */
var cumulative = [], bands = {};
[0,60,95].forEach(function(fee){
  cumulative = cumulative.concat((ZONES[String(fee)]||[]).map(function(t){ return [t.la,t.lo]; }));
  bands[fee] = cumulative.slice();
});

TIERS.forEach(function(tier){
  var ring = round(grow(hull(bands[tier.fee]), 1.12, .028), 3);
  L.polygon(ring, {
    color:tier.color, weight:tier.fee===0 ? 2.5 : 1.6, opacity:tier.fee===0 ? .95 : .6,
    dashArray:tier.dash, fillColor:tier.color, fillOpacity:tier.fill,
    lineJoin:'round', interactive:false
  }).addTo(map);

  /* The zone name is written on the territory, the way a paper map names a
     county. This is the legend — there isn't a second one. */
  L.marker(tier.at, {
    interactive:false, keyboard:false,
    icon:L.divIcon({className:'dm-maplabel '+tier.lbl, html:tier.label, iconSize:[170,20], iconAnchor:[85,10]})
  }).addTo(map);
});

/* Towns. Small on purpose — the tiles already print the names, these just
   mark which band each one falls in. */
var byZip = {};
TIERS.forEach(function(tier){
  (ZONES[String(tier.fee)]||[]).forEach(function(t){
    byZip[t.z] = { t:t, tier:tier };
    L.circleMarker([t.la,t.lo], {
      radius:tier.fee===0 ? 5 : 4, color:'#FFF9F0', weight:1.5,
      fillColor:tier.color, fillOpacity:1
    }).addTo(map).bindPopup(
      '<b>'+t.n+', '+t.s+'</b><br>'+t.mi+' miles &middot; '+
      (tier.fee===0 ? 'free delivery' : '$'+tier.fee+' delivery')
    );
  });
});

L.marker(HOME, {
  icon:L.divIcon({className:'dm-home', html:'<i></i><b>Our shop</b>', iconSize:[15,15], iconAnchor:[7,7]}),
  zIndexOffset:500
}).addTo(map);

/* Frame every town we serve, with room for the headline and the ZIP card. */
var all = [];
Object.keys(ZONES).forEach(function(f){ ZONES[f].forEach(function(t){ all.push([t.la,t.lo]); }); });
var full = L.latLngBounds(all).pad(.04);

function frameAll(animate){
  var narrow = window.innerWidth < 860;
  map.fitBounds(full, {
    paddingTopLeft:  narrow ? [18,104] : [40,104],
    paddingBottomRight: narrow ? [18,158] : [40,44],
    animate:!!animate && !reduce
  });
}
frameAll(false);
window.addEventListener('resize', function(){ if(!youMarker) frameAll(false); });

/* Touch: the map stays inert until tapped, so a thumb landing on it while
   scrolling never traps the page. */
var veil = document.getElementById('dmVeil');
if(touch){
  veil.classList.add('on');
  veil.addEventListener('click', function(){
    veil.classList.remove('on');
    map.dragging.enable();
    L.control.zoom({position:'topright'}).addTo(map);
  });
} else {
  map.on('click', function(){ map.scrollWheelZoom.enable(); });
}

/* ─── THE ANSWER ────────────────────────────────────────────────
   Looked up in the page, not over the network — rural signal is not something
   to bet a five-second answer on, and this data is already in the HTML.
   /booking/check-zip stays the source of truth for actual pricing at checkout.
   ──────────────────────────────────────────────────────────────── */
var input = document.getElementById('dmZip'),
    go    = document.getElementById('dmGo'),
    out   = document.getElementById('dmRes'),
    reset = document.getElementById('dmReset'),
    youMarker = null;

function say(kind, head, body){
  out.className = 'dm-res on ' + kind;
  out.innerHTML = '<strong>'+head+'</strong><span>'+body+'</span>';
}

/* Centre the town clear of the ZIP card instead of behind it. */
function focusTown(t){
  /* Zoom 10 keeps the shop and the zone edge in frame alongside your town —
     any closer and the answer loses the context that makes it believable. */
  var zoom = 10,
      narrow = window.innerWidth < 860,
      pt = map.project([t.la,t.lo], zoom);
  pt = narrow ? pt.add([0, 78]) : pt.subtract([150, 0]);
  map[reduce ? 'setView' : 'flyTo'](map.unproject(pt, zoom), zoom, {duration:1});

  if(youMarker) map.removeLayer(youMarker);
  youMarker = L.marker([t.la,t.lo], {
    icon:L.divIcon({className:'dm-you', html:'<i></i><b>'+t.n+' &middot; '+t.mi+' mi</b>', iconSize:[17,17], iconAnchor:[8,8]}),
    zIndexOffset:1000, interactive:false
  }).addTo(map);
  reset.classList.add('on');
}

function clearTown(){
  if(youMarker){ map.removeLayer(youMarker); youMarker = null; }
  reset.classList.remove('on');
  frameAll(true);
}

function check(){
  var zip = (input.value||'').replace(/[^0-9]/g,'').slice(0,5);
  if(zip.length !== 5){
    say('ask','That needs to be five digits','Type the ZIP where the party is happening.');
    input.focus();
    return;
  }
  var hit = byZip[zip];
  if(!hit){
    say('ask','That one is not on our map',
      'It does not mean no &mdash; we go further than this. <a href="tel:+15803089288">Call or text (580) 308-9288</a> and we will sort it out.');
    clearTown();          /* pull back to the whole territory, so "further than
                             this" has something to be further than */
    return;
  }
  var t = hit.t, fee = hit.tier.fee;
  if(fee === 0){
    say('free','Yes &mdash; and delivery is free',
      t.n + ' is ' + (t.mi === 0 ? 'right here in town' : t.mi + ' miles out') +
      '. We set it up, anchor it, and come back for it. No delivery charge.');
  } else {
    say('fee','Yes &mdash; delivery is $'+fee,
      t.n + ' is ' + t.mi + ' miles out. One flat $' + fee +
      ' for the whole order, however many units you rent.');
  }
  focusTown(t);
}

go.addEventListener('click', check);
input.addEventListener('keydown', function(e){ if(e.key === 'Enter'){ e.preventDefault(); check(); } });
input.addEventListener('input', function(){
  this.value = this.value.replace(/[^0-9]/g,'').slice(0,5);
  if(this.value.length === 5) check();          /* five digits in, answer out */
});
reset.addEventListener('click', function(){
  clearTown();
  out.className = 'dm-res';
  input.value = '';
  input.focus();
});

})();
</script>
