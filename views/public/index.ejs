<%- include('../layouts/public', { body: `

<!-- Hero Section -->
<section class="hero-section">
  <video class="hero-bg-video" autoplay muted loop playsinline preload="metadata" poster="/assets/video/hero-poster-wide.jpg" aria-hidden="true">
    <source src="/assets/video/hero-setup-wide.mp4" type="video/mp4">
  </video>
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <div class="hero-kicker">Bounce Houses · Water Slides · Party Rentals</div>
        <h1>Bounce House &amp; Water Slide Rentals in <span>Tonkawa &amp; Kay County, OK</span></h1>
        <p class="hero-tagline" style="font-size:1.3rem;font-weight:700;color:#fff;margin:0 0 .5rem;text-shadow:0 2px 8px rgba(0,0,0,.35)">Kay County's Bounce Man — family owned, family fun</p>
        <p>Bounce houses, water slides, and party equipment rental for Tonkawa, Ponca City, Stillwater, and surrounding Oklahoma areas.</p>
        <div class="mt-3">
          <span style="display:inline-flex;align-items:center;gap:9px;background:#047857;color:#fff;font-weight:700;font-size:15px;padding:9px 20px;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,0.18)">
            <i class="fas fa-truck-fast"></i> FREE Delivery &amp; Setup — all of Kay County
          </span>
        </div>
        <div class="mt-4 d-flex gap-3 flex-wrap">
          <a href="/booking" class="btn btn-book-now btn-lg"><i class="fas fa-calendar-check me-2"></i>Book Now</a>
          <a href="/equipment" class="btn btn-outline-light btn-lg px-4" style="border-radius:12px">View Equipment <i class="fas fa-arrow-right ms-2"></i></a>
        </div>
        <div class="mt-4 d-flex gap-2 align-items-center flex-wrap">
          <span style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.35);color:#fff;font-weight:600;font-size:13px;padding:8px 16px;border-radius:10px">
            <i class="fas fa-spray-can-sparkles"></i> 100% Clean &amp; Sanitized
          </span>
          <span style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.35);color:#fff;font-weight:600;font-size:13px;padding:8px 16px;border-radius:10px">
            <i class="fas fa-shield-halved"></i> Licensed &amp; Insured
          </span>
        </div>
      </div>
    </div>
  </div>
  <span class="hero-video-badge"><i class="fas fa-bolt"></i> Real Kay County setup</span>
</section>
<script>
  (function () {
    try {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var v = document.querySelector('.hero-bg-video');
        if (v) { v.removeAttribute('autoplay'); v.pause(); }
      }
    } catch (e) {}
  })();
</script>

<!-- How It Works -->
<section class="py-5 fun-bg" style="background:white">
  <div class="shape-circle shape-1"></div>
  <div class="shape-circle shape-2"></div>
  <div class="container py-4">
    <div class="section-title">
      <h2>How It Works</h2>
      <p>Renting is easy — just 4 simple steps!</p>
    </div>
    <div class="row g-4">
      <div class="col-md-3">
        <div class="how-it-works-step">
          <div class="step-number">1</div>
          <h3>Browse</h3>
          <p>Check out our equipment and pick your favorites</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="how-it-works-step">
          <div class="step-number">2</div>
          <h3>Pick a Date</h3>
          <p>Choose your event date and check availability</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="how-it-works-step">
          <div class="step-number">3</div>
          <h3>Book & Pay</h3>
          <p>Reserve with a deposit — pay the rest on delivery day</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="how-it-works-step">
          <div class="step-number">4</div>
          <h3>We Deliver!</h3>
          <p>We set up, you party, we pick up. Easy!</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Equipment -->
<section class="py-5">
  <div class="container py-4">
    <div class="section-title">
      <h2>Featured Equipment</h2>
      <p>Our most popular rentals — book yours today!</p>
    </div>
    <div class="row g-4">
${featured.length > 0 ? featured.map(item => `
      <div class="col-md-6 col-lg-4">
        <a href="/equipment/${item.slug}" class="equipment-card-link" style="text-decoration:none;color:inherit;display:block">
          <div class="equipment-card">
            <img src="${item.image || '/assets/images/placeholder-bounce.svg'}" class="card-img-top" alt="${item.name}" style="${(item.category === 'add_ons' || item.category === 'add-ons') ? 'object-fit:contain;background:#f8f9fa;padding:20px' : ''}">
            <div class="card-body">
              <span class="badge-category mb-2">${item.category.replace(/[-_]/g, ' ')}</span>${(item.category === 'water_slides' || item.category === 'water-slides' || item.category === 'combo_units' || item.category === 'combo-units' || (item.price_wet !== null && item.price_wet !== undefined && item.price_wet !== '')) ? ' <span style="background:var(--bm-blue);color:white;font-weight:600;padding:3px 10px;border-radius:20px;font-size:11px"><i class="fas fa-tint me-1"></i>Wet / Dry</span>' : ''}
              <h5 class="card-title mt-2">${item.name}${item.quantity > 1 ? ' <span style="background:#059669;color:white;font-weight:600;padding:2px 8px;border-radius:20px;font-size:11px;vertical-align:middle">x' + item.quantity + ' Available</span>' : ''}</h5>
              <p class="text-muted small">${item.short_description || ''}</p>
              <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="price-tag">From $${parseFloat(item.full_day_only ? item.price_daily : (item.price_4hr || item.price_daily * 0.65)).toFixed(0)}</span>
                <span class="btn btn-sm btn-outline-primary rounded-pill">Details <i class="fas fa-arrow-right ms-1"></i></span>
              </div>
              <div style="font-size:11px;color:#059669;font-weight:600;margin-top:4px"><i class="fas fa-truck me-1"></i>FREE delivery in Kay County</div>
            </div>
          </div>
        </a>
      </div>
`).join('') : `
      <div class="col-12 text-center py-5">
        <div style="font-size:80px;opacity:0.3">🎈</div>
        <h4 class="text-muted">Equipment coming soon!</h4>
        <p class="text-muted">We're getting our inventory ready. Check back soon!</p>
      </div>
`}
    </div>
    <div class="text-center mt-4">
      <a href="/equipment" class="btn btn-bm btn-lg rounded-pill px-5">View All Equipment <i class="fas fa-arrow-right ms-2"></i></a>
    </div>
  </div>
</section>

<!-- Social Proof: Reviews -->
<section style="background:#f8f9fa;padding:60px 0">
  <div class="container text-center">
    <h2 style="color:var(--bm-blue);font-weight:800;font-family:'Poppins',sans-serif">What Parents Are Saying</h2>
    <p class="text-muted mb-4">Real reviews from real families</p>
    <div class="row g-4 justify-content-center">
      ${reviews.length > 0 ? reviews.slice(0, 3).map(r => `
      <div class="col-md-4">
        <div class="testimonial-card">
          <div class="stars mb-2">${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}</div>
          <p>"${r.comment || 'Great experience!'}"</p>
          <strong>${r.customer_name || 'Happy Customer'}</strong>
          ${r.source === 'google' ? `<div style="margin-top:6px;font-size:12px;color:#888"><i class="fab fa-google"></i> Posted on Google</div>` : ''}
        </div>
      </div>
      `).join('') : `
      <div class="col-12">
        <div class="testimonial-card" style="max-width:480px;margin:0 auto">
          <p style="font-size:18px;color:#555;margin-bottom:16px">Be our first to leave a review!</p>
          <a href="https://g.page/r/bouncemanrentals/review" target="_blank" class="btn btn-outline-primary rounded-pill"><i class="fab fa-google me-2"></i>Review us on Google</a>
        </div>
      </div>
      `}
    </div>
    <a href="/reviews" class="btn btn-outline-primary rounded-pill mt-4">See All Reviews</a>
  </div>
</section>

<!-- Service Areas -->
<section class="py-5 fun-bg">
  <div class="shape-circle shape-1"></div>
  <div class="shape-circle shape-3"></div>
  <div class="container py-4">
    <div class="section-title">
      <h2>Free Delivery Across Kay County</h2>
      <p>And beyond — serving Oklahoma communities near and far</p>
    </div>
    <div class="row g-3 justify-content-center">
      <div class="col-auto"><div class="bg-white rounded-pill px-4 py-2 shadow-sm"><strong>Tonkawa</strong> <span class="badge bg-success">FREE</span></div></div>
      <div class="col-auto"><div class="bg-white rounded-pill px-4 py-2 shadow-sm"><strong>Ponca City</strong> <span class="badge bg-success">FREE</span></div></div>
      <div class="col-auto"><div class="bg-white rounded-pill px-4 py-2 shadow-sm"><strong>Blackwell</strong> <span class="badge bg-success">FREE</span></div></div>
      <div class="col-auto"><div class="bg-white rounded-pill px-4 py-2 shadow-sm"><strong>Newkirk</strong> <span class="badge bg-success">FREE</span></div></div>
      <div class="col-auto"><div class="bg-white rounded-pill px-4 py-2 shadow-sm"><strong>Kaw City</strong> <span class="badge bg-success">FREE</span></div></div>
      <div class="col-auto"><div class="bg-white rounded-pill px-4 py-2 shadow-sm"><strong>Stillwater</strong></div></div>
      <div class="col-auto"><div class="bg-white rounded-pill px-4 py-2 shadow-sm"><strong>Enid</strong></div></div>
    </div>
    <div class="text-center mt-4">
      <a href="/service-areas" class="btn btn-outline-primary rounded-pill">View Delivery Zones & Pricing</a>
    </div>
  </div>
</section>

`, scripts: '' }) %>
