<%- include('../../layouts/public', { body: `

<style>
  .booking-progress { display: flex; justify-content: center; gap: 0; margin-bottom: 40px; }
  .booking-progress .step { display: flex; align-items: center; gap: 8px; padding: 12px 20px; color: #aaa; font-weight: 600; font-size: 14px; position: relative; }
  .booking-progress .step.active { color: var(--bm-orange); }
  .booking-progress .step.completed { color: var(--bm-green); }
  .booking-progress .step .step-num { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; background: #e9ecef; color: #aaa; }
  .booking-progress .step.active .step-num { background: var(--bm-gradient); color: white; }
  .booking-progress .step.completed .step-num { background: var(--bm-green); color: white; }
  .booking-progress .step-line { width: 40px; height: 2px; background: #e9ecef; align-self: center; }
  .booking-progress .step-line.active { background: var(--bm-orange); }

  .select-card { position: relative; cursor: pointer; transition: border 0.2s, box-shadow 0.2s; border: 3px solid transparent; }
  .select-card.selected { border-color: var(--bm-orange); box-shadow: 0 8px 30px rgba(255,107,53,0.25); }
  .select-card .check-overlay { position: absolute; top: 12px; right: 12px; width: 32px; height: 32px; border-radius: 50%; background: white; border: 2px solid #ddd; display: flex; align-items: center; justify-content: center; z-index: 5; transition: all 0.2s; }
  .select-card.selected .check-overlay { background: var(--bm-orange); border-color: var(--bm-orange); color: white; }

  .selection-summary { background: white; border-radius: 16px; padding: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
  .filter-pill { border: 2px solid var(--bm-blue); color: var(--bm-blue); background: transparent; font-weight: 600; transition: all 0.2s; }
  .filter-pill:hover, .filter-pill.active { background: var(--bm-blue); color: white; border-color: var(--bm-blue); }

  @media (max-width: 991px) {
    .sticky-summary { position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; border-radius: 16px 16px 0 0; box-shadow: 0 -4px 20px rgba(0,0,0,0.15); }
  }
</style>

<section class="py-5">
  <div class="container">

    <!-- Progress Bar -->
    <div class="booking-progress">
      <div class="step completed">
        <span class="step-num"><i class="fas fa-check"></i></span>
        <span class="d-none d-md-inline">Pick Date</span>
      </div>
      <div class="step-line"></div>
      <div class="step active">
        <span class="step-num">2</span>
        <span class="d-none d-md-inline">Select Items</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">3</span>
        <span class="d-none d-md-inline">Your Details</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">4</span>
        <span class="d-none d-md-inline">Review</span>
      </div>
    </div>

    <div class="section-title">
      <h2>Choose Your Rentals</h2>
      <p>Available for <strong>${eventDate ? (() => { var d = new Date(eventDate + 'T12:00:00'); return d.toLocaleDateString('en-US', {month:'long',day:'numeric',year:'numeric'}); })() : 'your selected date'}</strong></p>
    </div>

    <!-- Category Filter Pills -->
    <div class="text-center mb-4" id="categoryFilters">
      <button class="btn filter-pill rounded-pill m-1 active" data-category="all">All</button>
      ${categories.map(c => '<button class="btn filter-pill rounded-pill m-1" data-category="' + c.slug + '">' + c.name + '</button>').join('')}
    </div>

    <div class="row">
      <!-- Equipment Grid -->
      <div class="col-lg-12">
        <div class="row g-4" id="equipmentGrid">
          ${equipment.map(function(item) { return '<div class="col-md-6 equipment-item" data-category="' + (item.category || '') + '" data-id="' + item.id + '" data-name="' + item.name + '" data-price="' + ('${rentalDuration}' === '4hr' ? (item.price_4hr || item.price_daily * 0.65) : '${rentalDuration}' === 'overnight' ? (item.price_overnight || item.price_daily * 1.15) : item.price_daily) + '">' +
            '<div class="equipment-card select-card" onclick="toggleItem(this, &quot;' + item.id + '&quot;, &quot;' + (item.name || '').replace(/"/g, '') + '&quot;, ' + item.price_daily + ')">' +
              '<div class="check-overlay"><i class="fas fa-check" style="display:none"></i></div>' +
              '<img src="' + (item.image || '/assets/images/placeholder-bounce.svg') + '" class="card-img-top" alt="' + item.name + '">' +
              '<div class="card-body">' +
                '<span class="badge-category mb-2">' + (item.category || '').replace(/_/g, ' ') + '</span>' +
                '<h5 class="card-title mt-2">' + item.name + '</h5>' +
                '<p class="text-muted small mb-2">' + (item.short_description || '') + '</p>' +
                '<div class="small text-muted mb-2">' +
                  (item.dimensions ? '<i class="fas fa-ruler-combined me-1"></i>' + item.dimensions + ' &bull; ' : '') +
                  (item.capacity_kids ? '<i class="fas fa-child me-1"></i>Up to ' + item.capacity_kids + ' kids' : '') +
                '</div>' +
                '<span class="price-tag">From $' + parseFloat(item.price_4hr || item.price_daily * 0.65).toFixed(0) + '</span>' +
              '</div>' +
            '</div>' +
          '</div>'; }).join('')}
        </div>

        
        <!-- Add-Ons Section -->
        ${(typeof addons !== 'undefined' && addons.length > 0) ? '<div class="mt-4"><h5 style="color:var(--bm-blue);font-weight:700" class="mb-3"><i class="fas fa-plus-circle me-2" style="color:var(--bm-orange)"></i>Add Extras to Your Event</h5><div class="row g-3">' + addons.map(function(addon) { var addonPrice = rentalDuration === '4hr' ? addon.price_4hr : (rentalDuration === 'overnight' ? (addon.price_overnight || addon.price_daily) : addon.price_daily); return '<div class="col-md-6"><div class="equipment-card select-card" style="padding:0" onclick="toggleItem(this, &quot;' + addon.id + '&quot;, &quot;' + addon.name.replace(/"/g, '') + '&quot;, ' + addonPrice + ')"><div class="check-overlay"><i class="fas fa-check" style="display:none"></i></div><div class="card-body d-flex align-items-center gap-3"><img src="' + (addon.image || '/assets/images/placeholder-bounce.svg') + '" style="width:60px;height:60px;object-fit:contain;border-radius:8px"><div style="flex:1"><h6 class="mb-1">' + addon.name + '</h6><p class="text-muted small mb-0">' + (addon.short_description || '') + '</p></div><span class="fw-bold" style="color:var(--bm-orange)">+\x24' + addonPrice + '</span></div></div></div>'; }).join('') + '</div></div>' : ''}

        <!-- Wet/Dry Option (shown when water slide selected) -->
        <div id="wetDrySection" class="mt-4" style="display:none">
          <h5 style="color:var(--bm-blue);font-weight:700" class="mb-3"><i class="fas fa-tint me-2" style="color:#3b82f6"></i>Wet or Dry?</h5>
          <div class="row g-3">
            <div class="col-6">
              <div class="btn btn-outline-secondary w-100 text-center" style="padding:12px;border-radius:12px;cursor:pointer;background:var(--bm-blue,#004E89);color:white" onclick="selectWetDry(false,this)" id="dryBtn">
                <div class="fw-bold"><i class="fas fa-sun me-1"></i>Dry</div>
                <div class="small">Standard setup</div>
              </div>
            </div>
            <div class="col-6">
              <div class="btn btn-outline-secondary w-100 text-center" style="padding:12px;border-radius:12px;cursor:pointer" onclick="selectWetDry(true,this)" id="wetBtn">
                <div class="fw-bold"><i class="fas fa-tint me-1" style="color:#3b82f6"></i>Wet (+\x2420)</div>
                <div class="small">Water hookup included</div>
              </div>
            </div>
          </div>
        </div>

        ${equipment.length === 0 ? '<div class="text-center py-5"><div style="font-size:80px;opacity:0.3"><i class="fas fa-box-open"></i></div><h4 class="text-muted">No equipment available yet</h4><p class="text-muted">Check back soon!</p></div>' : ''}
      </div>

    </div>

    <!-- Selection Summary (below all options) -->
    <div class="row mt-4">
      <div class="col-lg-6 mx-auto">
        <div class="selection-summary" id="selectionSummary" style="border-radius:16px;padding:24px;background:white;box-shadow:0 2px 12px rgba(0,0,0,0.08);">
          <h5 style="color:var(--bm-blue);font-weight:700;"><i class="fas fa-shopping-cart me-2"></i>Your Selection</h5>
          <hr>
          <div id="selectedList">
            <p class="text-muted text-center small" id="emptyMsg">No items selected yet</p>
          </div>
          <hr>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fw-bold">Subtotal:</span>
            <span class="fw-bold" style="color:var(--bm-orange);font-size:20px;" id="subtotal">$0</span>
          </div>
          <span class="text-muted small d-block mb-3" id="itemCount">0 items selected</span>
          <a href="#" class="btn btn-book-now w-100 disabled" id="continueBtn" onclick="goToStep2(event)">
            <i class="fas fa-arrow-right me-2"></i>Continue to Your Details
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

`, scripts: `
<script>
  var selectedItems = {};

  var wetOption = false;

  function selectWetDry(isWet, el) {
    wetOption = isWet;
    document.getElementById('dryBtn').style.background = isWet ? '' : 'var(--bm-blue,#004E89)';
    document.getElementById('dryBtn').style.color = isWet ? '' : 'white';
    document.getElementById('wetBtn').style.background = isWet ? 'var(--bm-blue,#004E89)' : '';
    document.getElementById('wetBtn').style.color = isWet ? 'white' : '';
    updateSummary();
  }

  // Check if any selected item is a water slide
  function checkWetDry() {
    var hasWaterSlide = false;
    var waterSlideCategories = document.querySelectorAll('.equipment-item');
    Object.keys(selectedItems).forEach(function(id) {
      var el = document.querySelector('[data-id="' + id + '"]');
      if (el && el.dataset.category === 'water_slides') hasWaterSlide = true;
    });
    var section = document.getElementById('wetDrySection');
    if (section) section.style.display = hasWaterSlide ? '' : 'none';
  }


  // Pre-select items from query params if returning
  (function() {
    var params = new URLSearchParams(window.location.search);
    var preItems = params.get('items');
    if (preItems) {
      preItems.split(',').forEach(function(id) {
        var el = document.querySelector('[data-id="' + id + '"]');
        if (el) {
          var card = el.querySelector('.select-card');
          var name = el.dataset.name;
          var price = parseFloat(el.dataset.price);
          toggleItem(card, id, name, price);
        }
      });
    }
  })();

  function toggleItem(card, id, name, price) {
    if (selectedItems[id]) {
      delete selectedItems[id];
      card.classList.remove('selected');
      card.querySelector('.fa-check').style.display = 'none';
    } else {
      selectedItems[id] = { name: name, price: price };
      card.classList.add('selected');
      card.querySelector('.fa-check').style.display = '';
    }
    updateSummary();
  }

  function updateSummary() {
    var keys = Object.keys(selectedItems);
    var listEl = document.getElementById('selectedList');
    var emptyMsg = document.getElementById('emptyMsg');
    var subtotalEl = document.getElementById('subtotal');
    var countEl = document.getElementById('itemCount');
    var continueBtn = document.getElementById('continueBtn');
    var subtotal = 0;

    listEl.innerHTML = '';
    if (keys.length === 0) {
      listEl.innerHTML = '<p class="text-muted text-center small" id="emptyMsg">No items selected yet</p>';
      subtotalEl.textContent = '$0';
      countEl.textContent = '0 items selected';
      checkWetDry();
      continueBtn.classList.add('disabled');
      continueBtn.style.opacity = '0.5';
      continueBtn.style.pointerEvents = 'none';
      return;
    }

    keys.forEach(function(id) {
      var item = selectedItems[id];
      subtotal += item.price;
      var row = document.createElement('div');
      row.className = 'd-flex justify-content-between align-items-center mb-2';
      row.innerHTML = '<span class="small">' + item.name + '</span><span class="small fw-bold">$' + item.price.toFixed(0) + '</span>';
      listEl.appendChild(row);
    });

    subtotalEl.textContent = '$' + subtotal.toFixed(0);
    countEl.textContent = keys.length + ' item' + (keys.length > 1 ? 's' : '') + ' selected';
    if (wetOption) { subtotal += 20; subtotalEl.textContent = '\x24' + subtotal.toFixed(0); }
    checkWetDry();
    continueBtn.classList.remove('disabled');
    continueBtn.style.opacity = '1';
    continueBtn.style.pointerEvents = 'auto';
  }

  function goToStep2(e) {
    e.preventDefault();
    var ids = Object.keys(selectedItems);
    if (ids.length === 0) return;
    var params = new URLSearchParams(window.location.search);
    window.location.href = '/booking/details?items=' + ids.join(',') + '&wet_option=' + (wetOption ? '1' : '0') + '&event_date=' + (params.get('event_date')||'') + '&rental_duration=' + (params.get('rental_duration')||'daily') + '&event_start_time=' + (params.get('event_start_time')||'09:00') + '&event_end_time=' + (params.get('event_end_time')||'19:00');
  }

  // Category filtering
  document.getElementById('categoryFilters').addEventListener('click', function(e) {
    if (!e.target.matches('.filter-pill')) return;
    document.querySelectorAll('.filter-pill').forEach(function(b) { b.classList.remove('active'); });
    e.target.classList.add('active');
    var cat = e.target.dataset.category;
    document.querySelectorAll('.equipment-item').forEach(function(item) {
      if (cat === 'all' || item.dataset.category === cat) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  });

  // Initialize summary state
  updateSummary();
</script>
` }) %>
