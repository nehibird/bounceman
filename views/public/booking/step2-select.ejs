<%- include('../../layouts/public', { body: `

<style>
  .booking-progress { display: flex; justify-content: center; gap: 0; margin-bottom: 40px; }
  .booking-progress .step { display: flex; align-items: center; gap: 8px; padding: 12px 20px; color: #aaa; font-weight: 600; font-size: 14px; position: relative; }
  .booking-progress .step.active { color: var(--bm-orange); }
  .booking-progress .step.completed { color: var(--bm-green); }
  .booking-progress .step .step-num { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; background: #e9ecef; color: #aaa; }
  .booking-progress .step.active .step-num { background: var(--bm-gradient); color: white; }
  .booking-progress .step.completed .step-num { background: var(--bm-green); color: white; }
  .booking-progress .step-line { width: 40px; height: 2px; background: #e9ecef; align-self: center; }
  .booking-progress .step-line.active { background: var(--bm-orange); }

  .select-card { position: relative; cursor: pointer; transition: border 0.2s, box-shadow 0.2s; border: 3px solid transparent; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .select-card.selected { border-color: var(--bm-orange); box-shadow: 0 8px 30px rgba(255,107,53,0.25); }
  .select-card .check-overlay { position: absolute; top: 12px; right: 12px; width: 32px; height: 32px; border-radius: 50%; background: white; border: 2px solid #ddd; display: flex; align-items: center; justify-content: center; z-index: 5; transition: all 0.2s; }
  .select-card.selected .check-overlay { background: var(--bm-orange); border-color: var(--bm-orange); color: white; }

  .selection-summary { background: white; border-radius: 16px; padding: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }

  .price-days-note { margin-left: 8px; font-size: 13px; font-weight: 700; color: #6b7480; vertical-align: middle; }

  /* Wet/Dry chooser — required, visually distinct (amber = dry, blue = wet) */
  .wet-dry-inline { margin-top: 14px; border-top: 1px solid #eef0f3; padding-top: 14px; }
  .wd-q { font-size: 14.5px; font-weight: 700; color: #1c2733; margin-bottom: 11px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .wd-req { font-size: 11px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: #b9521f; background: #fdecdf; border: 1px solid #f6cda9; padding: 3px 9px; border-radius: 20px; }
  .wd-req.wd-chosen { color: #1f7a3d; background: #e4f6ea; border-color: #bce5c9; }
  .wd-req.wd-flash { animation: wdflash 0.55s ease; }
  @keyframes wdflash { 0%,100%{ transform: scale(1); } 35%{ transform: scale(1.12); color:#fff; background:#e0492f; border-color:#e0492f; } }
  .wd-row { display: flex; gap: 12px; }
  .wd-btn {
    flex: 1; display: flex; align-items: center; gap: 11px;
    padding: 12px 13px; border-radius: 13px; cursor: pointer;
    border: 2px solid #e3e7ec; background: #f7f9fb; text-align: left;
    transition: all 0.18s;
  }
  .wd-btn:hover { border-color: #cfd6de; }
  .wd-ic { width: 38px; height: 38px; min-width: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; font-size: 16px; }
  .wd-t { font-size: 15.5px; font-weight: 700; color: #1c2733; line-height: 1.1; }
  .wd-s { font-size: 12px; color: #6b7480; margin-top: 2px; }
  .wd-btn[data-mode="dry"] .wd-ic i { color: #F39C12; }
  .wd-btn[data-mode="wet"] .wd-ic i { color: #1C8FE0; }
  .wd-btn[data-mode="dry"].wd-active { background: linear-gradient(135deg,#FBB034,#F39C12); border-color: #F39C12; box-shadow: 0 6px 16px rgba(243,156,18,.32); }
  .wd-btn[data-mode="wet"].wd-active { background: linear-gradient(135deg,#27A9E5,#0E6BB8); border-color: #0E6BB8; box-shadow: 0 6px 16px rgba(14,107,184,.32); }
  .wd-btn.wd-active .wd-ic { background: rgba(255,255,255,.25); }
  .wd-btn.wd-active .wd-ic i { color: #fff; }
  .wd-btn.wd-active .wd-t { color: #fff; }
  .wd-btn.wd-active .wd-s { color: rgba(255,255,255,.92); }
  .filter-pill { border: 2px solid var(--bm-blue); color: var(--bm-blue); background: transparent; font-weight: 600; transition: all 0.2s; }
  .filter-pill:hover, .filter-pill.active { background: var(--bm-blue); color: white; border-color: var(--bm-blue); }
  .days-btn-s2 {
    padding: 10px 20px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
    font-size: 15px;
    border: 2px solid #e0e0e0;
    background: #f8f8f8;
    color: #555;
    transition: all 0.2s;
    user-select: none;
  }
  .days-btn-s2.selected {
    background: var(--bm-blue, #004E89) !important;
    color: white !important;
    border-color: var(--bm-blue, #004E89) !important;
  }
  .days-btn-s2.disabled-day {
    opacity: 0.35;
    pointer-events: none;
  }

  /* Compact-sheet controls are phone-only; on desktop the summary is the normal in-page card. */
  .sheet-toggle { display: none; }
  /* The wet/dry warning is a <button> now (tap = scroll to the unit needing an answer); reset its UA look, keep the inline pill styling. */
  #wetChoiceWarn { width: 100%; text-align: left; cursor: pointer; font-family: inherit; }

  @media (max-width: 991px) {
    /* COMPACT BY DEFAULT. Measured on a 375x667 phone: the open sheet took 38-52% of the screen and,
       with six items, its list was a 76px nested scroller showing two of six lines while the subtotal
       read $1,394 -- the customer could not see what they were buying. Now the sheet is ONE row
       ("6 items - $1,394 [v]  [Continue]", ~76px, 11% of the screen); tapping the summary expands the
       full list (.expanded), capped at 60dvh with the list itself scrolling, so Continue (flex 0 0 auto,
       in the footer below the list) can never be pushed off-screen. */
    #selectionSummary.has-items:not(.expanded) #selectionScroll { display: none; }
    /* The subtotal row + count are redundant with the toggle label; the free-day nudge is expanded-only
       (the wet/dry warning stays visible in both states because it blocks Continue). */
    #selectionSummary.has-items #selectionFooter > hr,
    #selectionSummary.has-items #selectionFooter > .d-flex,
    #selectionSummary.has-items #itemCount { display: none !important; }
    #selectionSummary.has-items:not(.expanded) #freeDayPromo { display: none !important; }
    #selectionSummary.has-items.expanded { max-height: 60vh; max-height: 60dvh; }
    #sheetBar { display: flex; align-items: center; gap: 10px; }
    #selectionSummary.has-items .sheet-toggle {
      display: flex; flex: 1 1 auto; min-width: 0; align-items: center; justify-content: space-between; gap: 8px;
      min-height: 48px; padding: 0 4px; background: none; border: 0; text-align: left;
      font-size: 16px; font-weight: 800; color: #1c2733; cursor: pointer;
    }
    .sheet-toggle .sheet-total { color: var(--bm-orange); }
    .sheet-toggle .fa-chevron-up { transition: transform .2s; color: #6b7480; }
    #selectionSummary.expanded .sheet-toggle .fa-chevron-up { transform: rotate(180deg); }
    .sheet-toggle:focus-visible, #wetChoiceWarn:focus-visible { outline: 3px solid var(--bm-orange, #E8833A); outline-offset: 2px; }
    #selectionSummary.has-items #continueBtn { width: auto !important; flex: 0 0 auto; white-space: nowrap; min-height: 48px; padding-left: 18px; padding-right: 18px; }
    #selectionSummary.has-items #continueBtn .cont-more { display: none; }
    /* The sheet used to be ONE scrolling box (max-height 42vh; overflow-y:auto) with Continue as
       its last child, so on a 375x667 phone the button was already below the fold after a single
       item and customers had to discover that the little sheet scrolls -- lost bookings. Now the
       sheet is a flex column: #selectionScroll (heading + item list) takes the leftover height and
       scrolls, #selectionFooter (subtotal + Continue) never shrinks, so Continue is always on
       screen. The outer overflow-y:auto is only a last resort for very short landscape screens. */
    #selectionSummary.has-items { position: fixed; bottom: 0; left: 0; right: 0; z-index: 1001; margin: 0; border-radius: 16px 16px 0 0; max-height: 52vh; max-height: 52dvh; overflow-y: auto; box-shadow: 0 -4px 16px rgba(0,0,0,.15); display: flex; flex-direction: column; padding: 14px 18px !important; }
    #selectionSummary.has-items #selectionScroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; }
    #selectionSummary.has-items #selectionFooter { flex: 0 0 auto; }
    #selectionSummary.has-items h5 { font-size: 15px; margin-bottom: 0; }
    #selectionSummary.has-items hr { margin: 6px 0; }
    #selectionSummary.has-items #selectionFooter .mb-3 { margin-bottom: 8px !important; }
    #selectionSummary.has-items #freeDayPromo, #selectionSummary.has-items #wetChoiceWarn { margin-bottom: 6px !important; padding: 6px 10px !important; }
    /* compact sheet is ~76-120px tall, not half the screen: reserve just that so the last card is reachable */
    body.has-sticky-summary { padding-bottom: 140px; }
  }
</style>

<section class="py-5">
  <div class="container">

    <!-- Progress Bar -->
    <div class="booking-progress">
      <div class="step completed">
        <span class="step-num"><i class="fas fa-check"></i></span>
        <span class="d-none d-md-inline">Pick Date</span>
      </div>
      <div class="step-line"></div>
      <div class="step active">
        <span class="step-num">2</span>
        <span class="d-none d-md-inline">Select Items</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">3</span>
        <span class="d-none d-md-inline">Your Details</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">4</span>
        <span class="d-none d-md-inline">Review</span>
      </div>
    </div>

    <div class="section-title">
      <h2>Choose Your Rentals</h2>
      <p>Available for <strong>${eventDate ? (() => { var d = new Date(eventDate + 'T12:00:00'); return d.toLocaleDateString('en-US', {month:'long',day:'numeric',year:'numeric'}); })() : 'your selected date'}</strong></p>
    </div>

    <!-- Rental summary bar -->
    <div class="text-center mb-4">
      <div style="background:#eef3f8;border-radius:12px;padding:14px 24px;display:inline-block;">
        <span style="font-weight:700;color:#004E89;font-size:15px;">
          <i class="fas fa-calendar me-1"></i>
          ${eventDate ? (() => { var d = new Date(eventDate + 'T12:00:00'); return d.toLocaleDateString('en-US', {weekday:'long',month:'long',day:'numeric'}); })() : 'Your date'}
          &nbsp;&bull;&nbsp;
          <i class="fas fa-clock me-1"></i>Ready by ${readyBy ? (() => { var p=String(readyBy).split(':'); var h=parseInt(p[0],10)||0; var m=String(parseInt(p[1],10)||0).padStart(2,'0'); var ap=h>=12?'PM':'AM'; h=h%12||12; return h+':'+m+' '+ap; })() : ''}
          &nbsp;&bull;&nbsp;
          ${rentalDays > 1 ? 'Multi-Day' : (rentalDuration === '4hr' ? 'Half Day (4 hrs)' : 'Full Day (11 AM–7 PM)')}
          &nbsp;&bull;&nbsp;
          ${rentalDays} day${rentalDays > 1 ? 's' : ''}
        </span>
      </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="text-center mb-4" id="categoryFilters">
      <button class="btn filter-pill rounded-pill m-1 active" data-category="all">All</button>
      ${categories.map(c => '<button class="btn filter-pill rounded-pill m-1" data-category="' + c.slug + '">' + c.name + '</button>').join('')}
    </div>

    <div class="row">
      <!-- Equipment Grid -->
      <div class="col-lg-12">
        <div class="row g-4" id="equipmentGrid">
          ${equipment.map(function(item) {
            var itemPrice = item.computedPrice || (rentalDuration === '4hr' && !item.full_day_only ? (item.price_4hr || item.price_daily * 0.65) : item.price_daily);
            if (item.booked) {
              // Has availability in other time windows — show card in color with info overlay
              if (item.availableSlots && item.availableSlots.length > 0) {
                var firstSlot = item.availableSlots[0];
                var otherSlots = item.availableSlots.join(' & ');
                return '<div class="col-md-6 equipment-item" data-category="' + (item.category || '') + '" data-id="' + item.id + '">' +
                  '<div class="equipment-card" style="pointer-events:none;position:relative;border:2px solid #bbf7d0">' +
                    '<div style="position:absolute;top:10px;left:10px;right:10px;z-index:5;display:flex;justify-content:space-between;align-items:flex-start">' +
                      '<div style="background:rgba(239,71,111,0.95);color:white;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;box-shadow:0 2px 6px rgba(0,0,0,0.2)"><i class="fas fa-lock me-1"></i>' + currentTimeLabel + ' full</div>' +
                      '<div style="background:rgba(22,163,74,0.95);color:white;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;box-shadow:0 2px 6px rgba(0,0,0,0.2)"><i class="fas fa-check-circle me-1"></i>' + firstSlot + ' open</div>' +
                    '</div>' +
                    '<img src="' + (item.image || '/assets/images/placeholder-bounce.svg') + '" class="card-img-top" alt="' + item.name + '"' + ((item.image_fit ? item.image_fit === 'contain' : (item.category === 'add_ons' || item.category === 'add-ons')) ? ' style="object-fit:contain;padding:20px;background:#f8f8f8"' : '') + '>' +
                    '<div class="card-body">' +
                      '<span class="badge-category mb-2">' + (item.category || '').replace(/[-_]/g, ' ') + '</span>' +
                      '<h5 class="card-title mt-2">' + item.name + '</h5>' +
                      '<p class="text-muted small mb-2">' + (item.short_description || '') + '</p>' +
                      '<span class="price-tag">$' + parseFloat(itemPrice).toFixed(0) + '</span>' +
                      (rentalDays > 1 ? '<span class="price-days-note">for ' + rentalDays + ' days</span>' : '') +
                      '<div style="margin-top:10px;padding:8px 12px;background:#eff6ff;border-radius:8px;font-size:12px;color:#1d4ed8;font-weight:600;text-align:center"><i class="fas fa-clock me-1"></i>Switch to ' + otherSlots + ' to book this</div>' +
                    '</div>' +
                  '</div>' +
                '</div>';
              }
              // Fully booked across all time windows — show grayed out card
              return '<div class="col-md-6 equipment-item" data-category="' + (item.category || '') + '" data-id="' + item.id + '">' +
                '<div class="equipment-card" style="opacity:0.45;pointer-events:none;position:relative">' +
                  '<div style="position:absolute;top:12px;right:12px;z-index:5;background:var(--bm-pink,#EF476F);color:white;padding:4px 14px;border-radius:20px;font-size:12px;font-weight:700"><i class="fas fa-ban me-1"></i>Fully Booked</div>' +
                  '<img src="' + (item.image || '/assets/images/placeholder-bounce.svg') + '" class="card-img-top" alt="' + item.name + '" style="filter:grayscale(100%)' + ((item.image_fit ? item.image_fit === 'contain' : (item.category === 'add_ons' || item.category === 'add-ons')) ? ';object-fit:contain;padding:20px;background:#f8f8f8' : '') + '">' +
                  '<div class="card-body">' +
                    '<span class="badge-category mb-2">' + (item.category || '').replace(/[-_]/g, ' ') + '</span>' +
                    '<h5 class="card-title mt-2">' + item.name + '</h5>' +
                    '<p class="text-muted small mb-2">' + (item.short_description || '') + '</p>' +
                    '<span class="price-tag" style="opacity:0.5">$' + parseFloat(itemPrice).toFixed(0) + '</span>' +
                  '</div>' +
                '</div>' +
              '</div>';
            }
            var wetUp = 0;  // wet upcharge removed 2026-07 — wet and dry are the same price
            var hasWet = (item.category === 'water_slides' || item.category === 'water-slides' || item.category === 'combo_units' || item.category === 'combo-units') || (item.price_wet !== null && item.price_wet !== undefined && item.price_wet !== '');
            return '<div class="col-md-6 equipment-item" data-category="' + (item.category || '') + '" data-id="' + item.id + '" data-name="' + item.name + '" data-price="' + itemPrice + '" data-addon-rate="' + (item.addonPrice !== null && item.addonPrice !== undefined ? item.addonPrice : '') + '" data-has-wet="' + (hasWet ? '1' : '0') + '" data-wet-up="' + wetUp + '" data-extra-day="' + (item.extraDayPrice !== null && item.extraDayPrice !== undefined ? item.extraDayPrice : '') + '" data-max-extra="' + (item.maxExtraDays || 0) + '">' +
            '<div class="equipment-card select-card">' +
              '<div class="check-overlay"><i class="fas fa-check" style="display:none"></i></div>' +
              '<img src="' + (item.image || '/assets/images/placeholder-bounce.svg') + '" class="card-img-top" alt="' + item.name + '"' + ((item.image_fit ? item.image_fit === 'contain' : (item.category === 'add_ons' || item.category === 'add-ons')) ? ' style="object-fit:contain;padding:20px;background:#f8f8f8"' : '') + '>' +
              '<div class="card-body">' +
                '<span class="badge-category mb-2">' + (item.category || '').replace(/[-_]/g, ' ') + '</span>' +
                '<h5 class="card-title mt-2">' + item.name + '</h5>' +
                '<p class="text-muted small mb-2">' + (item.short_description || '') + '</p>' +
                (item.dimensions ? '<div class="small text-muted mb-2"><i class="fas fa-ruler-combined me-1"></i>' + item.dimensions + '</div>' : '') +
                (item.specialApplies && item.regularPrice ? '<div style="margin-bottom:4px"><span style="background:#E8833A;color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:10px">&#9728; FULL DAY, HALF-DAY PRICE</span></div><span style="text-decoration:line-through;color:#9aa0a6;font-size:18px;margin-right:6px">$' + parseFloat(item.regularPrice).toFixed(0) + '</span>' : '') +
                '<span class="price-tag">$' + parseFloat(itemPrice).toFixed(0) + '</span>' +
                (rentalDays > 1 ? '<span class="price-days-note">for ' + rentalDays + ' days</span>' : '') +
                (item.addonPrice ? '<div style="margin-top:4px"><span style="color:#2e7d32;font-size:12px;font-weight:600">or &#36;' + parseFloat(item.addonPrice).toFixed(0) + ' added to any rental</span></div>' : '') +
                (item.multidayUnavailable ? '<div style="margin-top:6px"><span style="color:#c62828;font-size:12px;font-weight:600"><i class="fas fa-ban me-1"></i>Not available for ' + rentalDays + '+ days</span></div>' : item.availableQty === 1 ? '<div style="margin-top:6px"><span style="color:#c62828;font-size:12px;font-weight:600"><i class="fas fa-fire me-1"></i>Only 1 left!</span></div>' : '') +
                (rentalDays > 1 && /generator/i.test(item.name) ? '<div style="margin-top:8px;background:#fff3cd;border-radius:8px;padding:8px 12px"><span style="color:#856404;font-size:12px;font-weight:600"><i class="fas fa-gas-pump me-1"></i>You provide the gas for multi-day rentals.</span></div>' : '') +
                (hasWet ? '<div class="wet-dry-inline" id="wetdry-' + item.id + '" style="display:none">' +
                  '<div class="wd-q">Do you need it wet or dry? <span class="wd-req" id="wdreq-' + item.id + '">Choose one</span></div>' +
                  '<div class="wd-row">' +
                    '<div class="wd-btn" data-mode="dry" id="wd-dry-' + item.id + '"><div class="wd-ic"><i class="fas fa-sun"></i></div><div><div class="wd-t">Dry</div><div class="wd-s">No water — keep it dry</div></div></div>' +
                    '<div class="wd-btn" data-mode="wet" id="wd-wet-' + item.id + '"><div class="wd-ic"><i class="fas fa-tint"></i></div><div><div class="wd-t">Wet</div><div class="wd-s">Splash &amp; slide — same price</div></div></div>' +
                  '</div></div>' : '') +
              '</div>' +
            '</div>' +
          '</div>'; }).join('')}
        </div>

        
        <!-- Add-Ons Section -->
        ${(typeof addons !== 'undefined' && addons.length > 0) ? '<div class="mt-4"><h5 style="color:var(--bm-blue);font-weight:700" class="mb-3"><i class="fas fa-plus-circle me-2" style="color:var(--bm-orange)"></i>Add Extras to Your Event</h5><div class="row g-3" id="addonGrid">' + addons.map(function(addon) {
          var addonPrice = addon.computedPrice || (rentalDuration === '4hr' ? addon.price_4hr : addon.price_daily);
          // These cards sat OUTSIDE #equipmentGrid with no data-id/name/price, and the click handler
          // only listened on #equipmentGrid and bailed without data-id -- so cornhole/speaker/generator
          // were unclickable for seven months. Same data-* contract as the equipment cards now;
          // data-price is the STANDALONE price and data-addon-rate the ride-along rate, so the cart can
          // mirror lib/helpers addonPricedIds. Deliberately NOT class equipment-item: the category
          // filter pills hide every .equipment-item that does not match, which would hide the extras.
          var standalone = (addon.standalonePrice !== undefined && addon.standalonePrice !== null) ? addon.standalonePrice : addonPrice;
          var rate = (addon.addonPrice !== undefined && addon.addonPrice !== null) ? addon.addonPrice : '';
          var inner = '<div class="check-overlay"><i class="fas fa-check" style="display:none"></i></div><div class="card-body d-flex align-items-center gap-3"><img src="' + (addon.image || '/assets/images/placeholder-bounce.svg') + '" style="width:60px;height:60px;object-fit:contain;border-radius:8px"><div style="flex:1"><h6 class="mb-1">' + addon.name + '</h6><p class="text-muted small mb-0">' + (addon.short_description || '') + '</p></div><span class="fw-bold" style="color:var(--bm-orange)">+\x24' + addonPrice + '</span></div>';
          if (addon.booked) {
            return '<div class="col-md-6"><div class="equipment-card" style="padding:0;opacity:0.45;pointer-events:none">' + inner + '</div></div>';
          }
          return '<div class="col-md-6 addon-item" data-category="' + (addon.category || '') + '" data-id="' + addon.id + '" data-name="' + addon.name + '" data-price="' + standalone + '" data-addon-rate="' + rate + '" data-has-wet="0"><div class="equipment-card select-card" style="padding:0">' + inner + '</div></div>';
        }).join('') + '</div></div>' : ''}


        ${equipment.length === 0 ? '<div class="text-center py-5"><div style="font-size:80px;opacity:0.3"><i class="fas fa-box-open"></i></div><h4 class="text-muted">No equipment available yet</h4><p class="text-muted">Check back soon!</p></div>' : ''}
      </div>

    </div>

    <!-- Multi-day note (day count is chosen up front on step 1) -->
    ${rentalDays > 1 ? '<div class="row mt-4"><div class="col-lg-8 mx-auto"><div style="background:#eef3f8;border-radius:12px;padding:14px 20px;text-align:center;font-size:14px;color:#004E89;font-weight:600"><i class="fas fa-calendar-week me-2"></i>Prices below are the total for your ' + rentalDays + '-day rental. <a href="/booking" style="color:#004E89;text-decoration:underline">Change days</a></div></div></div>' : ''}

        <!-- Selection Summary (below all options) -->
    <div class="row mt-4">
      <div class="col-lg-6 mx-auto">
