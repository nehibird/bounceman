<script>
  var selectedItems = {};
  var wetItems = {}; // track wet/dry per item ID
  var rentalDays = ${ parseInt(rentalDays, 10) || 1 };
  // JSON-encode + escape '<' (same pattern as step3-details WD_UNITS) so no value can break out of
  // this inline script. The route also allowlists rental_duration; this is the second lock.
  var rentalDurationParam = ${ JSON.stringify(String(rentalDuration)).replace(/</g, '\\u003c') };
  var selectedDaysS2 = 1;

  function isFullDayBooking() { return rentalDurationParam !== '4hr'; }

  function getMaxDaysForSelection() {
    var ids = Object.keys(selectedItems);
    if (ids.length === 0) return 1;
    var minExtra = Infinity;
    ids.forEach(function(id) {
      var el = document.querySelector('[data-id="' + id + '"]');
      if (!el) return;
      var cat = el.dataset.category || '';
      if (cat === 'add_ons' || cat === 'add-ons') return;
      var maxExtra = parseInt(el.dataset.maxExtra || '0');
      if (maxExtra < minExtra) minExtra = maxExtra;
    });
    if (minExtra === Infinity) return 1;
    return 1 + minExtra;
  }

  function getExtraCostForDays(days) {
    if (days <= 1) return 0;
    var extraDays = days - 1;
    var ids = Object.keys(selectedItems);
    var total = 0;
    ids.forEach(function(id) {
      var el = document.querySelector('[data-id="' + id + '"]');
      if (!el) return;
      var cat = el.dataset.category || '';
      if (cat === 'add_ons' || cat === 'add-ons') return;
      var extraDay = parseFloat(el.dataset.extraDay || '0');
      if (!isNaN(extraDay) && extraDay > 0) total += extraDay * extraDays;
    });
    return total;
  }

  function getUnavailableForDays(days) {
    if (days <= 1) return [];
    var extraDays = days - 1;
    var unavail = [];
    Object.keys(selectedItems).forEach(function(id) {
      var el = document.querySelector('[data-id="' + id + '"]');
      if (!el) return;
      var cat = el.dataset.category || '';
      if (cat === 'add_ons' || cat === 'add-ons') return;
      var maxExtra = parseInt(el.dataset.maxExtra || '0');
      if (maxExtra < extraDays) unavail.push(selectedItems[id].name);
    });
    return unavail;
  }

  function refreshMultiDayBlock() {
    var block = document.getElementById('multiDayBlock');
    if (!block) return;
    var ids = Object.keys(selectedItems).filter(function(id) {
      var el = document.querySelector('[data-id="' + id + '"]');
      if (!el) return false;
      var cat = el.dataset.category || '';
      return cat !== 'add_ons' && cat !== 'add-ons';
    });
    if (!isFullDayBooking() || ids.length === 0) {
      block.style.display = 'none';
      selectedDaysS2 = 1;
      return;
    }
    block.style.display = '';

    var maxDays = Math.min(3, getMaxDaysForSelection());

    if (selectedDaysS2 > maxDays) selectedDaysS2 = maxDays;
    document.querySelectorAll('.days-btn-s2').forEach(function(btn) {
      var d = parseInt(btn.dataset.days);
      btn.classList.toggle('selected', d === selectedDaysS2);
      btn.classList.toggle('disabled-day', d > maxDays);
    });

    var extraCostDiv = document.getElementById('extraDayCost');
    var warnDiv = document.getElementById('extraDayWarning');
    if (selectedDaysS2 > 1) {
      var extra = getExtraCostForDays(selectedDaysS2);
      if (extra > 0) {
        extraCostDiv.textContent = '+$' + (Number.isInteger(extra) ? extra : extra.toFixed(2)) + ' — ' + selectedDaysS2 + ' days total';
        extraCostDiv.style.display = '';
      } else {
        extraCostDiv.style.display = 'none';
      }
      var unavail = getUnavailableForDays(selectedDaysS2);
      if (unavail.length > 0) {
        warnDiv.textContent = 'Not available for ' + selectedDaysS2 + ' days: ' + unavail.join(', ');
        warnDiv.style.display = '';
      } else {
        warnDiv.style.display = 'none';
      }
    } else {
      extraCostDiv.style.display = 'none';
      warnDiv.style.display = 'none';
    }
  }

  // Event delegation: equipment AND add-on card click (toggleItem). Registered on both grids
  // below -- it used to be #equipmentGrid only, which is why add-ons were dead.
  function readRate(el) {
    var r = parseFloat(el.dataset.addonRate);
    return isNaN(r) ? null : r;
  }
  function handleCardClick(e) {
    var wdBtn = e.target.closest('.wd-btn');
    if (wdBtn) {
      e.stopPropagation();
      var container = wdBtn.closest('.wet-dry-inline');
      if (!container) return;
      var itemId = container.id.replace('wetdry-', '');
      var isWet = wdBtn.dataset.mode === 'wet';
      setWetDry(itemId, isWet, wdBtn);
      return;
    }
    var card = e.target.closest('.select-card');
    if (!card) return;
    var itemDiv = card.closest('.equipment-item');
    if (!itemDiv) {
      itemDiv = card.closest('[data-id]');
    }
    if (!itemDiv) return;
    var id = itemDiv.dataset.id;
    var name = itemDiv.dataset.name;
    var price = parseFloat(itemDiv.dataset.price);
    if (id && name && !isNaN(price)) toggleItem(card, id, name, price, readRate(itemDiv));
  }
  document.getElementById('equipmentGrid').addEventListener('click', handleCardClick);
  var addonGridEl = document.getElementById('addonGrid');
  if (addonGridEl) addonGridEl.addEventListener('click', handleCardClick);

  document.getElementById('continueBtn').addEventListener('click', function(e) {
    goToStep2(e);
  });

  var dayBtnsEl = document.getElementById('dayBtns');
  if (dayBtnsEl) {
    dayBtnsEl.addEventListener('click', function(e) {
      var btn = e.target.closest('.days-btn-s2');
      if (!btn || btn.classList.contains('disabled-day')) return;
      selectedDaysS2 = parseInt(btn.dataset.days);
      refreshMultiDayBlock();
    });
  }

  function setWetDry(itemId, isWet, btn) {
    wetItems[itemId] = isWet;
    var dryBtn = document.getElementById('wd-dry-' + itemId);
    var wetBtn = document.getElementById('wd-wet-' + itemId);
    if (dryBtn) { dryBtn.classList.toggle('wd-active', !isWet); }
    if (wetBtn) { wetBtn.classList.toggle('wd-active', isWet); }
    var req = document.getElementById('wdreq-' + itemId);
    if (req) {
      req.textContent = isWet ? '✓ Wet selected' : '✓ Dry selected';
      req.classList.add('wd-chosen');
      req.classList.remove('wd-flash');
    }
    updateSummary();
  }

  // Reset a card's wet/dry chooser back to its unchosen state
  function resetWetDryUI(itemId) {
    var dryBtn = document.getElementById('wd-dry-' + itemId);
    var wetBtn = document.getElementById('wd-wet-' + itemId);
    if (dryBtn) dryBtn.classList.remove('wd-active');
    if (wetBtn) wetBtn.classList.remove('wd-active');
    var req = document.getElementById('wdreq-' + itemId);
    if (req) { req.textContent = 'Choose one'; req.classList.remove('wd-chosen', 'wd-flash'); }
  }

  // Selected, wet-capable items that still need a wet/dry choice
  function getUnchosenWetItems() {
    return Object.keys(selectedItems).filter(function(id) {
      var el = document.querySelector('[data-id="' + id + '"]');
      if (!el || el.dataset.hasWet !== '1') return false;
      return typeof wetItems[id] === 'undefined';
    });
  }

  function showHideWetDry() {
    document.querySelectorAll('.wet-dry-inline').forEach(function(el) {
      var itemId = el.id.replace('wetdry-', '');
      if (selectedItems[itemId]) {
        el.style.display = '';
      } else {
        el.style.display = 'none';
        delete wetItems[itemId];
        resetWetDryUI(itemId);
      }
    });
  }

  (function() {
    var params = new URLSearchParams(window.location.search);
    var preItems = params.get('items') || params.get('preselect');
    if (preItems) {
      preItems.split(',').forEach(function(id) {
        var el = document.querySelector('[data-id="' + id + '"]');
        if (el) {
          var card = el.querySelector('.select-card');
          if (!card) return;
          var name = el.dataset.name;
          var price = parseFloat(el.dataset.price);
          toggleItem(card, id, name, price, readRate(el));
        }
      });
    }
  })();

  function toggleItem(card, id, name, price, addonRate) {
    if (selectedItems[id]) {
      delete selectedItems[id];
      card.classList.remove('selected');
      card.querySelector('.fa-check').style.display = 'none';
    } else {
      selectedItems[id] = { name: name, price: price, addonRate: (typeof addonRate === 'number' && !isNaN(addonRate)) ? addonRate : null };
      card.classList.add('selected');
      card.querySelector('.fa-check').style.display = '';
    }
    showHideWetDry();
    updateSummary();
  }

  // Mirror of lib/helpers addonPricedIds so the cart total matches what /booking/review charges:
  // the priciest item is the ANCHOR and pays full price (ties -> lowest id); every other item that
  // has a ride-along rate pays that instead. Alone, an add-on is its own anchor (cornhole $75 alone,
  // $20 beside a slide). Server stays authoritative; this is display only.
  function getAddonPricedIds(keys) {
    var out = {};
    if (keys.length <= 1) return out;
    var anchor = null;
    keys.forEach(function(id) {
      if (anchor === null || selectedItems[id].price > selectedItems[anchor].price ||
          (selectedItems[id].price === selectedItems[anchor].price && String(id) < String(anchor))) anchor = id;
    });
    keys.forEach(function(id) {
      if (id !== anchor && selectedItems[id].addonRate !== null) out[id] = true;
    });
    return out;
  }

  function updateSummary() {
    var keys = Object.keys(selectedItems);
    var listEl = document.getElementById('selectedList');
    var emptyMsg = document.getElementById('emptyMsg');
    var subtotalEl = document.getElementById('subtotal');
    var countEl = document.getElementById('itemCount');
    var continueBtn = document.getElementById('continueBtn');
    var wetWarnEl = document.getElementById('wetChoiceWarn');
    var wetWarnTextEl = document.getElementById('wetChoiceWarnText');
    var subtotal = 0;

    var summaryEl = document.getElementById('selectionSummary');
    if (summaryEl) {
      summaryEl.classList.toggle('has-items', keys.length > 0);
      document.body.classList.toggle('has-sticky-summary', keys.length > 0);
    }

    listEl.innerHTML = '';
    if (keys.length === 0) {
      listEl.innerHTML = '<p class="text-muted text-center small" id="emptyMsg">No items selected yet</p>';
      subtotalEl.textContent = '$0';
      countEl.textContent = '0 items selected';
      var sheetSum0 = document.getElementById('sheetSummary');
      if (sheetSum0) sheetSum0.innerHTML = '0 items &middot; $0';
      setSheetExpanded(false); // an empty cart has nothing to expand; do not reopen expanded next time
      showHideWetDry();
      continueBtn.disabled = true;
      continueBtn.style.opacity = '0.5';
      if (wetWarnEl) wetWarnEl.style.display = 'none';
      var pe0 = document.getElementById('freeDayPromo');
      if (pe0) pe0.style.display = 'none';
      refreshMultiDayBlock();
      return;
    }

    var addonPriced = getAddonPricedIds(keys);
    keys.forEach(function(id) {
      var item = selectedItems[id];
      var itemTotal = addonPriced[id] ? item.addonRate : item.price;
      var label = item.name;
      if (wetItems[id]) {
        label += ' (Wet)';  // wet is the same price — no upcharge added
      }
      subtotal += itemTotal;
      var row = document.createElement('div');
      row.className = 'd-flex justify-content-between align-items-center mb-2';
      row.innerHTML = '<span class="small">' + label + '</span><span class="small fw-bold">$' + itemTotal.toFixed(0) + '</span>';
      listEl.appendChild(row);
    });

    subtotalEl.textContent = '$' + subtotal.toFixed(0);
    countEl.textContent = keys.length + ' item' + (keys.length > 1 ? 's' : '') + ' selected';
    var sheetSum = document.getElementById('sheetSummary');
    if (sheetSum) sheetSum.innerHTML = keys.length + ' item' + (keys.length > 1 ? 's' : '') + ' &middot; <span class="sheet-total">$' + subtotal.toLocaleString('en-US', { maximumFractionDigits: 0 }) + '</span>';

    // Promo nudge: book 3+ items → one extra day free (applied at checkout).
    var promoEl = document.getElementById('freeDayPromo');
    if (promoEl) {
      var n = keys.length;
      if (rentalDays >= 2 && n >= 3) {
        promoEl.innerHTML = '🎁 Your extra day is <b>FREE</b> — 3+ item bonus, applied at checkout!';
        promoEl.style.display = '';
      } else if (rentalDays >= 2 && n > 0) {
        promoEl.innerHTML = '🎁 Add ' + (3 - n) + ' more item' + ((3 - n) > 1 ? 's' : '') + ' and your extra day is <b>FREE</b>!';
        promoEl.style.display = '';
      } else if (rentalDays < 2 && n >= 3) {
        promoEl.innerHTML = '🎁 Booking 3+ items? Keep them a 2nd day <b>FREE</b> — <a href="/booking" style="color:inherit;text-decoration:underline">add days</a>.';
        promoEl.style.display = '';
      } else {
        promoEl.style.display = 'none';
      }
    }

    // Button stays clickable so the click can guide them to the unmade choice
    continueBtn.disabled = false;
    continueBtn.style.opacity = '1';

    // Surface a hint when a wet-capable item still needs a wet/dry choice
    var unchosen = getUnchosenWetItems();
    if (unchosen.length > 0 && wetWarnEl && wetWarnTextEl) {
      var names = unchosen.map(function(id) { return selectedItems[id].name; });
      wetWarnTextEl.textContent = 'Choose wet or dry for: ' + names.join(', ');
      wetWarnEl.style.display = '';
    } else if (wetWarnEl) {
      wetWarnEl.style.display = 'none';
    }
    refreshMultiDayBlock();
  }

  // Flash the "Choose one" badge on every unit still missing a wet/dry answer and scroll to the
  // first. Shared by Continue and the (now tappable) amber warning in the cart sheet, which used to
  // be inert text. Collapses the sheet first so an expanded list never covers the unit being shown.
  // Returns true when something needed an answer.
  function nudgeUnchosenWetDry() {
    var unchosen = getUnchosenWetItems();
    if (unchosen.length === 0) return false;
    setSheetExpanded(false);
    unchosen.forEach(function(id) {
      var req = document.getElementById('wdreq-' + id);
      if (req) { req.classList.remove('wd-flash'); void req.offsetWidth; req.classList.add('wd-flash'); }
    });
    var firstEl = document.getElementById('wetdry-' + unchosen[0]);
    if (firstEl) firstEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return true;
  }
  function setSheetExpanded(on) {
    var sum = document.getElementById('selectionSummary');
    var tg = document.getElementById('sheetToggle');
    if (sum) sum.classList.toggle('expanded', !!on);
    if (tg) tg.setAttribute('aria-expanded', on ? 'true' : 'false');
  }
  (function() {
    var tg = document.getElementById('sheetToggle');
    var warn = document.getElementById('wetChoiceWarn');
    if (tg) tg.addEventListener('click', function() {
      setSheetExpanded(!document.getElementById('selectionSummary').classList.contains('expanded'));
    });
    if (warn) warn.addEventListener('click', nudgeUnchosenWetDry);
  })();

  function goToStep2(e) {
    e.preventDefault();
    var ids = Object.keys(selectedItems);
    if (ids.length === 0) return;

    // Block until every wet-capable item has a wet/dry choice; nudge toward it
    if (nudgeUnchosenWetDry()) return;

    var params = new URLSearchParams(window.location.search);
    var wetIds = Object.keys(wetItems).filter(function(id) { return wetItems[id]; });
    var eventDateParam = params.get('event_date') || '';
    // Day count is chosen up front on step 1 — pass it straight through
    var rentalDaysParam = parseInt(params.get('rental_days')) || 1;
    var effectiveDays = isFullDayBooking() ? Math.max(1, rentalDaysParam) : 1;
    var endDateParam = params.get('event_end_date') || eventDateParam;
    window.location.href = '/booking/details?items=' + ids.join(',') + '&wet_items=' + wetIds.join(',') +
      '&event_date=' + eventDateParam +
      '&rental_duration=' + (params.get('rental_duration') || 'daily') +
      '&event_start_time=' + (params.get('event_start_time') || '09:00') +
      '&event_end_time=' + (params.get('event_end_time') || '19:00') +
      '&rental_days=' + effectiveDays +
      '&event_end_date=' + endDateParam +
      '&ready_by=' + (params.get('ready_by') || params.get('event_start_time') || '09:00') +
      '&wd=1';  // step 2 asked wet/dry — tells step 3 the URL answer is a real choice
  }

  document.getElementById('categoryFilters').addEventListener('click', function(e) {
    if (!e.target.matches('.filter-pill')) return;
    document.querySelectorAll('.filter-pill').forEach(function(b) { b.classList.remove('active'); });
    e.target.classList.add('active');
    var cat = e.target.dataset.category;
    document.querySelectorAll('.equipment-item').forEach(function(item) {
      if (cat === 'all' || item.dataset.category === cat) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  });

  updateSummary();
  refreshMultiDayBlock();

</script>
