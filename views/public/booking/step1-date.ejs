<%- include('../../layouts/public', { body: `

<style>
  .booking-progress { display: flex; justify-content: center; gap: 0; margin-bottom: 40px; }
  .booking-progress .step { display: flex; align-items: center; gap: 8px; padding: 12px 20px; color: #aaa; font-weight: 600; font-size: 14px; }
  .booking-progress .step.active { color: var(--bm-orange); }
  .booking-progress .step.completed { color: var(--bm-green); }
  .booking-progress .step .step-num { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; background: #e9ecef; color: #aaa; }
  .booking-progress .step.active .step-num { background: var(--bm-gradient); color: white; }
  .booking-progress .step.completed .step-num { background: var(--bm-green); color: white; }
  .booking-progress .step-line { width: 40px; height: 2px; background: #e9ecef; align-self: center; }
  .date-card { background: white; border-radius: 20px; padding: 30px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); }
  /* was width:fit-content; the calendar now sizes itself to 100% (max 308px = 7 x 44px cells), which fit-content would make circular. */
  .date-card-calendar { width: 100%; max-width: 308px; margin: 0 auto; }
  .dur-btn {
    padding: 16px 8px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 80px;
  }
  .dur-btn .dur-label { font-weight: 700; font-size: 15px; line-height: 1.2; }
  .dur-btn .dur-sub { font-size: 12px; opacity: 0.7; margin-top: 2px; }
  /* Duration controls are real <button>s now (they were <div>s: unreachable by Tab, no
     Enter/Space, no pressed state for screen readers). Show where focus is. */
  .dur-btn:focus-visible { outline: 3px solid var(--bm-orange, #E8833A); outline-offset: 2px; }
  .dur-btn:disabled { cursor: not-allowed; }
  #nativeDateInput:focus-visible { outline: 3px solid var(--bm-orange, #E8833A); outline-offset: 2px; }
  /* The keyboard date field used to sit visibly under the calendar; on phones it read as a
     confusing duplicate ("Or type / choose your date"). Visually-hidden (clip pattern), NOT
     display:none / visibility:hidden -- those drop it from the accessibility tree AND tab order,
     which would undo the WCAG 2.1.1 fix (flatpickr's inline days are tabindex=-1). It stays 1px,
     focusable and announced; on :focus-within it springs into normal flow so a sighted keyboard
     user can see what they are typing into. position:absolute needs the .date-card anchor below. */
  .date-card { position: relative; }
  .sr-date:not(:focus-within) {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0;
    overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }
  /* Calendar tap targets, measured on iPhone 14: day cells 39x42 (guideline 44x44) because
     flatpickr caps .flatpickr-day at max-width:39px / height:39px (layout adds 42px height on
     mobile). 7 x 44 = 308px, which is exactly the calendar's 307.875px, so the grid holds. The
     card gutters shrink on narrow phones so the 308px calendar is not squeezed below 44px cells. */
  .date-card-calendar .flatpickr-calendar.inline { width: 100%; max-width: 308px; }
  .date-card-calendar .flatpickr-innerContainer, .date-card-calendar .flatpickr-rContainer,
  .date-card-calendar .flatpickr-days, .date-card-calendar .dayContainer { width: 100%; min-width: 0; max-width: none; }
  .date-card-calendar .flatpickr-day { max-width: none; flex-basis: 14.2857%; height: 44px; line-height: 44px; }
  /* Month/year header: the layout gives the month select + year input min-height:44px inside
     flatpickr's fixed 34px, line-height:1 header, so the descenders were cut off at the bottom.
     Grow the header to fit and centre its contents; arrows follow so they stay mid-header. */
  .date-card-calendar .flatpickr-months .flatpickr-month,
  .date-card-calendar .flatpickr-current-month { height: 52px; }
  .date-card-calendar .flatpickr-current-month { display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1.3; }
  .date-card-calendar .flatpickr-months .flatpickr-prev-month,
  .date-card-calendar .flatpickr-months .flatpickr-next-month { height: 52px; display: flex; align-items: center; justify-content: center; padding: 0 10px; }
  @media (max-width: 420px) { .date-card { padding: 20px 8px; } }
  /* Scroll target for the post-date-pick nudge; keeps the heading clear of the sticky header. */
  #durationCard { scroll-margin-top: 80px; }
  .dur-btn.selected {
    background: var(--bm-blue, #004E89) !important;
    color: white !important;
    border-color: var(--bm-blue, #004E89) !important;
  }
  .dur-btn.selected .dur-sub,
  .dur-btn.selected .dur-label,
  .dur-btn.selected i { color: white !important; opacity: 1 !important; }
  .days-btn {
    padding: 10px 20px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
    font-size: 15px;
    border: 2px solid #e0e0e0;
    background: #f8f8f8;
    color: #555;
    transition: all 0.2s;
    user-select: none;
  }
  .days-btn.selected {
    background: var(--bm-blue, #004E89) !important;
    color: white !important;
    border-color: var(--bm-blue, #004E89) !important;
  }
  .day-stepper { display: flex; align-items: center; gap: 18px; }
  .day-step-btn {
    width: 48px; height: 48px; border-radius: 12px;
    border: 2px solid var(--bm-blue, #004E89); background: #fff; color: var(--bm-blue, #004E89);
    font-size: 26px; font-weight: 700; line-height: 1; cursor: pointer;
    display: flex; align-items: center; justify-content: center; transition: all .15s;
  }
  .day-step-btn:hover:not(:disabled) { background: var(--bm-blue, #004E89); color: #fff; }
  .day-step-btn:disabled { opacity: .3; cursor: not-allowed; }
  .day-count { font-size: 22px; font-weight: 800; color: #1c2733; min-width: 96px; text-align: center; }
  .day-count-unit { font-size: 15px; font-weight: 600; color: #6b7480; }
  .readyby-select {
    font-size: 15px;
    padding: 10px 16px;
    border-radius: 10px;
    border: 2px solid #e0e0e0;
    width: 100%;
    max-width: 260px;
    font-weight: 600;
    color: #333;
  }
  .readyby-select:focus {
    border-color: var(--bm-blue, #004E89);
    outline: none;
    box-shadow: 0 0 0 3px rgba(0,78,137,0.12);
  }
</style>

<section class="py-5">
  <div class="container">
    <div class="booking-progress">
      <div class="step active">
        <span class="step-num">1</span>
        <span class="d-none d-md-inline">Pick Date</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">2</span>
        <span class="d-none d-md-inline">Select Items</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">3</span>
        <span class="d-none d-md-inline">Your Details</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">4</span>
        <span class="d-none d-md-inline">Review</span>
      </div>
    </div>

    <div class="section-title">
      <h1>Book Your Bounce House Rental</h1>
      <p class="h5 fw-normal text-muted">When is your event? Pick a date and time to see what's available</p>
      ${ typeof preselectItem !== 'undefined' && preselectItem ? '<div id="bookingChip" style="display:inline-flex;align-items:center;gap:8px;margin-top:6px;padding:8px 16px;border-radius:999px;background:#FFF3E8;border:1px solid #E8833A;color:#15263A;font-size:15px;font-weight:600"><i class="fas fa-check-circle" style="color:#E8833A"></i><span>Booking: ' + esc(preselectItem.name) + (preselectItem.price ? ' &mdash; Full Day $' + preselectItem.price.toFixed(0) : '') + '</span></div>' : '' }
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <form id="dateForm" action="/booking/select" method="GET">

          <!-- 1. Date -->
          <div class="date-card mb-4">
            <h5 style="color:var(--bm-blue);font-weight:700;" class="mb-3"><i class="fas fa-calendar-alt me-2"></i>Event Date</h5>
            <div class="date-card-calendar"><div id="datePicker"></div></div>
            <!-- Keyboard / screen-reader path. Inline flatpickr days are tabindex=-1, so Tab never
                 reached the calendar and the funnel was a WCAG 2.1.1 dead end without a mouse.
                 This real date input stays in two-way sync with the calendar. -->
            <div class="sr-date" style="max-width:260px;margin:16px auto 0;">
              <label for="nativeDateInput" class="form-label fw-bold small mb-1">Or type / choose your date</label>
              <input type="date" id="nativeDateInput" class="form-control" aria-describedby="nativeDateMsg">
              <div id="nativeDateMsg" class="small mt-1" role="status" aria-live="polite" style="min-height:1.3em;color:#b02a37"></div>
            </div>
            <input type="hidden" name="event_date" id="eventDateInput" required>
          </div>

          <!-- 2. Duration -->
          <div class="date-card mb-4" id="durationCard">
            <h6 class="fw-bold mb-3"><i class="fas fa-clock me-2"></i>How Long Do You Need It?</h6>
            <div class="row g-3" role="group" aria-label="How long do you need it?">
              <div class="col-4">
                <button type="button" class="btn btn-outline-primary w-100 text-center dur-btn" id="durHalfDay" aria-pressed="false">
                  <span class="dur-label">Half Day</span>
                  <span class="dur-sub">4 hours</span>
                </button>
              </div>
              <div class="col-4">
                <button type="button" class="btn btn-outline-primary w-100 text-center dur-btn selected" id="durFullDay" aria-pressed="true">
                  <span class="dur-label">Full Day</span>
                  <span class="dur-sub">11 AM – 7 PM</span>
                </button>
              </div>
              <div class="col-4">
                <button type="button" class="btn btn-outline-primary w-100 text-center dur-btn" id="durMultiDay" aria-pressed="false">
                  <span class="dur-label">Multi Day</span>
                  <span class="dur-sub">2–7 days</span>
                </button>
              </div>
            </div>
            <div id="fulldayNote" style="margin-top:12px;font-size:13px;color:#004E89;display:block;">
              <i class="fas fa-info-circle me-1"></i> 11 AM – 7 PM — we set up before 11.
            </div>

            <div id="sundayNote" aria-live="polite" style="display:none;margin-top:12px;background:#eef3f8;border-radius:10px;padding:12px;font-size:14px;color:#004E89">
              <i class="fas fa-info-circle me-1"></i> Sundays are <strong>full-day only</strong>. We usually drop off
              <strong>Saturday evening</strong> and pick up <strong>Monday morning</strong>, so you get the overnight
              free. Because it stays out overnight, Sunday setups can't be at a park or other public space.
              <a href="#" id="sundayTermsLink" style="color:#004E89;text-decoration:underline">See the details</a>
            </div>

            <div id="holidayNote" aria-live="polite" style="display:none;margin-top:12px;background:#eef3f8;border-radius:10px;padding:12px;font-size:14px;color:#004E89">
              <i class="fas fa-info-circle me-1"></i> Memorial Day and Labor Day are <strong>full-day only</strong> — no half-day or multi-day on these holidays.
            </div>

            <div id="weekdaySpecialNote" aria-live="polite" style="display:none;margin-top:12px;background:#FFF3E8;border:1px solid #E8833A;border-radius:10px;padding:12px;font-size:14px;color:#15263A">
              <i class="fas fa-sun me-1" style="color:#E8833A"></i> <strong>${settings.weekday_special_label || 'Weekday Special'}!</strong> On this weekday you get a <strong>Full Day for the Half-Day price</strong> — see your deal on the next step. 🎉
            </div>
          </div>

          <!-- 2b. How many days? (multi-day only) -->
          <div class="date-card mb-4" id="daysCard" style="display:none;">
            <h6 class="fw-bold mb-3"><i class="fas fa-calendar-week me-2"></i>How Many Days?</h6>
            <p class="text-muted small mb-3">Keep it for the whole weekend or event — you'll see each unit's multi-day total on the next step.</p>
            <div class="day-stepper">
              <button type="button" class="day-step-btn" id="dayMinus" aria-label="Fewer days">&minus;</button>
              <div class="day-count"><span id="dayCountNum">2</span> <span class="day-count-unit">days</span></div>
              <button type="button" class="day-step-btn" id="dayPlus" aria-label="More days">+</button>
            </div>
            <div class="text-muted small mt-3" id="daysHint"><i class="fas fa-info-circle me-1"></i>From 2 up to 7 days.</div>
          </div>

          <!-- 3. Ready-by time (half-day only) -->
          <div class="date-card mb-4" id="timeCard" style="display:none;">
            <h6 class="fw-bold mb-3"><i class="fas fa-sun me-2"></i>What time do you want to start?</h6>
            <p class="text-muted small mb-3">Pick when your 4 hours begin.</p>
            <select id="readyBySelect" class="readyby-select">
              <option value="">Select a time...</option>
            </select>
          </div>

          <!-- Hidden fields -->
          <input type="hidden" name="rental_duration" id="hiddenDuration" value="daily">
          <input type="hidden" name="event_start_time" id="hiddenStart" value="09:00">
          <input type="hidden" name="event_end_time" id="hiddenEnd" value="19:00">
          <input type="hidden" name="rental_days" id="hiddenDays" value="1">
          <input type="hidden" name="event_end_date" id="hiddenEndDate" value="">
          <input type="hidden" name="ready_by" id="hiddenReadyBy" value="">

          <div class="text-center">
            <button type="submit" class="btn btn-book-now px-5 py-3">
              See Available Equipment <i class="fas fa-arrow-right ms-2"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  /* The lead-capture coupon (#bml-root) sits at z-index 99999 and was covering the
     modal's "Pick a different day" button. Terms the customer has to read outrank a
     $10-off popup, so the modal and its backdrop go above it — and the coupon is
     hidden outright while the modal is open rather than left peeking around it. */
  .modal-backdrop.sunday-terms-backdrop { z-index: 100000; }
  body.sunday-terms-open #bml-root { display: none !important; }
</style>

<!-- Sunday terms. Fires the moment a Sunday is picked, not at checkout: the delivery
     window is different (usually Saturday evening) and parks are out, and a customer
     who finds that out on the review page has already made plans around a guess. -->
<div class="modal fade" id="sundayModal" tabindex="-1" aria-labelledby="sundayModalLabel" aria-hidden="true" style="z-index:100010">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:none;border-radius:16px;overflow:hidden">
      <div class="modal-header" style="background:var(--bm-blue,#004E89);color:#fff;border:none;padding:18px 22px">
        <h5 class="modal-title" id="sundayModalLabel" style="font-weight:700">
          <i class="fas fa-sun me-2"></i>About Sunday rentals
        </h5>
      </div>
      <div class="modal-body" style="padding:22px">

        <div style="background:#FFF3E8;border:1px solid #E8833A;border-radius:12px;padding:14px 16px;margin-bottom:18px">
          <div style="font-weight:700;color:#15263A;font-size:16px;margin-bottom:4px">
            <i class="fas fa-gift me-2" style="color:#E8833A"></i>You get a free overnight
          </div>
          <div style="font-size:14px;color:#4a4a4a;line-height:1.55">
            Sunday rentals are usually dropped off <strong>Saturday evening</strong> and picked up
            <strong>Monday morning</strong> &mdash; so you keep it the whole weekend and through Sunday night
            at no extra charge. Most people love this. We just want you to know before you book.
          </div>
        </div>

        <div style="display:flex;gap:12px;margin-bottom:14px">
          <div style="flex:0 0 22px;text-align:center;color:#E8833A"><i class="fas fa-ban"></i></div>
          <div style="font-size:14px;color:#4a4a4a;line-height:1.55">
            <strong style="color:#15263A">No parks or public spaces on Sundays.</strong>
            Because the unit stays out overnight, Sunday setups have to be at a home, indoors,
            or on private business property &mdash; somewhere it can be looked after.
          </div>
        </div>

        <div style="display:flex;gap:12px;margin-bottom:14px">
          <div style="flex:0 0 22px;text-align:center;color:#E8833A"><i class="fas fa-clock"></i></div>
          <div style="font-size:14px;color:#4a4a4a;line-height:1.55">
            <strong style="color:#15263A">Full day only.</strong>
            We don't do half days on Sundays.
          </div>
        </div>

        <div style="display:flex;gap:12px">
          <div style="flex:0 0 22px;text-align:center;color:#E8833A"><i class="fas fa-house-chimney"></i></div>
          <div style="font-size:14px;color:#4a4a4a;line-height:1.55">
            <strong style="color:#15263A">Please leave it set up overnight.</strong>
            Keep it plugged in if you can, and make sure our crew can get to it Monday morning.
          </div>
        </div>

      </div>
      <div class="modal-footer" style="border:none;padding:0 22px 22px;gap:10px">
        <button type="button" class="btn btn-link px-3" id="sundayModalCancel"
                style="color:#8a8a8a;text-decoration:none">Pick a different day</button>
        <button type="button" class="btn btn-book-now px-4" id="sundayModalOk">
          Got it &mdash; that works for me
        </button>
      </div>
    </div>
  </div>
</div>

`, scripts: `
<script>
  // Drop empty entries BEFORE Number(). An empty setting means "block nothing", but
  // ''.split(',') is [''] and Number('') is 0 — which is Sunday. That silently greyed
  // out every Sunday on the calendar while the server happily allowed Sunday bookings.
  var BLOCKED_WEEKDAYS = '${settings.blocked_weekdays || ""}'.split(',')
    .map(function(s) { return s.trim(); })
    .filter(function(s) { return s !== ''; })
    .map(Number)
    .filter(function(n) { return !isNaN(n) && n >= 0 && n <= 6; });

  var WEEKDAY_SPECIAL = {
    active: '${settings.weekday_special_active || ""}' === '1',
    start: '${settings.weekday_special_start || ""}',
    end: '${settings.weekday_special_end || ""}',
    days: '${settings.weekday_special_days || "1,2,3,4,5"}'.split(',')
      .map(function(s) { return s.trim(); })
      .filter(function(s) { return s !== ''; })
      .map(Number)
      .filter(function(n) { return !isNaN(n) && n >= 0 && n <= 6; })
  };
  function isWeekdaySpecialDate(dateStr) {
    if (!WEEKDAY_SPECIAL.active || !dateStr) return false;
    if (WEEKDAY_SPECIAL.start && dateStr < WEEKDAY_SPECIAL.start) return false;
    if (WEEKDAY_SPECIAL.end && dateStr > WEEKDAY_SPECIAL.end) return false;
    return WEEKDAY_SPECIAL.days.indexOf(new Date(dateStr + 'T12:00:00').getDay()) !== -1;
  }

  // Memorial Day (last Mon of May) + Labor Day (first Mon of Sep) = full-day only.
  // Keep in sync with isFullDayOnlyDate() in lib/helpers.js (server enforces it too).
  function isFullDayOnlyHoliday(dateStr) {
    if (!dateStr) return false;
    var d = new Date(dateStr + 'T12:00:00');
    if (isNaN(d.getTime())) return false;
    var y = d.getFullYear(), m = d.getMonth(), day = d.getDate();
    if (m === 8) { var dow1 = new Date(y, 8, 1).getDay(); return day === 1 + ((1 - dow1 + 7) % 7); }
    if (m === 4) { var lastMay = new Date(y, 5, 0).getDate(); var ldow = new Date(y, 4, lastMay).getDay(); return day === lastMay - ((ldow - 1 + 7) % 7); }
    return false;
  }

  var HALFDAY_HOURS = 4;
  var MIN_READY_BY_H = 8;
  var MAX_END_HOUR = 22;
  var MAX_DAYS = 7;
  var MIN_MULTI = 2;

  var selectedDurationType = 'allday';
  var selectedDays = 1;
  var readyByHour = 9;
  var readyByMin = 0;

  function pad2(n) { return n < 10 ? '0' + n : String(n); }
  function fmt24(h, m) { return pad2(h) + ':' + pad2(m); }
  function fmt12(h, m) {
    var ampm = h >= 12 ? 'PM' : 'AM';
    var h12 = h % 12 || 12;
    return h12 + ':' + pad2(m) + ' ' + ampm;
  }
  function isoOffset(dateStr, days) {
    if (!dateStr) return '';
    var d = new Date(dateStr + 'T12:00:00');
    d.setDate(d.getDate() + days);
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
  }

  function buildReadyByTimes() {
    var maxH = MAX_END_HOUR - HALFDAY_HOURS;
    var times = [];
    for (var h = MIN_READY_BY_H; h <= maxH; h++) {
      times.push({ h: h, m: 0 });
      if (h < maxH) times.push({ h: h, m: 30 });
    }
    return times;
  }

  function refreshReadyBySelect() {
    var sel = document.getElementById('readyBySelect');
    var times = buildReadyByTimes();
    var maxH = MAX_END_HOUR - HALFDAY_HOURS;
    if (readyByHour * 60 + readyByMin > maxH * 60) {
      readyByHour = 9; readyByMin = 0;
    }
    sel.innerHTML = '<option value="">Select a time...</option>';
    times.forEach(function(t) {
      var opt = document.createElement('option');
      opt.value = fmt24(t.h, t.m);
      opt.textContent = fmt12(t.h, t.m);
      if (t.h === readyByHour && t.m === readyByMin) opt.selected = true;
      sel.appendChild(opt);
    });
    updateHiddenFields();
  }

  function updateHiddenFields() {
    var durVal, startVal, endVal, readyByVal;
    if (selectedDurationType !== 'halfday') {
      // Full Day and Multi Day both bill the full-day rate per day
      durVal = 'daily';
      startVal = '11:00';
      endVal = '19:00';
      readyByVal = '11:00';
    } else {
      durVal = '4hr';
      var sel = document.getElementById('readyBySelect');
      var val = sel.value;
      readyByVal = val;
      if (!val) {
        startVal = '';
        endVal = '';
      } else {
        var parts = val.split(':');
        var rh = parseInt(parts[0]);
        var rm = parseInt(parts[1]);
        startVal = fmt24(rh, rm);
        endVal = fmt24(rh + HALFDAY_HOURS, rm);
      }
    }
    document.getElementById('hiddenDuration').value = durVal;
    document.getElementById('hiddenStart').value = startVal;
    document.getElementById('hiddenEnd').value = endVal;
    document.getElementById('hiddenReadyBy').value = readyByVal;
    var days = (selectedDurationType === 'multiday') ? selectedDays : 1;
    document.getElementById('hiddenDays').value = String(days);
    var dateStr = document.getElementById('eventDateInput').value;
    document.getElementById('hiddenEndDate').value = dateStr ? isoOffset(dateStr, days - 1) : '';
  }

  // Number-of-days stepper (full-day only)
  function renderDays() {
    var num = document.getElementById('dayCountNum');
    if (num) num.textContent = selectedDays;
    var unit = document.querySelector('#daysCard .day-count-unit');
    if (unit) unit.textContent = selectedDays === 1 ? 'day' : 'days';
    var minus = document.getElementById('dayMinus');
    var plus = document.getElementById('dayPlus');
    if (minus) minus.disabled = selectedDays <= MIN_MULTI;
    if (plus) plus.disabled = selectedDays >= MAX_DAYS;
  }

  function setDays(n) {
    selectedDays = Math.max(MIN_MULTI, Math.min(MAX_DAYS, n));
    renderDays();
    updateHiddenFields();
  }

  function selectDurationType(type) {
    selectedDurationType = type;
    document.getElementById('durHalfDay').classList.toggle('selected', type === 'halfday');
    document.getElementById('durFullDay').classList.toggle('selected', type === 'allday');
    document.getElementById('durMultiDay').classList.toggle('selected', type === 'multiday');
    // Screen readers get the choice from aria-pressed, not from the .selected colour.
    document.getElementById('durHalfDay').setAttribute('aria-pressed', String(type === 'halfday'));
    document.getElementById('durFullDay').setAttribute('aria-pressed', String(type === 'allday'));
    document.getElementById('durMultiDay').setAttribute('aria-pressed', String(type === 'multiday'));
    var timeCard = document.getElementById('timeCard');
    var fulldayNote = document.getElementById('fulldayNote');
    var daysCard = document.getElementById('daysCard');
    if (type === 'halfday') {
      timeCard.style.display = '';
      if (fulldayNote) fulldayNote.style.display = 'none';
      if (daysCard) daysCard.style.display = 'none';
      selectedDays = 1;
      refreshReadyBySelect();
    } else if (type === 'multiday') {
      timeCard.style.display = 'none';
      if (fulldayNote) fulldayNote.style.display = 'none';
      if (daysCard) daysCard.style.display = '';
      if (selectedDays < MIN_MULTI) selectedDays = MIN_MULTI;
    } else {
      // Full Day
      timeCard.style.display = 'none';
      if (fulldayNote) fulldayNote.style.display = 'block';
      if (daysCard) daysCard.style.display = 'none';
      selectedDays = 1;
    }
    renderDays();
    updateHiddenFields();
    applyDayRules();
  }

  function setDurDisabled(btn, off) {
    if (!btn) return;
    // Real disabled attribute: pointer-events:none only stops the mouse, so a keyboard user
    // could still Tab to and press a greyed-out Half Day on a Sunday.
    btn.disabled = !!off;
    if (off) { btn.classList.add('disabled'); btn.style.opacity = '0.4'; btn.style.pointerEvents = 'none'; }
    else { btn.classList.remove('disabled'); btn.style.opacity = ''; btn.style.pointerEvents = ''; }
  }

  function applyDayRules() {
    var dateStr = document.getElementById('eventDateInput').value;
    var note = document.getElementById('sundayNote');
    var specialNote = document.getElementById('weekdaySpecialNote');
    var holidayNote = document.getElementById('holidayNote');
    var halfBtn = document.getElementById('durHalfDay');
    var multiBtn = document.getElementById('durMultiDay');
    var isSunday = dateStr ? (new Date(dateStr + 'T12:00:00').getDay() === 0) : false;
    var isSpecial = isWeekdaySpecialDate(dateStr);
    var isHoliday = isFullDayOnlyHoliday(dateStr);

    note.style.display = (isSunday && !isHoliday) ? '' : 'none';
    if (specialNote) specialNote.style.display = (isSpecial && !isHoliday) ? '' : 'none';
    if (holidayNote) holidayNote.style.display = isHoliday ? '' : 'none';

    // Memorial Day / Labor Day: full-day only — disable BOTH half-day and multi-day.
    setDurDisabled(multiBtn, isHoliday);
    // Half-day is disabled on Sundays, weekday-special days, and the full-day-only holidays.
    setDurDisabled(halfBtn, isSunday || isSpecial || isHoliday);

    // Force the selection back to Full Day when the current pick is no longer allowed.
    if (isHoliday && selectedDurationType !== 'allday') { selectDurationType('allday'); return; }
    if ((isSunday || isSpecial) && selectedDurationType === 'halfday') { selectDurationType('allday'); return; }
  }

  // Sunday terms, shown the instant a Sunday is picked. Sunday is not just "a day we're
  // open" — delivery is usually the evening before, pickup is Monday, and parks are out.
  // Surfacing that at checkout would be too late; they've already planned around it.
  // Shown once per visit so re-picking dates doesn't turn into whack-a-mole.
  var sundayModal = null, sundayTermsSeen = false;
  function showSundayTerms() {
    if (sundayTermsSeen) return false;
    var el = document.getElementById('sundayModal');
    if (!el || typeof bootstrap === 'undefined' || !bootstrap.Modal) return false; // never block booking
    sundayTermsSeen = true;
    if (!sundayModal) {
      sundayModal = new bootstrap.Modal(el, { backdrop: 'static', keyboard: false });
      el.addEventListener('shown.bs.modal', function() {
        document.body.classList.add('sunday-terms-open');
        var bd = document.querySelector('.modal-backdrop:last-of-type');
        if (bd) bd.classList.add('sunday-terms-backdrop');
      });
      el.addEventListener('hidden.bs.modal', function() {
        document.body.classList.remove('sunday-terms-open');
        // The scroll was held back while the terms were up. Only follow through if the customer
        // kept the Sunday ("Got it"); "Pick a different day" clears eventDateInput, so no scroll.
        if (scrollAfterSundayModal) {
          scrollAfterSundayModal = false;
          if (document.getElementById('eventDateInput').value) scrollToDuration();
        }
      });
    }
    sundayModal.show();
    return true;
  }
  // After a date is picked the duration cards + "See Available Equipment" were ~1.2 screens
  // below on an iPhone 14 (CTA at y~1,100): the page just sat there and the next step was
  // invisible. Glide to the duration card. Smooth, but 'auto' for prefers-reduced-motion; skipped
  // when it is already well in view (desktop, re-picking a date), and delayed one frame-ish so the
  // Sunday/holiday notes applyDayRules() just revealed have settled the layout.
  var scrollAfterSundayModal = false;
  function scrollToDuration() {
    setTimeout(function() {
      var el = document.getElementById('durationCard');
      if (!el) return;
      var r = el.getBoundingClientRect();
      if (r.top >= 0 && r.top < window.innerHeight * 0.45) return;
      var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      el.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'start' });
    }, 150);
  }

  // "Today" in the business's timezone, not the visitor's: at 9 PM Pacific it is already
  // tomorrow in Chicago, and the native input and the calendar must agree on the first
  // bookable day. '' (Intl unavailable) falls back to flatpickr's local 'today'.
  var CHICAGO_TODAY = (function() {
    try {
      var p = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
      return /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(p) ? p : '';
    } catch (err) { return ''; }
  })();
  var WEEKDAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  var nativeSyncing = false; // true while the native input is driving the calendar (stops echo loops)

  var datePicker = flatpickr('#datePicker', {
    inline: true,
    minDate: CHICAGO_TODAY || 'today',
    dateFormat: 'Y-m-d',
    disable: [function(date) { return BLOCKED_WEEKDAYS.indexOf(date.getDay()) !== -1; }],
    onChange: function(sel, dateStr) {
      // Mirror into the native input unless it is the one that started this change
      // (rewriting it mid-typing would eat the keystrokes of a half-entered date).
      var nd = document.getElementById('nativeDateInput');
      if (nd && !nativeSyncing && nd.value !== dateStr) nd.value = dateStr;
      document.getElementById('eventDateInput').value = dateStr;
      document.getElementById('hiddenEndDate').value = isoOffset(dateStr, 0);
      applyDayRules();
      updateHiddenFields();
      // Sunday terms modal first (it can open on this same interaction); scrolling underneath
      // a modal would fight it, so defer the scroll until the modal closes. Never scroll while
      // the native input is driving: a keyboard user mid-typing a date (Chrome fires change at
      // year 0002...) must not have the page pulled out from under the field.
      if (dateStr && !nativeSyncing) {
        var opened = new Date(dateStr + 'T12:00:00').getDay() === 0 && showSundayTerms();
        if (opened) scrollAfterSundayModal = true; else scrollToDuration();
      } else if (dateStr && new Date(dateStr + 'T12:00:00').getDay() === 0) showSundayTerms();
    }
  });

  // Native date input -> calendar. A date typed or picked here must hit EXACTLY the rules a
  // calendar click does, so it is not written to the form directly: after screening out the
  // dates flatpickr's min/disable would have refused (a native input can't grey out weekdays),
  // it goes through datePicker.setDate(v, true), which runs the same onChange above —
  // eventDateInput, hidden end date, applyDayRules() (Sunday/holiday/weekday-special lock to
  // Full Day, disabling Half Day and Multi Day) and showSundayTerms(). A bad date clears
  // the calendar + eventDateInput instead, so submit's "select a date" guard blocks it.
  (function() {
    var nd = document.getElementById('nativeDateInput');
    var msg = document.getElementById('nativeDateMsg');
    if (!nd) return;
    if (CHICAGO_TODAY) nd.min = CHICAGO_TODAY;
    function problemWith(v) {
      if (!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(v)) return 'Please enter a full date.';
      var d = new Date(v + 'T12:00:00');
      if (isNaN(d.getTime())) return 'Please enter a valid date.';
      if (CHICAGO_TODAY && v < CHICAGO_TODAY) return 'That date has already passed - please pick today or later.';
      if (BLOCKED_WEEKDAYS.indexOf(d.getDay()) !== -1) return 'We are not available on ' + WEEKDAY_NAMES[d.getDay()] + 's - please pick another day.';
      return '';
    }
    nd.addEventListener('change', function() {
      var v = nd.value;
      var problem = v ? problemWith(v) : '';
      msg.textContent = problem;
      nativeSyncing = true;
      try {
        if (!v || problem) datePicker.clear();
        else datePicker.setDate(v, true);
      } finally { nativeSyncing = false; }
    });
  })();

  // "Pick a different day" clears the selection and reopens the calendar, so declining
  // the terms doesn't leave a Sunday silently sitting in the form.
  (function() {
    var cancel = document.getElementById('sundayModalCancel');
    var ok = document.getElementById('sundayModalOk');
    var link = document.getElementById('sundayTermsLink');
    if (link) link.addEventListener('click', function(e) {
      e.preventDefault();
      sundayTermsSeen = false; // an explicit request to re-read it
      showSundayTerms();
    });
    if (ok) ok.addEventListener('click', function() { if (sundayModal) sundayModal.hide(); });
    if (cancel) cancel.addEventListener('click', function() {
      var fp = document.getElementById('datePicker') && document.getElementById('datePicker')._flatpickr;
      if (fp) fp.clear();
      document.getElementById('eventDateInput').value = '';
      sundayTermsSeen = false; // they backed out — show it again if they pick another Sunday
      applyDayRules();
      updateHiddenFields();
      if (sundayModal) sundayModal.hide();
    });
  })();

  document.getElementById('readyBySelect').addEventListener('change', function() {
    if (this.value) {
      var p = this.value.split(':');
      readyByHour = parseInt(p[0]);
      readyByMin = parseInt(p[1]);
    }
    updateHiddenFields();
  });

  document.getElementById('durHalfDay').addEventListener('click', function() { selectDurationType('halfday'); });
  document.getElementById('durFullDay').addEventListener('click', function() { selectDurationType('allday'); });
  document.getElementById('durMultiDay').addEventListener('click', function() { selectDurationType('multiday'); });

  document.getElementById('dayMinus').addEventListener('click', function() { setDays(selectedDays - 1); });
  document.getElementById('dayPlus').addEventListener('click', function() { setDays(selectedDays + 1); });

  // Carry forward preselect param
  (function() {
    var params = new URLSearchParams(window.location.search);
    var preselect = params.get('preselect');
    if (preselect) {
      var input = document.createElement('input');
      input.type = 'hidden'; input.name = 'preselect'; input.value = preselect;
      document.getElementById('dateForm').appendChild(input);
    }
    var dur = params.get('rental_duration');
    if (dur === '4hr') { selectDurationType('halfday'); }
  })();

  document.getElementById('dateForm').addEventListener('submit', function(e) {
    if (!document.getElementById('eventDateInput').value) {
      e.preventDefault();
      if (typeof showToast === 'function') showToast('Please select an event date.', 'warning');
      else alert('Please select an event date.');
      return;
    }
    if (selectedDurationType === 'halfday' && !document.getElementById('readyBySelect').value) {
      e.preventDefault();
      if (typeof showToast === 'function') showToast('Please select a start time.', 'warning');
      else alert('Please select a start time.');
      return;
    }
    updateHiddenFields();
  });

  // Initialize — full day is default, time card hidden, days stepper visible
  renderDays();
  updateHiddenFields();
</script>
` }) %>
