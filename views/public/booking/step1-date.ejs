<%- include('../../layouts/public', { body: `

<style>
  .booking-progress { display: flex; justify-content: center; gap: 0; margin-bottom: 40px; }
  .booking-progress .step { display: flex; align-items: center; gap: 8px; padding: 12px 20px; color: #aaa; font-weight: 600; font-size: 14px; }
  .booking-progress .step.active { color: var(--bm-orange); }
  .booking-progress .step.completed { color: var(--bm-green); }
  .booking-progress .step .step-num { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; background: #e9ecef; color: #aaa; }
  .booking-progress .step.active .step-num { background: var(--bm-gradient); color: white; }
  .booking-progress .step.completed .step-num { background: var(--bm-green); color: white; }
  .booking-progress .step-line { width: 40px; height: 2px; background: #e9ecef; align-self: center; }
  .date-card { background: white; border-radius: 20px; padding: 30px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); }
  .date-card-calendar { width: fit-content; margin: 0 auto; }
  
  
  
  
  
  .dur-btn {
    padding: 16px 8px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 80px;
  }
  .dur-btn .dur-label { font-weight: 700; font-size: 15px; line-height: 1.2; }
  .dur-btn .dur-sub { font-size: 12px; opacity: 0.7; margin-top: 2px; }
  .dur-btn.selected {
    background: var(--bm-blue, #004E89) !important;
    color: white !important;
    border-color: var(--bm-blue, #004E89) !important;
  }
  .dur-btn.selected .dur-sub,
  .dur-btn.selected .dur-label,
  .dur-btn.selected .small,
  .dur-btn.selected .text-muted,
  .dur-btn.selected i { color: white !important; opacity: 1 !important; }
</style>

<section class="py-5">
  <div class="container">
    <div class="booking-progress">
      <div class="step active">
        <span class="step-num">1</span>
        <span class="d-none d-md-inline">Pick Date</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">2</span>
        <span class="d-none d-md-inline">Select Items</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">3</span>
        <span class="d-none d-md-inline">Your Details</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">4</span>
        <span class="d-none d-md-inline">Review</span>
      </div>
    </div>

    <div class="section-title">
      <h2>When is Your Event?</h2>
      <p>Pick a date and time to see what's available</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <form id="dateForm" action="/booking/select" method="GET">

          <div class="date-card mb-4">
            <h5 style="color:var(--bm-blue);font-weight:700;" class="mb-3"><i class="fas fa-calendar-alt me-2"></i>Event Date</h5>
            <div class="date-card-calendar"><div id="datePicker"></div></div>
            <input type="hidden" name="event_date" id="eventDateInput" required>
          </div>

          <div class="date-card mb-4">
            <h6 class="fw-bold mb-3"><i class="fas fa-clock me-2"></i>How Long Do You Need It?</h6>
            <div class="row g-3">
              <div class="col-4">
                <div class="btn btn-outline-primary w-100 text-center dur-btn" id="durHalfDay">
                  <span class="dur-label">Half Day</span>
                  <span class="dur-sub">4 hours</span>
                </div>
              </div>
              <div class="col-4">
                <div class="btn btn-outline-primary w-100 text-center dur-btn selected" id="durFullDay">
                  <span class="dur-label">Full Day</span>
                  <span class="dur-sub">10 hours</span>
                </div>
              </div>
              <div class="col-4">
                <div class="btn btn-outline-primary w-100 text-center dur-btn" id="durOvernight">
                  <span class="dur-label">Overnight</span>
                  <span class="dur-sub">Next day</span>
                </div>
              </div>
            </div>

            <!-- Morning/Afternoon sub-choice (only for half day) -->
            <div id="halfDayChoice" class="row g-3 mt-3" style="display:none">
              <div class="col-6">
                <div class="btn btn-outline-secondary w-100 text-center dur-btn selected" id="halfMorning">
                  <span class="dur-label"><i class="fas fa-sun me-1" style="color:#f59e0b"></i> Morning</span>
                  <span class="dur-sub" id="morningTimeLabel"></span>
                </div>
              </div>
              <div class="col-6">
                <div class="btn btn-outline-secondary w-100 text-center dur-btn" id="halfAfternoon">
                  <span class="dur-label"><i class="fas fa-cloud-sun me-1" style="color:#f97316"></i> Afternoon</span>
                  <span class="dur-sub" id="afternoonTimeLabel"></span>
                </div>
              </div>
            </div>

            <div id="saturdayNote" style="display:none;margin-top:12px;background:#e8f5e9;border-radius:10px;padding:12px;font-size:14px;color:#2e7d32">
              <i class="fas fa-gift me-1"></i> <strong>Bonus!</strong> We don't pick up on Sundays, so your unit stays through the weekend and we'll pick up Monday. Enjoy the extra day!
            </div>

            <input type="hidden" name="rental_duration" id="hiddenDuration" value="daily">
            <input type="hidden" name="event_start_time" id="hiddenStart" value="09:00">
            <input type="hidden" name="event_end_time" id="hiddenEnd" value="19:00">
          </div>

          <div class="text-center">
            <button type="submit" class="btn btn-book-now px-5 py-3">
              See Available Equipment <i class="fas fa-arrow-right ms-2"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

`, scripts: `
<script>
  // Settings from server
  var HALFDAY_MORNING_START = '${settings.halfday_morning_start || '09:00'}';
  var HALFDAY_MORNING_END = '${settings.halfday_morning_end || '13:00'}';
  var HALFDAY_AFTERNOON_START = '${settings.halfday_afternoon_start || '15:00'}';
  var HALFDAY_AFTERNOON_END = '${settings.halfday_afternoon_end || '19:00'}';
  var BLOCKED_WEEKDAYS = '${settings.blocked_weekdays || '0'}'.split(',').map(Number).filter(function(n) { return !isNaN(n); });

  function fmt12(t) {
    var parts = t.split(':'); var h = parseInt(parts[0]); var m = parts[1] || '00';
    var ampm = h >= 12 ? 'PM' : 'AM'; h = h > 12 ? h - 12 : (h === 0 ? 12 : h);
    return m === '00' ? h + ' ' + ampm : h + ':' + m + ' ' + ampm;
  }

  document.getElementById('morningTimeLabel').textContent = fmt12(HALFDAY_MORNING_START) + ' \\u2013 ' + fmt12(HALFDAY_MORNING_END);
  document.getElementById('afternoonTimeLabel').textContent = fmt12(HALFDAY_AFTERNOON_START) + ' \\u2013 ' + fmt12(HALFDAY_AFTERNOON_END);

  flatpickr('#datePicker', {
    inline: true,
    minDate: 'today',
    dateFormat: 'Y-m-d',
    disable: [function(date) { return BLOCKED_WEEKDAYS.indexOf(date.getDay()) !== -1; }],
    onChange: function(sel, dateStr) {
      document.getElementById('eventDateInput').value = dateStr;
      checkSaturdayOvernight();
    }
  });

  function checkSaturdayOvernight() {
    var dateStr = document.getElementById('eventDateInput').value;
    var dur = document.getElementById('hiddenDuration').value;
    var note = document.getElementById('saturdayNote');
    if (dateStr && dur === 'overnight') {
      var d = new Date(dateStr + 'T12:00:00');
      note.style.display = d.getDay() === 6 ? '' : 'none';
    } else {
      note.style.display = 'none';
    }
  }

  function selectDuration(type, el) {
    document.querySelectorAll('#durHalfDay,#durFullDay,#durOvernight').forEach(function(b) { b.classList.remove('selected'); });
    el.classList.add('selected');
    var halfChoice = document.getElementById('halfDayChoice');

    if (type === 'halfday') {
      halfChoice.style.display = '';
      selectHalf('morning', document.getElementById('halfMorning'));
    } else if (type === 'fullday') {
      halfChoice.style.display = 'none';
      document.getElementById('hiddenDuration').value = 'daily';
      document.getElementById('hiddenStart').value = '09:00';
      document.getElementById('hiddenEnd').value = '19:00';
    } else if (type === 'overnight') {
      halfChoice.style.display = 'none';
      document.getElementById('hiddenDuration').value = 'overnight';
      document.getElementById('hiddenStart').value = '15:00';
      document.getElementById('hiddenEnd').value = '10:00';
    }
    checkSaturdayOvernight();
  }

  function selectHalf(time, el) {
    document.getElementById('halfMorning').classList.remove('selected');
    document.getElementById('halfAfternoon').classList.remove('selected');
    el.classList.add('selected');
    document.getElementById('hiddenDuration').value = '4hr';
    if (time === 'morning') {
      document.getElementById('hiddenStart').value = HALFDAY_MORNING_START;
      document.getElementById('hiddenEnd').value = HALFDAY_MORNING_END;
    } else {
      document.getElementById('hiddenStart').value = HALFDAY_AFTERNOON_START;
      document.getElementById('hiddenEnd').value = HALFDAY_AFTERNOON_END;
    }
  }

  // Carry forward preselect item ID from equipment detail page
  (function() {
    var params = new URLSearchParams(window.location.search);
    var preselect = params.get('preselect');
    if (preselect) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'preselect';
      input.value = preselect;
      document.getElementById('dateForm').appendChild(input);
    }
    // If rental_duration was passed, pre-select it
    var dur = params.get('rental_duration');
    if (dur === '4hr') {
      selectDuration('halfday', document.getElementById('durHalfDay'));
    } else if (dur === 'overnight') {
      selectDuration('overnight', document.getElementById('durOvernight'));
    }
  })();

  document.getElementById('dateForm').addEventListener('submit', function(e) {
    if (!document.getElementById('eventDateInput').value) {
      e.preventDefault();
      showToast('Please select an event date.', 'warning');
    }
  });

  // addEventListener replacements for inline onclick
  document.getElementById('durHalfDay').addEventListener('click', function() { selectDuration('halfday', this); });
  document.getElementById('durFullDay').addEventListener('click', function() { selectDuration('fullday', this); });
  document.getElementById('durOvernight').addEventListener('click', function() { selectDuration('overnight', this); });
  document.getElementById('halfMorning').addEventListener('click', function() { selectHalf('morning', this); });
  document.getElementById('halfAfternoon').addEventListener('click', function() { selectHalf('afternoon', this); });
</script>
` }) %>
