<%- include("../../layouts/public", { body: `
<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6 text-center">
        <div class="card shadow-sm">
          <div class="card-body py-5">
            <svg class="bm-i text-warning" style="font-size:64px;margin-bottom:20px" aria-hidden="true"><use href="#i-times-circle"/></svg>
            <h2 style="color:var(--bm-blue)">Payment Cancelled</h2>
            <p class="text-muted mb-4">No worries! You can pay anytime before your event, or on delivery day.</p>
            ${booking && booking.pay_path ? `
            <a href="${esc(booking.pay_path)}" class="btn btn-bm me-2"><svg class="bm-i me-2" aria-hidden="true"><use href="#i-credit-card"/></svg>Try Again</a>
            ` : ""}
            <a href="/" class="btn btn-bm-outline"><svg class="bm-i me-2" aria-hidden="true"><use href="#i-home"/></svg>Back to Home</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
`, scripts: "" }) %>
