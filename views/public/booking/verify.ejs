<%- include('../../layouts/public', { body: `

<section class="py-5">
  <div class="container" style="max-width:480px">
    <div class="text-center mb-4">
      <h1 style="color:var(--bm-blue);font-weight:700"><i class="fas fa-shield-alt me-2"></i>Confirm It's You</h1>
      <p class="text-muted">To protect your delivery address and payment details, enter the <strong>email address or mobile number</strong> you booked with.</p>
    </div>
    <div class="bg-white rounded-4 p-4 shadow-sm">
      ${verifyError ? '<div class="alert alert-danger" role="alert">' + esc(verifyError) + '</div>' : ''}
      <form action="/booking/verify" method="POST">
        <input type="hidden" name="booking_number" value="${esc(verifyBookingNumber)}">
        <input type="hidden" name="dest" value="${esc(verifyDest)}">
        <label class="form-label fw-bold" for="contact">Email or mobile number</label>
        <input type="text" id="contact" name="contact" class="form-control mb-3" required autofocus
               autocomplete="email tel" autocapitalize="none" autocorrect="off" spellcheck="false"
               placeholder="you@example.com or (580) 555-1234" style="border-radius:12px;padding:12px 16px">
        <button type="submit" class="btn btn-book-now btn-lg w-100"><i class="fas fa-lock me-2"></i>Continue</button>
      </form>
    </div>
    <div class="text-center text-muted small mt-3">
      Trouble? Call or text <a href="tel:5803089288" style="color:#D77C42">(580) 308-9288</a>
    </div>
  </div>
</section>

`, scripts: '' }) %>
