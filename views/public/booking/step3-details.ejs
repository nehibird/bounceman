          <div class="d-flex justify-content-between">
            <a href="#" class="btn btn-outline-secondary rounded-pill px-4" id="backBtn">
              <i class="fas fa-arrow-left me-2"></i>Back
            </a>
            <button type="submit" class="btn btn-book-now px-4">
              Continue to Review<i class="fas fa-arrow-right ms-2"></i>
            </button>
          </div>

        </div>
      </div>
    </form>

  </div>
</section>

`, scripts: `
<script>
  var WD_UNITS = ${ typeof cartUnits !== 'undefined' && cartUnits ? JSON.stringify(cartUnits).replace(/</g, '\\u003c') : '[]' };

  // --- Wet/dry chooser ------------------------------------------------------
  // Server-supplied cart, injected through the surrounding template literal
  // (EJS tags cannot appear inside it). Each entry: {id, name, wetCapable, dryBlocked}.
  // wdChoice[equipmentId] = true (wet) / false (dry). A wet-capable unit absent
  // from this map has not been answered yet and blocks submit.
  var wdChoice = {};

  function wdEsc(t) {
    return String(t == null ? '' : t)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // Render the card. Only water-capable units ask; add-ons and dry-only units skip it.
  function wdRender() {
    var mount = document.getElementById('wetDryMount');
    if (!mount) return;
    var units = WD_UNITS.filter(function(u) { return u.wetCapable; });
    if (!units.length) return;

    var html = '<div class="details-card" id="wetDryCard">' +
      '<h5><i class="fas fa-tint me-2"></i>Wet or Dry?</h5>';
    units.forEach(function(u) {
      var id = wdEsc(u.id);
      html += '<div class="wd-unit" data-unit-id="' + id + '" data-dry-blocked="' + (u.dryBlocked ? '1' : '0') + '">' +
        '<div class="wd-q"><span>' + wdEsc(u.name) + '</span>' +
        '<span class="wd-req" id="wdreq-' + id + '">Choose one</span></div>' +
        '<div class="wd-row">' +
          '<div class="wd-btn' + (u.dryBlocked ? ' wd-disabled' : '') + '" data-mode="dry" data-unit="' + id + '" id="wd-dry-' + id + '">' +
            '<div class="wd-ic"><i class="fas fa-sun"></i></div>' +
            '<div><div class="wd-t">Dry</div><div class="wd-s">No water — same price</div></div>' +
          '</div>' +
          '<div class="wd-btn" data-mode="wet" data-unit="' + id + '" id="wd-wet-' + id + '">' +
            '<div class="wd-ic"><i class="fas fa-tint"></i></div>' +
            '<div><div class="wd-t">Wet</div><div class="wd-s">Splash &amp; slide — same price</div></div>' +
          '</div>' +
        '</div>' +
        (u.dryBlocked
          ? '<div class="wd-why"><i class="fas fa-circle-info me-1"></i>This unit is booked wet shortly before your rental and needs time to dry, so dry is not available on this date. Wet is — or call (580) 308-9288 about another date.</div>'
          : '') +
      '</div>';
    });
    html += '<div class="field-err" id="err-wd" role="alert"></div></div>';
    mount.innerHTML = html;
  }

  function wdUnitEls() {
    return Array.prototype.slice.call(document.querySelectorAll('.wd-unit'));
  }

  function wdUnanswered() {
    return wdUnitEls().filter(function(el) {
      return typeof wdChoice[el.dataset.unitId] === 'undefined';
    });
  }

  function wdSyncHidden() {
    var wetIds = Object.keys(wdChoice).filter(function(id) { return wdChoice[id]; });
    document.getElementById('hiddenWetItems').value = wetIds.join(',');
    siteSync(); // water question follows the wet/dry answer
    refreshBackHref(); // the Back link must carry the wet/dry answer as it stands NOW
  }

  // Back to step 2 = this page's own query string, minus nothing it needs. This used to be
  // hand-listed as event_date + rental_duration + preselect only, so a customer who clicked
  // Back silently lost rental_days / event_end_date / event_start_time / event_end_time /
  // ready_by: a 3-day booking came back as 1 day and a 2 PM half-day as 09:00-19:00 (which
  // also over-held inventory). Step 4 never shows the day count, so nobody noticed until
  // delivery day. Cloning the URL means any param step 2 forwards to us survives by
  // construction, and a param added to step 2 later cannot be forgotten here.
  function buildBackHref() {
    var back = new URLSearchParams(window.location.search);
    back.delete('wd'); // step 2 re-asserts this itself on the way forward
    var hw = document.getElementById('hiddenWetItems');
    if (hw) back.set('wet_items', hw.value || ''); // the chooser on THIS page may have changed it
    return '/booking/select?' + back.toString();
  }
  function refreshBackHref() {
    var b = document.getElementById('backBtn');
    if (b) b.href = buildBackHref();
  }

  function wdSet(unitId, isWet) {
    var el = document.querySelector('.wd-unit[data-unit-id="' + unitId + '"]');
    if (!el) return;
    // Dry can be unavailable when the unit is out wet shortly beforehand.
    if (!isWet && el.dataset.dryBlocked === '1') return;
    wdChoice[unitId] = isWet;
    var dryBtn = document.getElementById('wd-dry-' + unitId);
    var wetBtn = document.getElementById('wd-wet-' + unitId);
    if (dryBtn) { dryBtn.classList.toggle('wd-active', !isWet); }
    if (wetBtn) { wetBtn.classList.toggle('wd-active', isWet); }
    var req = document.getElementById('wdreq-' + unitId);
    if (req) { req.textContent = isWet ? 'Wet' : 'Dry'; req.classList.add('wd-chosen'); }
    wdSyncHidden();
  }

  document.addEventListener('click', function(e) {
    var btn = e.target && e.target.closest ? e.target.closest('.wd-btn') : null;
    if (!btn || btn.classList.contains('wd-disabled')) return;
    wdSet(btn.getAttribute('data-unit'), btn.getAttribute('data-mode') === 'wet');
  });

  // --- Power & water (asked early, driven by the cart) ----------------------
  // WHICH units need power comes from the route: cartUnits[i].needsPower (false for equipment whose
  // power_required starts "None" or "Battery": Toddler Soft Play Playground = "None - no power needed",
  // Cornhole = "None", Speaker = "Battery powered"). The old rule keyed off a hard-coded generator UUID
  // (fff4986b-...) that matches NO row in equipment (the real Portable Generator is E68C23DC-...), so
  // every cart without that ghost id - including soft play - was forced to tick "power available" or leave.
  // If the route has not been updated, needsPower is undefined and we keep asking (safe default), but as an
  // inline yes/no, never as a top-of-page toast at submit.
  // The optional powerAddon local ({id,name,price}) lets "no outlet" add the generator right here.
  var PW_ADDON = ${ typeof powerAddon !== 'undefined' && powerAddon && powerAddon.id ? JSON.stringify({ id: String(powerAddon.id), name: String(powerAddon.name || 'Portable Generator'), price: (powerAddon.price === null || powerAddon.price === undefined || !isFinite(Number(powerAddon.price))) ? null : Number(powerAddon.price) }).replace(/</g, '\\u003c') : 'null' };

  function pwIsGen(u) { return /generator/i.test(u.name || '') || (PW_ADDON && u.id === PW_ADDON.id); }
  var PW_HAS_GEN = WD_UNITS.some(pwIsGen);   // a generator already in the cart satisfies "no outlet"
  var PW_NEEDS = !WD_UNITS.length || WD_UNITS.some(function(u) { return !pwIsGen(u) && u.needsPower !== false; });

  function pwVal(name) {
    var r = document.querySelector('input[name="' + name + '"]:checked');
    return r ? r.value : '';
  }
  function fieldErr(id, msg, focusEl) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg; el.style.display = 'block';
    if (el.parentNode && el.parentNode.classList) el.parentNode.classList.add('has-err');
    var t = focusEl || el;
    if (t.scrollIntoView) t.scrollIntoView({ behavior: 'smooth', block: 'center' });
    if (focusEl && focusEl.focus) { try { focusEl.focus({ preventScroll: true }); } catch (x) { focusEl.focus(); } }
  }
  function clearFieldErr(id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.style.display = 'none'; el.textContent = '';
    if (el.parentNode && el.parentNode.classList) el.parentNode.classList.remove('has-err');
  }

  // Show only the questions this cart needs. Called whenever wet/dry changes.
  function siteSync() {
    var pq = document.getElementById('powerQ'), wq = document.getElementById('waterCheckWrap'), card = document.getElementById('siteCard');
    if (!pq || !wq || !card) return;
    var showP = PW_NEEDS && !PW_HAS_GEN;
    var showW = (document.getElementById('hiddenWetItems').value || '').length > 0;
    pq.style.display = showP ? '' : 'none';
    wq.style.display = showW ? '' : 'none';
    card.style.display = (showP || showW) ? '' : 'none';
    // A hidden question must not submit a stale answer.
    document.getElementById('powerAvail').disabled = !(showP && pwVal('power_choice') === 'yes');
    document.getElementById('waterAvail').disabled = !(showW && pwVal('water_choice') === 'yes');
    pwNote(); waterNote();
  }

  function pwNote() {
    var n = document.getElementById('powerNote');
    if (!n) return;
    n.textContent = '';
    if (pwVal('power_choice') !== 'no') { n.style.display = 'none'; return; }
    n.style.display = 'block';
    if (PW_ADDON) {
      n.appendChild(document.createTextNode('No problem - we will add a ' + PW_ADDON.name + (PW_ADDON.price !== null ? ' (' + osMoney(PW_ADDON.price) + ')' : '') + ' to your rental so it runs anywhere. The price is confirmed on the next step.'));
    } else {
      var a = document.createElement('a');
      a.href = buildBackHref(); a.textContent = 'Go back and add the Portable Generator';
      n.appendChild(document.createTextNode('A generator runs it without an outlet. '));
      n.appendChild(a);
      n.appendChild(document.createTextNode(' (your answers are kept), or call (580) 308-9288.'));
    }
  }

  function waterNote() {
    var n = document.getElementById('waterNote');
    if (!n) return;
    n.textContent = '';
    if (pwVal('water_choice') !== 'no') { n.style.display = 'none'; return; }
    n.style.display = 'block';
    var canDry = WD_UNITS.every(function(u) { return !u.wetCapable || !u.dryBlocked; });
    n.appendChild(document.createTextNode('A wet setup needs a hose hookup nearby. '));
    if (canDry) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'btn btn-sm btn-outline-primary rounded-pill'; b.id = 'switchDry';
      b.style.minHeight = '44px';
      b.textContent = 'Switch to dry (same price)';
      n.appendChild(b);
    } else {
      n.appendChild(document.createTextNode('Please call (580) 308-9288 and we will sort out a dry option for your date.'));
    }
  }

  document.addEventListener('change', function(e) {
    var nm = e.target && e.target.name;
    if (nm === 'power_choice') { clearFieldErr('err-power'); siteSync(); }
    if (nm === 'water_choice') { clearFieldErr('err-water'); siteSync(); }
  });
  document.addEventListener('click', function(e) {
    if (e.target && e.target.id === 'switchDry') {
      Object.keys(wdChoice).forEach(function(id) { if (wdChoice[id]) wdSet(id, false); });
      var wr = document.querySelector('input[name="water_choice"]:checked'); if (wr) wr.checked = false;
      clearFieldErr('err-water'); siteSync();
    }
    if (e.target && e.target.closest && e.target.closest('.wd-btn')) clearFieldErr('err-wd');
  });

  // --- Order summary --------------------------------------------------------
  // Where each number comes from (nothing is invented client-side):
  //   item names      -> WD_UNITS (server cartUnits, already on this page)
  //   per-line price  -> WD_UNITS[i].price     (OPTIONAL - needs route handoff, see report)
  //   subtotal        -> CART_SUBTOTAL from the route (authoritative: addon rates, multi-day, free day),
  //                      else the sum of line prices if every line has one, else not shown
  //   delivery        -> /booking/check-zip response .fee, the same call checkZip() already makes
  // Tax is resolved server-side at review and is NOT computed here.
  var CART_SUBTOTAL = ${ typeof cartSubtotal !== 'undefined' && cartSubtotal !== null && isFinite(Number(cartSubtotal)) ? Number(cartSubtotal) : 'null' };
  var osDelivery = null; // null = ZIP not entered / not valid yet

  function osMoney(n) { return '$' + (Math.round(n * 100) % 100 ? n.toFixed(2) : n.toFixed(0)); }

  function osRender() {
    var box = document.getElementById('orderSum');
    if (!box || !WD_UNITS.length) return; // no cart data: leave it hidden rather than show an empty box
    box.style.display = '';

    var allPriced = true, sum = 0, lines = '';
    WD_UNITS.forEach(function(u) {
      var p = Number(u.price);
      var has = u.price !== undefined && u.price !== null && isFinite(p);
      if (has) { sum += p; } else { allPriced = false; }
      lines += '<div class="os-row"><span>' + wdEsc(u.name) + '</span><span>' + (has ? osMoney(p) : '') + '</span></div>';
    });
    document.getElementById('osLines').innerHTML = lines;
    document.getElementById('osCount').textContent = '(' + WD_UNITS.length + ' item' + (WD_UNITS.length === 1 ? '' : 's') + ')';

    var sub = (CART_SUBTOTAL !== null) ? CART_SUBTOTAL : (allPriced ? sum : null);
    document.getElementById('osSubRow').style.display = sub === null ? 'none' : '';
    if (sub !== null) document.getElementById('osSub').textContent = osMoney(sub);

    document.getElementById('osDel').textContent = osDelivery === null ? 'Enter ZIP below' : (osDelivery === 0 ? 'FREE' : osMoney(osDelivery));

    var totRow = document.getElementById('osTotRow');
    var head = document.getElementById('osHead');
    if (sub === null) {
      totRow.style.display = 'none';
      head.textContent = 'Price on next step';
    } else if (osDelivery === null) {
      totRow.style.display = 'none';
      head.textContent = osMoney(sub) + ' + delivery';
    } else {
      totRow.style.display = '';
      document.getElementById('osTot').textContent = osMoney(sub + osDelivery);
      head.textContent = osMoney(sub + osDelivery) + ' before tax';
    }
  }
  // Collapsed by default on phones so the form starts in the first screen; the head still shows the figure.
  if (window.innerWidth < 768) { var osBox = document.getElementById('orderSum'); if (osBox) osBox.removeAttribute('open'); }
  osRender();

  // Pull query params from previous step and populate hidden fields
  (function() {
    // Build the wet/dry card first so the init below can see and pre-select it.
    wdRender();
    var params = new URLSearchParams(window.location.search);
    var items = params.get('items') || '';
    var date = params.get('event_date') || '';
    var start = params.get('event_start_time') || '';
    var end = params.get('event_end_time') || '';
    var duration = params.get('rental_duration') || 'daily';

    document.getElementById('hiddenItems').value = items;
    document.getElementById('hiddenDate').value = date;
    document.getElementById('hiddenStart').value = start;
    document.getElementById('hiddenEnd').value = end;
    document.getElementById('hiddenDuration').value = duration;

    var wetItems = params.get('wet_items') || '';

    // Carry the multi-day count forward so checkout charges/blocks the full rental
    document.getElementById('hiddenDays').value = params.get('rental_days') || '1';
    document.getElementById('hiddenEndDate').value = params.get('event_end_date') || date;

    if (document.getElementById('wetDryCard')) {
      // The chooser is on the page, so it owns wet_items from here on.
      // wd=1 means step 2 already asked and the URL carries a real customer answer,
      // so pre-select it. Sarah's texted links carry no wd flag — leave those blank
      // so the customer is actually asked instead of inheriting a guess.
      var preWet = wetItems.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
      if (params.get('wd') === '1') {
        wdUnitEls().forEach(function(el) {
          wdSet(el.dataset.unitId, preWet.indexOf(el.dataset.unitId) !== -1);
        });
      }
      wdSyncHidden();
    } else {
      // No water-capable units — preserve the old passthrough behaviour exactly.
      document.getElementById('hiddenWetItems').value = wetItems;
      siteSync();
    }

    // Build back link (full param set — see buildBackHref)
    refreshBackHref();
    siteSync();
  })();


  // Phone formatting
  document.querySelector('input[name="phone"]').addEventListener('input', function(e) {
    var val = e.target.value.replace(/\\D/g, '');
    // Drop a leading +1 before formatting. Without this, someone typing their own number
    // as 15806281767 got saved as "(158) 062-8176" — the first three digits were taken as
    // the area code and everything shifted. Silent, and only discovered when a text bounced.
    if (val.length === 11 && val.charAt(0) === '1') val = val.slice(1);
    if (val.length >= 6) {
      e.target.value = '(' + val.substring(0,3) + ') ' + val.substring(3,6) + '-' + val.substring(6,10);
    } else if (val.length >= 3) {
      e.target.value = '(' + val.substring(0,3) + ') ' + val.substring(3);
    }
  });

  // Form validation
  document.getElementById('detailsForm').addEventListener('submit', function(e) {
    var params = new URLSearchParams(window.location.search);
    // Read the LIVE choice, not the URL — the customer may have changed it here.
    var wetItems = document.getElementById('hiddenWetItems').value || '';
    var items = params.get('items') || '';

    // Failures are shown INLINE under the field that failed (first failure wins, in page order). They used to be
    // a top-right toast that overlapped the header on a 375px screen, away from the field, and the power/water
    // ones sent the customer Back, losing their wet/dry answer.
    // Every water-capable unit needs an explicit answer. Previously this page
    // inherited whatever the link said, so a texted link could book the wrong
    // setup or dead-end at a 409 the customer could do nothing about.
    var unanswered = wdUnanswered();
    if (unanswered.length > 0) {
      e.preventDefault();
      var names = unanswered.map(function(el) {
        var q = el.querySelector('.wd-q span');
        return q ? q.textContent : 'your rental';
      });
      unanswered.forEach(function(el) {
        var req = el.querySelector('.wd-req');
        if (req) { req.classList.remove('wd-flash'); void req.offsetWidth; req.classList.add('wd-flash'); }
      });
      fieldErr('err-wd', 'Please choose wet or dry for: ' + names.join(', '), unanswered[0]);
      return;
    }

    // Power: asked only when the cart needs it and no generator is in it.
    var powerShown = document.getElementById('powerQ').style.display !== 'none';
    if (powerShown) {
      var pc = pwVal('power_choice');
      if (!pc) {
        e.preventDefault();
        fieldErr('err-power', 'Please tell us whether there is an outlet nearby.', document.querySelector('input[name="power_choice"]'));
        return;
      }
      if (pc === 'no' && !PW_ADDON) {
        e.preventDefault();
        fieldErr('err-power', 'Without an outlet this rental needs our Portable Generator. Use the link above to add it, or call (580) 308-9288.', document.getElementById('powerNote'));
        return;
      }
    }

    // Wet units require a water hookup.
    if (wetItems.length > 0) {
      var wc = pwVal('water_choice');
      if (!wc) {
        e.preventDefault();
        fieldErr('err-water', 'Please tell us whether there is a water hookup nearby.', document.querySelector('input[name="water_choice"]'));
        return;
      }
      if (wc === 'no') {
        e.preventDefault();
        fieldErr('err-water', 'A wet setup needs a water hookup within 100 feet. Switch to dry above, or say yes if you have one.', document.getElementById('waterNote'));
        return;
      }
    }

    // No park setups on Sundays — see sundayParkSelected() below. The inline note already exists; surface it.
    if (sundayParkSelected()) {
      e.preventDefault();
      var spn = document.getElementById('sundayParkNote');
      spn.style.display = '';
      spn.scrollIntoView({ behavior: 'smooth', block: 'center' });
      document.querySelector('select[name="venue_type"]').focus({ preventScroll: true });
      return;
    }

    // "No outlet" + generator offered here: put it in the cart the review step prices (equipment_ids).
    if (powerShown && pwVal('power_choice') === 'no' && PW_ADDON) {
      var hi = document.getElementById('hiddenItems');
      if (hi.value.split(',').indexOf(PW_ADDON.id) === -1) hi.value = hi.value ? hi.value + ',' + PW_ADDON.id : PW_ADDON.id;
    }

    // ZIP must be in service area
    if (!zipValid) {
      e.preventDefault();
      var zr = document.getElementById('zipResult');
      zr.style.display = 'block'; zr.textContent = '';
      var zs = document.createElement('span'); zs.style.color = '#c62828'; zs.style.fontWeight = '600';
      var short5 = document.getElementById('zipInput').value.replace(/\\D/g, '').length < 5;
      zs.appendChild(document.createTextNode(short5 ? 'Enter your 5-digit ZIP so we can price delivery.' : 'That ZIP is outside our delivery area. Please call '));
      if (!short5) { var za = document.createElement('a'); za.href = 'tel:5803089288'; za.textContent = '(580) 308-9288'; za.style.color = 'inherit'; zs.appendChild(za); zs.appendChild(document.createTextNode(' to discuss delivery options.')); }
      zr.appendChild(zs);
      zr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      document.getElementById('zipInput').focus({ preventScroll: true });
      return;
    }
  });

  // ZIP code validation
  var zipValid = false;
  var zipTimer = null;
  function checkZip(val) {
    val = val.replace(/\\D/g, '');
    if (val.length < 5) {
      document.getElementById('zipResult').style.display = 'none';
      zipValid = false;
      osDelivery = null; osRender();
      return;
    }
    clearTimeout(zipTimer);
    zipTimer = setTimeout(function() {
      fetch('/booking/check-zip?zip=' + val)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var el = document.getElementById('zipResult');
          el.style.display = 'block';
          // MED-1: Use textContent to avoid DOM XSS — message comes from API response
          var icon = document.createElement('i');
          var span = document.createElement('span');
          var msg = document.createTextNode(data.message || '');
          if (data.valid) {
            zipValid = true;
            osDelivery = Number(data.fee) || 0; osRender();
            span.style.color = '#2e7d32';
            icon.className = 'fas fa-check-circle me-1';
          } else {
            zipValid = false;
            osDelivery = null; osRender();
            span.style.color = '#c62828';
            icon.className = 'fas fa-times-circle me-1';
          }
          span.appendChild(icon);
          span.appendChild(msg);
          el.textContent = '';
          el.appendChild(span);
        })
        .catch(function() { zipValid = true; }); // allow on error
    }, 400);
  }

  // CSP-safe: replace oninput="checkZip" with addEventListener
  document.getElementById("zipInput").addEventListener("input", function() { checkZip(this.value); });

  // Tax-exempt: require a permit # when the box is checked (prevents accidental checking)
  (function() {
    var cb = document.getElementById('taxExemptCheck');
    var wrap = document.getElementById('taxExemptCodeWrap');
    var cert = document.getElementById('taxExemptCert');
    if (!cb || !wrap || !cert) return;
    function sync() {
      if (cb.checked) { wrap.style.display = ''; cert.required = true; }
      else { wrap.style.display = 'none'; cert.required = false; cert.value = ''; }
    }
    cb.addEventListener('change', sync);
    sync();
  })();

  // Show the hard-surface/indoor surcharge note only when it applies
  (function() {
    var surf = document.querySelector('select[name="surface_type"]');
    var venue = document.querySelector('select[name="venue_type"]');
    var note = document.getElementById('surfaceFeeNote');
    if (!note) return;
    function sync() {
      var s = (surf && surf.value || '').toLowerCase();
      var v = (venue && venue.value || '').toLowerCase();
      note.style.display = (/concrete|asphalt/.test(s) || /indoor/.test(v)) ? '' : 'none';
    }
    if (surf) surf.addEventListener('change', sync);
    if (venue) venue.addEventListener('change', sync);
    sync();
  })();

  // Sunday + Park is refused: a Sunday rental is collected Monday morning, so the unit
  // would be left unattended in a public park overnight. Warn at the moment they pick it
  // rather than after they've filled the rest of the form in. The server re-checks this.
  function isSundayEventDate() {
    var d = document.getElementById('hiddenDate').value;
    if (!d) return false;
    var dt = new Date(d + 'T12:00:00');
    return !isNaN(dt.getTime()) && dt.getDay() === 0;
  }
  function sundayParkSelected() {
    var venue = document.querySelector('select[name="venue_type"]');
    return isSundayEventDate() && /park/i.test((venue && venue.value) || '');
  }
  (function() {
    var venue = document.querySelector('select[name="venue_type"]');
    var note = document.getElementById('sundayParkNote');
    if (!venue || !note) return;
    function sync() { note.style.display = sundayParkSelected() ? '' : 'none'; }
    venue.addEventListener('change', sync);
    sync();
  })();
</script>
<script>if(typeof fbq!=='undefined')fbq('track','InitiateCheckout');</script>
