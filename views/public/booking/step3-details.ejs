<%- include('../../layouts/public', { body: `

<style>
  .booking-progress { display: flex; justify-content: center; gap: 0; margin-bottom: 40px; }
  .booking-progress .step { display: flex; align-items: center; gap: 8px; padding: 12px 20px; color: #aaa; font-weight: 600; font-size: 14px; }
  .booking-progress .step.active { color: var(--bm-orange); }
  .booking-progress .step.completed { color: var(--bm-green); }
  .booking-progress .step .step-num { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; background: #e9ecef; color: #aaa; }
  .booking-progress .step.active .step-num { background: var(--bm-gradient); color: white; }
  .booking-progress .step.completed .step-num { background: var(--bm-green); color: white; }
  .booking-progress .step-line { width: 40px; height: 2px; background: #e9ecef; align-self: center; }
  .booking-progress .step-line.completed { background: var(--bm-green); }

  .details-card { background: white; border-radius: 20px; padding: 30px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); margin-bottom: 24px; }
  .details-card h5 { color: var(--bm-blue); font-weight: 700; margin-bottom: 20px; }
  .form-control, .form-select { border: 2px solid #e9ecef; border-radius: 12px; padding: 10px 16px; transition: border-color 0.2s; }
  .form-control:focus, .form-select:focus { border-color: var(--bm-orange); box-shadow: 0 0 0 3px rgba(255,107,53,0.1); }
  .form-label { font-weight: 600; color: #555; }
  .delivery-note { background: #fff3cd; border-radius: 12px; padding: 12px 16px; font-size: 14px; }

  /* Wet/Dry chooser — mirrors step 2 so the question looks the same wherever it is
     asked (amber = dry, blue = wet). Needed here because Sarah's texted links land
     straight on this page and skip step 2 entirely. */
  .wd-unit { margin-bottom: 18px; }
  .wd-unit:last-child { margin-bottom: 0; }
  .wd-q { font-size: 14.5px; font-weight: 700; color: #1c2733; margin-bottom: 11px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .wd-req { font-size: 11px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: #b9521f; background: #fdecdf; border: 1px solid #f6cda9; padding: 3px 9px; border-radius: 20px; }
  .wd-req.wd-chosen { color: #1f7a3d; background: #e4f6ea; border-color: #bce5c9; }
  .wd-req.wd-flash { animation: wdflash 0.55s ease; }
  @keyframes wdflash { 0%,100%{ transform: scale(1); } 35%{ transform: scale(1.12); color:#fff; background:#e0492f; border-color:#e0492f; } }
  .wd-row { display: flex; gap: 12px; }
  .wd-btn {
    flex: 1; display: flex; align-items: center; gap: 11px;
    padding: 12px 13px; border-radius: 13px; cursor: pointer;
    border: 2px solid #e3e7ec; background: #f7f9fb; text-align: left;
    transition: all 0.18s;
  }
  .wd-btn:hover { border-color: #cfd6de; }
  .wd-ic { width: 38px; height: 38px; min-width: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; font-size: 16px; }
  .wd-t { font-size: 15.5px; font-weight: 700; color: #1c2733; line-height: 1.1; }
  .wd-s { font-size: 12px; color: #6b7480; margin-top: 2px; }
  .wd-btn[data-mode="dry"] .wd-ic i { color: #F39C12; }
  .wd-btn[data-mode="wet"] .wd-ic i { color: #1C8FE0; }
  .wd-btn[data-mode="dry"].wd-active { background: linear-gradient(135deg,#FBB034,#F39C12); border-color: #F39C12; box-shadow: 0 6px 16px rgba(243,156,18,.32); }
  .wd-btn[data-mode="wet"].wd-active { background: linear-gradient(135deg,#27A9E5,#0E6BB8); border-color: #0E6BB8; box-shadow: 0 6px 16px rgba(14,107,184,.32); }
  .wd-btn.wd-active .wd-ic { background: rgba(255,255,255,.25); }
  .wd-btn.wd-active .wd-ic i { color: #fff; }
  .wd-btn.wd-active .wd-t { color: #fff; }
  .wd-btn.wd-active .wd-s { color: rgba(255,255,255,.92); }
  .wd-btn.wd-disabled { opacity: .5; cursor: not-allowed; background: #f1f3f5; }
  .wd-btn.wd-disabled:hover { border-color: #e3e7ec; }
  .wd-why { font-size: 12px; color: #b9521f; margin-top: 8px; }

  /* Tap rows. The old power/water/SMS/tax checkboxes were 22x22px with a label you could only hit on the text
     (audit at 375x667). A row is now >=56px (>=48px for the long-text consent rows), the whole row is the label,
     and the control itself is 28px. #b84a12 on white = 5.22:1 for the checked border. */
  .tap-row { display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 10px 14px; margin: 0 0 10px; border: 2px solid #e3e7ec; border-radius: 13px; background: #f7f9fb; cursor: pointer; font-weight: 600; color: #1c2733; }
  .tap-row input { width: 28px; height: 28px; flex: 0 0 28px; margin: 0; cursor: pointer; accent-color: #b84a12; }
  .tap-row:has(input:checked) { border-color: #b84a12; background: #fff4ec; }
  .tap-row:focus-within { outline: 3px solid var(--bm-ink); outline-offset: 2px; }
  .tap-row.tap-plain { align-items: flex-start; min-height: 48px; font-weight: 400; background: #fff; }
  .tap-row.tap-plain input { margin-top: 2px; }
  /* Inline per-field errors replace the top-right toast, which on a phone sat on the header, far from the field that failed.
     #b3261e on white = 6.5:1. */
  .field-err { display: none; color: #b3261e; font-size: 14px; font-weight: 600; margin-top: 6px; }
  .has-err > .tap-opts .tap-row, .has-err .tap-row.tap-err-target { border-color: #b3261e; }
  .site-note { font-size: 14px; color: #3d4652; background: #fff4ec; border-left: 4px solid #b84a12; border-radius: 6px; padding: 10px 12px; margin-bottom: 10px; display: none; }
  .site-q { margin-bottom: 18px; }
  .site-q:last-child { margin-bottom: 0; }

  /* Order summary. A text scan of this page found no $, Subtotal, Total or Deposit across ~2,800px of form.
     Native <details>: collapsed on phones (one 48px line that still shows the running figure), open on
     desktop. Deliberately NOT sticky - the cart sheet on step 2 showed a pinned panel eats a 375px viewport. */
  .order-sum { background: #fff; border: 2px solid #f0e3d8; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); margin-bottom: 16px; }
  .order-sum > summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 16px; min-height: 48px; cursor: pointer; font-weight: 700; color: var(--bm-blue); }
  .order-sum > summary::-webkit-details-marker { display: none; }
  .order-sum .os-head { color: var(--bm-orange-text, #b84a12); /* price text: #d77c42 is 3.07:1 on white, #b84a12 is 5.22:1 */ white-space: nowrap; }
  .order-sum .os-chev { font-size: 12px; margin-left: 6px; transition: transform .2s; }
  .order-sum[open] .os-chev { transform: rotate(180deg); }
  .order-sum .os-body { padding: 0 16px 14px; font-size: 14.5px; }
  .order-sum .os-row { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; }
  .order-sum .os-tot { border-top: 2px solid #f0f0f0; margin-top: 6px; padding-top: 8px; font-weight: 700; color: var(--bm-blue); }
  .order-sum .os-note { margin: 8px 0 0; font-size: 12px; color: #777; }
</style>

<section class="py-5">
  <div class="container">

    <!-- Progress Bar -->
    <div class="booking-progress">
      <div class="step completed">
        <span class="step-num"><i class="fas fa-check"></i></span>
        <span class="d-none d-md-inline">Select Items</span>
      </div>
      <div class="step-line completed"></div>
      <div class="step completed">
        <span class="step-num"><i class="fas fa-check"></i></span>
