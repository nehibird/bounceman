              </div>
              <div class="col-md-6">
                <label class="form-label">Phone *</label>
                <input type="tel" class="form-control" name="phone" autocomplete="tel" inputmode="tel" required placeholder="(580) 555-0123">
              </div>
            </div>
          </div>

          <!-- Delivery Information -->
          <div class="details-card">
            <h5><i class="fas fa-truck me-2"></i>Delivery Information</h5>
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label">Delivery Address *</label>
                <input type="text" class="form-control" name="delivery_address" autocomplete="street-address" required placeholder="123 Main Street">
              </div>
