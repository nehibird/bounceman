                <input type="text" class="form-control" name="delivery_address" autocomplete="street-address" required placeholder="123 Main Street">
              </div>
              <div class="col-md-6">
                <label class="form-label">City *</label>
                <input type="text" class="form-control" name="delivery_city" autocomplete="address-level2" required placeholder="Tonkawa">
              </div>
              <div class="col-md-6">
                <label class="form-label">ZIP Code *</label>
                <input type="text" class="form-control" name="delivery_zip" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]*" required placeholder="74653" maxlength="10" id="zipInput">
                <div id="zipResult" style="margin-top:6px;font-size:13px;display:none"></div>
              </div>
              <div class="col-12">
                <label class="form-label">Delivery Notes</label>
