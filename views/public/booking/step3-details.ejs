            <div class="os-body">
              <div id="osLines"></div>
              <div class="os-row" id="osSubRow" style="display:none"><span>Subtotal</span><span id="osSub"></span></div>
              <div class="os-row"><span>Delivery</span><span id="osDel"></span></div>
              <div class="os-row os-tot" id="osTotRow" style="display:none"><span>Total before tax</span><span id="osTot"></span></div>
              <p class="os-note">Tax and any discount code are added on the next step.</p>
            </div>
          </details>

          <!-- Wet or Dry. Built client-side from WD_UNITS below: this whole file is a
