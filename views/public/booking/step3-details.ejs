                <label class="tap-row"><input type="radio" name="water_choice" value="no"><span>No, there is no water nearby</span></label>
              </div>
              <div class="site-note" id="waterNote"></div>
              <div class="field-err" id="err-water" role="alert"></div>
              <input type="hidden" name="water_available" value="true" id="waterAvail" disabled>
            </div>
          </div>

          <!-- Customer Information -->
          <div class="details-card">
            <h5><i class="fas fa-user me-2"></i>Customer Information</h5>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">First Name *</label>
                <input type="text" class="form-control" name="first_name" autocomplete="given-name" required placeholder="John">
              </div>
              <div class="col-md-6">
                <label class="form-label">Last Name *</label>
