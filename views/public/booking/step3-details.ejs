          <div class="details-card" id="siteCard" style="display:none">
            <h5><i class="fas fa-plug me-2"></i>Power &amp; water at your setup spot</h5>
            <div class="site-q" id="powerQ" style="display:none">
              <div class="wd-q"><span id="powerQLabel">Is there a power outlet close to where it will go?</span></div>
              <div class="tap-opts" role="radiogroup" aria-labelledby="powerQLabel">
                <label class="tap-row"><input type="radio" name="power_choice" value="yes"><span>Yes, there is an outlet nearby</span></label>
                <label class="tap-row"><input type="radio" name="power_choice" value="no"><span>No, there is no outlet nearby</span></label>
              </div>
