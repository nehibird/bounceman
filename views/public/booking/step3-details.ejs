              <div class="field-err" id="err-power" role="alert"></div>
              <input type="hidden" name="power_available" value="true" id="powerAvail" disabled>
            </div>
            <div class="site-q" id="waterCheckWrap" style="display:none">
              <div class="wd-q"><span id="waterQLabel">Is there a water hookup (garden hose) close to where it will go?</span></div>
