                  <option value="Birthday Party">Birthday Party</option>
                  <option value="Corporate Event">Corporate Event</option>
                  <option value="School Event">School Event</option>
                  <option value="Church Event">Church Event</option>
                  <option value="Community Event">Community Event</option>
                  <option value="Wedding">Wedding</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Venue Type *</label>
                <select class="form-select" name="venue_type" required>
                  <option value="">Select venue type...</option>
                  <option value="Backyard">Backyard</option>
                  <option value="Park">Park</option>
                  <option value="Indoor">Indoor</option>
                  <option value="Commercial">Commercial</option>
                </select>
                <div id="sundayParkNote" style="display:none;margin-top:6px;font-size:12px;color:#b9521f;background:#fdf1ea;border-left:3px solid #d77c42;border-radius:4px;padding:8px 10px">
                  <i class="fas fa-triangle-exclamation me-1"></i><strong>Not available on Sundays.</strong>
                  Sunday rentals are picked up Monday morning, so the unit would sit in the park overnight.
                  Please choose a backyard, indoor, or commercial location &mdash; or pick a Saturday instead.
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label">Surface Type *</label>
                <select class="form-select" name="surface_type" required>
                  <option value="">Select surface type...</option>
                  <option value="Grass">Grass</option>
                  <option value="Concrete">Concrete</option>
                  <option value="Asphalt">Asphalt</option>
                  <option value="Dirt">Dirt</option>
                </select>
                <div id="surfaceFeeNote" style="display:none;margin-top:6px;font-size:12px;color:#5b6b7f"><i class="fas fa-info-circle me-1"></i>On concrete, asphalt or indoors we anchor with sandbags instead of stakes — no extra charge.</div>
              </div>
              <div class="col-md-6 d-flex align-items-end">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="power_available" value="true" id="powerCheck">
                  <label class="form-check-label fw-bold" for="powerCheck">
                    <i class="fas fa-plug me-1"></i>Power outlet available nearby
                  </label>
                </div>
              </div>
              <div class="col-md-6 d-flex align-items-end" id="waterCheckWrap" style="display:none">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="water_available" value="true" id="waterCheck">
                  <label class="form-check-label fw-bold" for="waterCheck">
                    <i class="fas fa-tint me-1" style="color:#3b82f6"></i>Water hookup available nearby
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- SMS Consent -->
          <div class="details-card">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="sms_consent" value="1" id="smsConsent">
              <label class="form-check-label" for="smsConsent" style="font-size:13px;color:#666">
                I agree to receive text messages from Bounce Man LLC regarding my booking, including confirmations, reminders, and follow-ups. Msg & data rates may apply. Msg frequency varies. Reply STOP to opt out. Reply HELP for help.
                <a href="/privacy" target="_blank" style="color:var(--bm-orange)">Privacy Policy</a> | <a href="/terms" target="_blank" style="color:var(--bm-orange)">Terms</a>
              </label>
            </div>
          </div>

          <!-- Tax Exempt -->
          <div class="details-card">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="tax_exempt_claimed" value="1" id="taxExemptCheck">
              <label class="form-check-label" for="taxExemptCheck" style="font-size:13px;color:#666">
                <strong>We are a tax-exempt organization</strong> (church, school, or nonprofit) — A copy of your Oklahoma Sales Tax Exemption Certificate will be required prior to your balance due date.
              </label>
            </div>
            <div id="taxExemptCodeWrap" style="display:none;margin-top:12px;">
              <input type="text" class="form-control" name="tax_exempt_cert" id="taxExemptCert" placeholder="Oklahoma Sales Tax Exemption Permit #" autocomplete="off">
              <small class="text-muted" style="font-size:12px">Enter your exemption permit / certificate number to claim tax-exempt status.</small>
            </div>
          </div>

          <!-- Discount Code -->
          <div class="details-card">
            <h5><i class="fas fa-tag me-2"></i>Discount Code</h5>
            <div class="row g-3">
              <div class="col-md-8">
                <input type="text" class="form-control" name="discount_code" placeholder="Enter discount code (optional)">
              </div>
              <div class="col-md-4">
                <p class="text-muted small mt-2 mb-0">Code will be applied at review.</p>
              </div>
            </div>
          </div>

          <!-- Navigation -->
          <div class="d-flex justify-content-between">
            <a href="#" class="btn btn-outline-secondary rounded-pill px-4" id="backBtn">
              <i class="fas fa-arrow-left me-2"></i>Back
            </a>
            <button type="submit" class="btn btn-book-now px-4">
              Continue to Review<i class="fas fa-arrow-right ms-2"></i>
            </button>
          </div>

        </div>
      </div>
    </form>

  </div>
</section>

`, scripts: `
<script>
  var WD_UNITS = ${ typeof cartUnits !== 'undefined' && cartUnits ? JSON.stringify(cartUnits).replace(/</g, '\\u003c') : '[]' };

  // --- Wet/dry chooser ------------------------------------------------------
  // Server-supplied cart, injected through the surrounding template literal
  // (EJS tags cannot appear inside it). Each entry: {id, name, wetCapable, dryBlocked}.
  // wdChoice[equipmentId] = true (wet) / false (dry). A wet-capable unit absent
  // from this map has not been answered yet and blocks submit.
  var wdChoice = {};

  function wdEsc(t) {
    return String(t == null ? '' : t)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // Render the card. Only water-capable units ask; add-ons and dry-only units skip it.
  function wdRender() {
    var mount = document.getElementById('wetDryMount');
    if (!mount) return;
    var units = WD_UNITS.filter(function(u) { return u.wetCapable; });
    if (!units.length) return;

    var html = '<div class="details-card" id="wetDryCard">' +
      '<h5><i class="fas fa-tint me-2"></i>Wet or Dry?</h5>';
    units.forEach(function(u) {
      var id = wdEsc(u.id);
      html += '<div class="wd-unit" data-unit-id="' + id + '" data-dry-blocked="' + (u.dryBlocked ? '1' : '0') + '">' +
        '<div class="wd-q"><span>' + wdEsc(u.name) + '</span>' +
        '<span class="wd-req" id="wdreq-' + id + '">Choose one</span></div>' +
        '<div class="wd-row">' +
          '<div class="wd-btn' + (u.dryBlocked ? ' wd-disabled' : '') + '" data-mode="dry" data-unit="' + id + '" id="wd-dry-' + id + '">' +
            '<div class="wd-ic"><i class="fas fa-sun"></i></div>' +
            '<div><div class="wd-t">Dry</div><div class="wd-s">No water — same price</div></div>' +
          '</div>' +
          '<div class="wd-btn" data-mode="wet" data-unit="' + id + '" id="wd-wet-' + id + '">' +
            '<div class="wd-ic"><i class="fas fa-tint"></i></div>' +
            '<div><div class="wd-t">Wet</div><div class="wd-s">Splash &amp; slide — same price</div></div>' +
          '</div>' +
        '</div>' +
        (u.dryBlocked
          ? '<div class="wd-why"><i class="fas fa-circle-info me-1"></i>This unit is booked wet shortly before your rental and needs time to dry, so dry is not available on this date. Wet is — or call (580) 308-9288 about another date.</div>'
          : '') +
      '</div>';
    });
    html += '</div>';
    mount.innerHTML = html;
  }

  function wdUnitEls() {
    return Array.prototype.slice.call(document.querySelectorAll('.wd-unit'));
  }

  function wdUnanswered() {
    return wdUnitEls().filter(function(el) {
      return typeof wdChoice[el.dataset.unitId] === 'undefined';
    });
  }

  function wdSyncHidden() {
    var wetIds = Object.keys(wdChoice).filter(function(id) { return wdChoice[id]; });
    document.getElementById('hiddenWetItems').value = wetIds.join(',');
    var wrap = document.getElementById('waterCheckWrap');
    if (wrap) { wrap.style.display = wetIds.length > 0 ? '' : 'none'; }
  }

  function wdSet(unitId, isWet) {
    var el = document.querySelector('.wd-unit[data-unit-id="' + unitId + '"]');
    if (!el) return;
    // Dry can be unavailable when the unit is out wet shortly beforehand.
    if (!isWet && el.dataset.dryBlocked === '1') return;
    wdChoice[unitId] = isWet;
    var dryBtn = document.getElementById('wd-dry-' + unitId);
    var wetBtn = document.getElementById('wd-wet-' + unitId);
    if (dryBtn) { dryBtn.classList.toggle('wd-active', !isWet); }
    if (wetBtn) { wetBtn.classList.toggle('wd-active', isWet); }
    var req = document.getElementById('wdreq-' + unitId);
    if (req) { req.textContent = isWet ? 'Wet' : 'Dry'; req.classList.add('wd-chosen'); }
    wdSyncHidden();
  }

  document.addEventListener('click', function(e) {
    var btn = e.target && e.target.closest ? e.target.closest('.wd-btn') : null;
    if (!btn || btn.classList.contains('wd-disabled')) return;
    wdSet(btn.getAttribute('data-unit'), btn.getAttribute('data-mode') === 'wet');
  });

  // Pull query params from previous step and populate hidden fields
  (function() {
    // Build the wet/dry card first so the init below can see and pre-select it.
    wdRender();
    var params = new URLSearchParams(window.location.search);
    var items = params.get('items') || '';
    var date = params.get('event_date') || '';
    var start = params.get('event_start_time') || '';
    var end = params.get('event_end_time') || '';
    var duration = params.get('rental_duration') || 'daily';

    document.getElementById('hiddenItems').value = items;
    document.getElementById('hiddenDate').value = date;
    document.getElementById('hiddenStart').value = start;
    document.getElementById('hiddenEnd').value = end;
    document.getElementById('hiddenDuration').value = duration;

    var wetItems = params.get('wet_items') || '';

    // Carry the multi-day count forward so checkout charges/blocks the full rental
    document.getElementById('hiddenDays').value = params.get('rental_days') || '1';
    document.getElementById('hiddenEndDate').value = params.get('event_end_date') || date;

    if (document.getElementById('wetDryCard')) {
      // The chooser is on the page, so it owns wet_items from here on.
      // wd=1 means step 2 already asked and the URL carries a real customer answer,
      // so pre-select it. Sarah's texted links carry no wd flag — leave those blank
      // so the customer is actually asked instead of inheriting a guess.
      var preWet = wetItems.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
      if (params.get('wd') === '1') {
        wdUnitEls().forEach(function(el) {
          wdSet(el.dataset.unitId, preWet.indexOf(el.dataset.unitId) !== -1);
        });
      }
      wdSyncHidden();
    } else {
      // No water-capable units — preserve the old passthrough behaviour exactly.
      document.getElementById('hiddenWetItems').value = wetItems;
      if (wetItems && wetItems.length > 0) {
        document.getElementById('waterCheckWrap').style.display = '';
      }
    }

    // Build back link
    document.getElementById('backBtn').href = '/booking/select?event_date=' + date + '&rental_duration=' + duration + '&preselect=' + items;
  })();


  // Phone formatting
  document.querySelector('input[name="phone"]').addEventListener('input', function(e) {
    var val = e.target.value.replace(/\\D/g, '');
    // Drop a leading +1 before formatting. Without this, someone typing their own number
    // as 15806281767 got saved as "(158) 062-8176" — the first three digits were taken as
    // the area code and everything shifted. Silent, and only discovered when a text bounced.
    if (val.length === 11 && val.charAt(0) === '1') val = val.slice(1);
    if (val.length >= 6) {
      e.target.value = '(' + val.substring(0,3) + ') ' + val.substring(3,6) + '-' + val.substring(6,10);
    } else if (val.length >= 3) {
      e.target.value = '(' + val.substring(0,3) + ') ' + val.substring(3);
    }
  });

  // Form validation
  document.getElementById('detailsForm').addEventListener('submit', function(e) {
    var params = new URLSearchParams(window.location.search);
    // Read the LIVE choice, not the URL — the customer may have changed it here.
    var wetItems = document.getElementById('hiddenWetItems').value || '';
    var items = params.get('items') || '';

    // Every water-capable unit needs an explicit answer. Previously this page
    // inherited whatever the link said, so a texted link could book the wrong
    // setup or dead-end at a 409 the customer could do nothing about.
    var unanswered = wdUnanswered();
    if (unanswered.length > 0) {
      e.preventDefault();
      var names = unanswered.map(function(el) {
        var q = el.querySelector('.wd-q span');
        return q ? q.textContent : 'your rental';
      });
      showToast('Please choose wet or dry for: ' + names.join(', '), 'warning');
      unanswered.forEach(function(el) {
        var req = el.querySelector('.wd-req');
        if (req) { req.classList.remove('wd-flash'); void req.offsetWidth; req.classList.add('wd-flash'); }
      });
      unanswered[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    // No park setups on Sundays — see sundayParkSelected() below.
    if (sundayParkSelected()) {
      e.preventDefault();
      showToast('We can\\'t set up at a park on Sundays — Sunday rentals are picked up Monday morning, so the unit would be left out overnight. Please choose a backyard, indoor, or commercial location, or pick a Saturday instead.', 'warning');
      document.querySelector('select[name="venue_type"]').focus();
      return;
    }

    // Wet units require water hookup
    if (wetItems.length > 0) {
      var waterCheck = document.getElementById('waterCheck');
      if (!waterCheck.checked) {
        e.preventDefault();
        showToast('You selected a wet setup, which requires a water hookup within 100 feet. Please confirm water is available or go back and select the dry option.', 'warning');
        waterCheck.focus();
        return;
      }
    }

    // No power = must have generator
    var powerCheck = document.getElementById('powerCheck');
    if (!powerCheck.checked) {
      var hasGenerator = items.indexOf('fff4986b-1b23-4202-9bcb-ddc8775c5410') !== -1;
      if (!hasGenerator) {
        e.preventDefault();
        showToast('Inflatables require power to run. Please confirm a power outlet is available nearby, or go back and add a Portable Generator to your rental.', 'warning');
        powerCheck.focus();
        return;
      }
    }
    // ZIP must be in service area
    if (!zipValid) {
      e.preventDefault();
      showToast('Your ZIP code is outside our delivery area. Please call <a href="tel:5803089288" style="color:white;text-decoration:underline">(580) 308-9288</a> to discuss delivery options.', 'error');
      document.getElementById('zipInput').focus();
      return;
    }
  });

  // ZIP code validation
  var zipValid = false;
  var zipTimer = null;
  function checkZip(val) {
    val = val.replace(/\D/g, '');
    if (val.length < 5) {
      document.getElementById('zipResult').style.display = 'none';
      zipValid = false;
      return;
    }
    clearTimeout(zipTimer);
    zipTimer = setTimeout(function() {
      fetch('/booking/check-zip?zip=' + val)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var el = document.getElementById('zipResult');
          el.style.display = 'block';
          // MED-1: Use textContent to avoid DOM XSS — message comes from API response
          var icon = document.createElement('i');
          var span = document.createElement('span');
          var msg = document.createTextNode(data.message || '');
          if (data.valid) {
            zipValid = true;
            span.style.color = '#2e7d32';
            icon.className = 'fas fa-check-circle me-1';
          } else {
            zipValid = false;
            span.style.color = '#c62828';
            icon.className = 'fas fa-times-circle me-1';
          }
          span.appendChild(icon);
          span.appendChild(msg);
          el.textContent = '';
          el.appendChild(span);
        })
        .catch(function() { zipValid = true; }); // allow on error
    }, 400);
  }

  // CSP-safe: replace oninput="checkZip" with addEventListener
  document.getElementById("zipInput").addEventListener("input", function() { checkZip(this.value); });

  // Tax-exempt: require a permit # when the box is checked (prevents accidental checking)
  (function() {
    var cb = document.getElementById('taxExemptCheck');
    var wrap = document.getElementById('taxExemptCodeWrap');
    var cert = document.getElementById('taxExemptCert');
    if (!cb || !wrap || !cert) return;
    function sync() {
      if (cb.checked) { wrap.style.display = ''; cert.required = true; }
      else { wrap.style.display = 'none'; cert.required = false; cert.value = ''; }
    }
    cb.addEventListener('change', sync);
    sync();
  })();

  // Show the hard-surface/indoor surcharge note only when it applies
  (function() {
    var surf = document.querySelector('select[name="surface_type"]');
    var venue = document.querySelector('select[name="venue_type"]');
    var note = document.getElementById('surfaceFeeNote');
    if (!note) return;
    function sync() {
      var s = (surf && surf.value || '').toLowerCase();
      var v = (venue && venue.value || '').toLowerCase();
      note.style.display = (/concrete|asphalt/.test(s) || /indoor/.test(v)) ? '' : 'none';
    }
    if (surf) surf.addEventListener('change', sync);
    if (venue) venue.addEventListener('change', sync);
    sync();
  })();

  // Sunday + Park is refused: a Sunday rental is collected Monday morning, so the unit
  // would be left unattended in a public park overnight. Warn at the moment they pick it
  // rather than after they've filled the rest of the form in. The server re-checks this.
  function isSundayEventDate() {
    var d = document.getElementById('hiddenDate').value;
    if (!d) return false;
    var dt = new Date(d + 'T12:00:00');
    return !isNaN(dt.getTime()) && dt.getDay() === 0;
  }
  function sundayParkSelected() {
    var venue = document.querySelector('select[name="venue_type"]');
    return isSundayEventDate() && /park/i.test((venue && venue.value) || '');
  }
  (function() {
    var venue = document.querySelector('select[name="venue_type"]');
    var note = document.getElementById('sundayParkNote');
    if (!venue || !note) return;
    function sync() { note.style.display = sundayParkSelected() ? '' : 'none'; }
    venue.addEventListener('change', sync);
    sync();
  })();
</script>
<script>if(typeof fbq!=='undefined')fbq('track','InitiateCheckout');</script>
