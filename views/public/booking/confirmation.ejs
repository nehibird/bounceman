<%- include('../../layouts/public', { body: `

<style>
  .confirm-hero { text-align: center; padding: 60px 20px; }
  .confirm-icon { width: 120px; height: 120px; border-radius: 50%; background: #d1fae5; color: var(--bm-green); font-size: 56px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 24px; animation: popIn 0.5s ease; }
  @keyframes popIn { 0% { transform: scale(0); } 50% { transform: scale(1.2); } 100% { transform: scale(1); } }
  .booking-number { background: var(--bm-light-bg); border: 2px dashed var(--bm-orange); border-radius: 12px; padding: 16px 32px; display: inline-block; font-size: 28px; font-weight: 700; color: var(--bm-blue); letter-spacing: 2px; margin: 16px 0; }
  .next-steps { background: white; border-radius: 20px; padding: 30px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); text-align: left; max-width: 600px; margin: 30px auto; }
  .next-steps .step-item { display: flex; gap: 16px; padding: 14px 0; border-bottom: 1px solid #f5f5f5; }
  .next-steps .step-item:last-child { border-bottom: none; }
  .next-steps .step-icon { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: white; flex-shrink: 0; }
  .next-steps .step-icon.s1 { background: var(--bm-orange); }
  .next-steps .step-icon.s2 { background: var(--bm-blue); }
  .next-steps .step-icon.s3 { background: var(--bm-purple); }
  .next-steps .step-icon.s4 { background: var(--bm-green); }
  .confetti { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9999; overflow: hidden; }
  .confetti-piece { position: absolute; width: 10px; height: 10px; top: -10px; animation: confettiFall 3s ease-in forwards; }
  @keyframes confettiFall { 0% { opacity: 1; transform: translateY(0) rotate(0deg); } 100% { opacity: 0; transform: translateY(100vh) rotate(720deg); } }
</style>

<section class="py-5">
  <div class="container">

    <div class="confirm-hero">
      <!-- The route (routes/booking.js) passes depositPaid = true only for a genuinely paid deposit.
           This page used to say "Booking Confirmed!" unconditionally, so a customer who could not pay sat
           for days believing she was booked. Unpaid => say plainly it is NOT confirmed and how to pay.
           (Template-literal rules: no raw backticks or stray dollar-brace in this copy.) -->
      ${locals.depositPaid ? `
      <div class="confirm-icon">
        <i class="fas fa-check"></i>
      </div>
      <h1 style="color:var(--bm-blue);font-size:42px;">Booking Confirmed!</h1>
      <p class="text-muted" style="font-size:18px;">Your bounce house rental has been booked successfully</p>
      ` : `
      <div class="confirm-icon" style="background:#fef3c7;color:#92400e;">
        <i class="fas fa-exclamation"></i>
      </div>
      <h1 style="color:var(--bm-blue);font-size:42px;">Almost there &mdash; not booked yet</h1>
      <p style="font-size:18px;color:var(--bm-ink);">Your booking is <strong>not confirmed</strong> until the deposit is paid. We are holding your date for now, but the hold expires and the equipment is released to the next customer if the deposit is not received.</p>
      <p class="mt-3"><a href="${esc(locals.payDepositPath || ('/booking/pay-deposit/' + bookingNumber))}" class="btn btn-book-now btn-lg px-5"><i class="fas fa-lock me-2"></i>Pay Your Deposit Now</a></p>
      <p class="text-muted">Trouble paying? Call or text us at <a href="tel:5803089288" style="color:var(--bm-blue);font-weight:700;">(580) 308-9288</a> and we will take the deposit for you.</p>
      `}

      <div class="booking-number">${bookingNumber}</div>

      <p class="text-muted">Save this booking number for your records</p>
    </div>

    ${locals.depositPaid ? `

    <!-- Next Steps -->
    <div class="next-steps">
      <h5 style="color:var(--bm-blue);font-weight:700;text-align:center;margin-bottom:20px;">What Happens Next</h5>

      <div class="step-item">
        <div class="step-icon s1">1</div>
        <div>
          <div class="fw-bold">Check Your Email</div>
          <div class="text-muted small">A confirmation email with your booking details has been sent. Check your spam folder if you don't see it.</div>
        </div>
      </div>

      <div class="step-item">
        <div class="step-icon s2">2</div>
        <div>
          <div class="fw-bold">Rental Agreement Signed</div>
          <div class="text-muted small">You signed your rental agreement before paying, so there is nothing more to sign. If you need a copy, call or text us.</div>
        </div>
      </div>

      <div class="step-item">
        <div class="step-icon s3">3</div>
        <div>
          <div class="fw-bold">Delivery Confirmation</div>
          <div class="text-muted small">We'll reach out 24 hours before your event to confirm delivery details, timing, and setup location.</div>
        </div>
      </div>

      <div class="step-item">
        <div class="step-icon s4">4</div>
        <div>
          <div class="fw-bold">Event Day</div>
          <div class="text-muted small">We'll deliver, set up, and pick up your equipment. The remaining balance is due on delivery day.</div>
        </div>
      </div>
    </div>
    ` : ''}

    <!-- Action Buttons -->
    <div class="text-center mt-4">
      <a href="/booking/lookup" class="btn btn-outline-primary rounded-pill px-4 me-2 mb-2">
        <i class="fas fa-search me-2"></i>Look Up Your Booking
      </a>
      <a href="/booking" class="btn btn-outline-secondary rounded-pill px-4 me-2 mb-2">
        <i class="fas fa-plus me-2"></i>Book Another Rental
      </a>
      <a href="/" class="btn btn-book-now px-4 mb-2">
        <i class="fas fa-home me-2"></i>Back to Home
      </a>
    </div>

  </div>
</section>

<!-- Confetti Container -->
<div class="confetti" id="confetti"></div>

`, scripts: `
<script>
  // Simple confetti effect
  (function() {
    var colors = ['#FF6B35', '#004E89', '#FFD166', '#06D6A0', '#EF476F', '#7B2D8E'];
    var container = document.getElementById('confetti');
    // Celebrate only a paid booking - confetti on an unpaid, unconfirmed page would repeat the original lie.
    if (!${locals.depositPaid ? 'true' : 'false'}) { container.remove(); return; }
    for (var i = 0; i < 60; i++) {
      var piece = document.createElement('div');
      piece.className = 'confetti-piece';
      piece.style.left = Math.random() * 100 + '%';
      piece.style.background = colors[Math.floor(Math.random() * colors.length)];
      piece.style.animationDelay = Math.random() * 2 + 's';
      piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
      piece.style.width = (Math.random() * 8 + 6) + 'px';
      piece.style.height = (Math.random() * 8 + 6) + 'px';
      container.appendChild(piece);
    }
    // Remove confetti after animation
    setTimeout(function() { container.remove(); }, 5000);
  })();
</script>
${locals.depositPaid ? `<script>if(typeof fbq!=='undefined'){fbq('track','Purchase',{value:${Number(locals.conversionValue)||0},currency:'USD'},{eventID:${JSON.stringify(String(bookingNumber||''))}});}</script>` : ''}
${locals.depositPaid && (locals.ecEmailHash || locals.ecPhoneHash) ? `<script>if(typeof gtag==='function'){gtag('set','user_data',{${locals.ecEmailHash ? `sha256_email_address:${JSON.stringify(locals.ecEmailHash)}` : ''}${locals.ecEmailHash && locals.ecPhoneHash ? ',' : ''}${locals.ecPhoneHash ? `sha256_phone_number:${JSON.stringify(locals.ecPhoneHash)}` : ''}});}</script>` : ''}
${locals.depositPaid ? `<script>if(typeof gtag==='function'){gtag('event','conversion',{send_to:'AW-18074004860/P4n-CM6-k7EcEPzarapD',value:${Number(locals.conversionValue)||0},currency:'USD',transaction_id:${JSON.stringify(String(bookingNumber||''))}});}</script>` : ''}
` }) %>
