<%- include("../../layouts/public", { body: \`
<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6 text-center">
        <div class="card shadow-sm">
          <div class="card-body py-5">
            <i class="fas fa-check-circle text-success" style="font-size:64px;margin-bottom:20px"></i>
            <h2 style="color:var(--bm-blue)">Payment Complete!</h2>
            <p class="text-muted mb-4">Thank you for your payment.</p>
            \${booking ? \`
            <div class="bg-light rounded p-3 mb-4">
              <p class="mb-1"><strong>Booking:</strong> \${booking.booking_number}</p>
              <p class="mb-1"><strong>Event Date:</strong> \${booking.rental_period || booking.event_date}</p>
              <p class="mb-0 text-success"><strong>Status:</strong> Paid in Full</p>
            </div>
            \` : ""}
            <p class="text-muted">A receipt has been sent to your email.</p>
            <a href="/" class="btn btn-bm mt-3"><i class="fas fa-home me-2"></i>Back to Home</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
\`, scripts: "" }) %>
