<%- include('../../layouts/public', { body: `

<style>
  .booking-progress { display: flex; justify-content: center; gap: 0; margin-bottom: 40px; }
  .booking-progress .step { display: flex; align-items: center; gap: 8px; padding: 12px 20px; color: #aaa; font-weight: 600; font-size: 14px; }
  .booking-progress .step.active { color: var(--bm-orange); }
  .booking-progress .step.completed { color: var(--bm-green); }
  .booking-progress .step .step-num { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; background: #e9ecef; color: #aaa; }
  .booking-progress .step.active .step-num { background: var(--bm-gradient); color: white; }
  .booking-progress .step.completed .step-num { background: var(--bm-green); color: white; }
  .booking-progress .step-line { width: 40px; height: 2px; background: #e9ecef; align-self: center; }
  .booking-progress .step-line.completed { background: var(--bm-green); }

  .date-card { background: white; border-radius: 20px; padding: 30px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); }
  .flatpickr-calendar { margin: 0 auto; }
  .availability-result { padding: 16px; border-radius: 12px; margin-top: 20px; font-weight: 600; display: none; }
  .availability-result.available { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
  .availability-result.unavailable { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
  .time-select { border: 2px solid #e9ecef; border-radius: 12px; padding: 10px 16px; font-size: 15px; width: 100%; transition: border-color 0.2s; }
  .time-select:focus { border-color: var(--bm-orange); outline: none; }
</style>

<section class="py-5">
  <div class="container">

    <!-- Progress Bar -->
    <div class="booking-progress">
      <div class="step completed">
        <span class="step-num"><i class="fas fa-check"></i></span>
        <span class="d-none d-md-inline">Select Items</span>
      </div>
      <div class="step-line completed"></div>
      <div class="step active">
        <span class="step-num">2</span>
        <span class="d-none d-md-inline">Pick Date</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">3</span>
        <span class="d-none d-md-inline">Your Details</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-num">4</span>
        <span class="d-none d-md-inline">Review</span>
      </div>
    </div>

    <div class="section-title">
      <h2>Pick Your Date & Time</h2>
      <p>${selectedItems.length} item${selectedItems.length !== 1 ? 's' : ''} selected</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <form id="dateForm" action="/booking/details" method="GET">
          <!-- Carry forward selected items -->
          <input type="hidden" name="items" value="${selectedItems.join(',')}">
          <input type="hidden" name="rental_duration" id="hiddenDuration" value="daily">

          <div class="date-card mb-4">
            <h5 style="color:var(--bm-blue);font-weight:700;" class="mb-3"><i class="fas fa-calendar-alt me-2"></i>Event Date</h5>
            <div id="datePicker"></div>
            <input type="hidden" name="event_date" id="eventDateInput" required>
          </div>

          <!-- Rental Duration Selector -->
          <div class="date-card mb-4">
            <h6 class="fw-bold mb-3"><i class="fas fa-clock me-2"></i>Rental Duration</h6>
            <div class="row g-3">
              <div class="col-4">
                <input type="radio" name="rental_duration" value="4hr" id="dur4hr" class="btn-check">
                <label class="btn btn-outline-primary w-100 rounded-pill" for="dur4hr" style="padding:12px">
                  <div class="fw-bold">4 Hours</div>
                  <div class="small">Quick party</div>
                </label>
              </div>
              <div class="col-4">
                <input type="radio" name="rental_duration" value="daily" id="durDaily" class="btn-check" checked>
                <label class="btn btn-outline-primary w-100 rounded-pill" for="durDaily" style="padding:12px">
                  <div class="fw-bold">Full Day</div>
                  <div class="small">8 hours</div>
                </label>
              </div>
              <div class="col-4">
                <input type="radio" name="rental_duration" value="overnight" id="durOvernight" class="btn-check">
                <label class="btn btn-outline-primary w-100 rounded-pill" for="durOvernight" style="padding:12px">
                  <div class="fw-bold">Overnight</div>
                  <div class="small">Next-day pickup</div>
                </label>
              </div>
            </div>
          </div>

          <div class="date-card mb-4">
            <h5 style="color:var(--bm-blue);font-weight:700;" class="mb-3"><i class="fas fa-clock me-2"></i>Event Time</h5>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-bold">Start Time</label>
                <select name="event_start_time" id="startTime" class="time-select" required>
                  <option value="">Select start time...</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">End Time</label>
                <select name="event_end_time" id="endTime" class="time-select" required>
                  <option value="">Select end time...</option>
                </select>
              </div>
            </div>
            <p class="text-muted small mt-2 mb-0" id="timeHint"><i class="fas fa-info-circle me-1"></i>Times auto-set based on rental duration. You can adjust if needed.</p>
          </div>

          <!-- Availability Check -->
          <div class="date-card mb-4">
            <div class="d-flex justify-content-between align-items-center">
              <h5 style="color:var(--bm-blue);font-weight:700;" class="mb-0"><i class="fas fa-search me-2"></i>Availability</h5>
              <button type="button" class="btn btn-outline-primary rounded-pill" id="checkAvailBtn" onclick="checkAvailability()">
                <i class="fas fa-check-circle me-1"></i>Check Availability
              </button>
            </div>
            <div class="availability-result" id="availResult"></div>
          </div>

          <div class="d-flex justify-content-between">
            <a href="/booking?items=${selectedItems.join(',')}" class="btn btn-outline-secondary rounded-pill px-4">
              <i class="fas fa-arrow-left me-2"></i>Back
            </a>
            <button type="submit" class="btn btn-book-now px-4" id="continueBtn">
              Continue to Details<i class="fas fa-arrow-right ms-2"></i>
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</section>

`, scripts: `
<script>
  // Build time options (7:00 AM to 10:00 PM in 30min increments)
  (function() {
    var startSel = document.getElementById('startTime');
    var endSel = document.getElementById('endTime');
    for (var h = 7; h <= 22; h++) {
      for (var m = 0; m < 60; m += 30) {
        if (h === 22 && m === 30) break;
        var hour12 = h > 12 ? h - 12 : (h === 0 ? 12 : h);
        var ampm = h >= 12 ? 'PM' : 'AM';
        var label = hour12 + ':' + (m < 10 ? '0' + m : m) + ' ' + ampm;
        var val = (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m);
        startSel.innerHTML += '<option value="' + val + '">' + label + '</option>';
        endSel.innerHTML += '<option value="' + val + '">' + label + '</option>';
      }
    }
    // Defaults: 9 AM start, 5 PM end (Full Day)
    startSel.value = '09:00';
    endSel.value = '17:00';
  })();

  // Duration radio change handler
  document.querySelectorAll('input[name="rental_duration"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var dur = this.value;
      var startSel = document.getElementById('startTime');
      var endSel = document.getElementById('endTime');
      var hint = document.getElementById('timeHint');
      document.getElementById('hiddenDuration').value = dur;
      if (dur === '4hr') {
        startSel.value = '10:00';
        endSel.value = '14:00';
        hint.innerHTML = '<i class="fas fa-info-circle me-1"></i>4-hour rental: 10 AM - 2 PM (adjustable).';
      } else if (dur === 'daily') {
        startSel.value = '09:00';
        endSel.value = '17:00';
        hint.innerHTML = '<i class="fas fa-info-circle me-1"></i>Full day rental: 9 AM - 5 PM (adjustable).';
      } else if (dur === 'overnight') {
        startSel.value = '09:00';
        endSel.value = '09:00';
        hint.innerHTML = '<i class="fas fa-info-circle me-1"></i>Overnight rental: delivered in the morning, picked up next day. End time indicates next-day pickup.';
      }
    });
  });

  // Initialize Flatpickr inline calendar
  var fp = flatpickr('#datePicker', {
    inline: true,
    minDate: 'today',
    dateFormat: 'Y-m-d',
    onChange: function(selectedDates, dateStr) {
      document.getElementById('eventDateInput').value = dateStr;
      // Reset availability check
      var r = document.getElementById('availResult');
      r.style.display = 'none';
      r.className = 'availability-result';
    }
  });

  function checkAvailability() {
    var date = document.getElementById('eventDateInput').value;
    if (!date) {
      alert('Please select a date first.');
      return;
    }
    var btn = document.getElementById('checkAvailBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Checking...';

    var items = document.querySelector('input[name="items"]').value;
    fetch('/booking/check-date', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ date: date, equipment_ids: items.split(',') })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      var r = document.getElementById('availResult');
      r.style.display = 'block';
      if (data.available) {
        r.className = 'availability-result available';
        r.innerHTML = '<i class="fas fa-check-circle me-2"></i>Great news! All selected items are available on this date.';
      } else {
        r.className = 'availability-result unavailable';
        r.innerHTML = '<i class="fas fa-times-circle me-2"></i>' + (data.message || 'Some items are not available on this date. Please choose a different date.');
      }
    })
    .catch(function() {
      var r = document.getElementById('availResult');
      r.style.display = 'block';
      r.className = 'availability-result available';
      r.innerHTML = '<i class="fas fa-info-circle me-2"></i>Could not verify availability online. You may proceed and we will confirm by email.';
    })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-check-circle me-1"></i>Check Availability';
    });
  }

  // Form validation
  document.getElementById('dateForm').addEventListener('submit', function(e) {
    if (!document.getElementById('eventDateInput').value) {
      e.preventDefault();
      alert('Please select an event date.');
      return;
    }
    var start = document.getElementById('startTime').value;
    var end = document.getElementById('endTime').value;
    if (!start || !end) {
      e.preventDefault();
      alert('Please select start and end times.');
      return;
    }
    var dur = document.querySelector('input[name="rental_duration"]:checked');
    var durVal = dur ? dur.value : 'daily';
    if (durVal !== 'overnight' && start >= end) {
      e.preventDefault();
      alert('End time must be after start time.');
      return;
    }
  });
</script>
` }) %>
