<%- include('../../layouts/public', { body: `

<style>
  .cancel-hero { text-align: center; padding: 60px 20px; }
  .cancel-icon { width: 100px; height: 100px; border-radius: 50%; background: #fee2e2; color: #ef4444; font-size: 48px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 24px; }
  .help-card { background: white; border-radius: 20px; padding: 28px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); max-width: 520px; margin: 0 auto; }
</style>

<section class="py-5">
  <div class="container">
    <div class="cancel-hero">
      <div class="cancel-icon"><i class="fas fa-times"></i></div>
      <h1 style="color:var(--bm-blue);font-size:36px;">Booking Not Completed</h1>
      <p class="text-muted" style="font-size:18px;">No worries — your booking was not confirmed and you were not charged.</p>
    </div>

    <div class="help-card">
      <h5 style="color:var(--bm-blue);font-weight:700;text-align:center;margin-bottom:20px;">What Would You Like to Do?</h5>

      <div class="text-center">
        <a href="/booking" class="btn btn-book-now px-4 mb-3 d-block">
          <i class="fas fa-redo me-2"></i>Try Booking Again
        </a>
        <a href="/" class="btn btn-outline-secondary rounded-pill px-4 mb-3 d-block">
          <i class="fas fa-home me-2"></i>Return to Homepage
        </a>
      </div>

      <hr>

      <p class="text-center text-muted small mb-2">Need help? We're here for you.</p>
      <p class="text-center">
        <a href="tel:5803089288" class="fw-bold" style="color:var(--bm-orange);">
          <i class="fas fa-phone me-1"></i>(580) 308-9288
        </a>
      </p>
    </div>
  </div>
</section>

`, scripts: `` }) %>
