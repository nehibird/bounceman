    <div class="biz-tech">
      <span>Node.js</span><span>Express</span><span>SQLite</span><span>Docker</span><span>Cloudflare</span><span>Stripe</span><span>Twilio</span><span>Voice AI</span><span>Google Ads API</span><span>Meta Ads API</span><span>Bank Sync</span>
    </div>
