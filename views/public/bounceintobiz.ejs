        ['fa-university','Bank &amp; Stripe Sync','Live cash position and payout tracking.'],
        ['fa-file-invoice-dollar','Expenses','Track spend, reimbursements, and profitability.'],
        ['fa-wrench','Maintenance Log','Per-unit service history to keep the fleet safe.'],
