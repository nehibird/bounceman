      <div class="biz-eyebrow">Everything Under One Roof</div>
      <h2 class="biz-h2">One platform. The whole operation.</h2>
    </div>
    <div class="row g-4">
      ${[
        ['fa-calendar-check','Bookings &amp; Calendar','Full booking lifecycle with a visual event calendar.'],
        ['fa-truck','Delivery Routing','Zone-based delivery fees + route planning by day.'],
        ['fa-users','Customer CRM','Every customer, history, and tax-exempt status on file.'],
        ['fa-comments','SMS &amp; Messenger AI','Sarah replies on text + Facebook automatically.'],
        ['fa-phone','Phone AI + Call Log','Voice receptionist with recordings &amp; summaries.'],
