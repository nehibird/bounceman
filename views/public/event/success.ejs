<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root { --bm-orange: #FF6B35; --bm-blue: #004E89; --bm-green: #2ECC71; }
    body { font-family: 'Nunito', sans-serif; background: linear-gradient(135deg, #2ECC71 0%, #27AE60 100%); min-height: 100vh; margin: 0; padding: 16px; display: flex; align-items: center; justify-content: center; }
    .success-container { max-width: 420px; width: 100%; text-align: center; }
    .success-card { background: white; border-radius: 24px; padding: 40px 30px; box-shadow: 0 20px 60px rgba(0,0,0,0.15); }
    .check-icon { width: 80px; height: 80px; border-radius: 50%; background: var(--bm-green); color: white; font-size: 40px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px; animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    @keyframes popIn { 0% { transform: scale(0); } 100% { transform: scale(1); } }
    .wristband-display { background: var(--bm-blue); color: white; border-radius: 16px; padding: 20px; margin: 20px 0; }
    .wristband-display .label { font-size: 14px; opacity: 0.8; text-transform: uppercase; letter-spacing: 1px; }
    .wristband-display .numbers { font-size: 48px; font-weight: 800; line-height: 1.1; }
    .wristband-display .instruction { font-size: 13px; opacity: 0.7; margin-top: 8px; }
    .detail-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f0f0f0; font-size: 14px; }
    .detail-row:last-child { border: none; }
    .detail-row .label { color: #888; }
    .detail-row .value { font-weight: 700; color: #333; }
    .countdown { color: white; font-size: 14px; margin-top: 20px; opacity: 0.8; }
    .countdown strong { font-size: 20px; }
    .pending-spinner { padding: 40px; }
    .pending-spinner i { font-size: 48px; color: white; opacity: 0.8; }
    .pending-spinner p { color: white; margin-top: 16px; font-size: 16px; }
  </style>
</head>
<body>

<div class="success-container">
  <% if (reg.payment_status === 'completed') { %>

  <div class="success-card">
    <div class="check-icon"><i class="fas fa-check"></i></div>
    <h2 style="color:var(--bm-blue);font-weight:800;margin-bottom:4px">All Set!</h2>
    <p class="text-muted">Grab your wristband<%= reg.kid_count > 1 ? 's' : '' %> and have fun!</p>

    <!-- Wristband Number -->
    <div class="wristband-display">
      <div class="label">Wristband<%= reg.wristband_start !== reg.wristband_end ? 's' : '' %></div>
      <div class="numbers">
        <% if (reg.wristband_start === reg.wristband_end) { %>
          #<%= reg.wristband_start %>
        <% } else { %>
          #<%= reg.wristband_start %> - #<%= reg.wristband_end %>
        <% } %>
      </div>
      <div class="instruction">Show this to get your wristband<%= reg.kid_count > 1 ? 's' : '' %></div>
    </div>

    <!-- Details -->
    <div style="text-align:left;padding:0 10px">
      <div class="detail-row">
        <span class="label">Parent</span>
        <span class="value"><%= reg.parent_name %></span>
      </div>
      <div class="detail-row">
        <span class="label">Kids</span>
        <span class="value"><%= reg.kid_count %></span>
      </div>
      <div class="detail-row">
        <span class="label">Event</span>
        <span class="value"><%= reg.event_name %></span>
      </div>
      <div class="detail-row">
        <span class="label">Paid</span>
        <span class="value">$<%= parseFloat(reg.amount_paid).toFixed(2) %></span>
      </div>
    </div>
  </div>

  <% if (kiosk) { %>
  <div class="countdown">
    Next registration in <strong id="countdown">10</strong> seconds
  </div>
  <% } %>

  <% } else { %>

  <!-- Payment pending — poll for completion -->
  <div class="pending-spinner">
    <i class="fas fa-spinner fa-spin"></i>
    <p>Confirming your payment...</p>
  </div>

  <% } %>
</div>

<script>
(function() {
  var status = '<%= reg.payment_status %>';
  var kiosk = <%= kiosk ? 'true' : 'false' %>;
  var eventId = '<%= reg.ev_id %>';
  var sessionId = '<%= sessionId %>';

  // Poll if still pending
  if (status !== 'completed') {
    var attempts = 0;
    function poll() {
      attempts++;
      if (attempts > 15) {
        document.querySelector('.pending-spinner p').textContent = 'Payment received! Wristband will be assigned shortly. Please check with the booth.';
        return;
      }
      fetch('/event/status?session_id=' + encodeURIComponent(sessionId))
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.status === 'completed') { location.reload(); }
          else { setTimeout(poll, 2000); }
        })
        .catch(function() { setTimeout(poll, 3000); });
    }
    poll();
  }

  // Kiosk countdown
  if (status === 'completed' && kiosk) {
    var secs = 10;
    var el = document.getElementById('countdown');
    var timer = setInterval(function() {
      el.textContent = --secs;
      if (secs <= 0) {
        clearInterval(timer);
        window.location.href = '/event?event=' + eventId + '&kiosk=1';
      }
    }, 1000);
  }
})();
</script>
</body>
</html>
