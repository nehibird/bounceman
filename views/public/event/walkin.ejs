<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root { --bm-orange: #FF6B35; --bm-blue: #004E89; --bm-green: #2ECC71; }
    * { box-sizing: border-box; }
    body { font-family: 'Nunito', sans-serif; background: linear-gradient(135deg, #FF6B35 0%, #FF8F65 100%); min-height: 100vh; margin: 0; padding: 16px; }
    .walkin-container { max-width: 480px; margin: 0 auto; }
    .walkin-header { text-align: center; color: white; margin-bottom: 20px; padding-top: 10px; }
    .walkin-header h1 { font-size: 28px; font-weight: 800; margin: 0; text-shadow: 0 2px 4px rgba(0,0,0,0.2); }
    .walkin-header .event-name { font-size: 18px; opacity: 0.9; margin-top: 4px; }
    .walkin-header .price-badge { display: inline-block; background: white; color: var(--bm-orange); padding: 6px 20px; border-radius: 30px; font-weight: 800; font-size: 20px; margin-top: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.15); }
    .walkin-card { background: white; border-radius: 20px; padding: 24px; margin-bottom: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.12); }
    .walkin-card h6 { color: var(--bm-blue); font-weight: 700; margin-bottom: 16px; font-size: 15px; }
    .form-control, .form-select { border: 2px solid #e9ecef; border-radius: 12px; padding: 12px 16px; font-size: 16px; }
    .form-control:focus, .form-select:focus { border-color: var(--bm-orange); box-shadow: 0 0 0 3px rgba(255,107,53,0.15); }
    .form-label { font-weight: 600; color: #555; font-size: 14px; }
    .kid-stepper { display: flex; align-items: center; gap: 16px; }
    .kid-stepper button { width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--bm-blue); background: white; color: var(--bm-blue); font-size: 24px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
    .kid-stepper button:active { background: var(--bm-blue); color: white; }
    .kid-stepper .count { font-size: 36px; font-weight: 800; color: var(--bm-blue); min-width: 50px; text-align: center; }
    .kid-name-input { margin-top: 8px; }
    .waiver-box { max-height: 300px; overflow-y: auto; background: #f8f9fa; border-radius: 12px; padding: 16px; font-size: 12px; line-height: 1.6; color: #666; border: 1px solid #e9ecef; margin-bottom: 12px; }
    .sig-wrap { border: 2px dashed #ccc; border-radius: 12px; background: #fafafa; position: relative; margin-bottom: 12px; }
    .sig-wrap canvas { width: 100%; height: 150px; display: block; cursor: crosshair; touch-action: none; }
    .sig-placeholder { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); color: #bbb; font-size: 15px; pointer-events: none; }
    .total-bar { background: var(--bm-blue); color: white; border-radius: 16px; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; box-shadow: 0 4px 15px rgba(0,78,137,0.3); }
    .total-bar .label { font-size: 16px; font-weight: 600; }
    .total-bar .amount { font-size: 28px; font-weight: 800; }
    .btn-pay { background: linear-gradient(135deg, #2ECC71, #27AE60); color: white; border: none; border-radius: 16px; padding: 18px; font-size: 18px; font-weight: 700; width: 100%; box-shadow: 0 6px 20px rgba(46,204,113,0.4); transition: all 0.2s; }
    .btn-pay:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(46,204,113,0.5); color: white; }
    .btn-pay:disabled { background: #ccc; box-shadow: none; transform: none; }
    .error-msg { background: #fee2e2; color: #991b1b; border-radius: 12px; padding: 12px 16px; font-size: 14px; display: none; margin-bottom: 12px; }
    .loading { display: none; text-align: center; padding: 20px; color: white; font-size: 16px; }
    .payment-option { border: 2px solid #e9ecef; border-radius: 16px; padding: 16px; margin-bottom: 12px; cursor: pointer; transition: all 0.2s; text-align: left; background: white; width: 100%; }
    .payment-option:hover { border-color: var(--bm-orange); background: #fff8f5; }
    .payment-option.selected { border-color: var(--bm-orange); background: #fff3ed; box-shadow: 0 0 0 3px rgba(255,107,53,0.15); }
    .payment-option .opt-icon { font-size: 28px; margin-bottom: 4px; }
    .payment-option .opt-title { font-weight: 800; font-size: 16px; color: #333; }
    .payment-option .opt-desc { font-size: 13px; color: #888; margin-top: 2px; }
    .payment-option.selected .opt-title { color: var(--bm-orange); }
    @media (max-width: 380px) { body { padding: 10px; } .walkin-card { padding: 18px; } }
  </style>
</head>
<body>

<div class="walkin-container">

  <!-- Header -->
  <div class="walkin-header">
    <img src="/assets/images/navbar-wordmark.svg" alt="Bounce Man" style="height:50px;margin-bottom:6px;filter:drop-shadow(0 0 3px white) drop-shadow(0 0 3px white) drop-shadow(0 0 1px white)">
    <% if (selectedEvent) { %>
      <div class="event-name"><%= selectedEvent.name %></div>
      <% if (parseFloat(selectedEvent.price_per_kid) === 0) { %>
        <div class="price-badge" style="background:rgba(46,204,113,0.25);color:#1a7a4a">🎈 15 min free bounce</div>
      <% } else { %>
        <div class="price-badge">$<%= parseFloat(selectedEvent.price_per_kid).toFixed(0) %>/kid</div>
      <% } %>
    <% } else { %>
      <div class="event-name">Walk-Up Registration</div>
    <% } %>
  </div>

  <% if (!selectedEvent && events.length > 0) { %>
  <!-- Event Selector (iPad kiosk mode) -->
  <div class="walkin-card">
    <h6><i class="fas fa-calendar-alt me-2"></i>Select Event</h6>
    <select id="eventSelect" class="form-select">
      <option value="">Choose an event...</option>
      <% events.forEach(function(e) { %>
        <option value="<%= e.id %>" data-price="<%= e.price_per_kid %>"><%= e.name %> (<%= e.event_date %>) - $<%= parseFloat(e.price_per_kid).toFixed(0) %>/kid</option>
      <% }); %>
    </select>
  </div>
  <% } %>

  <% if (events.length === 0 && !selectedEvent) { %>
  <div class="walkin-card text-center">
    <i class="fas fa-calendar-times" style="font-size:48px;color:#ccc;margin-bottom:12px"></i>
    <h6>No Active Events</h6>
    <p class="text-muted small mb-0">Check back later or contact us at (580) 308-9288</p>
  </div>
  <% } %>

  <div id="formSection" style="<%= (selectedEvent || events.length === 0) ? '' : 'display:none' %>">

    <!-- Parent Info -->
    <div class="walkin-card">
      <h6><i class="fas fa-user me-2"></i>Parent / Guardian</h6>
      <div class="mb-3">
        <label class="form-label">Full Legal Name (Print) *</label>
        <input type="text" id="parentName" class="form-control" placeholder="First and last name" required>
      </div>
      <% if (!prefillPhone) { %>
      <div>
        <label class="form-label">Phone Number <span class="text-muted">(optional)</span></label>
        <input type="tel" id="parentPhone" class="form-control" placeholder="(580) 555-0123">
      </div>
      <% } else { %>
      <input type="hidden" id="parentPhone" value="<%= prefillPhone %>">
      <% } %>
    </div>

    <!-- Kids -->
    <div class="walkin-card">
      <h6><i class="fas fa-child me-2"></i>Kids</h6>
      <div class="text-center mb-3">
        <div class="kid-stepper justify-content-center">
          <button type="button" id="kidMinus">-</button>
          <div class="count" id="kidCount">1</div>
          <button type="button" id="kidPlus">+</button>
        </div>
      </div>
      <div id="kidNamesList">
        <div class="kid-name-input d-flex gap-2">
          <input type="text" class="form-control form-control-sm" placeholder="Kid 1 name" data-kid="1" style="flex:2">
          <input type="number" class="form-control form-control-sm" placeholder="Age" data-kid-age="1" min="1" max="17" style="flex:1">
        </div>
      </div>
    </div>

    <!-- Waiver -->
    <div class="walkin-card">
      <h6><i class="fas fa-file-contract me-2"></i>Release of Liability</h6>
      <div style="background:#fff3cd;border-radius:8px;padding:10px 12px;font-size:11px;font-weight:700;color:#856404;margin-bottom:10px">
        ⚠️ PLEASE READ CAREFULLY — THIS IS A LEGALLY BINDING DOCUMENT. DO NOT SIGN UNLESS YOU HAVE READ AND FULLY UNDERSTAND EACH SECTION.
      </div>
      <div class="waiver-box">
        <strong>BOUNCE MAN LLC — PARTICIPANT AGREEMENT, ASSUMPTION OF RISK, AND RELEASE OF LIABILITY</strong><br><br>
        <em>Bounce Man LLC is registered with and annually inspected by the Oklahoma Department of Labor, Amusement Ride Safety Division, and carries the required minimum liability insurance coverage.</em><br><br>

        <strong>1. ASSUMPTION OF RISK</strong><br>
        I understand and acknowledge that participation in inflatable amusement activities involves inherent and unavoidable risks of physical injury. These risks include, but are not limited to: falls, trips, and loss of balance during bouncing; collisions with other participants or with the walls, floor, or structure of the inflatable unit; sprains, strains, bruises, and fractures; overexertion and heat-related illness; injury caused by another participant's actions; and sudden deflation of the inflatable unit. I understand these are inherent risks of the activity itself and <strong>I voluntarily accept and assume all inherent risks of participation on behalf of myself and my child(ren).</strong><br><br>

        <strong>2. PARENT / GUARDIAN RESPONSIBILITY</strong><br>
        I am solely responsible for the supervision of my child(ren) at all times during this event and must remain on the premises and be immediately reachable. Bounce Man LLC personnel manage the safe operation of the equipment only — they are not providing individual childcare or continuous monitoring of any individual participant. I accept full responsibility for my child(ren)'s behavior and physical readiness to participate.<br><br>

        <strong>3. SAFETY RULES</strong><br>
        I agree that my child(ren) will comply with all safety rules at all times: no shoes inside the inflatable; no food, drinks, or gum; no sharp objects or jewelry; no rough play, wrestling, or flipping; no climbing on walls or netting; observe posted capacity limits; no participation if ill or injured; exit immediately if instructed by staff. Failure to follow rules may result in removal without refund. If my child(ren) violate these rules and an injury results, <strong>I bear comparative fault for that injury.</strong><br><br>

        <strong>4. HEALTH AND FITNESS REPRESENTATION</strong><br>
        I represent that my child(ren) are in good physical health and have no known medical conditions, orthopedic limitations, or physical impairments that would make inflatable activity unsafe or inadvisable. If any such condition exists, I will not permit my child(ren) to participate.<br><br>

        <strong>5. RELEASE OF LIABILITY</strong><br>
        To the fullest extent permitted by applicable law, <strong>I hereby release, waive, and discharge Bounce Man LLC, its owners, officers, employees, agents, volunteers, and representatives</strong> ("Released Parties") from any and all liability, claims, demands, causes of action, or losses — whether known or unknown — arising out of or related to my child(ren)'s participation in this event, including claims arising from the <strong>ordinary negligence</strong> of the Released Parties. This includes claims for personal injury, bodily injury, property damage, and all resulting damages. <strong>This release does not apply to gross negligence, willful misconduct, or intentional acts.</strong> To the extent permitted by Oklahoma law, I execute this release on behalf of my minor child(ren). I acknowledge that Oklahoma law may limit the enforceability of a parental release of a minor's claims, and I intend this release to operate to the maximum extent the law permits.<br><br>

        <strong>6. INDEMNIFICATION</strong><br>
        I agree to indemnify, defend, and hold harmless the Released Parties from any and all claims, suits, damages, costs, and attorneys' fees brought by any person arising from: my own negligence or misconduct; my child(ren)'s failure to follow safety rules; any misrepresentation I have made; or any act or omission by me or any person under my care during the event.<br><br>

        <strong>7. MEDICAL AUTHORIZATION</strong><br>
        In the event my child requires emergency medical attention and I cannot be immediately reached, I authorize Bounce Man LLC personnel to contact emergency medical services (911) on my child's behalf and consent to emergency medical treatment being administered by qualified medical personnel.<br><br>

        <strong>8. PHOTO AND VIDEO CONSENT</strong><br>
        I consent to photographs and video recordings being taken of my child(ren) and myself during this event for use by Bounce Man LLC in promotional materials, social media, and marketing. To opt out, notify a staff member before participation begins.<br><br>

        <strong>9. GOVERNING LAW AND SEVERABILITY</strong><br>
        This agreement is governed by the laws of the State of Oklahoma. If any provision is found unenforceable, the remaining provisions remain in full force and effect.<br><br>

        This agreement is binding on myself, my heirs, executors, and legal representatives.
      </div>

      <!-- Signature Canvas -->
      <div class="sig-wrap">
        <canvas id="sigCanvas" width="720" height="150"></canvas>
        <div class="sig-placeholder" id="sigPlaceholder"><i class="fas fa-pen me-1"></i>Sign here</div>
      </div>
      <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="agreeCheck">
          <label class="form-check-label small" for="agreeCheck">I confirm I have read, understand, and agree to all sections above. I am the parent or legal guardian of the child(ren) named and am at least 18 years of age.</label>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ms-2" style="white-space:nowrap" id="clearSigBtn">
          <i class="fas fa-eraser me-1"></i>Clear
        </button>
      </div>
    </div>

    <!-- SMS Consent -->
    <div class="walkin-card">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="smsConsent">
        <label class="form-check-label small" for="smsConsent" style="color:#666">
          I agree to receive text messages from Bounce Man LLC regarding this event and future events. Msg &amp; data rates may apply. Reply STOP to opt out.
          <a href="/privacy" target="_blank" style="color:var(--bm-orange)">Privacy Policy</a>
        </label>
      </div>
    </div>

    <!-- Payment Method -->
    <% var hasMultiple = (selectedEvent && (selectedEvent.allow_card + selectedEvent.allow_cash + selectedEvent.allow_google_review) > 1); %>
    <% if (selectedEvent && (selectedEvent.allow_card || selectedEvent.allow_cash || selectedEvent.allow_google_review)) { %>
    <div class="walkin-card">
      <h6><i class="fas fa-credit-card me-2"></i>How would you like to pay?</h6>
      <% if (selectedEvent.allow_card) { %>
      <button type="button" class="payment-option" data-method="card">
        <div class="opt-icon">💳</div>
        <div class="opt-title">Pay by Card — $<%= parseFloat(selectedEvent.price_per_kid).toFixed(0) %>/kid</div>
        <div class="opt-desc">Secure checkout via Stripe</div>
      </button>
      <% } %>
      <% if (selectedEvent.allow_cash) { %>
      <button type="button" class="payment-option" data-method="cash">
        <div class="opt-icon">💵</div>
        <div class="opt-title">Pay Cash at the Booth</div>
        <div class="opt-desc">Bring $<%= parseFloat(selectedEvent.price_per_kid).toFixed(0) %>/kid when you check in</div>
      </button>
      <% } %>
      <% if (selectedEvent.allow_google_review) { %>
      <button type="button" class="payment-option" data-method="google_review">
        <div class="opt-icon">⭐</div>
        <div class="opt-title">Google Review — Free Admission</div>
        <div class="opt-desc">Write a Google review, show us your phone, and get a child admission for 15 minutes</div>
      </button>
      <% } %>
    </div>
    <% } %>

    <!-- Total & Pay -->
    <div class="total-bar" id="totalBar">
      <div class="label">Total</div>
      <div class="amount" id="totalAmount">$0</div>
    </div>

    <div class="error-msg" id="errorMsg"></div>
    <div class="loading" id="loadingMsg"><i class="fas fa-spinner fa-spin me-2"></i>Processing...</div>

    <button class="btn-pay" id="payBtn" disabled>
      <i class="fas fa-lock me-2"></i><span id="payBtnLabel">Register</span>
    </button>

    <p id="stripeFooter" class="text-center text-white small mt-3" style="opacity:0.7;display:none">
      <i class="fas fa-shield-alt me-1"></i>Secure payment via Stripe
    </p>

  </div>
</div>

<script>
(function() {
  var kidCount = 1;
  var pricePerKid = <%= selectedEvent ? selectedEvent.price_per_kid : 0 %>;
  var eventId = '<%= selectedEvent ? selectedEvent.id : '' %>';
  var isKiosk = <%= kiosk ? 'true' : 'false' %>;
  var hasSigned = false;
  var selectedMethod = null;
  var allowCard = <%= selectedEvent && selectedEvent.allow_card ? 'true' : 'false' %>;
  var allowCash = <%= selectedEvent && selectedEvent.allow_cash ? 'true' : 'false' %>;
  var allowGoogleReview = <%= selectedEvent && selectedEvent.allow_google_review ? 'true' : 'false' %>;
  var onlyOneMethod = [allowCard, allowCash, allowGoogleReview].filter(Boolean).length === 1;

  // Auto-select if only one payment method
  if (onlyOneMethod) {
    if (allowCard) selectedMethod = 'card';
    else if (allowCash) selectedMethod = 'cash';
    else if (allowGoogleReview) selectedMethod = 'google_review';
  }

  // Event selector (iPad kiosk)
  window.selectEvent = function(id) {
    if (!id) { document.getElementById('formSection').style.display = 'none'; return; }
    var opt = document.querySelector('#eventSelect option[value="' + id + '"]');
    pricePerKid = parseFloat(opt.dataset.price);
    eventId = id;
    document.getElementById('formSection').style.display = '';
    updateTotal();
  };

  // Kid count stepper
  window.changeKidCount = function(delta) {
    kidCount = Math.max(1, Math.min(20, kidCount + delta));
    document.getElementById('kidCount').textContent = kidCount;
    var list = document.getElementById('kidNamesList');
    list.innerHTML = '';
    for (var i = 1; i <= kidCount; i++) {
      var div = document.createElement('div');
      div.className = 'kid-name-input d-flex gap-2';
      div.innerHTML = '<input type="text" class="form-control form-control-sm" placeholder="Kid ' + i + ' name" data-kid="' + i + '" style="flex:2"><input type="number" class="form-control form-control-sm" placeholder="Age" data-kid-age="' + i + '" min="1" max="17" style="flex:1">';
      list.appendChild(div);
    }
    updateTotal();
  };

  function updateTotal() {
    var totalEl = document.getElementById('totalAmount');
    var totalBar = document.getElementById('totalBar');
    if (selectedMethod === 'google_review') {
      totalEl.textContent = 'FREE';
      totalBar.style.background = 'linear-gradient(135deg,#2ECC71,#27AE60)';
    } else if (selectedMethod === 'cash') {
      totalEl.textContent = '$' + (kidCount * pricePerKid).toFixed(0) + ' cash';
      totalBar.style.background = '';
    } else {
      totalEl.textContent = '$' + (kidCount * pricePerKid).toFixed(0);
      totalBar.style.background = '';
    }
    updatePayBtn();
  }

  // Signature canvas
  var canvas = document.getElementById('sigCanvas');
  var ctx = canvas.getContext('2d');
  var drawing = false;
  var placeholder = document.getElementById('sigPlaceholder');

  function resizeCanvas() {
    var rect = canvas.getBoundingClientRect();
    var dpr = window.devicePixelRatio || 1;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
    ctx.lineWidth = 2;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = '#333';
  }
  resizeCanvas();
  window.addEventListener('resize', function() { if (!hasSigned) resizeCanvas(); });

  function getPos(e) {
    var rect = canvas.getBoundingClientRect();
    var cx, cy;
    if (e.touches && e.touches.length > 0) { cx = e.touches[0].clientX; cy = e.touches[0].clientY; }
    else { cx = e.clientX; cy = e.clientY; }
    return { x: cx - rect.left, y: cy - rect.top };
  }
  function startDraw(e) { e.preventDefault(); drawing = true; var p = getPos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); }
  function draw(e) { if (!drawing) return; e.preventDefault(); var p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); hasSigned = true; placeholder.style.display = 'none'; updatePayBtn(); }
  function stopDraw(e) { if (drawing) { e.preventDefault(); drawing = false; } }

  canvas.addEventListener('mousedown', startDraw);
  canvas.addEventListener('mousemove', draw);
  canvas.addEventListener('mouseup', stopDraw);
  canvas.addEventListener('mouseleave', stopDraw);
  canvas.addEventListener('touchstart', startDraw, { passive: false });
  canvas.addEventListener('touchmove', draw, { passive: false });
  canvas.addEventListener('touchend', stopDraw, { passive: false });
  canvas.addEventListener('touchcancel', stopDraw, { passive: false });

  window.clearSig = function() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    hasSigned = false;
    placeholder.style.display = 'block';
    updatePayBtn();
  };

  // Payment option selection
  document.querySelectorAll('.payment-option').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.payment-option').forEach(function(b) { b.classList.remove('selected'); });
      btn.classList.add('selected');
      selectedMethod = btn.dataset.method;
      updateTotal();
    });
  });

  // Auto-select highlight if only one method
  if (onlyOneMethod) {
    var autoBtn = document.querySelector('.payment-option[data-method="' + selectedMethod + '"]');
    if (autoBtn) autoBtn.classList.add('selected');
  }

  // Pay button state
  var agreeCheck = document.getElementById('agreeCheck');
  agreeCheck.addEventListener('change', updatePayBtn);

  function updatePayBtn() {
    var btn = document.getElementById('payBtn');
    var labelEl = document.getElementById('payBtnLabel');
    var name = document.getElementById('parentName').value.trim();
    var needMethod = (allowCard || allowCash || allowGoogleReview) && !onlyOneMethod;
    var ready = hasSigned && agreeCheck.checked && name && eventId && (!needMethod || selectedMethod);
    btn.disabled = !ready;

    if (selectedMethod === 'cash') {
      labelEl.textContent = 'Register — Pay Cash at Booth';
      btn.style.background = 'linear-gradient(135deg,#004E89,#0066b3)';
    } else if (selectedMethod === 'google_review') {
      labelEl.textContent = 'Register — Show Us Your Review';
      btn.style.background = 'linear-gradient(135deg,#f59e0b,#d97706)';
    } else {
      labelEl.textContent = 'Pay & Register';
      btn.style.background = '';
    }
    document.getElementById('stripeFooter').style.display = selectedMethod === 'card' ? 'block' : 'none';
  }
  document.getElementById('parentName').addEventListener('input', updatePayBtn);

  // Submit
  window.submitAndPay = function() {
    var name = document.getElementById('parentName').value.trim();
    if (!name) { showError('Please enter your name.'); return; }
    if (!hasSigned) { showError('Please sign the waiver.'); return; }
    if (!agreeCheck.checked) { showError('Please agree to the waiver.'); return; }
    if (!eventId) { showError('Please select an event.'); return; }
    if ((allowCard || allowCash || allowGoogleReview) && !onlyOneMethod && !selectedMethod) { showError('Please select a payment method.'); return; }

    var kidNames = [];
    var kidAges = [];
    document.querySelectorAll('#kidNamesList [data-kid]').forEach(function(inp) {
      kidNames.push(inp.value.trim() || ('Kid ' + inp.dataset.kid));
    });
    document.querySelectorAll('#kidNamesList [data-kid-age]').forEach(function(inp) {
      kidAges.push(inp.value.trim() || '');
    });

    var btn = document.getElementById('payBtn');
    btn.disabled = true;
    document.getElementById('loadingMsg').style.display = 'block';
    document.getElementById('errorMsg').style.display = 'none';

    var sigData = canvas.toDataURL('image/png');
    var method = selectedMethod || (allowCard ? 'card' : allowCash ? 'cash' : 'google_review');

    fetch('/event/pay', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        event_id: eventId,
        parent_name: name,
        parent_phone: document.getElementById('parentPhone').value.trim(),
        kid_count: kidCount,
        kid_names: kidNames,
        kid_ages: kidAges,
        waiver_signature: sigData,
        waiver_version: 'v2-2026-05-15',
        payment_method: method,
        kiosk: isKiosk
      })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.url) {
        window.location.href = data.url;
      } else {
        throw new Error(data.error || 'Payment setup failed');
      }
    })
    .catch(function(err) {
      showError(err.message);
      btn.disabled = false;
      document.getElementById('loadingMsg').style.display = 'none';
    });
  };

  function showError(msg) {
    var el = document.getElementById('errorMsg');
    el.textContent = msg;
    el.style.display = 'block';
  }

  // Phone formatting
  document.getElementById('parentPhone').addEventListener('input', function(e) {
    var val = e.target.value.replace(/\D/g, '');
    if (val.length >= 6) { e.target.value = '(' + val.substring(0,3) + ') ' + val.substring(3,6) + '-' + val.substring(6,10); }
    else if (val.length >= 3) { e.target.value = '(' + val.substring(0,3) + ') ' + val.substring(3); }
  });

  // Init
  updateTotal();

  var evtSel = document.getElementById('eventSelect');
  if (evtSel) { evtSel.addEventListener('change', function() { window.selectEvent(this.value); }); }

  document.getElementById('kidMinus').addEventListener('click', function() { window.changeKidCount(-1); });
  document.getElementById('kidPlus').addEventListener('click', function() { window.changeKidCount(1); });
  document.getElementById('clearSigBtn').addEventListener('click', function() { window.clearSig(); });
  document.getElementById('payBtn').addEventListener('click', function() { window.submitAndPay(); });

})();
</script>
</body>
</html>
