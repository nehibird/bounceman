<%- include('../layouts/public', { body: `

<section class="py-5">
  <div class="container">
    <style>
      .equipment-h1 { font-size:38px; font-weight:700; color:var(--bm-blue); position:relative; display:inline-block; margin:0; }
      .equipment-h1::after { content:''; display:block; width:60px; height:4px; background:var(--bm-orange); margin:12px auto 0; border-radius:2px; }
      @media (max-width: 768px) { .equipment-h1 { font-size:30px; } }
    </style>
    <div class="section-title">
      <h1 class="equipment-h1">Bounce House &amp; Water Slide Rentals in Kay County, OK</h1>
      <p>Browse our inventory and find the perfect rental for your event</p>
    </div>

    <!-- Category Filter -->
    <div class="text-center mb-4">
      <a href="/equipment" class="btn ${activeCategory === 'all' ? 'btn-bm' : 'btn-outline-secondary'} rounded-pill m-1">All</a>
      ${categories.map(c => `
        <a href="/equipment?category=${c.slug}" class="btn ${activeCategory === c.slug ? 'btn-bm' : 'btn-outline-secondary'} rounded-pill m-1">${c.name}</a>
      `).join('')}
    </div>

    <div class="row g-4">
      ${equipment.length > 0 ? equipment.map(item => `
      <div class="col-md-6 col-lg-4">
        <a href="/equipment/${item.slug}" style="text-decoration:none;color:inherit;display:block">
          <div class="equipment-card">
            <img src="${item.image || '/assets/images/placeholder-bounce.svg'}" class="card-img-top" alt="${item.name}" style="${(item.category === 'add_ons' || item.category === 'add-ons') ? 'object-fit:contain;padding:20px;background:#f8f8f8' : ''}">
            <div class="card-body">
              <span class="badge-category mb-2">${(item.category || '').replace(/[-_]/g, ' ')}</span>${(item.category === 'water_slides' || item.category === 'water-slides' || item.category === 'combo_units' || item.category === 'combo-units' || (item.price_wet !== null && item.price_wet !== undefined && item.price_wet !== '')) ? ' <span style="background:#2563eb;color:white;font-weight:600;padding:3px 10px;border-radius:20px;font-size:11px"><i class="fas fa-tint me-1"></i>Wet / Dry</span>' : ''}
              <h5 class="card-title mt-2">${item.name}${item.quantity > 1 ? ' <span style="background:#059669;color:white;font-weight:600;padding:2px 8px;border-radius:20px;font-size:11px;vertical-align:middle">x' + item.quantity + ' Available</span>' : ''}</h5>
              <p class="text-muted small mb-2">${item.short_description || ''}</p>
              ${item.dimensions ? '<div class="small text-muted mb-3"><i class="fas fa-ruler-combined me-1"></i>' + item.dimensions + '</div>' : ''}
              <div class="d-flex justify-content-between align-items-center">
                <span class="price-tag">From $${parseFloat(item.full_day_only ? item.price_daily : (item.price_4hr || item.price_daily * 0.65)).toFixed(0)}</span>
                <span class="btn btn-sm btn-outline-primary rounded-pill">Details <i class="fas fa-arrow-right ms-1"></i></span>
              </div>
              <div style="font-size:11px;color:#059669;font-weight:600;margin-top:4px"><i class="fas fa-truck me-1"></i>FREE delivery in Kay County</div>
            </div>
          </div>
        </a>
      </div>
      `).join('') : `
      <div class="col-12 text-center py-5">
        <div style="font-size:80px;opacity:0.3">🎪</div>
        <h4 class="text-muted">No equipment available yet</h4>
        <p class="text-muted">Check back soon — we're adding inventory!</p>
      </div>
      `}
    </div>

    <!-- Equipment request / wishlist card -->
    <div class="row mt-5">
      <div class="col-lg-8 mx-auto">
        <div id="suggestCard" class="bg-white rounded-4 shadow-sm p-4 p-md-5 text-center" style="border:2px dashed #e6cbb0">
          <div id="suggestMain">
            <div style="font-size:44px">🔎</div>
            <h4 style="color:var(--bm-blue);font-weight:700;margin-top:6px">Not finding what you're looking for?</h4>
            <p class="text-muted" style="max-width:520px;margin:6px auto 18px">Tell us what you'd love to rent and we'll take your feedback into consideration as we grow our lineup.</p>
            <form id="suggestForm" class="row g-2 justify-content-center" style="max-width:560px;margin:0 auto">
              <div class="col-12">
                <input type="text" class="form-control form-control-lg" id="suggestInput" name="suggestion" maxlength="300" placeholder="e.g. a foam pit, dunk tank, 40ft obstacle course..." required>
              </div>
              <div class="col-12 col-sm-8">
                <input type="email" class="form-control" id="suggestEmail" name="email" maxlength="254" placeholder="Your email (optional)" autocomplete="email">
              </div>
              <div class="col-12 col-sm-4 d-grid">
                <button type="submit" class="btn btn-book-now" id="suggestBtn">Send</button>
              </div>
            </form>
          </div>
          <div id="suggestThanks" style="display:none">
            <div style="font-size:44px">🎉</div>
            <h4 style="color:var(--bm-blue);font-weight:700">Thanks for the idea!</h4>
            <p class="text-muted mb-0">We appreciate the feedback and will keep it in mind as we add inventory.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

`, scripts: `
<script>
if (typeof fbq !== "undefined" && document.querySelector("script[src*=fbevents]")) {
  fbq('track', 'ViewContent', { content_name: 'Equipment', content_type: 'product' });
}
(function() {
  var form = document.getElementById('suggestForm');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var btn = document.getElementById('suggestBtn');
    var suggestion = document.getElementById('suggestInput').value.trim();
    if (!suggestion) return;
    btn.disabled = true; btn.textContent = 'Sending...';
    fetch('/equipment/suggest', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ suggestion: suggestion, email: document.getElementById('suggestEmail').value.trim() })
    }).then(function(r) { return r.json(); }).then(function() {
      document.getElementById('suggestMain').style.display = 'none';
      document.getElementById('suggestThanks').style.display = '';
    }).catch(function() {
      btn.disabled = false; btn.textContent = 'Send';
      if (typeof showToast === 'function') showToast('Something went wrong — please try again.', 'error');
      else alert('Something went wrong — please try again.');
    });
  });
})();
</script>
` }) %>
