<%- include('../layouts/public', { body: `

<!-- Contact Hero -->
<section class="hero-section" style="padding:60px 0">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <h1>Get In <span>Touch</span></h1>
        <p>Have a question or ready to book? We would love to hear from you!</p>
      </div>
      <div class="col-lg-5 d-none d-lg-block text-center">
        <div style="font-size:140px;opacity:0.3">📞</div>
      </div>
    </div>
  </div>
</section>

<!-- Contact Content -->
<section class="py-5">
  <div class="container py-4">

    ${typeof success !== 'undefined' && success ? '<div class="alert alert-success alert-dismissible fade show mb-4" role="alert"><i class="fas fa-check-circle me-2"></i>' + success + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>' : ''}

    <div class="row g-5">
      <!-- Contact Form -->
      <div class="col-lg-7">
        <div style="background:white;border-radius:20px;padding:40px;box-shadow:0 8px 30px rgba(0,0,0,0.08)">
          <h3 style="color:var(--bm-blue);font-weight:700;margin-bottom:8px">Send Us a Message</h3>
          <p style="color:#666;margin-bottom:30px">Fill out the form below and we will get back to you within 24 hours.</p>

          <form action="/contact" method="POST">
            <!-- Honeypot + timing (spam protection) -->
            <div style="position:absolute;left:-9999px;top:-9999px" aria-hidden="true">
              <input type="text" name="website_url" tabindex="-1" autocomplete="off">
            </div>
            <input type="hidden" name="_ts" value="">
            <script>document.querySelector('input[name="_ts"]').value=Date.now();</script>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="cf-name" class="form-label fw-bold" style="color:var(--bm-blue)">Your Name <span style="color:var(--bm-pink)">*</span></label>
                <div class="input-group">
                  <span class="input-group-text" style="background:var(--bm-light-bg);border-right:none"><i class="fas fa-user" style="color:var(--bm-orange)"></i></span>
                  <input type="text" id="cf-name" name="name" class="form-control" placeholder="John Smith" required style="border-left:none;border-radius:0 8px 8px 0">
                </div>
              </div>
              <div class="col-md-6">
                <label for="cf-email" class="form-label fw-bold" style="color:var(--bm-blue)">Email Address <span style="color:var(--bm-pink)">*</span></label>
                <div class="input-group">
                  <span class="input-group-text" style="background:var(--bm-light-bg);border-right:none"><i class="fas fa-envelope" style="color:var(--bm-orange)"></i></span>
                  <input type="email" id="cf-email" name="email" class="form-control" placeholder="you@email.com" required style="border-left:none;border-radius:0 8px 8px 0">
                </div>
              </div>
              <div class="col-md-6">
                <label for="cf-phone" class="form-label fw-bold" style="color:var(--bm-blue)">Phone Number</label>
                <div class="input-group">
                  <span class="input-group-text" style="background:var(--bm-light-bg);border-right:none"><i class="fas fa-phone" style="color:var(--bm-orange)"></i></span>
                  <input type="tel" id="cf-phone" name="phone" class="form-control" placeholder="(405) 555-1234" style="border-left:none;border-radius:0 8px 8px 0">
                </div>
                <small class="text-muted" style="font-size:12px">Leave a number and we'll text you right back. Msg &amp; data rates may apply; reply STOP to opt out.</small>
              </div>
              <div class="col-md-6">
                <label for="eventDatePicker" class="form-label fw-bold" style="color:var(--bm-blue)">Event Date</label>
                <div class="input-group">
                  <span class="input-group-text" style="background:var(--bm-light-bg);border-right:none"><i class="fas fa-calendar" style="color:var(--bm-orange)"></i></span>
                  <input type="text" name="event_date" id="eventDatePicker" class="form-control" placeholder="Select a date" style="border-left:none;border-radius:0 8px 8px 0">
                </div>
              </div>
              <div class="col-12">
                <label for="cf-message" class="form-label fw-bold" style="color:var(--bm-blue)">Message <span style="color:var(--bm-pink)">*</span></label>
                <textarea id="cf-message" name="message" class="form-control" rows="5" placeholder="Tell us about your event — date, location, number of guests, what you are looking for..." required style="border-radius:8px"></textarea>
              </div>
              <div class="col-12">
                <label class="form-label fw-bold" style="color:var(--bm-blue)">Are you a human? <span style="color:var(--bm-pink)">*</span></label>
                <div class="d-flex align-items-center gap-3">
                  <span id="captcha-q" style="font-size:18px;font-weight:700;color:var(--bm-blue);white-space:nowrap"></span>
                  <input type="hidden" name="_captcha_answer" id="captcha-a">
                  <input type="number" name="captcha" class="form-control" placeholder="Your answer" required style="border-radius:8px;max-width:140px">
                </div>
                <small class="text-muted">Solve the math problem to prove you are not a robot</small>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-book-now btn-lg w-100" style="padding:14px">
                  <i class="fas fa-paper-plane me-2"></i>Send Message
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="col-lg-5">
        <div class="d-flex flex-column gap-4">

          <!-- Phone -->
          <div style="background:white;border-radius:20px;padding:30px;box-shadow:0 8px 30px rgba(0,0,0,0.08);display:flex;align-items:center;gap:20px">
            <div style="width:60px;height:60px;border-radius:50%;background:var(--bm-gradient);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <i class="fas fa-phone" style="font-size:24px;color:white"></i>
            </div>
            <div>
              <h6 style="color:var(--bm-blue);font-weight:700;margin-bottom:4px">Phone</h6>
              <a href="tel:${settings.company_phone || ''}" style="color:var(--bm-orange);font-weight:600;text-decoration:none;font-size:18px">${settings.company_phone || 'Coming soon'}</a>
              <p style="color:#999;font-size:13px;margin:4px 0 0">Call or text anytime</p>
            </div>
          </div>

          <!-- Email -->
          <div style="background:white;border-radius:20px;padding:30px;box-shadow:0 8px 30px rgba(0,0,0,0.08);display:flex;align-items:center;gap:20px">
            <div style="width:60px;height:60px;border-radius:50%;background:var(--bm-gradient);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <i class="fas fa-envelope" style="font-size:24px;color:white"></i>
            </div>
            <div>
              <h6 style="color:var(--bm-blue);font-weight:700;margin-bottom:4px">Email</h6>
              <a href="mailto:${settings.company_email || ''}" style="color:var(--bm-orange);font-weight:600;text-decoration:none;font-size:16px">${settings.company_email || ''}</a>
              <p style="color:#999;font-size:13px;margin:4px 0 0">We reply within 24 hours</p>
            </div>
          </div>

          <!-- Address -->
          <div style="background:white;border-radius:20px;padding:30px;box-shadow:0 8px 30px rgba(0,0,0,0.08);display:flex;align-items:center;gap:20px">
            <div style="width:60px;height:60px;border-radius:50%;background:var(--bm-gradient);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <i class="fas fa-map-marker-alt" style="font-size:24px;color:white"></i>
            </div>
            <div>
              <h6 style="color:var(--bm-blue);font-weight:700;margin-bottom:4px">Address</h6>
              <p style="color:#555;font-weight:600;margin:0">113 N Barrick Way</p>
              <p style="color:#555;margin:0">Tonkawa, OK 74653</p>
            </div>
          </div>

          <!-- Business Hours -->
          <div style="background:white;border-radius:20px;padding:30px;box-shadow:0 8px 30px rgba(0,0,0,0.08);display:flex;align-items:center;gap:20px">
            <div style="width:60px;height:60px;border-radius:50%;background:var(--bm-gradient);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <i class="fas fa-clock" style="font-size:24px;color:white"></i>
            </div>
            <div>
              <h6 style="color:var(--bm-blue);font-weight:700;margin-bottom:4px">Business Hours</h6>
              <p style="color:#555;font-weight:600;margin:0">Every day, including Sunday</p>
              <p style="color:#555;margin:0">8:00 AM - 8:00 PM</p>
              <p style="color:#999;font-size:13px;margin:4px 0 0">Open year-round</p>
            </div>
          </div>

          <!-- Quick Note -->
          <div style="background:var(--bm-gradient-cool);border-radius:20px;padding:25px;color:white;text-align:center">
            <i class="fas fa-bolt" style="font-size:28px;margin-bottom:10px;color:var(--bm-yellow)"></i>
            <h6 style="font-weight:700;margin-bottom:8px">Need a Quick Quote?</h6>
            <p style="opacity:0.85;font-size:14px;margin-bottom:15px">Tell us your event date, location, and guest count for an instant estimate.</p>
            <a href="/booking" class="btn btn-sm rounded-pill px-4" style="background:white;color:var(--bm-blue);font-weight:700">Start Booking <i class="fas fa-arrow-right ms-1"></i></a>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

`, scripts: '<script>flatpickr("#eventDatePicker", { minDate: "today", dateFormat: "Y-m-d", disableMobile: true });(function(){var a=Math.floor(Math.random()*10)+1,b=Math.floor(Math.random()*10)+1;document.getElementById("captcha-q").textContent="What is "+a+" + "+b+"?";document.getElementById("captcha-a").value=String(a+b);})();</script>' }) %>