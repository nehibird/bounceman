<%- include('../layouts/public', { body: `

${(function() {
  var baseUrl = 'https://bouncemanrentals.com';
  var escJson = function(obj) { return JSON.stringify(obj).replace(/</g, '\\u003c'); };
  var stripHtml = function(html) { return (html || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim(); };

  var primaryImage = images.find(function(i) { return i.is_primary; }) || images[0];
  var imageUrl = primaryImage ? baseUrl + primaryImage.image_path : baseUrl + '/assets/images/placeholder-bounce.svg';
  var price = item.price_daily || item.price_4hr || 0;

  var productSchema = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: item.name,
    description: stripHtml(item.description) || item.short_description || item.name,
    image: imageUrl,
    sku: item.id,
    category: (item.category || '').replace(/[-_]/g, ' '),
    brand: { '@type': 'Brand', name: 'Bounce Man Rentals' },
    offers: {
      '@type': 'Offer',
      url: baseUrl + '/equipment/' + item.slug,
      priceCurrency: 'USD',
      price: parseFloat(price).toFixed(2),
      availability: item.status === 'available' ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      itemCondition: 'https://schema.org/NewCondition'
    }
  };

  if (reviews && reviews.length > 0) {
    var totalRating = 0;
    for (var i = 0; i < reviews.length; i++) totalRating += reviews[i].rating;
    var avgRating = totalRating / reviews.length;
    productSchema.aggregateRating = {
      '@type': 'AggregateRating',
      ratingValue: avgRating.toFixed(1),
      reviewCount: reviews.length,
      bestRating: 5,
      worstRating: 1
    };
    productSchema.review = reviews.slice(0, 5).map(function(r) {
      return {
        '@type': 'Review',
        author: { '@type': 'Person', name: r.customer_name || 'Happy Customer' },
        reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5, worstRating: 1 },
        reviewBody: r.comment || '',
        datePublished: r.created_at || undefined
      };
    });
  }

  var breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: baseUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Equipment', item: baseUrl + '/equipment' },
      { '@type': 'ListItem', position: 3, name: item.name, item: baseUrl + '/equipment/' + item.slug }
    ]
  };

  return '<script type="application/ld+json">' + escJson(productSchema) + '</script>' +
         '<script type="application/ld+json">' + escJson(breadcrumbSchema) + '</script>';
})()}

<!-- Breadcrumb -->
<section class="py-3" style="background:white;border-bottom:1px solid #eee">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0" style="font-size:14px">
        <li class="breadcrumb-item"><a href="/" style="color:var(--bm-blue)">Home</a></li>
        <li class="breadcrumb-item"><a href="/equipment" style="color:var(--bm-blue)">Equipment</a></li>
        <li class="breadcrumb-item active" aria-current="page">${item.name}</li>
      </ol>
    </nav>
  </div>
</section>

<!-- Equipment Detail -->
<section class="py-5">
  <div class="container">
    <div class="row g-5">

      <!-- Left Column: Image Gallery -->
      <div class="col-lg-7">
        <div class="bg-white rounded-4 overflow-hidden shadow-sm">
          <div id="mainImageWrap" style="position:relative;width:100%;padding-top:66%;overflow:hidden;background:#f0f0f0">
            <img id="mainImage"
              src="${images.length > 0 ? images.find(i => i.is_primary)?.image_path || images[0].image_path : '/assets/images/placeholder-bounce.svg'}"
              alt="${item.name}"
              style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:${(item.category === 'add_ons' || item.category === 'add-ons') ? 'contain;background:#f8f9fa;padding:30px' : 'cover'}">
          </div>
          ${images.length > 1 ? `
          <div class="d-flex gap-2 p-3 flex-wrap" id="thumbRow">
            ${images.map((img, i) => `
              <img src="${img.image_path}" alt="${img.image_path.includes('rules-card') ? 'What we need on delivery day: power within 50 ft, flat grass or hard surface, an adult supervising, and a flat $50 deposit — delivery, setup and takedown included' : item.name + ' photo ' + (i + 1)}"
                class="img-thumb" data-src="${img.image_path}"
                style="width:80px;height:60px;object-fit:cover;border-radius:8px;cursor:pointer;border:3px solid ${img.is_primary ? 'var(--bm-orange)' : 'transparent'};opacity:${img.is_primary ? '1' : '0.6'};transition:all 0.2s">
            `).join('')}
          </div>
          ` : ''}
        </div>
      </div>

      <!-- Right Column: Info & Booking -->
      <div class="col-lg-5">
        <span class="badge-category mb-3 d-inline-block">${(item.category || '').replace(/[-_]/g, ' ')}</span>${(item.category === 'water_slides' || item.category === 'water-slides' || item.category === 'combo_units' || item.category === 'combo-units' || (item.price_wet !== null && item.price_wet !== undefined && item.price_wet !== '')) ? ' <span style="background:#2563eb;color:white;font-weight:600;padding:4px 12px;border-radius:20px;font-size:12px;display:inline-block;margin-bottom:12px"><i class="fas fa-tint me-1"></i>Wet / Dry</span>' : ''}
        <h1 style="color:var(--bm-blue);font-size:32px;font-weight:700;margin-bottom:12px">${item.name}</h1>
        <p class="text-muted" style="font-size:16px;line-height:1.6">${item.short_description || ''}</p>

        <style>.price-tier-card:hover{border-color:var(--bm-orange)!important;box-shadow:0 4px 15px rgba(255,107,53,0.2)}.price-tier-popular:hover{box-shadow:0 4px 15px rgba(0,78,137,0.3)}</style>
        <!-- Price Tiers -->
        <div class="row g-3 mb-3">
          ${item.full_day_only ? '' : `
          <div class="col-4">
            <a href="/booking?preselect=${item.id}&rental_duration=4hr" style="text-decoration:none;color:inherit;display:block">
              <div class="price-tier-card" style="background:#f8f9fa;border-radius:12px;padding:15px;text-align:center;border:2px solid transparent;cursor:pointer;transition:border-color 0.2s,box-shadow 0.2s">
                <div style="font-size:12px;color:#888;font-weight:600;text-transform:uppercase">4 Hours</div>
                <div style="font-size:24px;font-weight:700;color:var(--bm-orange)">$${parseFloat(item.price_4hr || item.price_daily * 0.65).toFixed(0)}</div>
              </div>
            </a>
          </div>`}
          <div class="col-4">
            <a href="/booking?preselect=${item.id}&rental_duration=daily" style="text-decoration:none;color:inherit;display:block">
              <div class="price-tier-popular" style="background:var(--bm-blue);border-radius:12px;padding:15px;text-align:center;color:white;position:relative;cursor:pointer;transition:box-shadow 0.2s">
                <div style="position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:var(--bm-orange);color:white;font-size:10px;font-weight:700;padding:2px 10px;border-radius:10px">POPULAR</div>
                <div style="font-size:12px;opacity:0.8;font-weight:600;text-transform:uppercase">Full Day</div>
                <div style="font-size:24px;font-weight:700">$${parseFloat(item.price_daily).toFixed(0)}</div>
              </div>
            </a>
          </div>
          <div class="col-4">
            <a href="/booking?preselect=${item.id}&rental_duration=daily" style="text-decoration:none;color:inherit;display:block">
              <div class="price-tier-card" style="background:#f8f9fa;border-radius:12px;padding:15px;text-align:center;border:2px solid transparent;cursor:pointer;transition:border-color 0.2s,box-shadow 0.2s">
                <div style="font-size:12px;color:#888;font-weight:600;text-transform:uppercase">+ Extra Day</div>
                <div style="font-size:24px;font-weight:700;color:var(--bm-orange)">+$${parseFloat(item.price_extra_day || item.price_daily * 0.4).toFixed(0)}</div>
                <div style="font-size:10px;color:#aaa;font-weight:600;text-transform:uppercase;letter-spacing:.02em">per extra day</div>
              </div>
            </a>
          </div>
        </div>

        <!-- Specs Grid -->
        <div class="bg-white rounded-4 p-4 shadow-sm mb-4">
          <h6 style="color:var(--bm-blue);font-weight:700;margin-bottom:16px"><i class="fas fa-clipboard-list me-2"></i>Specifications</h6>
          <div class="row g-3">
            ${item.dimensions ? `
            <div class="col-6">
              <div class="text-muted small">Footprint</div>
              <div style="font-weight:600"><i class="fas fa-ruler-combined me-1" style="color:var(--bm-orange)"></i>${item.dimensions}</div>
            </div>
            ` : ''}
            ${item.age_range ? `
            <div class="col-6">
              <div class="text-muted small">Age Range</div>
              <div style="font-weight:600"><i class="fas fa-birthday-cake me-1" style="color:var(--bm-orange)"></i>${item.age_range}</div>
            </div>
            ` : ''}
            ${item.power_required ? `
            <div class="col-6">
              <div class="text-muted small">Power</div>
              <div style="font-weight:600"><i class="fas fa-bolt me-1" style="color:var(--bm-orange)"></i>${item.power_required}</div>
            </div>
            ` : ''}
            ${item.weight_lbs ? `
            <div class="col-6">
              <div class="text-muted small">Weight</div>
              <div style="font-weight:600"><i class="fas fa-weight-hanging me-1" style="color:var(--bm-orange)"></i>${item.weight_lbs} lbs</div>
            </div>
            ` : ''}
          </div>
        </div>

        <!-- Book This Item -->
        <div class="bg-white rounded-4 p-4 shadow-sm mb-4">
          <h6 style="color:var(--bm-blue);font-weight:700;margin-bottom:16px"><i class="fas fa-calendar-alt me-2"></i>Book This Item</h6>
          <p class="text-muted small mb-3">Select a duration above or tap below to start booking.</p>
          <a href="/booking?preselect=${item.id}" class="btn btn-book-now btn-lg w-100">
            <i class="fas fa-calendar-check me-2"></i>Book Now
          </a>
          <p class="text-center text-muted small mt-2 mb-0"><i class="fas fa-info-circle me-1"></i>Just a flat $50 deposit books your date — the rest is due on delivery day.</p>
        </div>
      </div>

    </div>

    <!-- Full Description -->
    ${item.description ? `
    <div class="bg-white rounded-4 p-4 p-md-5 shadow-sm mt-5">
      <h3 style="color:var(--bm-blue);font-weight:700;margin-bottom:20px">About This Rental</h3>
      <div style="line-height:1.8;color:#555">${item.description}</div>
    </div>
    ` : ''}

    <!-- Reviews -->
    ${reviews.length > 0 ? `
    <div class="mt-5">
      <div class="section-title">
        <h2>Customer Reviews</h2>
      </div>
      <div class="row g-4">
        ${reviews.map(r => `
        <div class="col-md-6">
          <div class="testimonial-card">
            <div class="stars mb-2">${'&#9733;'.repeat(r.rating)}${'&#9734;'.repeat(5 - r.rating)}</div>
            <p>"${r.comment || 'Great experience!'}"</p>
            <strong>${r.customer_name || 'Happy Customer'}</strong>
            ${r.event_date ? '<span class="text-muted small ms-2">' + r.event_date + '</span>' : ''}
          </div>
        </div>
        `).join('')}
      </div>
    </div>
    ` : ''}

    <!-- Related Equipment -->
    ${related.length > 0 ? `
    <div class="mt-5">
      <div class="section-title">
        <h2>You Might Also Like</h2>
      </div>
      <div class="row g-4">
        ${related.slice(0, 3).map(r => `
        <div class="col-md-4">
          <div class="equipment-card">
            <img src="${r.image || '/assets/images/placeholder-bounce.svg'}" class="card-img-top" alt="${r.name}">
            <div class="card-body">
              <span class="badge-category mb-2">${(r.category || '').replace(/[-_]/g, ' ')}</span>
              <h5 class="card-title mt-2">${r.name}</h5>
              <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="price-tag">From $${parseFloat(r.full_day_only ? r.price_daily : (r.price_4hr || r.price_daily * 0.65)).toFixed(0)}</span>
                <a href="/equipment/${r.slug}" class="btn btn-sm btn-outline-primary rounded-pill">Details <i class="fas fa-arrow-right ms-1"></i></a>
              </div>
            </div>
          </div>
        </div>
        `).join('')}
      </div>
    </div>
    ` : ''}

  </div>
</section>

`, scripts: `
<script>
  // Image gallery switching
  document.querySelectorAll('.img-thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      var src = this.getAttribute('data-src');
      var main = document.getElementById('mainImage');
      main.src = src;
      main.alt = this.alt;
      document.querySelectorAll('.img-thumb').forEach(function(t) {
        t.style.border = '3px solid transparent';
        t.style.opacity = '0.6';
      });
      this.style.border = '3px solid var(--bm-orange)';
      this.style.opacity = '1';
    });
  });
</script>
<script>if(typeof fbq!=='undefined')fbq('track','ViewContent',{content_name:'Equipment Detail',content_type:'product'});</script>
` }) %>
