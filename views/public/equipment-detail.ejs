<%- include('../layouts/public', { body: `

<!-- Breadcrumb -->
<section class="py-3" style="background:white;border-bottom:1px solid #eee">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0" style="font-size:14px">
        <li class="breadcrumb-item"><a href="/" style="color:var(--bm-blue)">Home</a></li>
        <li class="breadcrumb-item"><a href="/equipment" style="color:var(--bm-blue)">Equipment</a></li>
        <li class="breadcrumb-item active" aria-current="page">${item.name}</li>
      </ol>
    </nav>
  </div>
</section>

<!-- Equipment Detail -->
<section class="py-5">
  <div class="container">
    <div class="row g-5">

      <!-- Left Column: Image Gallery -->
      <div class="col-lg-7">
        <div class="bg-white rounded-4 overflow-hidden shadow-sm">
          <div id="mainImageWrap" style="position:relative;width:100%;padding-top:66%;overflow:hidden;background:#f0f0f0">
            <img id="mainImage"
              src="${images.length > 0 ? images.find(i => i.is_primary)?.image_path || images[0].image_path : '/assets/images/placeholder-bounce.svg'}"
              alt="${item.name}"
              style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:${item.category === 'add_ons' ? 'contain;background:#f8f9fa;padding:30px' : 'cover'}">
          </div>
          ${images.length > 1 ? `
          <div class="d-flex gap-2 p-3 flex-wrap" id="thumbRow">
            ${images.map((img, i) => `
              <img src="${img.image_path}" alt="${item.name} photo ${i + 1}"
                class="img-thumb" data-src="${img.image_path}"
                style="width:80px;height:60px;object-fit:cover;border-radius:8px;cursor:pointer;border:3px solid ${img.is_primary ? 'var(--bm-orange)' : 'transparent'};opacity:${img.is_primary ? '1' : '0.6'};transition:all 0.2s">
            `).join('')}
          </div>
          ` : ''}
        </div>
      </div>

      <!-- Right Column: Info & Booking -->
      <div class="col-lg-5">
        <span class="badge-category mb-3 d-inline-block">${(item.category || '').replace(/_/g, ' ')}</span>
        <h1 style="color:var(--bm-blue);font-size:32px;font-weight:700;margin-bottom:12px">${item.name}</h1>
        <p class="text-muted" style="font-size:16px;line-height:1.6">${item.short_description || ''}</p>

        <!-- Price Tiers -->
        <div class="row g-3 mb-3">
          <div class="col-4">
            <div style="background:#f8f9fa;border-radius:12px;padding:15px;text-align:center;border:2px solid transparent" price-tier-card" onclick="selectTier('4hr')" id="tierLabel4hr" style="cursor:pointer">
              <div style="font-size:12px;font-weight:600;text-transform:uppercase">4 Hours</div>
              <div style="font-size:24px;font-weight:700;color:var(--bm-orange)">$${parseFloat(item.price_4hr || item.price_daily * 0.65).toFixed(0)}</div>
            </div>
          </div>
          <div class="col-4">
            <div style="background:var(--bm-blue);border-radius:12px;padding:15px;text-align:center;color:white;position:relative;cursor:pointer" onclick="selectTier('daily')" id="tierLabelDaily">
              <div style="position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:var(--bm-orange);color:white;font-size:10px;font-weight:700;padding:2px 10px;border-radius:10px">POPULAR</div>
              <div style="font-size:12px;opacity:0.8;font-weight:600;text-transform:uppercase">Full Day</div>
              <div style="font-size:24px;font-weight:700">$${parseFloat(item.price_daily).toFixed(0)}</div>
            </div>
          </div>
          <div class="col-4">
            <div style="background:#f8f9fa;border-radius:12px;padding:15px;text-align:center;border:2px solid transparent" price-tier-card" onclick="selectTier('overnight')" id="tierLabelOvernight" style="cursor:pointer">
              <div style="font-size:12px;font-weight:600;text-transform:uppercase">Overnight</div>
              <div style="font-size:24px;font-weight:700;color:var(--bm-orange)">$${parseFloat(item.price_overnight || item.price_daily * 1.15).toFixed(0)}</div>
            </div>
          </div>
        </div>

        <!-- Morning/Afternoon sub-choice for 4hr -->
        <div id="timeWindowChoice" class="row g-2 mt-2 mb-3" style="display:none">
          <div class="col-6">
            <div class="btn btn-outline-secondary w-100 text-center" style="padding:10px;border-radius:12px;cursor:pointer" onclick="selectWindow('morning', this)" id="winMorningLabel">
              <div class="fw-bold"><i class="fas fa-sun me-1" style="color:#f59e0b"></i>Morning</div>
              <div class="small text-muted">9 AM - 1 PM</div>
            </div>
          </div>
          <div class="col-6">
            <div class="btn btn-outline-secondary w-100 text-center" style="padding:10px;border-radius:12px;cursor:pointer" onclick="selectWindow('afternoon', this)" id="winAfternoonLabel">
              <div class="fw-bold"><i class="fas fa-cloud-sun me-1" style="color:#f97316"></i>Afternoon</div>
              <div class="small text-muted">3 PM - 7 PM</div>
            </div>
          </div>
        </div>

        <!-- Morning/Afternoon for 4hr -->
        <div id="timeWindowChoice" class="row g-2 mt-2 mb-3" style="display:none">
          <div class="col-6">
            <div class="btn btn-outline-secondary w-100 text-center" style="padding:10px;border-radius:12px;cursor:pointer" onclick="selectWindow('morning',this)" id="winMorningLabel">
              <div class="fw-bold"><i class="fas fa-sun me-1" style="color:#f59e0b"></i>Morning</div>
              <div class="small text-muted">9 AM - 1 PM</div>
            </div>
          </div>
          <div class="col-6">
            <div class="btn btn-outline-secondary w-100 text-center" style="padding:10px;border-radius:12px;cursor:pointer" onclick="selectWindow('afternoon',this)" id="winAfternoonLabel">
              <div class="fw-bold"><i class="fas fa-cloud-sun me-1" style="color:#f97316"></i>Afternoon</div>
              <div class="small text-muted">3 PM - 7 PM</div>
            </div>
          </div>
        </div>

        <!-- Specs Grid -->
        <div class="bg-white rounded-4 p-4 shadow-sm mb-4">
          <h6 style="color:var(--bm-blue);font-weight:700;margin-bottom:16px"><i class="fas fa-clipboard-list me-2"></i>Specifications</h6>
          <div class="row g-3">
            ${item.dimensions ? `
            <div class="col-6">
              <div class="text-muted small">Dimensions</div>
              <div style="font-weight:600"><i class="fas fa-ruler-combined me-1" style="color:var(--bm-orange)"></i>${item.dimensions}</div>
            </div>
            ` : ''}
            ${item.capacity_kids ? `
            <div class="col-6">
              <div class="text-muted small">Capacity</div>
              <div style="font-weight:600"><i class="fas fa-child me-1" style="color:var(--bm-orange)"></i>Up to ${item.capacity_kids} kids</div>
            </div>
            ` : ''}
            ${item.age_range ? `
            <div class="col-6">
              <div class="text-muted small">Age Range</div>
              <div style="font-weight:600"><i class="fas fa-birthday-cake me-1" style="color:var(--bm-orange)"></i>${item.age_range}</div>
            </div>
            ` : ''}
            ${item.setup_time_min ? `
            <div class="col-6">
              <div class="text-muted small">Setup Time</div>
              <div style="font-weight:600"><i class="fas fa-clock me-1" style="color:var(--bm-orange)"></i>${item.setup_time_min} min</div>
            </div>
            ` : ''}
            ${item.power_required ? `
            <div class="col-6">
              <div class="text-muted small">Power</div>
              <div style="font-weight:600"><i class="fas fa-bolt me-1" style="color:var(--bm-orange)"></i>${item.power_required}</div>
            </div>
            ` : ''}
            ${item.weight_lbs ? `
            <div class="col-6">
              <div class="text-muted small">Weight</div>
              <div style="font-weight:600"><i class="fas fa-weight-hanging me-1" style="color:var(--bm-orange)"></i>${item.weight_lbs} lbs</div>
            </div>
            ` : ''}
          </div>
        </div>

        <!-- Book This Item -->
        <div class="bg-white rounded-4 p-4 shadow-sm mb-4">
          <h6 style="color:var(--bm-blue);font-weight:700;margin-bottom:16px"><i class="fas fa-calendar-alt me-2"></i>Book This Item</h6>

          <!-- Date Picker -->
          <div class="mb-3">
            <label class="form-label fw-bold small">Event Date</label>
            <input type="text" id="availDate" class="form-control" placeholder="Select a date..." readonly style="border-radius:12px">
          </div>
          <div id="availResult" class="mb-3" style="display:none"></div>

          <!-- Hidden inputs for goToBooking() - duration/time controlled by top tier cards -->
          <div style="display:none">
            <input type="radio" name="detail_duration" value="4hr" id="detDur4hr">
            <input type="radio" name="detail_duration" value="daily" id="detDurDaily" checked>
            <input type="radio" name="detail_duration" value="overnight" id="detDurOvernight">
            <select id="detStartTime"><option value="09:00">9 AM</option></select>
            <select id="detEndTime"><option value="19:00">7 PM</option></select>
          </div>

          <!-- Add-Ons shown after date confirmed -->
          <div id="addonSection" class="mb-3" style="display:none"></div>
          <div id="addonData" style="display:none">${typeof addons !== 'undefined' ? JSON.stringify(addons.map(function(a){return {id:a.id,name:a.name,desc:a.short_description||'',image:a.image||'',p4:a.price_4hr,pd:a.price_daily,po:a.price_overnight}})) : '[]'}</div>

          <!-- Book Now Button -->
          <button id="bookNowBtn" class="btn btn-book-now btn-lg w-100" disabled onclick="goToBooking()">
            <i class="fas fa-calendar-check me-2"></i>Book Now
          </button>

          ${item.deposit_amount ? '<p class="text-center text-muted small mt-2 mb-0"><i class="fas fa-info-circle me-1"></i>A $' + parseFloat(item.deposit_amount).toFixed(0) + ' deposit is required to reserve.</p>' : ''}
        </div>
      </div>

    </div>

    <!-- Full Description -->
    ${item.description ? `
    <div class="bg-white rounded-4 p-4 p-md-5 shadow-sm mt-5">
      <h3 style="color:var(--bm-blue);font-weight:700;margin-bottom:20px">About This Rental</h3>
      <div style="line-height:1.8;color:#555">${item.description}</div>
    </div>
    ` : ''}

    <!-- Reviews -->
    ${reviews.length > 0 ? `
    <div class="mt-5">
      <div class="section-title">
        <h2>Customer Reviews</h2>
      </div>
      <div class="row g-4">
        ${reviews.map(r => `
        <div class="col-md-6">
          <div class="testimonial-card">
            <div class="stars mb-2">${'&#9733;'.repeat(r.rating)}${'&#9734;'.repeat(5 - r.rating)}</div>
            <p>"${r.comment || 'Great experience!'}"</p>
            <strong>${r.customer_name || 'Happy Customer'}</strong>
            ${r.event_date ? '<span class="text-muted small ms-2">' + r.event_date + '</span>' : ''}
          </div>
        </div>
        `).join('')}
      </div>
    </div>
    ` : ''}

    <!-- Related Equipment -->
    ${related.length > 0 ? `
    <div class="mt-5">
      <div class="section-title">
        <h2>You Might Also Like</h2>
      </div>
      <div class="row g-4">
        ${related.slice(0, 3).map(r => `
        <div class="col-md-4">
          <div class="equipment-card">
            <img src="${r.image || '/assets/images/placeholder-bounce.svg'}" class="card-img-top" alt="${r.name}">
            <div class="card-body">
              <span class="badge-category mb-2">${(r.category || '').replace(/_/g, ' ')}</span>
              <h5 class="card-title mt-2">${r.name}</h5>
              <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="price-tag">From $${parseFloat(r.price_4hr || r.price_daily * 0.65).toFixed(0)}</span>
                <a href="/equipment/${r.slug}" class="btn btn-sm btn-outline-primary rounded-pill">Details <i class="fas fa-arrow-right ms-1"></i></a>
              </div>
            </div>
          </div>
        </div>
        `).join('')}
      </div>
    </div>
    ` : ''}

  </div>
</section>

`, scripts: `
<script>
  // Image gallery switching
  document.querySelectorAll('.img-thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      var src = this.getAttribute('data-src');
      document.getElementById('mainImage').src = src;
      document.querySelectorAll('.img-thumb').forEach(function(t) {
        t.style.border = '3px solid transparent';
        t.style.opacity = '0.6';
      });
      this.style.border = '3px solid var(--bm-orange)';
      this.style.opacity = '1';
    });
  });

  // Build time options
  (function() {
    var startSel = document.getElementById('detStartTime');
    var endSel = document.getElementById('detEndTime');
    for (var h = 7; h <= 22; h++) {
      for (var m = 0; m < 60; m += 30) {
        if (h === 22 && m === 30) break;
        var hour12 = h > 12 ? h - 12 : (h === 0 ? 12 : h);
        var ampm = h >= 12 ? 'PM' : 'AM';
        var label = hour12 + ':' + (m < 10 ? '0' + m : m) + ' ' + ampm;
        var val = (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m);
        startSel.innerHTML += '<option value="' + val + '">' + label + '</option>';
        endSel.innerHTML += '<option value="' + val + '">' + label + '</option>';
      }
    }
    startSel.value = '09:00';
    endSel.value = '17:00';
  })();

  var dateAvailable = false;

  // Flatpickr date picker with auto availability check
  flatpickr('#availDate', {
    minDate: 'today',
    dateFormat: 'Y-m-d',
    disableMobile: true,
    onChange: function(selectedDates, dateStr) {
      dateAvailable = false;
      document.getElementById('bookNowBtn').disabled = true;
      var resultDiv = document.getElementById('availResult');
      resultDiv.style.display = 'block';
      resultDiv.innerHTML = '<div class="text-center text-muted py-1"><i class="fas fa-spinner fa-spin me-1"></i>Checking availability...</div>';

      fetch('/check-availability?equipment_id=${item.id}&date=' + encodeURIComponent(dateStr))
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.available) {
            dateAvailable = true;
            resultDiv.innerHTML = '<div class="alert alert-success mb-0 py-2 small"><i class="fas fa-check-circle me-1"></i>Available on ' + dateStr + '!</div>';
            // duration handled by top tiers
            // time handled by top tiers
            document.getElementById('bookNowBtn').disabled = false;
          } else {
            resultDiv.innerHTML = '<div class="alert alert-danger mb-0 py-2 small"><i class="fas fa-times-circle me-1"></i>Not available on ' + dateStr + '. Try another date.</div>';
            // duration handled by top tiers
            // time handled by top tiers
          }
        })
        .catch(function() {
          dateAvailable = true;
          resultDiv.innerHTML = '<div class="alert alert-info mb-0 py-2 small"><i class="fas fa-info-circle me-1"></i>Could not verify online. You may proceed.</div>';
          // duration handled by top tiers
          // time handled by top tiers
          document.getElementById('bookNowBtn').disabled = false;
        });
    }
  });

  // Duration change updates times
  document.querySelectorAll('input[name="detail_duration"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var dur = this.value;
      var startSel = document.getElementById('detStartTime');
      var endSel = document.getElementById('detEndTime');
      if (dur === '4hr') { startSel.value = '10:00'; endSel.value = '14:00'; }
      else if (dur === 'daily') { startSel.value = '09:00'; endSel.value = '17:00'; }
      else if (dur === 'overnight') { startSel.value = '09:00'; endSel.value = '09:00'; }
    });
  });

  // Book Now — skip steps 1 & 2, go directly to customer details
  function goToBooking() {
    var date = document.getElementById('availDate').value;
    if (!date || !dateAvailable) return;
    var dur = document.querySelector('input[name="detail_duration"]:checked');
    var duration = dur ? dur.value : 'daily';
    var start = document.getElementById('detStartTime').value;
    var end = document.getElementById('detEndTime').value;
    var addonChecks = document.querySelectorAll('.addon-check:checked');
    var addonIds = Array.from(addonChecks).map(function(c){return c.value}).join(',');
    var params = 'items=${item.id}' + (addonIds ? ',' + addonIds : '') + '&event_date=' + encodeURIComponent(date) +
      '&rental_duration=' + duration +
      '&event_start_time=' + encodeURIComponent(start) +
      '&event_end_time=' + encodeURIComponent(end);
    window.location.href = '/booking/details?' + params;
  }

  // Tier click handler
  function selectTier(value) {
    var ids = {'4hr':'detDur4hr','daily':'detDurDaily','overnight':'detDurOvernight'};
    var radio = document.getElementById(ids[value]);
    if (radio) { radio.checked = true; }

    // Update styles
    var labels = {
      '4hr': document.getElementById('tierLabel4hr'),
      'daily': document.getElementById('tierLabelDaily'),
      'overnight': document.getElementById('tierLabelOvernight')
    };
    Object.keys(labels).forEach(function(k) {
      var l = labels[k];
      if (!l) return;
      if (k === value) {
        l.style.background = 'var(--bm-blue)';
        l.style.border = '2px solid var(--bm-blue)';
        l.style.color = 'white';
      } else {
        l.style.background = '#f8f9fa';
        l.style.border = '2px solid transparent';
        l.style.color = '';
      }
    });

    // Show/hide morning/afternoon
    var twc = document.getElementById('timeWindowChoice');
    if (twc) twc.style.display = (value === '4hr') ? '' : 'none';

    // Update hidden times
    var s = document.getElementById('detStartTime');
    var e = document.getElementById('detEndTime');
    if (value === '4hr') { s.value = '09:00'; e.value = '13:00'; }
    else if (value === 'daily') { s.value = '09:00'; e.value = '19:00'; }
    else if (value === 'overnight') { s.value = '15:00'; e.value = '10:00'; }
  }

  // Morning/afternoon click handler
  function selectWindow(value, el) {
    var s = document.getElementById('detStartTime');
    var e = document.getElementById('detEndTime');
    if (value === 'afternoon') { s.value = '15:00'; e.value = '19:00'; }
    else { s.value = '09:00'; e.value = '13:00'; }
    // Style
    document.getElementById('winMorningLabel').style.background = '';
    document.getElementById('winMorningLabel').style.color = '';
    document.getElementById('winAfternoonLabel').style.background = '';
    document.getElementById('winAfternoonLabel').style.color = '';
    el.style.background = 'var(--bm-blue)';
    el.style.color = 'white';
  }

  function selectTier(value) {
    var ids = {'4hr':'detDur4hr','daily':'detDurDaily','overnight':'detDurOvernight'};
    var r = document.getElementById(ids[value]);
    if (r) r.checked = true;
    var labels = {'4hr':document.getElementById('tierLabel4hr'),'daily':document.getElementById('tierLabelDaily'),'overnight':document.getElementById('tierLabelOvernight')};
    Object.keys(labels).forEach(function(k){
      var l=labels[k]; if(!l)return;
      if(k===value){l.style.background='var(--bm-blue)';l.style.border='2px solid var(--bm-blue)';l.style.color='white';}
      else{l.style.background='#f8f9fa';l.style.border='2px solid transparent';l.style.color='';}
    });
    var twc=document.getElementById('timeWindowChoice');
    if(twc)twc.style.display=(value==='4hr')?'':'none';
    var s=document.getElementById('detStartTime'),e=document.getElementById('detEndTime');
    if(value==='4hr'){s.value='09:00';e.value='13:00';}
    else if(value==='daily'){s.value='09:00';e.value='19:00';}
    else{s.value='15:00';e.value='10:00';}
    showAddons();
  }
  function selectWindow(value,el) {
    var s=document.getElementById('detStartTime'),e=document.getElementById('detEndTime');
    if(value==='afternoon'){s.value='15:00';e.value='19:00';}else{s.value='09:00';e.value='13:00';}
    document.getElementById('winMorningLabel').style.background='';document.getElementById('winMorningLabel').style.color='';
    document.getElementById('winAfternoonLabel').style.background='';document.getElementById('winAfternoonLabel').style.color='';
    el.style.background='var(--bm-blue)';el.style.color='white';
  }
  function showAddons() {
    var section=document.getElementById('addonSection');
    var dataEl=document.getElementById('addonData');
    if(!section||!dataEl)return;
    var items;try{items=JSON.parse(dataEl.textContent);}catch(e){return;}
    if(!items.length)return;
    var dur=document.querySelector('input[name="detail_duration"]:checked');
    var durVal=dur?dur.value:'daily';
    var html='<label class="form-label fw-bold small">Add extras to your event</label>';
    items.forEach(function(a){
      var price=durVal==='4hr'?a.p4:(durVal==='overnight'?a.po:a.pd);
      html+='<div class="d-flex align-items-center gap-2 p-2 mb-2 rounded-3" style="background:#f8f9fa">'+
        '<img src="'+(a.image||'/assets/images/placeholder-bounce.svg')+'" style="width:40px;height:40px;object-fit:contain;border-radius:8px">'+
        '<div style="flex:1"><div class="fw-bold small">'+a.name+'</div>'+
        '<div class="text-muted" style="font-size:11px">'+a.desc+'</div></div>'+
        '<span class="fw-bold small" style="color:var(--bm-orange)">+\x24'+price+'</span>'+
        '<input type="checkbox" class="form-check-input addon-check" value="'+a.id+'" style="width:20px;height:20px;cursor:pointer">'+
        '</div>';
    });
    section.innerHTML=html;
    section.style.display='';
  }
</script>
` }) %>
