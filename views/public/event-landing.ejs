<%- include('../layouts/public', { body: `

<section class="hero-section" style="padding:60px 0">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <span class="badge-category mb-3 d-inline-block">${eventData.badge}</span>
        <h1 style="font-size:40px;font-weight:700;margin-bottom:16px">${eventData.h1}</h1>
        <p style="font-size:19px;opacity:0.9;margin-bottom:28px">${eventData.subheading}</p>
        <div class="d-flex gap-3 flex-wrap">
          <a href="/booking" class="btn btn-book-now btn-lg"><i class="fas fa-calendar-check me-2"></i>Book Online Now</a>
          <a href="tel:(580) 308-9288" class="btn btn-outline-light btn-lg"><i class="fas fa-phone me-2"></i>(580) 308-9288</a>
        </div>
        <div class="d-flex gap-4 mt-4">
          <div><strong style="font-size:24px;display:block">FREE</strong><small>Delivery in Tonkawa</small></div>
          <div><strong style="font-size:24px;display:block">Kay County</strong><small>& nearby towns</small></div>
          <div><strong style="font-size:24px;display:block">5&#9733;</strong><small>Rated Service</small></div>
        </div>
      </div>
      <div class="col-lg-5 d-none d-lg-block text-center">
        <img src="${eventData.heroImage}" alt="${eventData.imgAlt}" class="img-fluid rounded-4" style="max-height:320px;object-fit:cover;width:100%">
      </div>
    </div>
  </div>
</section>

<section class="py-5 bg-white">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <h2 style="color:var(--bm-blue);font-size:30px;margin-bottom:20px">${eventData.contentHeading}</h2>
        ${eventData.bodyHtml}
      </div>
      <div class="col-lg-4">
        <div class="card border-0 rounded-4 p-4" style="background:var(--bm-gradient);color:white">
          <h4>Reserve Your Date</h4>
          <p style="opacity:0.9;font-size:15px">Popular dates book fast &mdash; lock in your ${eventData.occasion} rental today.</p>
          <a href="/booking" class="btn btn-light fw-bold w-100" style="color:var(--bm-orange)"><i class="fas fa-calendar-check me-2"></i>Check Availability</a>
          <a href="tel:(580) 308-9288" class="btn btn-outline-light mt-2 w-100"><i class="fas fa-phone me-2"></i>Call (580) 308-9288</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-5" style="background:var(--bm-light-bg)">
  <div class="container">
    <div class="section-title"><h2>${eventData.name} Rental FAQs</h2><p>The questions we hear most</p></div>
    <div class="row justify-content-center"><div class="col-lg-9">
      ${eventData.faqs.map(f => `<div class="card border-0 shadow-sm rounded-4 p-4 mb-3"><h3 style="color:var(--bm-blue);font-size:19px;margin-bottom:8px">${f.q}</h3><p class="mb-0" style="font-size:16px">${f.a}</p></div>`).join('')}
    </div></div>
  </div>
</section>

<section class="py-4 bg-white">
  <div class="container text-center">
    <h3 style="color:var(--bm-blue);margin-bottom:16px">Rentals Near You & For Every Occasion</h3>
    <div class="d-flex flex-wrap gap-2 justify-content-center">
      ${eventData.relatedLinks.map(c => `<a href="${c.url}" class="btn btn-outline-secondary rounded-pill px-3 py-2" style="font-size:14px">${c.name}</a>`).join('')}
      <a href="/booking" class="btn btn-book-now rounded-pill px-3 py-2" style="font-size:14px">Book Now</a>
    </div>
  </div>
</section>

`, scripts: `<script type="application/ld+json">${faqSchema}</script>\n<script type="application/ld+json">${serviceSchema}</script>` }) %>
