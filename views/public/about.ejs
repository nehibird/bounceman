<%- include('../layouts/public', { body: `

<!-- About Hero -->
<section class="hero-section" style="padding:60px 0">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <h1>About <span>Bounce Man</span></h1>
        <p>A Christ-centered family business bringing joy to small-town Oklahoma.</p>
      </div>
      <div class="col-lg-5 d-none d-lg-block text-center">
        <img src="/assets/images/logo.svg" alt="Bounce Man Logo" style="max-width:200px;filter:drop-shadow(2px 4px 8px rgba(0,0,0,0.2))">
      </div>
    </div>
  </div>
</section>

<!-- Our Story -->
<section class="py-5">
  <div class="container py-4">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <div style="background:var(--bm-gradient-cool);border-radius:24px;padding:60px;text-align:center;color:white;position:relative;overflow:hidden">
          <div style="position:absolute;top:-30px;right:-30px;width:150px;height:150px;background:var(--bm-yellow);border-radius:50%;opacity:0.15;pointer-events:none"></div>
          <div style="position:absolute;bottom:-20px;left:-20px;width:100px;height:100px;background:var(--bm-pink);border-radius:50%;opacity:0.15;pointer-events:none"></div>
          <i class="fas fa-cross" style="font-size:60px;opacity:0.9;margin-bottom:20px"></i>
          <h4 style="font-family:'Fredoka',sans-serif;margin-top:10px">The Reese Family</h4>
          <p style="opacity:0.8;margin:0">Nehemiah, Brenna & Kids</p>
        </div>
      </div>
      <div class="col-lg-6">
        <h2 style="color:var(--bm-blue);font-weight:700;margin-bottom:20px">Our Story</h2>
        <p style="font-size:17px;line-height:1.8;color:#555">
          We're the Reese family, and we've always tried to follow wherever God leads. That calling has taken us on some incredible adventures over the years, and Bounce Man is our latest one. We felt God opening a door into something new, and we decided to take a leap of faith and walk through it.
        </p>
        <p style="font-size:17px;line-height:1.8;color:#555">
          Honestly? We don't know exactly how this will turn out. But we trust the One who does. Nehemiah works in software by day, and Brenna is a full-time stay-at-home mom to our three little ones (ages 4, 2, and 6 months). We wanted something our whole family could be part of together, something our kids could see and touch and get excited about. Software is great, but it's hard to explain to a toddler. Bounce houses? Those speak for themselves.
        </p>
        <p style="font-size:17px;line-height:1.8;color:#555">
          This is a family venture in every sense. It's also genuinely the most fun business idea we could think of that was still real work. And it will be real work. These inflatables are heavy, weekends will be long, and Oklahoma summers are no joke. But we love it. We love seeing kids light up, we love serving our community, and we love that God gave us the chance to do both at once.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Faith Section -->
<section class="py-5" style="background:white">
  <div class="container py-4">
    <div class="row justify-content-center">
      <div class="col-lg-8 text-center">
        <i class="fas fa-book-bible" style="font-size:48px;color:var(--bm-orange);margin-bottom:20px"></i>
        <h2 style="color:var(--bm-blue);font-weight:700;margin-bottom:20px">Built on Faith</h2>
        <p style="font-size:17px;line-height:1.8;color:#555">
          Bounce Man is an openly Christ-centered business. We believe our work is worship, and we try to honor God in every delivery, every interaction, and every event. We're not perfect, but we serve a God who is, and He's the reason we're here.
        </p>
        <div style="background:var(--bm-light-bg);border-radius:16px;padding:30px;margin-top:30px;border-left:4px solid var(--bm-orange)">
          <p style="font-size:18px;font-style:italic;color:#444;margin-bottom:8px">
            "Whatever you do, work at it with all your heart, as working for the Lord, not for human masters."
          </p>
          <p style="font-weight:700;color:var(--bm-blue);margin:0">Colossians 3:23 (ESV)</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Our Values -->
<section class="py-5 fun-bg">
  <div class="shape-circle shape-1"></div>
  <div class="shape-circle shape-2"></div>
  <div class="container py-4">
    <div class="section-title">
      <h2>What We're About</h2>
      <p>The things that matter most to us as a family and a business</p>
    </div>
    <div class="row g-4">
      <div class="col-md-6 col-lg-3">
        <div style="text-align:center;padding:30px;background:white;border-radius:20px;height:100%;box-shadow:0 4px 15px rgba(0,0,0,0.06)">
          <div style="width:80px;height:80px;border-radius:50%;background:var(--bm-gradient);display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
            <i class="fas fa-cross" style="font-size:32px;color:white"></i>
          </div>
          <h5 style="color:var(--bm-blue);font-weight:700">Faith First</h5>
          <p style="color:#666;font-size:15px">Everything we do starts with Christ. We run this business as an act of obedience and worship, trusting God with the outcome.</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div style="text-align:center;padding:30px;background:white;border-radius:20px;height:100%;box-shadow:0 4px 15px rgba(0,0,0,0.06)">
          <div style="width:80px;height:80px;border-radius:50%;background:var(--bm-gradient);display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
            <i class="fas fa-people-roof" style="font-size:32px;color:white"></i>
          </div>
          <h5 style="color:var(--bm-blue);font-weight:700">Family Business</h5>
          <p style="color:#666;font-size:15px">This is something our whole family does together. Our kids are part of it, and we love that they get to watch something being built from the ground up.</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div style="text-align:center;padding:30px;background:white;border-radius:20px;height:100%;box-shadow:0 4px 15px rgba(0,0,0,0.06)">
          <div style="width:80px;height:80px;border-radius:50%;background:var(--bm-gradient);display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
            <i class="fas fa-shield-halved" style="font-size:32px;color:white"></i>
          </div>
          <h5 style="color:var(--bm-blue);font-weight:700">Safety & Clean</h5>
          <p style="color:#666;font-size:15px">Every inflatable is inspected and sanitized before and after each rental. Your children's safety is non-negotiable.</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div style="text-align:center;padding:30px;background:white;border-radius:20px;height:100%;box-shadow:0 4px 15px rgba(0,0,0,0.06)">
          <div style="width:80px;height:80px;border-radius:50%;background:var(--bm-gradient);display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
            <i class="fas fa-face-laugh-beam" style="font-size:32px;color:white"></i>
          </div>
          <h5 style="color:var(--bm-blue);font-weight:700">Fun Is the Point</h5>
          <p style="color:#666;font-size:15px">We picked this because it's genuinely fun. Seeing kids light up at an event is the best part of what we do. Joy is the whole reason we're here.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Why Choose Us -->
<section class="py-5" style="background:white">
  <div class="container py-4">
    <div class="section-title">
      <h2>Why Choose Bounce Man?</h2>
    </div>
    <div class="row g-4">
      <div class="col-lg-4">
        <div style="background:var(--bm-light-bg);border-radius:20px;padding:35px;height:100%;border-left:5px solid var(--bm-green)">
          <i class="fas fa-file-shield" style="font-size:36px;color:var(--bm-green);margin-bottom:15px"></i>
          <h5 style="color:var(--bm-blue);font-weight:700">Fully Insured</h5>
          <p style="color:#666">We carry full commercial liability insurance on every rental. Book with confidence knowing you and your guests are covered.</p>
        </div>
      </div>
      <div class="col-lg-4">
        <div style="background:var(--bm-light-bg);border-radius:20px;padding:35px;height:100%;border-left:5px solid var(--bm-orange)">
          <i class="fas fa-truck-fast" style="font-size:36px;color:var(--bm-orange);margin-bottom:15px"></i>
          <h5 style="color:var(--bm-blue);font-weight:700">Free Local Delivery</h5>
          <p style="color:#666">We deliver, set up, and pick up for free in Tonkawa and surrounding areas. You just focus on the party.</p>
        </div>
      </div>
      <div class="col-lg-4">
        <div style="background:var(--bm-light-bg);border-radius:20px;padding:35px;height:100%;border-left:5px solid var(--bm-purple)">
          <i class="fas fa-map-marker-alt" style="font-size:36px;color:var(--bm-purple);margin-bottom:15px"></i>
          <h5 style="color:var(--bm-blue);font-weight:700">Truly Local</h5>
          <p style="color:#666">We live here, our kids play here, and we're invested in this community. When you book with us, you're supporting a local family.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Fun Stats -->
<section class="py-5" style="background:var(--bm-gradient-cool);color:white">
  <div class="container py-4">
    <div class="row g-4 text-center">
      <div class="col-6 col-md-3">
        <div style="font-size:48px;font-weight:700;font-family:'Fredoka',sans-serif">6+</div>
        <div style="opacity:0.8;font-size:16px">Cities Served</div>
      </div>
      <div class="col-6 col-md-3">
        <div style="font-size:48px;font-weight:700;font-family:'Fredoka',sans-serif">100%</div>
        <div style="opacity:0.8;font-size:16px">Clean & Sanitized</div>
      </div>
      <div class="col-6 col-md-3">
        <div style="font-size:48px;font-weight:700;font-family:'Fredoka',sans-serif">FREE</div>
        <div style="opacity:0.8;font-size:16px">Tonkawa Delivery</div>
      </div>
      <div class="col-6 col-md-3">
        <div style="font-size:48px;font-weight:700;font-family:'Fredoka',sans-serif">Apr-Nov</div>
        <div style="opacity:0.8;font-size:16px">Rental Season</div>
      </div>
    </div>
  </div>
</section>

<!-- CTA to Contact -->
<section class="py-5 fun-bg">
  <div class="shape-circle shape-3"></div>
  <div class="container py-4 text-center">
    <h2 style="color:var(--bm-blue);font-weight:700;margin-bottom:15px">Want to Learn More?</h2>
    <p style="color:#666;font-size:18px;max-width:600px;margin:0 auto 30px">We'd love to hear from you. Whether you have questions about our equipment or want to talk about your upcoming event, reach out anytime.</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
      <a href="/contact" class="btn btn-book-now btn-lg"><i class="fas fa-envelope me-2"></i>Contact Us</a>
      <a href="/equipment" class="btn btn-outline-primary btn-lg rounded-pill px-4">Browse Equipment <i class="fas fa-arrow-right ms-2"></i></a>
    </div>
  </div>
</section>

`, scripts: '' }) %>
