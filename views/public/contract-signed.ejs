<%- include('../layouts/public', { body: `

<section class="py-5">
  <div class="container" style="max-width:600px">
    <div class="bg-white rounded-4 p-5 shadow-sm text-center">

      <!-- signer_name is posted by the signer (POST /contract/:id/sign) so it is untrusted; esc() everything below. -->
      <!-- Green Checkmark -->
      <div style="width:100px;height:100px;border-radius:50%;background:var(--bm-green);color:white;font-size:48px;line-height:100px;margin:0 auto 24px">
        <svg class="bm-i" aria-hidden="true"><use href="#i-check"/></svg>
      </div>

      <h1 style="color:var(--bm-blue);font-weight:700;margin-bottom:12px">Contract Signed!</h1>
      <p style="font-size:20px;color:#555">Thank you, ${esc(contract.signer_name)}!</p>

      <!-- Contract Details -->
      <div class="bg-light rounded-3 p-4 my-4 text-start" style="max-width:400px;margin-left:auto;margin-right:auto">
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Booking #</span>
          <strong>${esc(contract.booking_number)}</strong>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-muted">Signed on</span>
          <strong>${esc(contract.signed_at)}</strong>
        </div>
      </div>

      <p class="text-muted mb-4"><svg class="bm-i me-1" aria-hidden="true"><use href="#i-envelope"/></svg>A copy of the signed contract will be sent to your email.</p>

      <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="/booking/lookup" class="btn btn-book-now">
          <svg class="bm-i me-2" aria-hidden="true"><use href="#i-search"/></svg>View Your Booking
        </a>
        <a href="/" class="btn btn-outline-secondary rounded-pill px-4">
          <svg class="bm-i me-2" aria-hidden="true"><use href="#i-home"/></svg>Back to Home
        </a>
      </div>

    </div>
  </div>
</section>

`, scripts: '' }) %>
