<%- include('../layouts/public', { body: `

<section class="py-5">
  <div class="container" style="max-width:600px">
    <div class="bg-white rounded-4 p-5 shadow-sm text-center">

      <!-- Green Checkmark -->
      <div style="width:100px;height:100px;border-radius:50%;background:var(--bm-green);color:white;font-size:48px;line-height:100px;margin:0 auto 24px">
        <i class="fas fa-check"></i>
      </div>

      <h1 style="color:var(--bm-blue);font-weight:700;margin-bottom:12px">Contract Signed!</h1>
      <p style="font-size:20px;color:#555">Thank you, ${contract.signer_name}!</p>

      <!-- Contract Details -->
      <div class="bg-light rounded-3 p-4 my-4 text-start" style="max-width:400px;margin-left:auto;margin-right:auto">
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Booking #</span>
          <strong>${contract.booking_number}</strong>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-muted">Signed on</span>
          <strong>${contract.signed_at}</strong>
        </div>
      </div>

      <p class="text-muted mb-4"><i class="fas fa-envelope me-1"></i>A copy of the signed contract will be sent to your email.</p>

      <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="/booking/lookup" class="btn btn-book-now">
          <i class="fas fa-search me-2"></i>View Your Booking
        </a>
        <a href="/" class="btn btn-outline-secondary rounded-pill px-4">
          <i class="fas fa-home me-2"></i>Back to Home
        </a>
      </div>

    </div>
  </div>
</section>

`, scripts: '' }) %>
