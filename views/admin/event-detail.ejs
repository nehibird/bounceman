<%- include('../layouts/admin', { body: `

<!-- Event Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <div>
    <a href="/admin/events" class="text-muted small text-decoration-none"><i class="fas fa-arrow-left me-1"></i>Back to Events</a>
    <h3 class="mt-2 mb-0" style="font-weight:700;color:var(--bm-dark)">${esc(event.name)}</h3>
    <span class="text-muted">${event.event_date} ${event.location ? '&bull; ' + esc(event.location) : ''}</span>
  </div>
  <div>
    <span class="badge-status ${event.active ? 'badge-confirmed' : 'badge-cancelled'} me-2">${event.active ? 'Active' : 'Inactive'}</span>
    <span class="badge" style="background:var(--bm-primary);color:white;padding:8px 16px;border-radius:20px;font-size:16px">$${parseFloat(event.price_per_kid).toFixed(0)}/kid</span>
  </div>
</div>

<!-- Stats -->
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="stat-card">
      <div class="d-flex align-items-center gap-3">
        <div class="stat-icon" style="background:rgba(46,204,113,0.1);color:var(--bm-success)"><i class="fas fa-child"></i></div>
        <div>
          <div class="stat-value">${stats.kids}</div>
          <div class="stat-label">Kids Registered</div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <div class="d-flex align-items-center gap-3">
        <div class="stat-icon" style="background:rgba(0,78,137,0.1);color:var(--bm-secondary)"><i class="fas fa-users"></i></div>
        <div>
          <div class="stat-value">${stats.registrations}</div>
          <div class="stat-label">Families</div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <div class="d-flex align-items-center gap-3">
        <div class="stat-icon" style="background:rgba(46,204,113,0.1);color:var(--bm-success)"><i class="fas fa-dollar-sign"></i></div>
        <div>
          <div class="stat-value">$${stats.revenue.toFixed(2)}</div>
          <div class="stat-label">Revenue</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Walk-Up Link -->
<div class="card mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <strong><i class="fas fa-link me-2" style="color:var(--bm-primary)"></i>Walk-Up Link</strong>
        <div class="text-muted small text-break mt-1" id="eventLink">${settings.event_base_url || '/event'}?event=${event.id}</div>
      </div>
      <div>
        <button class="btn btn-sm btn-outline-primary rounded-pill me-2" id="copyLinkBtn">
          <i class="fas fa-copy me-1"></i>Copy
        </button>
        <a href="${settings.event_base_url || '/event'}?event=${event.id}&kiosk=1" target="_blank" class="btn btn-sm btn-bm rounded-pill">
          <i class="fas fa-tablet-alt me-1"></i>Kiosk Mode
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Registrations Table -->
<form method="POST" action="/admin/events/${event.id}/registrations/delete" id="deleteRegsForm">
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="fas fa-list me-2"></i>Registrations (${registrations.length})</span>
    <div class="d-flex align-items-center gap-2">
      <span class="text-muted small me-2">Wristbands issued: ${event.wristband_counter}</span>
      <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" id="deleteRegsBtn" style="display:none">
        <i class="fas fa-trash me-1"></i>Delete Selected
      </button>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0 rtable">
      <thead>
        <tr style="background:#f8f9fa">
          <th class="rt-hide" style="padding:12px 20px;width:40px"><input type="checkbox" id="selectAll" title="Select all"></th>
          <th>Wristband</th>
          <th>Parent</th>
          <th>Phone</th>
          <th>Kids</th>
          <th>Paid</th>
          <th class="d-none d-md-table-cell">Method</th>
          <th>Waiver</th>
          <th>Status</th>
          <th class="d-none d-md-table-cell">Time</th>
        </tr>
      </thead>
      <tbody>
        ${registrations.length === 0 ? '<tr><td colspan="10" class="text-center text-muted py-4">No registrations yet</td></tr>' : ''}
        ${registrations.map(function(r) {
          var kids = [];
          try { kids = JSON.parse(r.kid_names || '[]'); } catch(e) {}
          var wristband = r.wristband_start ? (r.wristband_start === r.wristband_end ? '#' + r.wristband_start : '#' + r.wristband_start + '-#' + r.wristband_end) : '-';
          return '<tr>' +
            '<td class="rt-hide" style="padding:12px 20px"><input type="checkbox" name="ids" value="' + r.id + '" class="reg-checkbox"></td>' +
            '<td data-label="Wristband"><strong style="color:var(--bm-secondary)">' + wristband + '</strong></td>' +
            '<td class="rt-primary">' + esc(r.parent_name) + '</td>' +
            '<td data-label="Phone">' + esc(r.parent_phone || '-') + '</td>' +
            '<td data-label="Kids">' + r.kid_count + ' <span class="text-muted small">(' + esc(kids.join(', ')) + ')</span></td>' +
            '<td data-label="Paid"><strong>$' + (r.amount_paid ? parseFloat(r.amount_paid).toFixed(2) : '0.00') + '</strong></td>' +
            '<td data-label="Method" class="d-none d-md-table-cell">' + (r.payment_method === 'cash' ? '💵 Cash' : r.payment_method === 'google_review' ? '⭐ Review' : r.payment_method === 'card' ? '💳 Card' : '—') + '</td>' +
            '<td data-label="Waiver">' + (r.waiver_signed ? '<i class="fas fa-check-circle text-success me-2"></i><a href="/uploads/waivers/waiver-' + r.id + '.html" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill" style="font-size:11px;padding:2px 8px">View</a>' : '<i class="fas fa-times-circle text-danger"></i>') + '</td>' +
            '<td data-label="Status"><span class="badge-status ' + (r.payment_status === 'completed' ? 'badge-confirmed' : 'badge-pending') + '">' + r.payment_status + '</span></td>' +
            '<td data-label="Time" class="d-none d-md-table-cell text-muted small">' + (r.created_at || '') + '</td>' +
          '</tr>';
        }).join('')}
      </tbody>
    </table>
  </div>
</div>
</form>

`, scripts: `
<script>
  var copyBtn = document.getElementById('copyLinkBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', function() {
      navigator.clipboard.writeText(document.getElementById('eventLink').textContent);
    });
  }

  var selectAll = document.getElementById('selectAll');
  var deleteBtn = document.getElementById('deleteRegsBtn');
  var checkboxes = document.querySelectorAll('.reg-checkbox');

  function updateDeleteBtn() {
    var checked = document.querySelectorAll('.reg-checkbox:checked').length;
    deleteBtn.style.display = checked > 0 ? 'inline-block' : 'none';
    deleteBtn.textContent = checked > 0 ? ' Delete Selected (' + checked + ')' : '';
    if (checked > 0) deleteBtn.innerHTML = '<i class="fas fa-trash me-1"></i>Delete Selected (' + checked + ')';
  }

  if (selectAll) {
    selectAll.addEventListener('change', function() {
      checkboxes.forEach(function(cb) { cb.checked = selectAll.checked; });
      updateDeleteBtn();
    });
  }

  checkboxes.forEach(function(cb) {
    cb.addEventListener('change', function() {
      selectAll.checked = document.querySelectorAll('.reg-checkbox:checked').length === checkboxes.length;
      updateDeleteBtn();
    });
  });

  document.getElementById('deleteRegsForm').addEventListener('submit', function(e) {
    var count = document.querySelectorAll('.reg-checkbox:checked').length;
    if (!confirm('Delete ' + count + ' registration' + (count > 1 ? 's' : '') + '? This cannot be undone.')) {
      e.preventDefault();
    }
  });
</script>
` }) %>
