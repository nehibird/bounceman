<%- include('../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h4 class="mb-1"><i class="fas fa-comments me-2"></i>Messages</h4>
    <p class="text-muted mb-0">${threads.length} conversation${threads.length !== 1 ? 's' : ''} — text customers from the Bounce Man number</p>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-4">
    <div class="card">
      <div class="list-group list-group-flush" style="max-height:72vh;overflow:auto">
        ${threads.length ? threads.map(t => `
        <a href="/admin/messages?to=${encodeURIComponent(t.number)}" class="list-group-item list-group-item-action ${t.number === active ? 'active' : ''}">
          <div class="d-flex justify-content-between align-items-center">
            <strong>${t.name || t.number}</strong>
            ${t.unread ? '<span class="badge bg-danger rounded-pill">new</span>' : ''}
          </div>
          <small class="${t.number === active ? '' : 'text-muted'} d-block text-truncate">${t.name ? t.number + ' · ' : ''}${(t.messages[t.messages.length - 1] || {}).body || ''}</small>
        </a>`).join('') : '<div class="p-4 text-muted text-center">No texts yet.<br><small>Inbound texts to 580-308-9288 will appear here.</small></div>'}
      </div>
    </div>
  </div>
  <div class="col-md-8">
    ${activeThread ? `
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div><strong>${activeThread.name || activeThread.number}</strong> ${activeThread.name ? '<small class="text-muted ms-1">' + activeThread.number + '</small>' : ''}</div>
        <button class="btn btn-sm btn-outline-success call-btn" data-phone="${activeThread.number}"><i class="fas fa-phone-alt me-1"></i>Call</button>
      </div>
      <div class="card-body" style="max-height:56vh;overflow:auto;background:#f1f3f5" id="convo">
        ${activeThread.messages.map(m => `
        <div class="d-flex mb-2 ${m.direction === 'outbound' ? 'justify-content-end' : 'justify-content-start'}">
          <div class="p-2 px-3 rounded-3 shadow-sm" style="max-width:75%;${m.direction === 'outbound' ? 'background:#0d6efd;color:#fff' : 'background:#fff;border:1px solid #dee2e6'}">
            <div style="white-space:pre-wrap;word-break:break-word">${m.body || ''}</div>
            <small class="${m.direction === 'outbound' ? 'text-white-50' : 'text-muted'} d-block mt-1" style="font-size:11px">${m.when || ''}</small>
          </div>
        </div>`).join('')}
      </div>
      <div class="card-footer">
        <form method="POST" action="/admin/messages/send" class="d-flex gap-2">
          <input type="hidden" name="to" value="${activeThread.number}">
          <input type="text" name="body" class="form-control" placeholder="Type a reply…" autocomplete="off" maxlength="1000" required>
          <button class="btn btn-primary" type="submit"><i class="fas fa-paper-plane me-1"></i>Send</button>
        </form>
      </div>
    </div>` : '<div class="card"><div class="card-body text-muted text-center py-5"><i class="fas fa-comment-dots fa-2x mb-2 d-block opacity-50"></i>Select a conversation to read and reply.</div></div>'}
  </div>
</div>

`, scripts: `
<script>
  var c = document.getElementById('convo');
  if (c) c.scrollTop = c.scrollHeight;
  // reuse the click-to-call from anywhere
  var MY_PHONE_KEY = 'bm_my_phone';
  document.querySelectorAll('.call-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var customerPhone = btn.getAttribute('data-phone');
      var myPhone = localStorage.getItem(MY_PHONE_KEY) || '';
      myPhone = prompt('Your cell number to call from:', myPhone);
      if (!myPhone) return;
      localStorage.setItem(MY_PHONE_KEY, myPhone);
      var orig = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
      fetch('/api/call/dial', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ to: customerPhone, your_phone: myPhone }) })
        .then(function(r){return r.json();}).then(function(d){ alert(d.success ? 'Ringing your phone now!' : ('Error: '+(d.error||'failed'))); btn.disabled=false; btn.innerHTML=orig; })
        .catch(function(){ alert('Request failed'); btn.disabled=false; btn.innerHTML=orig; });
    });
  });
</script>
` }) %>
