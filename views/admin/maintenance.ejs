<%- include('../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Maintenance Log</h4>
    <p class="text-muted mb-0">${logs.length} record${logs.length !== 1 ? 's' : ''}</p>
  </div>
  <button class="btn btn-bm" type="button" data-bs-toggle="collapse" data-bs-target="#addMaintenanceForm">
    <i class="fas fa-plus me-1"></i> Add Record
  </button>
</div>

<!-- Add Maintenance Form (Collapsible) -->
<div class="collapse mb-4" id="addMaintenanceForm">
  <div class="card">
    <div class="card-header"><i class="fas fa-plus-circle me-2"></i>New Maintenance Record</div>
    <div class="card-body">
      <form method="POST" action="/admin/maintenance">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Equipment ID</label>
            <input type="number" name="equipment_id" class="form-control" placeholder="Enter equipment ID" required>
            <small class="text-muted">Enter the numeric ID of the equipment item</small>
          </div>
          <div class="col-md-6">
            <label class="form-label">Type</label>
            <select name="type" class="form-select" required>
              <option value="">Select type...</option>
              <option value="inspection">Inspection</option>
              <option value="cleaning">Cleaning</option>
              <option value="repair">Repair</option>
              <option value="replacement">Replacement</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3" placeholder="Describe the maintenance performed..."></textarea>
          </div>
          <div class="col-md-4">
            <label class="form-label">Cost ($)</label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input type="number" name="cost" class="form-control" step="0.01" placeholder="0.00">
            </div>
          </div>
          <div class="col-md-4">
            <label class="form-label">Next Due Date</label>
            <input type="date" name="next_due" class="form-control">
          </div>
          <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-bm w-100"><i class="fas fa-save me-1"></i> Save Record</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Maintenance Logs Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 rtable">
        <thead>
          <tr>
            <th>Date</th>
            <th>Equipment</th>
            <th>Type</th>
            <th>Description</th>
            <th>Cost</th>
            <th>Performed By</th>
            <th>Next Due</th>
          </tr>
        </thead>
        <tbody>
          ${logs.length > 0 ? logs.map(log => `
          <tr>
            <td data-label="Date"><small>${log.performed_at || ''}</small></td>
            <td class="rt-primary">${log.equipment_name ? esc(log.equipment_name) : 'Equipment #' + (log.equipment_id || '?')}</td>
            <td data-label="Type">
              <span class="badge bg-${log.type === 'repair' ? 'danger' : log.type === 'inspection' ? 'info' : log.type === 'cleaning' ? 'success' : log.type === 'replacement' ? 'warning text-dark' : 'secondary'}">
                ${log.type || 'N/A'}
              </span>
            </td>
            <td data-label="Description">${esc(log.description)}</td>
            <td data-label="Cost">${log.cost ? '$' + parseFloat(log.cost).toFixed(2) : '-'}</td>
            <td data-label="Performed By">${esc(log.performed_by)}</td>
            <td data-label="Next Due">
              ${log.next_due ? `
                <span class="${new Date(log.next_due) < new Date() ? 'text-danger fw-bold' : ''}">
                  ${log.next_due}
                  ${new Date(log.next_due) < new Date() ? ' <i class="fas fa-exclamation-triangle"></i>' : ''}
                </span>
              ` : '-'}
            </td>
          </tr>
          `).join('') : '<tr><td colspan="7" class="text-center text-muted py-4">No maintenance records</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>

`, scripts: '' }) %>
