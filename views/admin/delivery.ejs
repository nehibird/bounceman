<%- include('../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Delivery Schedule</h4>
    <p class="text-muted mb-0">${deliveries.length} deliver${deliveries.length !== 1 ? 'ies' : 'y'} scheduled for ${date || 'today'}</p>
  </div>
  <div>
    <input type="date" class="form-control" value="${date || new Date().toISOString().split('T')[0]}" id="deliveryDateFilter">
  </div>
</div>

${deliveries.length > 0 ? deliveries.map((d, i) => `
<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span>
      <i class="fas fa-truck me-2 text-primary"></i>
      <strong>Delivery ${i + 1} of ${deliveries.length}</strong>
      <span class="text-muted ms-2">${d.event_start_time || ''}</span>
    </span>
    <a href="/admin/bookings/${d.id}" class="btn btn-sm btn-outline-secondary">
      <i class="fas fa-eye me-1"></i> Booking #${d.booking_number}
    </a>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-4">
        <small class="text-muted d-block"><i class="fas fa-user me-1"></i> Customer</small>
        <strong>${d.first_name} ${d.last_name}</strong>
        ${d.phone ? '<br><a href="tel:' + d.phone + '" class="text-decoration-none"><i class="fas fa-phone me-1"></i>' + d.phone + '</a>' : ''}
      </div>
      <div class="col-md-4">
        <small class="text-muted d-block"><i class="fas fa-map-marker-alt me-1"></i> Address</small>
        <strong>${d.delivery_address || 'No address'}</strong>
        ${d.delivery_city ? '<br>' + d.delivery_city : ''}${d.delivery_zip ? ', ' + d.delivery_zip : ''}
      </div>
      <div class="col-md-4">
        <small class="text-muted d-block"><i class="fas fa-clock me-1"></i> Setup Time</small>
        <strong>${d.setup_time ? d.setup_time + ' min' : 'N/A'}</strong>
      </div>
      <div class="col-12">
        <small class="text-muted d-block"><i class="fas fa-castle me-1"></i> Items</small>
        <div class="d-flex flex-wrap gap-2 mt-1">
          ${d.items ? d.items.split(', ').map(function(name) { return '<span class="badge bg-light text-dark border">' + name + '</span>'; }).join('') : '<span class="text-muted">No items listed</span>'}
        </div>
      </div>
      ${d.delivery_notes ? `
      <div class="col-12">
        <small class="text-muted d-block"><i class="fas fa-sticky-note me-1"></i> Delivery Notes</small>
        <div class="alert alert-warning py-2 mb-0 mt-1">${d.delivery_notes}</div>
      </div>
      ` : ''}
    </div>
  </div>
</div>
`).join('') : `
<div class="card">
  <div class="card-body text-center py-5">
    <i class="fas fa-truck fa-3x text-muted mb-3"></i>
    <h5 class="text-muted">No deliveries scheduled for this date</h5>
    <p class="text-muted">Select a different date to view deliveries.</p>
  </div>
</div>
`}

`, scripts: `
<script>
(function() {
  var df = document.getElementById('deliveryDateFilter');
  if (df) {
    df.addEventListener('change', function() {
      window.location='/admin/delivery?date='+this.value;
    });
  }
})();
</script>
` }) %>
