<script>
document.addEventListener("click", function(e) {
  var row = e.target.closest("[data-booking-href]");
  if (row && !e.target.closest("a,button")) window.location = row.dataset.bookingHref;
});
(function() {
  var labels = ${JSON.stringify(monthlyRevenue.map(m => m.label))};
  var data = ${JSON.stringify(monthlyRevenue.map(m => parseFloat(m.revenue.toFixed(2))))};
  var ctx = document.getElementById("monthlyRevenueChart");
  if (!ctx) return;
  var B = window.BMChart;
  new Chart(ctx, {
    type: "bar",
    data: {
      labels: labels,
      datasets: [{
        label: "Revenue",
        data: data,
        backgroundColor: B.alpha(B.colors.accent(), 0.85),
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      layout: { padding: { top: 18 } },
      plugins: {
        legend: { display: false },
        bmValueLabels: { format: B.money }
      },
      scales: B.scales()
    }
  });
})();
<\/script>

<script>
  (function() {
    var btn = document.getElementById('bankSyncBtn');
    if (!btn) return;
    btn.addEventListener('click', function() {
      var label = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<svg class="bm-i bm-i-spin me-1" aria-hidden="true"><use href="#i-rotate"/></svg>Syncing...';
      fetch('/admin/banks/sync', { method: 'POST', headers: { 'Accept': 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d && d.error) throw new Error(d.error);
          // Reload so every figure that depends on the balance updates together —
          // Safe to Spend and Net Liquid are computed server-side from it.
          location.reload();
        })
        .catch(function(e) {
          btn.disabled = false;
          btn.innerHTML = label;
          var at = document.getElementById('bankSyncedAt');
          if (at) { at.textContent = 'sync failed: ' + e.message; at.className = 'small text-danger'; }
        });
    });
  })();
</script>
