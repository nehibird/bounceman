<%- include('../layouts/admin', { body: `

${unsignedContracts.length ? `
<div class="bm-alert" role="alert">
  <div class="bm-alert-head">
    <svg class="bm-i" aria-hidden="true"><use href="#i-file-signature"/></svg>
    <strong>${unsignedContracts.length === 1
      ? 'One booking has no signed contract'
      : unsignedContracts.length + ' bookings have no signed contract'}</strong>
  </div>
  <div class="bm-alert-rows">
    ${unsignedContracts.map(u => `
    <a class="bm-alert-row" href="/admin/bookings/${u.booking_id}">
      <span class="bm-alert-when">${esc(u.when)}${u.days !== null && u.days <= 7
        ? '<em>' + (u.days === 0 ? 'today' : u.days === 1 ? 'tomorrow' : 'in ' + u.days + ' days') + '</em>'
        : ''}</span>
      <span class="bm-alert-who">${esc(u.name)}</span>
      <span class="bm-alert-no">${esc(u.booking_number)}</span>
    </a>`).join('')}
  </div>
</div>
<style>
  .bm-alert { border:1px solid var(--bm-fb-bad); border-left-width:4px;
    background:var(--bm-n-0); border-radius:var(--bm-radius-md);
    box-shadow:var(--bm-shadow-1); margin-bottom:var(--bm-space-5); overflow:hidden; }
  .bm-alert-head { display:flex; align-items:center; gap:10px;
    padding:var(--bm-space-3) var(--bm-space-4); color:var(--bm-fb-bad);
    font-size:15px; border-bottom:1px solid var(--bm-n-100); }
  .bm-alert-row { display:flex; align-items:center; gap:var(--bm-space-4);
    padding:10px var(--bm-space-4); text-decoration:none; color:var(--bm-n-800);
    border-bottom:1px solid var(--bm-n-50); font-size:14px; }
  .bm-alert-row:last-child { border-bottom:0; }
  .bm-alert-row:hover { background:var(--bm-accent-tint); }
  .bm-alert-when { font-weight:700; min-width:130px; }
  .bm-alert-when em { font-style:normal; font-weight:700; color:var(--bm-fb-bad);
    margin-left:6px; font-size:12px; }
  .bm-alert-who { flex:1 1 auto; }
  .bm-alert-no { color:var(--bm-n-500); font-size:12px; font-weight:600; }
  @media (max-width:575px) {
    .bm-alert-row { flex-wrap:wrap; gap:4px var(--bm-space-3); }
    .bm-alert-when { min-width:0; }
    .bm-alert-no { width:100%; }
  }
</style>` : ''}

<!-- Actions. These used to live in a Quick Actions card two full scrolls down, below
     the bank panel, three analytics rows and the upcoming-events table -- the things you
     DO were underneath everything you merely look at. -->
<div class="bm-actions">
  <a href="/admin/bookings/new" class="bm-act bm-act-primary">
    <svg class="bm-i" aria-hidden="true"><use href="#i-plus"/></svg>New booking
  </a>
  <a href="/admin/delivery" class="bm-act"><svg class="bm-i" aria-hidden="true"><use href="#i-truck"/></svg>Today</a>
  <a href="/admin/calendar" class="bm-act"><svg class="bm-i" aria-hidden="true"><use href="#i-calendar"/></svg>Calendar</a>
  <a href="/admin/equipment/new" class="bm-act"><svg class="bm-i" aria-hidden="true"><use href="#i-plus"/></svg>Add equipment</a>
  ${
    /* Pending and Reviews are counts, not actions. They used to render unconditionally,
       and "Pending (0)" in warning yellow was the single brightest control on the page
       -- an alarm for nothing, every day, which is how an operator learns to stop
       reading alarms. They appear only when there is something behind them. */
    stats.pendingBookings > 0
      ? `<a href="/admin/bookings?status=pending" class="bm-act bm-act-attn">
           <svg class="bm-i" aria-hidden="true"><use href="#i-clock"/></svg>${stats.pendingBookings} pending
         </a>`
      : ''
  }${
    stats.pendingReviews > 0
      ? `<a href="/admin/reviews" class="bm-act bm-act-attn">
           <svg class="bm-i" aria-hidden="true"><use href="#i-star"/></svg>${stats.pendingReviews} review${stats.pendingReviews === 1 ? '' : 's'} to approve
         </a>`
      : ''
  }
</div>
<style>
  .bm-actions { display:flex; flex-wrap:wrap; gap:var(--bm-space-2);
    margin-bottom:var(--bm-space-5); }
  .bm-act { display:inline-flex; align-items:center; gap:7px; padding:8px 15px;
    font-size:14px; font-weight:600; text-decoration:none; border-radius:var(--bm-radius-pill);
    border:1px solid var(--bm-n-200); background:var(--bm-n-0); color:var(--bm-n-700); }
  .bm-act:hover { border-color:var(--bm-n-300); background:var(--bm-n-25);
    color:var(--bm-n-900); }
  .bm-act .bm-i { font-size:12px; color:var(--bm-n-400); }
  .bm-act-primary { background:var(--bm-accent); border-color:var(--bm-accent);
    color:var(--bm-on-accent); }
  .bm-act-primary:hover { background:var(--bm-accent-hover);
    border-color:var(--bm-accent-fill-hover); color:var(--bm-on-accent); }
  .bm-act-primary .bm-i { color:var(--bm-on-accent); }
  .bm-act-attn { border-color:var(--bm-fb-warn); color:var(--bm-fb-warn); }
  .bm-act-attn:hover { background:var(--bm-n-25); color:var(--bm-fb-warn); }
  .bm-act-attn .bm-i { color:var(--bm-fb-warn); }
  @media (max-width:575px) { .bm-act { flex:1 1 auto; justify-content:center; } }
</style>

<!-- Money Row. Was: Today's Events, Month Revenue, Pending Bookings, Total Customers --
     a count, a revenue figure and two more counts, of which Today's Events and Pending
     Bookings are structurally zero for most of the year (the season runs Apr-Nov and
     "pending" is a status a booking passes through in minutes). So two of the four
     largest numbers on the page were permanent zeroes, while the figures that actually
     decide whether he can spend money -- safe-to-spend and net liquid position -- were
     an 11px grey footnote underneath the bank panel.
     Today's Events and Total Customers are both one click away: Today is in the action
     bar above, Customers is in the sidebar. -->
<div class="row g-4 mb-4">
  <div class="col-6 col-md-3">
    <a href="/admin/banks" class="text-decoration-none">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label">Safe to Spend</div>
            <div class="stat-value" style="color:${finance.safeToSpend >= 0 ? 'var(--bm-money-in)' : 'var(--bm-money-out)'}">${finance.safeToSpend < 0 ? '−' : ''}$${Math.abs(finance.safeToSpend).toLocaleString('en-US', {minimumFractionDigits:0, maximumFractionDigits:0})}</div>
            <div class="bm-delta">${compare.cash30 === 0 ? 'bank level over 30 days'
              : (compare.cash30 > 0 ? '▲ ' : '▼ ') + '$' + Math.abs(Math.round(compare.cash30)).toLocaleString('en-US') + ' in the bank over 30 days'}</div>
          </div>
          <div class="stat-icon" style="background:var(--bm-state-done-bg);color:var(--bm-money-in)"><svg class="bm-i" aria-hidden="true"><use href="#i-wallet"/></svg></div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-md-3">
    <a href="/admin/banks" class="text-decoration-none">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <!-- R12: no comparison here on purpose. This is a position, not a rate;
                 "up $400 this month" says nothing about whether it is healthy, and a
                 delta invented to fill the slot is worse than an empty one. -->
            <div class="stat-label">Net Liquid Position</div>
            <div class="stat-value" style="color:${finance.netLiquid >= 0 ? 'var(--bm-money-in)' : 'var(--bm-money-out)'}">${finance.netLiquid < 0 ? '−' : ''}$${Math.abs(finance.netLiquid).toLocaleString('en-US', {minimumFractionDigits:0, maximumFractionDigits:0})}</div>
          </div>
          <div class="stat-icon" style="background:var(--bm-state-done-bg);color:var(--bm-n-500)"><svg class="bm-i" aria-hidden="true"><use href="#i-scale-balanced"/></svg></div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-md-3">
    <a href="/admin/bookings" class="text-decoration-none">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label">Still Owed to You</div>
            <div class="stat-value" style="color:${parseFloat(analytics.balanceOwed) > 0 ? 'var(--bm-accent-text)' : 'var(--bm-n-400)'}">$${parseFloat(analytics.balanceOwed).toLocaleString('en-US', {minimumFractionDigits:0, maximumFractionDigits:0})}</div>
            <div class="bm-delta">${
              parseFloat(analytics.balanceOwed) <= 0 ? 'nothing outstanding'
              : compare.owed.overdueCount > 0
                ? '<span style="color:var(--bm-fb-bad);font-weight:700">' + compare.owed.overdueCount + ' past the event date</span>'
                : compare.owed.next ? 'due at delivery, next ' + fmtDateShort(compare.owed.next) : 'due at delivery'
            }</div>
          </div>
          <div class="stat-icon" style="background:var(--bm-accent-tint);color:var(--bm-accent-text)"><svg class="bm-i" aria-hidden="true"><use href="#i-hand-holding-dollar"/></svg></div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-md-3">
    <a href="/admin/reports" class="text-decoration-none">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label">Month Revenue</div>
            <div class="stat-value">$${parseFloat(stats.monthRevenue).toLocaleString('en-US', {minimumFractionDigits:0, maximumFractionDigits:0})}</div>
            <div class="bm-delta">${compare.monthVsPrev.pct === null
              ? 'first ' + compare.monthVsPrev.days + ' days of the month'
              : (compare.monthVsPrev.pct >= 0 ? '▲ ' : '▼ ') + Math.abs(compare.monthVsPrev.pct) + '% vs the same '
                + compare.monthVsPrev.days + ' days last month'}</div>
          </div>
          <div class="stat-icon" style="background:var(--bm-n-50);color:var(--bm-n-500)"><svg class="bm-i" aria-hidden="true"><use href="#i-chart-line"/></svg></div>
        </div>
      </div>
    </a>
  </div>
</div>

<!-- Bank Accounts (live balances from titan bank sync) -->
<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card">
      <div class="card-header fw-semibold"><svg class="bm-i me-2" aria-hidden="true"><use href="#i-university"/></svg>Bank Accounts</div>
      <div class="card-body">
        ${(typeof finance !== 'undefined' && finance) ? `
        <div class="mb-3 pb-3 border-bottom">
          <div class="row g-3">
            <div class="col-md-4">
              <div class="text-muted small text-uppercase" style="letter-spacing:.5px">Total Cash Position</div>
              <div class="fs-2 fw-bold text-success">$${finance.cashPosition.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})}</div>
              <div class="text-muted small">$${finance.bankCash.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})} available in bank${finance.stripeIncoming > 0 ? ' + $' + finance.stripeIncoming.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' on the way from Stripe' : ''}</div>
              <div class="d-flex align-items-center gap-2 mt-1">
                <button type="button" id="bankSyncBtn" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:12px">
                  <svg class="bm-i me-1" aria-hidden="true"><use href="#i-rotate"/></svg>Sync now
                </button>
                <span id="bankSyncedAt" class="small ${finance.bankAgeMins != null && finance.bankAgeMins > 120 ? 'text-warning fw-semibold' : 'text-muted'}">
                  ${finance.bankAgeMins == null ? 'never synced'
                    : finance.bankAgeMins < 2 ? 'just now'
                    : finance.bankAgeMins < 60 ? 'as of ' + finance.bankAgeMins + ' min ago'
                    : finance.bankAgeMins < 1440 ? 'as of ' + Math.round(finance.bankAgeMins/60) + 'h ago'
                    : 'as of ' + Math.round(finance.bankAgeMins/1440) + 'd ago'}
                </span>
              </div>
            </div>
            <div class="col-md-4">
              <div class="text-muted small text-uppercase" style="letter-spacing:.5px">
                <!-- R11. This read "SALES TAX OWED  $-350.72" in green: a negative
                     number, with a minus sign, under the word OWED, coloured as good
                     news. It takes a beat to work out that it means the state owes YOU
                     $350.72. The label carries the direction now and the figure is
                     always positive, so there is nothing to decode.
                     Colour: red when a bill is coming, because that is money leaving.
                     Overpaid is NOT green -- green is money in, and an overpayment is a
                     receivable from the OTC, not cash. It reads neutral. -->
                ${parseFloat(analytics.taxOwed) < 0 ? 'Sales Tax Overpaid' : 'Sales Tax Owed'}
                <svg class="bm-i ms-1" style="opacity:.5" title="Tax collected on events that have already happened, less what has been remitted to the OTC. Updates automatically the morning after an OkTAP payment clears your bank." aria-hidden="true"><use href="#i-circle-info"/></svg>
              </div>
              <div class="fs-2 fw-bold ${parseFloat(analytics.taxOwed) > 0 ? 'text-danger' : ''}">$${Math.abs(parseFloat(analytics.taxOwed)).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})}</div>
              <div class="text-muted small">
                ${parseFloat(analytics.taxOwed) < 0 ? 'Remitted more than was collected &mdash; the OTC is holding this.<br>' : ''}$${parseFloat(analytics.taxCollectedDelivered).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})} collected &minus; $${parseFloat(analytics.taxRemitted).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})} remitted${analytics.taxNotYetDue > 0 ? '<br>+ $' + parseFloat(analytics.taxNotYetDue).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' collected, not due yet' : ''}
              </div>
            </div>
            <div class="col-md-4">
              <!-- R9. This column used to restate Safe to Spend in 32px type, two inches
                   below the card at the top of the page that already says it -- and to two
                   decimals where the card shows none, so the same figure appeared as $758
                   and $758.22. The top row was promoted precisely so this number would be
                   the first thing on the screen; repeating it here spent that promotion.
                   What the panel is for is the WORKING: what came off the bank balance to
                   get there. That is what it shows now. -->
              <div class="text-muted small text-uppercase" style="letter-spacing:.5px">
                Held back from Safe to Spend
                <svg class="bm-i ms-1" style="opacity:.5" title="Bank available balance, minus sales tax held for Oklahoma, minus recurring money already committed (storage, the loan to Reagan, rent). Do not go below zero." aria-hidden="true"><use href="#i-circle-info"/></svg>
              </div>
              <div class="text-muted small">
                ${finance.safeToSpend < 0
                  ? '<span class="text-danger fw-semibold">Committed money exceeds what is in the bank.</span>'
                  : 'Taken off the bank balance to reach the figure at the top of the page'}
              </div>
              ${(finance.obligations && finance.obligations.items.length) ? `
              <div class="small text-muted mt-2 pt-2" style="border-top:1px dashed rgba(0,0,0,.12)">
                ${finance.obligations.items.map(function(o) {
                  return '<div class="d-flex justify-content-between"><span>' + o.name +
                    (o.overdue ? ' <span class="text-danger fw-semibold">overdue</span>' : '') +
                    ' <span class="text-muted">' + o.period + '</span></span><span>$' +
                    o.amount.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) + '</span></div>';
                }).join('')}
                <div class="d-flex justify-content-between fw-semibold"><span>Committed</span><span>$${finance.obligations.total.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})}</span></div>
                <a href="/admin/obligations" class="d-inline-block mt-1" style="font-size:.7rem">Manage recurring costs</a>
              </div>` : `
              <div class="small mt-2"><a href="/admin/obligations" style="font-size:.7rem">Add recurring costs</a></div>`}
            </div>
          </div>
          <div class="d-flex justify-content-between align-items-center small text-muted mt-3 pt-2 border-top">
            <!-- R9: the sentence explains the card at the top of the page; it does not
                 need to print the same figure again beside it. -->
            <span class="text-muted">Net liquid position is bank + Stripe &minus; card debt &mdash; shown at the top</span>
          </div>
        </div>` : ''}
        <div class="row g-3">
          ${(bankAccounts || []).map(a => {
            const isCredit = a.type === 'credit';
            const fmt = (v, d=2) => v == null ? '—' : '$' + parseFloat(v).toLocaleString('en-US', {minimumFractionDigits:d, maximumFractionDigits:d});
            // R11. This said "Avail. credit $-73", which means the card is SEVENTY-THREE
            // DOLLARS OVER ITS LIMIT -- the most actionable fact in this panel, rendered
            // as a minus sign in 13px grey under a 24px balance. A negative available
            // balance is not a small number, it is a different situation, so it says so
            // and takes the colour money leaving gets.
            const overLimit = isCredit && a.available != null && parseFloat(a.available) < 0;
            const sub = overLimit
              ? '<span class="text-danger fw-semibold">Over limit by ' + fmt(Math.abs(parseFloat(a.available)), 0) + '</span>'
              : isCredit
                ? (a.available == null ? '' : 'Avail. credit ' + fmt(a.available, 0))
                : (a.available == null ? '' : 'Available ' + fmt(a.available));
            const synced = a.last_synced ? new Date(a.last_synced).toLocaleString('en-US', {month:'short', day:'numeric', hour:'numeric', minute:'2-digit'}) : 'never';
            const stale = a.status && a.status !== 'ok';
            return `
            <div class="col-md-4">
              <!-- R8: no h-100. The Stripe tile carries a sparkline and three payouts and
                   is naturally much taller; matching the plain account tiles to it gave
                   each of them ~150px of nothing. They are peer objects, so they sit
                   top-aligned at their own heights instead. -->
              <div class="border rounded p-3">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <span class="fw-semibold">${a.name}</span>
                  ${stale ? `<span class="badge bg-warning text-dark">${a.status}</span>` : ''}
                </div>
                <div class="fs-4 fw-bold ${isCredit ? 'text-danger' : 'text-success'}">${isCredit && a.balance != null ? '-' : ''}${fmt(a.balance)}</div>
                <div class="text-muted small">${sub}</div>
                <div class="text-muted small mt-1"><svg class="bm-i me-1" aria-hidden="true"><use href="#i-clock"/></svg>Synced ${synced}</div>
              </div>
            </div>`;
          }).join('')}
          ${stripePayouts ? `
          <div class="col-md-4">
            <div class="border rounded p-3" style="border-color:#635bff !important">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="fw-semibold"><svg class="bm-i me-1" style="color:#635bff" aria-hidden="true"><use href="#i-stripe-s"/></svg> Stripe Payouts</span>
                ${stripePayouts.interval ? '<span class="badge bg-light text-body text-capitalize">' + stripePayouts.interval + '</span>' : ''}
              </div>
              <div class="fs-4 fw-bold text-success">$${(stripePayouts.pendingCents / 100).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})}</div>
              <div class="text-muted small">Incoming${(stripePayouts.pendingCents > 0 && stripePayouts.nextPayoutDate) ? ' • arrives ~' + new Date(stripePayouts.nextPayoutDate).toLocaleDateString('en-US', {weekday:'short', month:'short', day:'numeric'}) : ''}</div>
              ${(stripePayouts.spark && stripePayouts.spark.length) ? '<div class="mt-2">' + (function(){ var s = stripePayouts.spark; var mx = Math.max.apply(null, s.concat([1])); var bw=6, g=3, h=28; var bars = s.map(function(v,i){ var bh = Math.max(2, Math.round(v/mx*h)); return '<rect x="'+(i*(bw+g))+'" y="'+(h-bh)+'" width="'+bw+'" height="'+bh+'" rx="2" fill="var(--bm-fb-good)"></rect>'; }).join(''); return '<svg role="img" aria-label="Payouts over the last 30 days" width="'+(s.length*(bw+g))+'" height="'+h+'" style="max-width:100%">' + '<title>Payouts over the last 30 days</title>' + bars + '</svg>'; })() + '<div class="d-flex justify-content-between text-muted mt-1" style="font-size:11px"><span>30-day payouts</span><span class="fw-semibold text-dark">$' + (stripePayouts.last30Total/100).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) + '</span></div></div>' : ''}
              ${(stripePayouts.recent && stripePayouts.recent.length) ? '<hr class="my-2"><div class="small">' + stripePayouts.recent.slice(0,3).map(p => { const d = new Date(p.date).toLocaleDateString('en-US',{month:'short',day:'numeric'}); const amt = '$' + (p.amountCents/100).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); const ok = p.status==='paid'; return '<div class="d-flex justify-content-between align-items-center mb-1"><span class="text-muted">' + d + '</span><span>' + amt + ' <span class="badge ' + (ok?'bg-success-subtle text-success':'bg-warning-subtle text-warning') + '" style="font-size:10px">' + p.status + '</span></span></div>'; }).join('') + '</div>' : ''}
            </div>
          </div>` : ''}
        </div>
        ${(!bankAccounts || !bankAccounts.length) && !stripePayouts ? `<div class="text-muted text-center py-3">No accounts synced yet.</div>` : ''}
      </div>
    </div>
  </div>
</div>

<!-- Analytics Row 1: Financial Health + Pipeline + CC Debt.
     R8. These were three equal columns, all h-100, so Pipeline and Credit Card Debt were
     each stretched to Financial Health's height: about 470px of card holding three lines
     of content. Two enormous voids, side by side, and the most visible thing on the page
     that nobody had decided to put there.
     Financial Health is genuinely a tall card -- a figure, a progress bar, a three-cell
     table, a break-even row. The other two are each ONE NUMBER. So one wide column for
     the tall card, and the two short ones stacked in a narrow column beside it, each at
     its own height. Nothing is stretched to match anything. -->
<div class="row g-4 mb-4">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header fw-semibold"><svg class="bm-i me-2" aria-hidden="true"><use href="#i-chart-line"/></svg>Financial Health</div>
      <div class="card-body">
        <div class="text-center mb-3">
          <div class="text-muted small mb-1">Net Position</div>
          <div class="fs-2 fw-bold ${analytics.netPosition >= 0 ? 'text-success' : 'text-danger'}">
            ${analytics.netPosition >= 0 ? '+' : '−'}$${Math.abs(analytics.netPosition).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})}
          </div>
        </div>
        <div class="mb-2">
          <div class="d-flex justify-content-between small mb-1">
            <span class="text-muted">Investment Recovered</span>
            <strong>${parseFloat(analytics.recoveryPct).toFixed(1)}%</strong>
          </div>
          <div class="progress" style="height:8px">
            <div class="progress-bar ${analytics.recoveryPct >= 100 ? 'bg-success' : 'bg-warning'}" style="width:${Math.min(analytics.recoveryPct, 100)}%"></div>
          </div>
          <div class="d-flex justify-content-between small text-muted mt-1">
            <span>$${parseFloat(analytics.earnedNetOfTax).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})} earned to date</span>
            <span>$${parseFloat(analytics.operatingExpenses).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})} invested</span>
          </div>
