<%- include('../layouts/admin', { body: `

<!-- Stats Row -->
<div class="row g-4 mb-4">
  <div class="col-6 col-md-3">
    <a href="/admin/calendar" class="text-decoration-none">
      <div class="stat-card" style="cursor:pointer">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label">Today's Events</div>
            <div class="stat-value">${stats.todayBookings}</div>
          </div>
          <div class="stat-icon" style="background:rgba(255,107,53,0.1);color:#FF6B35"><i class="fas fa-calendar-day"></i></div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-md-3">
    <a href="/admin/reports" class="text-decoration-none">
      <div class="stat-card" style="cursor:pointer">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label">Month Revenue</div>
            <div class="stat-value">$${parseFloat(stats.monthRevenue).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})}</div>
          </div>
          <div class="stat-icon" style="background:rgba(46,204,113,0.1);color:#2ECC71"><i class="fas fa-dollar-sign"></i></div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-md-3">
    <a href="/admin/bookings?status=pending" class="text-decoration-none">
      <div class="stat-card" style="cursor:pointer">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label">Pending Bookings</div>
            <div class="stat-value">${stats.pendingBookings}</div>
          </div>
          <div class="stat-icon" style="background:rgba(243,156,18,0.1);color:#F39C12"><i class="fas fa-clock"></i></div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-md-3">
    <a href="/admin/customers" class="text-decoration-none">
      <div class="stat-card" style="cursor:pointer">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label">Total Customers</div>
            <div class="stat-value">${stats.totalCustomers}</div>
          </div>
          <div class="stat-icon" style="background:rgba(0,78,137,0.1);color:#004E89"><i class="fas fa-users"></i></div>
        </div>
      </div>
    </a>
  </div>
</div>

<!-- Bank Accounts (live balances from titan bank sync) -->
<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card">
      <div class="card-header fw-semibold"><i class="fas fa-university me-2"></i>Bank Accounts</div>
      <div class="card-body">
        ${(typeof finance !== 'undefined' && finance) ? `
        <div class="mb-3 pb-3 border-bottom">
          <div class="row g-3">
            <div class="col-md-4">
              <div class="text-muted small text-uppercase" style="letter-spacing:.5px">Total Cash Position</div>
              <div class="fs-2 fw-bold text-success">$${finance.cashPosition.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})}</div>
              <div class="text-muted small">$${finance.bankCash.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})} available in bank${finance.stripeIncoming > 0 ? ' + $' + finance.stripeIncoming.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' on the way from Stripe' : ''}</div>
            </div>
            <div class="col-md-4">
              <div class="text-muted small text-uppercase" style="letter-spacing:.5px">
                Sales Tax Owed
                <i class="fas fa-circle-info ms-1" style="opacity:.5"
                   title="Tax collected on events that have already happened, less what has been remitted to the OTC. Updates automatically the morning after an OkTAP payment clears your bank."></i>
              </div>
              <div class="fs-2 fw-bold ${analytics.taxOwed > 0 ? 'text-danger' : 'text-success'}">$${parseFloat(analytics.taxOwed).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})}</div>
              <div class="text-muted small">
                $${parseFloat(analytics.taxCollectedDelivered).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})} collected &minus; $${parseFloat(analytics.taxRemitted).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})} remitted${analytics.taxNotYetDue > 0 ? '<br>+ $' + parseFloat(analytics.taxNotYetDue).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' collected, not due yet' : ''}
              </div>
            </div>
            <div class="col-md-4">
              <div class="text-muted small text-uppercase" style="letter-spacing:.5px">
                Safe to Spend
                <i class="fas fa-circle-info ms-1" style="opacity:.5"
                   title="Bank available balance minus every dollar of sales tax you are holding for Oklahoma — both what is due now and what is collected but not yet due. Do not go below zero."></i>
              </div>
              <div class="fs-2 fw-bold ${finance.safeToSpend >= 0 ? 'text-success' : 'text-danger'}">${finance.safeToSpend < 0 ? '−' : ''}$${Math.abs(finance.safeToSpend).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})}</div>
              <div class="text-muted small">
                ${finance.safeToSpend < 0
                  ? '<span class="text-danger fw-semibold">You are holding more tax than you have in the bank.</span>'
                  : 'Bank available less tax held for the state'}
              </div>
            </div>
          </div>
          <div class="d-flex justify-content-between align-items-center small text-muted mt-3 pt-2 border-top">
            <span>Net liquid position <span class="text-muted">(bank + Stripe &minus; card)</span></span>
            <strong class="${finance.netLiquid >= 0 ? 'text-success' : 'text-danger'}">${finance.netLiquid < 0 ? '−' : ''}$${Math.abs(finance.netLiquid).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})}</strong>
          </div>
        </div>` : ''}
        <div class="row g-3">
          ${(bankAccounts || []).map(a => {
            const isCredit = a.type === 'credit';
            const fmt = (v, d=2) => v == null ? '—' : '$' + parseFloat(v).toLocaleString('en-US', {minimumFractionDigits:d, maximumFractionDigits:d});
            const sub = isCredit
              ? (a.available == null ? '' : 'Avail. credit ' + fmt(a.available, 0))
              : (a.available == null ? '' : 'Available ' + fmt(a.available));
            const synced = a.last_synced ? new Date(a.last_synced).toLocaleString('en-US', {month:'short', day:'numeric', hour:'numeric', minute:'2-digit'}) : 'never';
            const stale = a.status && a.status !== 'ok';
            return `
            <div class="col-md-4">
              <div class="border rounded p-3 h-100">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <span class="fw-semibold">${a.name}</span>
                  ${stale ? `<span class="badge bg-warning text-dark">${a.status}</span>` : ''}
                </div>
                <div class="fs-4 fw-bold ${isCredit ? 'text-danger' : 'text-success'}">${isCredit && a.balance != null ? '-' : ''}${fmt(a.balance)}</div>
                <div class="text-muted small">${sub}</div>
                <div class="text-muted small mt-1"><i class="far fa-clock me-1"></i>Synced ${synced}</div>
              </div>
            </div>`;
          }).join('')}
          ${stripePayouts ? `
          <div class="col-md-4">
            <div class="border rounded p-3 h-100" style="border-color:#635bff !important">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="fw-semibold"><i class="fab fa-stripe-s me-1" style="color:#635bff"></i> Stripe Payouts</span>
                ${stripePayouts.interval ? '<span class="badge bg-light text-muted text-capitalize">' + stripePayouts.interval + '</span>' : ''}
              </div>
              <div class="fs-4 fw-bold text-success">$${(stripePayouts.pendingCents / 100).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})}</div>
              <div class="text-muted small">Incoming${(stripePayouts.pendingCents > 0 && stripePayouts.nextPayoutDate) ? ' • arrives ~' + new Date(stripePayouts.nextPayoutDate).toLocaleDateString('en-US', {weekday:'short', month:'short', day:'numeric'}) : ''}</div>
              ${(stripePayouts.spark && stripePayouts.spark.length) ? '<div class="mt-2">' + (function(){ var s = stripePayouts.spark; var mx = Math.max.apply(null, s.concat([1])); var bw=6, g=3, h=28; var bars = s.map(function(v,i){ var bh = Math.max(2, Math.round(v/mx*h)); return '<rect x="'+(i*(bw+g))+'" y="'+(h-bh)+'" width="'+bw+'" height="'+bh+'" rx="2" fill="#198754"></rect>'; }).join(''); return '<svg role="img" aria-label="Payouts over the last 30 days" width="'+(s.length*(bw+g))+'" height="'+h+'" style="max-width:100%">' + '<title>Payouts over the last 30 days</title>' + bars + '</svg>'; })() + '<div class="d-flex justify-content-between text-muted mt-1" style="font-size:11px"><span>30-day payouts</span><span class="fw-semibold text-dark">$' + (stripePayouts.last30Total/100).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) + '</span></div></div>' : ''}
              ${(stripePayouts.recent && stripePayouts.recent.length) ? '<hr class="my-2"><div class="small">' + stripePayouts.recent.slice(0,3).map(p => { const d = new Date(p.date).toLocaleDateString('en-US',{month:'short',day:'numeric'}); const amt = '$' + (p.amountCents/100).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); const ok = p.status==='paid'; return '<div class="d-flex justify-content-between align-items-center mb-1"><span class="text-muted">' + d + '</span><span>' + amt + ' <span class="badge ' + (ok?'bg-success-subtle text-success':'bg-warning-subtle text-warning') + '" style="font-size:10px">' + p.status + '</span></span></div>'; }).join('') + '</div>' : ''}
            </div>
          </div>` : ''}
        </div>
        ${(!bankAccounts || !bankAccounts.length) && !stripePayouts ? `<div class="text-muted text-center py-3">No accounts synced yet.</div>` : ''}
      </div>
    </div>
  </div>
</div>

<!-- Analytics Row 1: Financial Health + Pipeline + CC Debt -->
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header fw-semibold"><i class="fas fa-chart-line me-2"></i>Financial Health</div>
      <div class="card-body">
        <div class="text-center mb-3">
          <div class="text-muted small mb-1">Net Position</div>
          <div class="fs-2 fw-bold ${analytics.netPosition >= 0 ? 'text-success' : 'text-danger'}">
            ${analytics.netPosition >= 0 ? '+' : '−'}$${Math.abs(analytics.netPosition).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})}
          </div>
        </div>
        <div class="mb-2">
          <div class="d-flex justify-content-between small mb-1">
            <span class="text-muted">Investment Recovered</span>
            <strong>${parseFloat(analytics.recoveryPct).toFixed(1)}%</strong>
          </div>
          <div class="progress" style="height:8px">
            <div class="progress-bar ${analytics.recoveryPct >= 100 ? 'bg-success' : 'bg-warning'}" style="width:${Math.min(analytics.recoveryPct, 100)}%"></div>
          </div>
          <div class="d-flex justify-content-between small text-muted mt-1">
            <span>$${parseFloat(analytics.earnedNetOfTax).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})} earned to date</span>
            <span>$${parseFloat(analytics.operatingExpenses).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})} invested</span>
          </div>
        </div>
        ${Math.abs(analytics.booksGap) > 0.01 ? `
        <div class="alert alert-danger py-2 px-3 small mb-2" role="alert">
          <i class="fas fa-triangle-exclamation me-1"></i><strong>Books don't balance by $${Math.abs(analytics.booksGap).toFixed(2)}.</strong>
          Booked should equal collected plus still-owed. Usually a booking carrying a deposit that was never paid.
        </div>` : ''}
        <div class="row g-0 text-center border rounded mb-2 py-2">
          <div class="col-4">
            <div class="text-muted" style="font-size:0.7rem" title="Every live booking including events that have not happened yet. Not the same as earned.">BOOKED (INCL. FUTURE)</div>
            <div class="fw-bold small">${parseFloat(analytics.totalRevenue).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})}</div>
          </div>
          <div class="col-4 border-start border-end">
            <div class="text-muted" style="font-size:0.7rem" title="Everything ever collected, net of refunds. This is not your bank balance — see Safe to Spend above.">COLLECTED TO DATE</div>
            <div class="fw-bold small text-success">${parseFloat(analytics.cashCollected).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})}</div>
          </div>
          <div class="col-4">
            <div class="text-muted" style="font-size:0.7rem">STILL OWED</div>
            <div class="fw-bold small text-warning">${parseFloat(analytics.balanceOwed).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})}</div>
          </div>
        </div>
        ${analytics.reimburseOwed > 0 ? `
        <a href="/admin/expenses" class="text-decoration-none">
          <div class="d-flex justify-content-between align-items-center border rounded px-3 py-2">
            <span class="small"><i class="fas fa-hand-holding-usd me-1 text-muted"></i>Owed back to you <span class="text-muted">— already counted above</span></span>
            <strong class="text-muted">$${parseFloat(analytics.reimburseOwed).toLocaleString('en-US', {minimumFractionDigits:2,maximumFractionDigits:2})}</strong>
          </div>
        </a>` : ''}
        ${analytics.breakEven && analytics.breakEven.status === 'projected' ? `
        <div class="d-flex justify-content-between align-items-center border rounded px-3 py-2 mt-2"
             title="Estimate: ~${analytics.breakEven.bookingsNeeded} more bookings to cover the remaining deficit, at your recent booking pace, stretched for the OK off-season (season modelled as ~6.5 active months). Updates live as bookings come in.">
          <span class="small"><i class="fas fa-flag-checkered me-1 text-primary"></i>Est. break-even</span>
          <span><strong>${analytics.breakEven.date}</strong> <span class="text-muted small">~${analytics.breakEven.bookingsNeeded} bookings</span></span>
        </div>` : analytics.breakEven && analytics.breakEven.status === 'reached' ? `
        <div class="d-flex justify-content-between align-items-center border border-success rounded px-3 py-2 mt-2">
          <span class="small text-success"><i class="fas fa-flag-checkered me-1"></i>Broke even</span>
          <strong class="text-success">🎉</strong>
        </div>` : ''}
        <hr class="my-2">
        <div class="d-flex justify-content-between small">
          <span class="text-muted">Avg ticket</span>
          <strong>$${parseFloat(analytics.avgTicket).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})}</strong>
        </div>
        <div class="d-flex justify-content-between small mt-1">
          <span class="text-muted">Bookings to break even</span>
          <strong class="${analytics.bookingsToBreakEven > 0 ? 'text-warning' : 'text-success'}">${analytics.bookingsToBreakEven > 0 ? '~' + analytics.bookingsToBreakEven + ' more' : 'Profitable!'}</strong>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header fw-semibold"><i class="fas fa-filter me-2"></i>Confirmed Pipeline</div>
      <div class="card-body text-center d-flex flex-column justify-content-center">
        <div class="text-muted small mb-1">Upcoming Booking Revenue</div>
        <div class="fs-2 fw-bold text-primary mb-3">$${parseFloat(analytics.pipeline.r).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0})}</div>
        <div class="badge bg-light text-dark fs-6 mb-3">${analytics.pipeline.c} upcoming event${analytics.pipeline.c !== 1 ? 's' : ''}</div>
        <a href="/admin/bookings" class="btn btn-sm btn-outline-primary">View All Bookings</a>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
        <span><i class="fas fa-credit-card me-2"></i>Credit Card Debt</span>
        <button class="btn btn-sm btn-link p-0 text-muted" data-bs-toggle="collapse" data-bs-target="#ccDebtEdit"><i class="fas fa-pencil-alt fa-xs"></i></button>
      </div>
      <div class="card-body text-center d-flex flex-column justify-content-center">
        <div class="text-muted small mb-1">Chase Ink — ending 7513</div>
        <div class="fs-2 fw-bold text-danger mb-2">$${parseFloat(analytics.creditCardDebt).toLocaleString('en-US', {minimumFractionDigits:2,maximumFractionDigits:2})}</div>
        <div class="text-muted small mb-3">as of last update</div>
        <div class="collapse" id="ccDebtEdit">
          <form method="POST" action="/admin/settings/credit-card-debt" class="d-flex gap-2 justify-content-center mt-1">
            <div class="input-group input-group-sm" style="max-width:180px">
              <span class="input-group-text">$</span>
              <input type="number" name="amount" class="form-control" step="0.01" value="${parseFloat(analytics.creditCardDebt).toFixed(2)}" placeholder="0.00">
            </div>
            <button type="submit" class="btn btn-sm btn-bm">Save</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Analytics Row 2: Monthly Chart + Equipment Utilization -->
<div class="row g-4 mb-4">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header fw-semibold"><i class="fas fa-chart-bar me-2"></i>Monthly Revenue (Last 6 Months)</div>
      <div class="card-body">
        <canvas id="monthlyRevenueChart" height="120"></canvas>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header fw-semibold"><i class="fas fa-boxes me-2"></i>Equipment Utilization</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <thead><tr><th class="ps-3">Unit</th><th class="text-center">Jobs</th><th class="pe-3">Revenue</th></tr></thead>
          <tbody>
            ${equipmentUtil.length > 0 ? equipmentUtil.map(e => `
            <tr>
              <td class="ps-3 small">${e.name}</td>
              <td class="text-center"><span class="badge bg-secondary">${e.bookings}</span></td>
              <td class="pe-3 small fw-semibold text-success">$${parseFloat(e.revenue).toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:0})}</td>
            </tr>
            `).join('') : '<tr><td colspan="3" class="text-center text-muted py-3 small">No booking data yet</td></tr>'}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Upcoming Events + Quick Actions -->
<div class="row g-4 mb-4">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-calendar-check me-2"></i>Upcoming Events</span>
        <a href="/admin/bookings" class="btn btn-sm btn-bm">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 rtable">
            <thead><tr><th>Date</th><th>Customer</th><th>Time</th><th>Status</th><th></th></tr></thead>
            <tbody>
              ${upcoming.length > 0 ? upcoming.map(b => `
              <tr style="cursor:pointer" data-booking-href="/admin/bookings/${b.id}">
                <td data-label="Date"><strong>${b.event_date}</strong>${(function(s,e){if(!e||e===s)return'';try{var d=Math.round((new Date(e+'T12:00:00')-new Date(s+'T12:00:00'))/86400000)+1;return ' <span class="badge bg-secondary" title="'+s+' to '+e+'">'+d+'d</span>';}catch(_){return''}})(b.event_date,b.event_end_date)}</td>
                <td class="rt-primary">${esc(b.first_name)} ${esc(b.last_name)}</td>
                <td data-label="Time">${(function(t){if(!t)return'';var p=t.split(':');var h=parseInt(p[0]);var m=p[1]||'00';var a=h>=12?'PM':'AM';h=h>12?h-12:(h==0?12:h);return h+':'+m+' '+a})(b.event_start_time)} - ${(function(t){if(!t)return'';var p=t.split(':');var h=parseInt(p[0]);var m=p[1]||'00';var a=h>=12?'PM':'AM';h=h>12?h-12:(h==0?12:h);return h+':'+m+' '+a})(b.event_end_time)}</td>
                <td data-label="Status"><span class="badge-status badge-${b.status}">${b.status}</span></td>
                <td class="rt-actions"><a href="/admin/bookings/${b.id}" class="btn btn-sm btn-outline-secondary">View</a></td>
              </tr>
              `).join('') : '<tr><td colspan="5" class="text-center text-muted py-4">No upcoming events</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-bolt me-2"></i>Quick Actions</div>
      <div class="card-body d-grid gap-2">
        <a href="/admin/bookings/new" class="btn btn-bm btn-sm"><i class="fas fa-plus me-2"></i>Add Booking</a>
        <a href="/admin/bookings?status=pending" class="btn btn-warning btn-sm"><i class="fas fa-clock me-2"></i>Pending (${stats.pendingBookings})</a>
        <a href="/admin/equipment/new" class="btn btn-bm btn-sm"><i class="fas fa-plus me-2"></i>Add Equipment</a>
        <a href="/admin/calendar" class="btn btn-outline-primary btn-sm"><i class="fas fa-calendar me-2"></i>View Calendar</a>
        <a href="/admin/reviews" class="btn btn-outline-secondary btn-sm"><i class="fas fa-star me-2"></i>Reviews (${stats.pendingReviews} pending)</a>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><i class="fas fa-info-circle me-2"></i>Inventory</div>
      <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
          <span>Total Equipment</span><strong>${stats.totalEquipment}</strong>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span>Unsigned Contracts</span><strong class="text-warning">${stats.unsignedContracts}</strong>
        </div>
        <div class="d-flex justify-content-between">
          <span>Week Bookings</span><strong>${stats.weekBookings}</strong>
        </div>
      </div>
    </div>
  </div>
</div>

`, scripts: `
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"><\/script>
<script>
document.addEventListener("click", function(e) {
  var row = e.target.closest("[data-booking-href]");
  if (row && !e.target.closest("a,button")) window.location = row.dataset.bookingHref;
});
(function() {
  var labels = ${JSON.stringify(monthlyRevenue.map(m => m.label))};
  var data = ${JSON.stringify(monthlyRevenue.map(m => parseFloat(m.revenue.toFixed(2))))};
  var ctx = document.getElementById("monthlyRevenueChart");
  if (!ctx) return;
  new Chart(ctx, {
    type: "bar",
    data: {
      labels: labels,
