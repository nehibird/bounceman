<%- include('../layouts/admin', { body: `

<h4 class="mb-4">Settings</h4>


<!-- Tab Navigation -->
<ul class="nav nav-tabs mb-4 flex-nowrap overflow-auto" id="settingsTabs" role="tablist">
  <li class="nav-item">
    <button class="nav-link active" id="business-tab" data-bs-toggle="tab" data-bs-target="#business" type="button">
      <i class="fas fa-building me-1"></i> Business
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link" id="zones-tab" data-bs-toggle="tab" data-bs-target="#zones" type="button">
      <i class="fas fa-map me-1"></i> Delivery Zones
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link" id="email-tab" data-bs-toggle="tab" data-bs-target="#emails" type="button">
      <i class="fas fa-envelope me-1"></i> Email Templates
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link" id="codes-tab" data-bs-toggle="tab" data-bs-target="#codes" type="button">
      <i class="fas fa-tag me-1"></i> Discount Codes
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button">
      <i class="fas fa-users me-1"></i> Users
    </button>
  </li>
</ul>

<div class="tab-content">

  <!-- Business Settings Tab -->
  <div class="tab-pane fade show active" id="business" role="tabpanel">
    <div class="card">
      <div class="card-body">
        <div id="settings-saved-alert" class="alert alert-success d-none mb-3">
          <i class="fas fa-check-circle me-1"></i> Settings saved!
        </div>
        <form method="POST" action="/admin/settings">
          <h6 class="text-muted mb-3">Company Information</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label">Company Name</label>
              <input type="text" name="company_name" class="form-control" value="${settings.company_name || ''}">
            </div>
            <div class="col-md-6">
              <label class="form-label">Company Email</label>
              <input type="email" name="company_email" class="form-control" value="${settings.company_email || ''}">
            </div>
            <div class="col-md-6">
              <label class="form-label">Company Phone</label>
              <input type="text" name="company_phone" class="form-control" value="${settings.company_phone || ''}">
            </div>
            <div class="col-md-6">
              <label class="form-label">Company Address</label>
              <input type="text" name="company_address" class="form-control" value="${settings.company_address || ''}">
            </div>
          </div>

          <h6 class="text-muted mb-3">Pricing & Policies</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-3">
              <label class="form-label">Sales Tax</label>
              <div class="form-control-plaintext small text-muted">
                Per delivery city &mdash; <a href="/admin/reports">see the OkTAP worksheet</a>
              </div>
              <div class="form-text" style="font-size:11px">
                Tonkawa 10.25% &middot; Ponca City 9.583% &middot; Blackwell 10.75% &middot; Newkirk 9.75%.
                Rates come from the OTC chart, not a setting.
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Deposit (%)</label>
              <input type="number" name="deposit_percent" class="form-control" step="1" value="${settings.deposit_percent || ''}">
            </div>
            <div class="col-md-3">
              <label class="form-label">Damage Waiver Fee ($)</label>
              <input type="number" name="damage_waiver_fee" class="form-control" step="0.01" value="${settings.damage_waiver_fee || ''}">
            </div>
            <div class="col-md-3">
              <label class="form-label">Cancellation Hours</label>
              <input type="number" name="cancellation_hours" class="form-control" value="${settings.cancellation_hours || ''}">
            </div>
          </div>

          <h6 class="text-muted mb-3">SEO & Branding</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label">Meta Title</label>
              <input type="text" name="meta_title" class="form-control" value="${settings.meta_title || ''}">
            </div>
            <div class="col-md-6">
              <label class="form-label">Meta Description</label>
              <input type="text" name="meta_description" class="form-control" value="${settings.meta_description || ''}">
            </div>
            <div class="col-md-3">
              <label class="form-label">Primary Color</label>
              <div class="input-group">
                <input type="color" name="primary_color" class="form-control form-control-color" value="${settings.primary_color || '#FF6B35'}" style="width:50px">
                <input type="text" class="form-control" value="${settings.primary_color || '#FF6B35'}" readonly>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Secondary Color</label>
              <div class="input-group">
                <input type="color" name="secondary_color" class="form-control form-control-color" value="${settings.secondary_color || '#004E89'}" style="width:50px">
                <input type="text" class="form-control" value="${settings.secondary_color || '#004E89'}" readonly>
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-bm"><i class="fas fa-save me-1"></i> Save Settings</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Delivery Zones Tab -->
  <div class="tab-pane fade" id="zones" role="tabpanel">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Delivery Zones</span>
        <a href="/admin/settings/zones/new" class="btn btn-sm btn-bm"><i class="fas fa-plus me-1"></i> Add Zone</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead><tr><th>Zone Name</th><th>ZIP Codes</th><th>Delivery Fee</th><th>Min Order</th><th></th></tr></thead>
            <tbody>
              ${zones.length > 0 ? zones.map(function(z) { return '<tr><td><strong>' + (z.zone_name || z.name || '') + '</strong></td><td><small>' + (z.zip_codes || '') + '</small></td><td>$' + parseFloat(z.delivery_fee || 0).toFixed(2) + '</td><td>$' + parseFloat(z.min_order || 0).toFixed(2) + '</td><td class="text-end"><a href="/admin/settings/zones/' + z.id + '/edit" class="btn btn-sm btn-outline-secondary me-1"><i class="fas fa-edit"></i></a><form method="POST" action="/admin/settings/zones/' + z.id + '/delete" style="display:inline" class="confirm-delete" data-confirm="Are you sure?"><button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></form></td></tr>'; }).join('') : '<tr><td colspan="5" class="text-center text-muted py-3">No delivery zones configured</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Email Templates Tab -->
  <div class="tab-pane fade" id="emails" role="tabpanel">
    <div class="card">
      <div class="card-header">Email Templates</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead><tr><th>Template Name</th><th>Subject</th><th></th></tr></thead>
            <tbody>
              ${emailTemplates.length > 0 ? emailTemplates.map(function(t) { return '<tr><td><strong>' + t.name + '</strong></td><td>' + (t.subject || '') + '</td><td></td></tr>'; }).join('') : '<tr><td colspan="3" class="text-center text-muted py-3">No email templates</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Discount Codes Tab -->
  <div class="tab-pane fade" id="codes" role="tabpanel">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Discount Codes</span>
        <a href="/admin/settings/codes/new" class="btn btn-sm btn-bm"><i class="fas fa-plus me-1"></i> Add Code</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 rtable">
            <thead><tr><th>Code</th><th>Type</th><th>Value</th><th class="d-none d-md-table-cell">Uses</th><th class="d-none d-md-table-cell">Expiry</th><th>Active</th><th></th></tr></thead>
            <tbody>
              ${codes.length > 0 ? codes.map(function(c) { return '<tr><td class="rt-primary"><code class="fw-bold">' + c.code + '</code></td><td data-label="Type">' + (c.type || '') + '</td><td data-label="Value">' + (c.type === 'free' ? 'Entire booking free' : c.type === 'percent' ? c.value + '%' : '$' + parseFloat(c.value || 0).toFixed(2)) + '</td><td class="d-none d-md-table-cell">' + (c.uses_count || 0) + (c.max_uses ? ' / ' + c.max_uses : '') + '</td><td class="d-none d-md-table-cell">' + (c.expires_at || 'Never') + '</td><td data-label="Active"><span class="badge bg-' + (c.active ? 'success' : 'secondary') + '">' + (c.active ? 'Active' : 'Inactive') + '</span></td><td class="rt-actions"><form method="POST" action="/admin/settings/codes/' + c.id + '/toggle" style="display:inline"><button type="submit" class="btn btn-sm btn-outline-' + (c.active ? 'warning' : 'success') + ' me-1"><i class="fas fa-' + (c.active ? 'pause' : 'play') + '"></i></button></form><form method="POST" action="/admin/settings/codes/' + c.id + '/delete" style="display:inline" class="confirm-delete" data-confirm="Are you sure?"><button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></form></td></tr>'; }).join('') : '<tr><td colspan="7" class="text-center text-muted py-3">No discount codes</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Users Tab -->
  <div class="tab-pane fade" id="users" role="tabpanel">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Admin Users</span>
        <a href="/admin/settings/users/new" class="btn btn-sm btn-bm"><i class="fas fa-plus me-1"></i> Add User</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead><tr><th>Email</th><th>Name</th><th>Role</th><th>Active</th><th></th></tr></thead>
            <tbody>
              ${users.length > 0 ? users.map(function(u) { return '<tr><td>' + u.email + '</td><td><strong>' + (u.name || '') + '</strong></td><td><span class="badge bg-' + (u.role === 'admin' ? 'danger' : 'primary') + '">' + (u.role || 'user') + '</span></td><td><span class="badge bg-' + (u.active ? 'success' : 'secondary') + '">' + (u.active ? 'Active' : 'Inactive') + '</span></td><td class="text-end"><a href="/admin/settings/users/' + u.id + '/edit" class="btn btn-sm btn-outline-secondary me-1"><i class="fas fa-edit"></i></a><form method="POST" action="/admin/settings/users/' + u.id + '/toggle" style="display:inline"><button type="submit" class="btn btn-sm btn-outline-' + (u.active ? 'warning' : 'success') + '"><i class="fas fa-' + (u.active ? 'user-slash' : 'user-check') + '"></i></button></form></td></tr>'; }).join('') : '<tr><td colspan="5" class="text-center text-muted py-3">No users found</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</div>

`, scripts: `
<script>
  // Show saved alert if URL has ?saved=1
  if (window.location.search.includes('saved=1')) {
    var alert = document.getElementById('settings-saved-alert');
    if (alert) {
      alert.classList.remove('d-none');
      setTimeout(function() { alert.classList.add('d-none'); }, 4000);
    }
    // Switch to business tab
    var tab = document.getElementById('business-tab');
    if (tab) new bootstrap.Tab(tab).show();
  }
</script>
` }) %>
