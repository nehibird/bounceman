<%- include('../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Reports</h4>
  <div class="d-flex gap-2">
    <a href="/admin/reports?period=week" class="btn btn-sm ${period === 'week' ? 'btn-bm' : 'btn-bm-outline'}">Week</a>
    <a href="/admin/reports?period=month" class="btn btn-sm ${period === 'month' ? 'btn-bm' : 'btn-bm-outline'}">Month</a>
    <a href="/admin/reports?period=quarter" class="btn btn-sm ${period === 'quarter' ? 'btn-bm' : 'btn-bm-outline'}">Quarter</a>
    <a href="/admin/reports?period=year" class="btn btn-sm ${period === 'year' ? 'btn-bm' : 'btn-bm-outline'}">Year</a>
  </div>
</div>

<!-- Stat Cards -->
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="stat-label">Total Revenue</div>
          <div class="stat-value">$${parseFloat(revenue || 0).toFixed(2)}</div>
        </div>
        <div class="stat-icon" style="background:rgba(46,204,113,0.1);color:#2ECC71"><i class="fas fa-dollar-sign"></i></div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="stat-label">Total Bookings</div>
          <div class="stat-value">${bookingCount || 0}</div>
        </div>
        <div class="stat-icon" style="background:rgba(255,107,53,0.1);color:#FF6B35"><i class="fas fa-calendar-check"></i></div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="stat-label">Avg Ticket</div>
          <div class="stat-value">$${parseFloat(avgTicket || 0).toFixed(2)}</div>
        </div>
        <div class="stat-icon" style="background:rgba(0,78,137,0.1);color:#004E89"><i class="fas fa-receipt"></i></div>
      </div>
    </div>
  </div>
</div>

<!-- Charts -->
<div class="row g-4 mb-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header"><i class="fas fa-chart-bar me-2"></i>Revenue by Month</div>
      <div class="card-body">
        <canvas id="revenueChart" height="300"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header"><i class="fas fa-chart-pie me-2"></i>Bookings by Status</div>
      <div class="card-body">
        <canvas id="statusChart" height="300"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- Top Items -->
<div class="card">
  <div class="card-header"><i class="fas fa-trophy me-2"></i>Top Equipment</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>#</th><th>Item</th><th>Rentals</th><th>Revenue</th></tr></thead>
        <tbody>
          ${topItems.length > 0 ? topItems.map(function(item, idx) { return '<tr><td><span class="badge ' + (idx < 3 ? 'bg-warning text-dark' : 'bg-secondary') + '">' + (idx + 1) + '</span></td><td><strong>' + item.item_name + '</strong></td><td>' + item.rentals + '</td><td>$' + parseFloat(item.revenue || 0).toFixed(2) + '</td></tr>'; }).join('') : '<tr><td colspan="4" class="text-center text-muted py-3">No data available</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- OkTAP Return Worksheet — fill form STS-20002-C straight off this -->
<div class="row g-4 mt-1">
  <div class="col-12">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h6 class="mb-0"><i class="fas fa-file-invoice-dollar me-2" style="color:#004E89"></i>OkTAP Return Worksheet
          <span class="text-muted small">— form STS-20002-C (not the superseded -A)</span></h6>
        <form method="GET" class="d-flex align-items-center gap-2">
          <label class="small text-muted mb-0">Filing period</label>
          <select name="month" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
            ${(filingMonths||[]).map(function(m){ return '<option value="'+m+'"'+(m===okReturn.month?' selected':'')+'>'+m+'</option>'; }).join('')}
          </select>
        </form>
      </div>

      ${okReturn.bookings === 0 ? '<div class="text-muted text-center py-4">No events in this period.</div>' : `
      <div class="row g-3">
        <div class="col-lg-5">
          <table class="table table-sm mb-2">
            <tbody>
              <tr><td class="text-muted">Line 1 — Total sales <span class="text-muted small">(gross receipts, tax excluded)</span></td><td class="text-end fw-semibold">$${okReturn.totalSales.toFixed(2)}</td></tr>
              <tr><td class="text-muted">Line 3 — Exemptions <span class="text-muted small">(Schedule J)</span></td><td class="text-end">$${(okReturn.exemptSales + okReturn.deliveryExcluded).toFixed(2)}</td></tr>
              <tr><td class="ps-4 text-muted small">· exempt customers</td><td class="text-end small text-muted">$${okReturn.exemptSales.toFixed(2)}</td></tr>
              <tr><td class="ps-4 text-muted small">· separately-stated delivery <span title="Excluded from the tax base under OAC 710:65-19-70(b)">ⓘ</span></td><td class="text-end small text-muted">$${okReturn.deliveryExcluded.toFixed(2)}</td></tr>
              <tr class="border-top"><td class="fw-semibold">Line 5 — Net taxable sales</td><td class="text-end fw-bold">$${okReturn.taxableSales.toFixed(2)}</td></tr>
              <tr><td class="text-muted">Line 6 — State tax (4.5%)</td><td class="text-end">$${okReturn.stateTax.toFixed(2)}</td></tr>
              <tr><td class="text-muted">Line 7 — City/County <span class="text-muted small">(STS-20021 Item P)</span></td><td class="text-end">$${okReturn.localTax.toFixed(2)}</td></tr>
              <tr class="border-top"><td class="fw-bold">Line 8/11 — TOTAL DUE</td><td class="text-end fw-bold fs-5">$${okReturn.totalDue.toFixed(2)}</td></tr>
            </tbody>
          </table>
          <div class="border rounded p-2 small">
            <div class="d-flex justify-content-between"><span class="text-muted">Already collected from customers</span><span>$${okReturn.taxCollected.toFixed(2)}</span></div>
            <div class="d-flex justify-content-between mt-1"><span class="fw-semibold">Out of your own pocket</span>
              <span class="fw-bold ${okReturn.outOfPocket > 0 ? 'text-danger' : 'text-success'}">$${okReturn.outOfPocket.toFixed(2)}</span></div>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="small text-muted mb-1 fw-semibold">STS-20021 — city &amp; county supplement</div>
          <div class="table-responsive">
            <table class="table table-sm">
              <thead><tr><th>Jurisdiction</th><th class="text-end">Net sales</th><th class="text-end">Rate</th><th class="text-end">Tax</th></tr></thead>
              <tbody>
                ${okReturn.jurisdictions.map(function(j){
                  return '<tr'+(j.resolved?'':' class="table-warning"')+'><td>'+j.city+(j.resolved?'':' <span class="badge bg-danger">unresolved jurisdiction</span>')+'</td>'
                    +'<td class="text-end">$'+j.base.toFixed(2)+'</td>'
                    +'<td class="text-end">'+(j.rate*100).toFixed(3)+'%</td>'
                    +'<td class="text-end">$'+j.tax.toFixed(2)+'</td></tr>';
                }).join('')}
                ${okReturn.counties.map(function(c){
                  return '<tr><td class="text-muted">'+c.county+' COUNTY</td>'
                    +'<td class="text-end text-muted">$'+c.base.toFixed(2)+'</td>'
                    +'<td class="text-end text-muted">'+(c.rate*100).toFixed(3)+'%</td>'
                    +'<td class="text-end text-muted">$'+c.tax.toFixed(2)+'</td></tr>';
                }).join('')}
                <tr class="border-top"><td colspan="3" class="fw-semibold text-end">Item P total &rarr; Line 7</td><td class="text-end fw-bold">$${okReturn.localTax.toFixed(2)}</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      ${okReturn.lines.some(function(l){return l.mismatch || l.unresolved;}) ? `
      <div class="alert alert-warning py-2 px-3 small mt-2 mb-2">
        <i class="fas fa-triangle-exclamation me-1"></i><strong>Some bookings do not match the current rate table.</strong>
        Tax charged at the time differs from what today's rates say, or the jurisdiction cannot be resolved. Review before filing.
      </div>` : ''}

      <div class="table-responsive mt-2">
        <table class="table table-sm table-hover">
          <thead><tr><th>Booking</th><th>Date</th><th>Customer</th><th>City</th><th class="text-end">Taxable</th><th class="text-end">Delivery</th><th class="text-end">Tax charged</th><th class="text-end">Per rate table</th><th>Exempt</th></tr></thead>
          <tbody>
            ${okReturn.lines.map(function(l){
              var cls = l.unresolved ? ' class="table-danger"' : (l.mismatch ? ' class="table-warning"' : '');
              var ex = l.exempt ? (l.cert ? '<span class="badge bg-success">'+l.cert+'</span>' : '<span class="badge bg-danger">UNBACKED</span>') : '';
              return '<tr'+cls+'><td><a href="/admin/bookings?q='+l.booking_number+'">'+l.booking_number+'</a></td>'
                +'<td>'+l.event_date+'</td><td>'+l.who+'</td><td>'+(l.city||'<span class="text-danger">none</span>')+'</td>'
                +'<td class="text-end">$'+l.base.toFixed(2)+'</td>'
                +'<td class="text-end text-muted">'+(l.delivery?'$'+l.delivery.toFixed(2):'—')+'</td>'
                +'<td class="text-end">$'+l.taxCharged.toFixed(2)+'</td>'
                +'<td class="text-end '+(l.mismatch?'fw-bold text-danger':'text-muted')+'">$'+l.shouldBe.toFixed(2)+'</td>'
                +'<td>'+ex+'</td></tr>';
            }).join('')}
          </tbody>
        </table>
      </div>
      <div class="text-muted small mt-1">
        Gross receipts exclude the tax itself. Delivery is in Line 1 and removed again on Schedule J
        (&ldquo;other legal exemptions&rdquo;, note: separately-stated delivery charge). Rates from the
        OTC COPO chart effective Jul&ndash;Sep 2026.
      </div>`}
    </div>
  </div>
</div>

<!-- Sales Tax by Event Month (OkTAP filing basis) -->
<div class="row g-4 mt-1">
  <div class="col-12">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h6 class="mb-0"><i class="fas fa-landmark me-2" style="color:#004E89"></i>Sales Tax by Event Month <span class="text-muted small">— remit on the month the event happens</span></h6>
        <span class="small text-muted">Collected but event not yet occurred: <strong>$${parseFloat(taxCollectedFuture||0).toFixed(2)}</strong></span>
      </div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Event Month</th><th class="text-end">Bookings</th><th class="text-end">Sales (total)</th><th class="text-end">Tax Collected</th></tr></thead>
          <tbody>
            ${(taxByMonth||[]).length ? (taxByMonth||[]).map(function(m){ return '<tr><td>'+(m.month || 'Unknown (missing event date)')+'</td><td class="text-end">'+m.bookings+'</td><td class="text-end">$'+parseFloat(m.total).toFixed(2)+'</td><td class="text-end fw-bold">$'+parseFloat(m.tax).toFixed(2)+'</td></tr>'; }).join('') : '<tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr>'}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Tax Exemptions (verify each) -->
<div class="row g-4 mt-1 mb-2">
  <div class="col-12">
    <div class="stat-card">
      <h6 class="mb-3"><i class="fas fa-file-contract me-2" style="color:#E8833A"></i>Tax Exemptions <span class="text-muted small">— an exemption with no certificate on file is UNBACKED (verify, or it's taxable)</span></h6>
      <div class="table-responsive">
        <table class="table table-sm mb-0 rtable">
          <thead><tr><th>Booking</th><th>Customer</th><th>Event</th><th class="text-end">Total</th><th class="text-end">Tax</th><th>Certificate</th><th title="OAC 710:65-7-6(c)(2) — documentation must be in hand within 90 days of the sale">Docs deadline</th></tr></thead>
          <tbody>
            ${(exemptions||[]).length ? exemptions.map(function(e){ var backed = e.tax_exempt_cert && String(e.tax_exempt_cert).trim(); var dl = (e.days_left==null?null:parseInt(e.days_left)); var clock = backed ? '<span class="text-muted small">—</span>' : (dl==null ? '' : (dl < 0 ? '<span class="badge bg-dark">window closed '+e.docs_due+'</span>' : '<span class="badge '+(dl<=14?'bg-danger':(dl<=30?'bg-warning text-dark':'bg-secondary'))+'">'+dl+'d left · '+e.docs_due+'</span>')); return '<tr'+(backed?'':' class="table-warning"')+'><td class="rt-primary">'+e.booking_number+'</td><td data-label="Customer">'+e.first_name+' '+(e.last_name||'')+'</td><td data-label="Event">'+e.event_date+'</td><td data-label="Total" class="text-end">$'+parseFloat(e.total||0).toFixed(2)+'</td><td data-label="Tax" class="text-end">$'+parseFloat(e.tax_amount||0).toFixed(2)+'</td><td data-label="Certificate">'+(backed ? '<span class="badge bg-success">'+e.tax_exempt_cert+'</span>' : '<span class="badge bg-danger">UNBACKED — review</span>')+'</td><td data-label="Docs deadline">'+clock+'</td></tr>'; }).join('') : '<tr><td colspan="7" class="text-center text-muted py-3">No exemption claims</td></tr>'}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

`, scripts: `
<script>
document.addEventListener('DOMContentLoaded', function() {
  var revenueCtx = document.getElementById('revenueChart').getContext('2d');
  new Chart(revenueCtx, {
    type: 'bar',
    data: {
      labels: [${revenueByMonth.map(function(m) { return "'" + m.month + "'"; }).join(',')}],
      datasets: [{
        label: 'Revenue',
        data: [${revenueByMonth.map(function(m) { return m.revenue; }).join(',')}],
        backgroundColor: 'rgba(255,107,53,0.7)', borderColor: '#FF6B35', borderWidth: 1, borderRadius: 6
      }, {
        label: 'Bookings',
        data: [${revenueByMonth.map(function(m) { return m.bookings; }).join(',')}],
        backgroundColor: 'rgba(0,78,137,0.7)', borderColor: '#004E89', borderWidth: 1, borderRadius: 6, yAxisID: 'y1'
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'top' } },
      scales: {
        y: { beginAtZero: true, ticks: { callback: function(v) { return '$' + v; } } },
        y1: { position: 'right', beginAtZero: true, grid: { drawOnChartArea: false } }
      }
    }
  });

  var statusCtx = document.getElementById('statusChart').getContext('2d');
  var sColors = { pending: '#F39C12', confirmed: '#2ECC71', completed: '#3498DB', cancelled: '#E74C3C' };
  new Chart(statusCtx, {
    type: 'doughnut',
    data: {
      labels: [${statusBreakdown.map(function(s) { return "'" + s.status + "'"; }).join(',')}],
      datasets: [{ data: [${statusBreakdown.map(function(s) { return s.c; }).join(',')}], backgroundColor: [${statusBreakdown.map(function(s) { return "'" + ({pending:'#F39C12',confirmed:'#2ECC71',completed:'#3498DB',cancelled:'#E74C3C'}[s.status] || '#6c757d') + "'"; }).join(',')}], borderWidth: 2, borderColor: '#fff' }]
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } }, cutout: '60%' }
  });
});
</script>
` }) %>
