<%- include('../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <h4 class="mb-0">Calendar</h4>
  <div class="d-flex gap-2 align-items-center flex-wrap">
    <span class="badge bg-warning text-dark"><i class="fas fa-circle me-1" style="font-size:8px"></i> Pending</span>
    <span class="badge bg-success"><i class="fas fa-circle me-1" style="font-size:8px"></i> Confirmed</span>
    <span class="badge bg-primary"><i class="fas fa-circle me-1" style="font-size:8px"></i> Completed</span>
    <span class="badge bg-danger"><i class="fas fa-circle me-1" style="font-size:8px"></i> Cancelled</span>
    <span class="badge bg-dark"><i class="fas fa-circle me-1" style="font-size:8px"></i> Blocked</span>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div id="calendar"></div>
  </div>
</div>

`, scripts: `
<script>
document.addEventListener('DOMContentLoaded', function() {
  var calendarEl = document.getElementById('calendar');
  var statusColors = { pending: '#F39C12', confirmed: '#2ECC71', completed: '#3498DB', cancelled: '#E74C3C' };

  // SECURITY: these values are customer-supplied (names, item names, block reasons). They used
  // to be concatenated into single-quoted JS literals with only apostrophes stripped, so a
  // closing script tag typed into a booking name broke out of this block -- stored XSS in the
  // admin panel, which is one POST away from creating another admin user. Build real objects
  // and let JSON.stringify do the escaping, then turn every '<' into its \u003c escape so the
  // HTML parser can never see a closing tag inside the data.
  // Side benefit: names like O'Brien are no longer mangled.
  //
  // DO NOT write a closing script tag literally anywhere in this block, not even in a comment.
  // The HTML parser does not know about JS comments: it ends the script at the first one it
  // sees, and everything below here silently stops being JavaScript. That is exactly what
  // happened on 2026-11-11 -- this comment described the bug and then caused it, and the
  // calendar rendered as an empty card until it was found.
  var bookingEvents = ${JSON.stringify(bookings.map(function(b) {
    var STATUS_COLORS = { pending: '#F39C12', confirmed: '#2ECC71', completed: '#3498DB', cancelled: '#E74C3C' };
    var name = (b.first_name || '') + ' ' + (b.last_name || '');
    var items = b.items || '';
    var days = parseInt(b.rental_days) || 1;
    var endDate = (b.event_end_date && b.event_end_date !== b.event_date) ? b.event_end_date : b.event_date;
    var color = STATUS_COLORS[b.status] || '#6c757d';
    return {
      title: name + (items ? ' - ' + items : '') + (days > 1 ? ' (' + days + ' days)' : ''),
      start: b.event_date + 'T' + (b.event_start_time || '08:00'),
      end: endDate + 'T' + (b.event_end_time || '17:00'),
      url: '/admin/bookings/' + b.id,
      backgroundColor: color,
      borderColor: color,
      textColor: '#fff'
    };
  })).replace(/</g, '\\u003c')};

  var blockedEvents = ${JSON.stringify(blocked.map(function(bl) {
    return {
      title: bl.reason || 'Blocked',
      start: bl.date,
      allDay: true,
      display: 'background',
      backgroundColor: 'rgba(231,76,60,0.2)',
      borderColor: '#E74C3C'
    };
  })).replace(/</g, '\\u003c')};

  // On phones the month grid is unreadable — default to a clean list view
  // with a simplified toolbar; desktop keeps the full month/week/day grid.
  var isMobile = window.matchMedia('(max-width: 767px)').matches;
  var calendar = new FullCalendar.Calendar(calendarEl, {
    initialView: isMobile ? 'listMonth' : 'dayGridMonth',
    headerToolbar: isMobile
      ? { left: 'prev,next', center: 'title', right: 'today' }
      : { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,timeGridDay' },
    footerToolbar: isMobile ? { left: '', center: '', right: 'listMonth,dayGridMonth' } : false,
    events: bookingEvents.concat(blockedEvents),
    eventClick: function(info) {
      if (info.event.url) { info.jsEvent.preventDefault(); window.location.href = info.event.url; }
    },
    height: 'auto',
    navLinks: true,
    editable: false,
    dayMaxEvents: true,
    noEventsContent: 'No bookings this period',
    windowResize: function() {
      var m = window.matchMedia('(max-width: 767px)').matches;
      if (m && calendar.view.type === 'dayGridMonth') calendar.changeView('listMonth');
      else if (!m && calendar.view.type === 'listMonth') calendar.changeView('dayGridMonth');
    }
  });
  calendar.render();
});
</script>
` }) %>
