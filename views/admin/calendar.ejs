<%- include('../layouts/admin', { body: `

<!-- R7. The page heading that used to sit here repeated the breadcrumb two inches
     above it, word for word. The header has carried the page name since P2-5, so this
     one said nothing. The legend keeps the row.

     THREE TRAPS, and this comment fell into all of them before it worked.

     1. It cannot be an EJS comment. This whole file is one include tag, and EJS scans
        for its own delimiters without caring that they sit inside a JavaScript template
        literal -- an opening delimiter here closes the OUTER include early and the page
        500s with "Could not find matching close tag".
     2. It cannot NAME those delimiters either, not even in prose inside an HTML comment.
        EJS does not respect HTML comments; it scans the raw file. Hence this paragraph
        describing them in words.
     3. It must not quote the markup it describes. verify-fcchrome.sh greps this file for
        a heading containing the page's name, and the first draft quoted the tag it had
        just deleted and failed its own gate.

     Only the smoke gate catches 1 and 2. Lint, the build, the node suites and the
     browser specs all pass straight through a broken template. Same family as the
     closing-script-tag warning at the top of this file, which also described the bug
     it was causing. -->
<div class="d-flex justify-content-end align-items-center flex-wrap gap-2 mb-4">
  <div class="bm-legend">
    <span class="bm-leg bm-ev-pending">Pending</span>
    <span class="bm-leg bm-ev-confirmed">Confirmed</span>
    <span class="bm-leg bm-ev-completed">Completed</span>
    <span class="bm-leg bm-leg-blocked">Blocked</span>
  </div>
</div>

<div id="bmBlocked" class="bm-blocked" hidden></div>
<style>
  /* R1. One row per blocked range in the month on screen, instead of the reason
     reprinted inside every affected day cell. */
  .bm-blocked { border:1px solid var(--bm-n-100); border-left:3px solid var(--bm-n-300);
    background:var(--bm-n-0); border-radius:var(--bm-radius-md);
    margin-bottom:var(--bm-space-4); overflow:hidden; }
  .bm-blocked-row { display:flex; align-items:baseline; gap:var(--bm-space-3);
    padding:9px var(--bm-space-4); font-size:var(--bm-text-base);
    color:var(--bm-n-700); border-bottom:1px solid var(--bm-n-50); }
  .bm-blocked-row:last-child { border-bottom:0; }
  .bm-blocked-when { font-weight:700; color:var(--bm-n-900); white-space:nowrap; }
  .bm-blocked-what { flex:1 1 auto; }
  .bm-blocked-why { color:var(--bm-n-500); font-size:var(--bm-text-sm); }
  .bm-blocked-lift { flex:0 0 auto; margin-left:var(--bm-space-3); }
  @media (max-width:575px) {
    .bm-blocked-row { flex-wrap:wrap; gap:2px var(--bm-space-3); }
    .bm-blocked-why { width:100%; }
  }
</style>

<div class="card">
  <div class="card-body">
    <div id="calendar"></div>
  </div>
</div>

`, scripts: `
<script>
document.addEventListener('DOMContentLoaded', function() {
  var calendarEl = document.getElementById('calendar');

  // SECURITY: these values are customer-supplied (names, item names, block reasons). They used
  // to be concatenated into single-quoted JS literals with only apostrophes stripped, so a
  // closing script tag typed into a booking name broke out of this block -- stored XSS in the
  // admin panel, which is one POST away from creating another admin user. Build real objects
  // and let JSON.stringify do the escaping, then turn every '<' into its \u003c escape so the
  // HTML parser can never see a closing tag inside the data.
  // Side benefit: names like O'Brien are no longer mangled.
  //
  // DO NOT write a closing script tag literally anywhere in this block, not even in a comment.
  // The HTML parser does not know about JS comments: it ends the script at the first one it
  // sees, and everything below here silently stops being JavaScript. That is exactly what
  // happened on 2026-11-11 -- this comment described the bug and then caused it, and the
  // calendar rendered as an empty card until it was found.
  // R3. No colour is passed from here any more. It used to carry its own Flat-UI
  // palette -- #F39C12 #2ECC71 #3498DB #E74C3C, hardcoded -- which made this view the
  // only literal colour left outside admin.css, the only surface that did not move in
  // dark mode, and the reason the legend disagreed with the calendar: the chips were
  // drawn from the D0 tokens while the events were drawn from these. The Completed chip
  // was brand orange while completed events were sky blue.
  //
  // A class instead, resolved in admin.css, where the legend chips resolve too. Two
  // things that must match now cannot fail to.
  var bookingEvents = ${JSON.stringify(bookings.map(function(b) {
    var name = ((b.first_name || '') + ' ' + (b.last_name || '')).trim();
    var items = b.items || '';
    var days = parseInt(b.rental_days) || 1;
    var endDate = (b.event_end_date && b.event_end_date !== b.event_date) ? b.event_end_date : b.event_date;
    var extra = Math.max(0, (parseInt(b.item_count) || 0) - 1);

    // R5. The title used to read "Callie Hart - Mini Castle Bounce House & Slide".
    // A month cell shows about eighteen characters, so every event on the screen
    // read "Callie Hart - Mi..." and the one thing the grid could not tell you was
    // WHICH UNIT IS OUT -- which is the reason to open a calendar at all. The
    // customer is one click away and on the booking itself; the unit is not
    // anywhere.
    //
    // So the unit leads. Long names still truncate -- "Mini Castle Bounce House &
    // Slide" is 32 characters -- but "Mini Castle Bou..." identifies the unit,
    // which "Callie Hart - Mi..." never did. No clever abbreviation: shortening
    // these names by rule would mean guessing which words are disposable, and
    // "Dual Lane Axe Throw", "Dual Lane Blitz" and "Dual Lane Hoop Shot" are three
    // different units that any such rule collapses into one.
    var head = (b.primary_item || 'Booking') + (extra ? ' +' + extra : '');
    return {
      title: head + (name ? ' \u00b7 ' + name : '') + (days > 1 ? ' (' + days + ' days)' : ''),
      start: b.event_date + 'T' + (b.event_start_time || '08:00'),
      end: endDate + 'T' + (b.event_end_time || '17:00'),
      url: '/admin/bookings/' + b.id,
      classNames: ['bm-ev-' + (b.status || 'pending')],
      // The full string, for the tooltip and anywhere with room to show it.
      extendedProps: { full: (name ? name + ' \u2014 ' : '') + (items || 'no items')
        + (days > 1 ? ' (' + days + ' days)' : '') }
    };
  })).replace(/</g, '\\u003c')};

  // R1. Two things were wrong here, and the second is the one that mattered.
  //
  // (a) A background event still renders its title inside the day cell. The reason was
  //     therefore printed once per ROW, and blocked_dates has one row per unit -- so
  //     June 10-14 printed the same sentence three times a day, 51 copies across the
  //     range, displacing the real bookings in those cells.
  //
  // (b) blocked_dates is per-EQUIPMENT: 61 of its 63 rows carry an equipment_id. The
  //     calendar painted every one of them as a full-day red wash, so a day when ONE
  //     unit was away at ODOL inspection looked exactly like a day the business was
  //     closed. August 7-16 is washed red and carries six confirmed bookings -- the
  //     other eighteen units were free the whole time. The grid was stating something
  //     untrue, which is worse than stating it repetitively.
  //
  // So only a whole-business block (equipment_id IS NULL) paints the day. A unit-level
  // block is a unit-level fact: it is reported in the strip above the grid, by name,
  // and it gets its proper home in R16's availability view, which is per unit by
  // construction. The title is gone either way; the reason reaches the cell as a
  // tooltip and the strip as text.
  var blockedEvents = ${JSON.stringify(blocked.filter(function(bl) {
    return !bl.equipment_id;
  }).map(function(bl) {
    return {
      title: '',
      start: bl.date,
      allDay: true,
      display: 'background',
      extendedProps: { reason: bl.reason || 'Blocked' }
    };
  })).replace(/</g, '\\u003c')};

  // Contiguous runs of the same reason for the same unit, so the strip says
  // "Jun 10 - Jun 14" once rather than listing five days.
  var blockedRanges = ${JSON.stringify((function() {
    var byKey = {};
    (blocked || []).forEach(function(bl) {
      var key = (bl.equipment_name || '') + '\u0000' + (bl.reason || '');
      (byKey[key] = byKey[key] || []).push(bl);
    });
    var out = [];
    Object.keys(byKey).forEach(function(key) {
      var rows = byKey[key].slice().sort(function(a, b) {
        return a.date < b.date ? -1 : a.date > b.date ? 1 : 0;
      });
      var start = null, prev = null;
      function flush() { if (start) out.push({ start: start, end: prev,
        unit: rows[0].equipment_name || null, equipmentId: rows[0].equipment_id || null,
        reason: rows[0].reason || null }); }
      rows.forEach(function(r) {
        if (prev === r.date) return;                       // same day, another row
        var contiguous = prev &&
          (new Date(r.date + 'T12:00:00') - new Date(prev + 'T12:00:00')) === 86400000;
        if (!contiguous) { flush(); start = r.date; }
        prev = r.date;
      });
      flush();
    });
    return out.sort(function(a, b) { return a.start < b.start ? -1 : 1; });
  })()).replace(/</g, '\\u003c')};

  // On phones the month grid is unreadable — default to a clean list view
  // with a simplified toolbar; desktop keeps the full month/week/day grid.
  var isMobile = window.matchMedia('(max-width: 767px)').matches;
  var calendar = new FullCalendar.Calendar(calendarEl, {
    initialView: isMobile ? 'listMonth' : 'dayGridMonth',
    headerToolbar: isMobile
      ? { left: 'prev,next', center: 'title', right: 'today' }
      : { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,timeGridDay' },
    footerToolbar: isMobile ? { left: '', center: '', right: 'listMonth,dayGridMonth' } : false,
    events: bookingEvents.concat(blockedEvents),
    eventClick: function(info) {
      if (info.event.url) { info.jsEvent.preventDefault(); window.location.href = info.event.url; }
    },
    height: 'auto',

    // R4. The week and day views ran 12am to 11pm, so you scrolled past nine empty
    // night hours to reach a 9am delivery -- about three quarters of the view was
    // dead. The floor is 7am because the earliest booking in the database starts at
    // 8am, so nothing is hidden by it.
    //
    // The ceiling stays at midnight, and that is the deliberate half. 21:00 was the
    // obvious choice and it would have CLIPPED three real bookings -- 2026-07-03 to
    // 10pm, 2026-07-24 to 9:30pm, and 2026-07-04 running to 11:59pm, which would have
    // appeared to end at nine. A view that silently shortens a booking is worse than
    // one with empty rows in it. verify-caltime.sh now fails if any booking falls
    // outside these bounds, so the next late event forces the decision rather than
    // disappearing.
    slotMinTime: '07:00:00',
    slotMaxTime: '24:00:00',

    views: {
      // Only the time-grid views. FullCalendar's timeGrid default omits the meridiem
      // entirely -- an event block read "9:00 - 1:00" -- which is exactly the
      // ambiguity the am/pm rule exists to prevent.
      //
      // The month view is left alone on purpose: it already renders "9a" and "1:30p",
      // which carry a meridiem, and widening those to "9:00am" would eat the space
      // R5 just won for the unit name.
      timeGrid: {
        eventTimeFormat: { hour: 'numeric', minute: '2-digit', meridiem: 'lowercase' }
      }
    },

    navLinks: true,
    editable: false,

    // R2. Until now nothing in the admin could block or unblock a date: 63 rows were in
    // that table and every one had been put there by hand. Dragging across days offers
    // to block them.
    //
    // This is the only write in this series that changes what a CUSTOMER can buy --
    // routes/booking.js and lib/helpers.js both refuse a date that appears in
    // blocked_dates -- so it asks what is already booked inside the range and shows the
    // answer BEFORE anything is written. A block over a live booking is allowed, because
    // the booking still exists and is still being delivered, but it never happens
    // without the operator seeing it.
    selectable: true,
    selectMirror: true,
    select: function(info) {
      // FullCalendar's end is exclusive; the last day a person selected is the one before.
      var last = new Date(new Date(info.endStr + 'T12:00:00').getTime() - 86400000)
        .toISOString().slice(0, 10);
      calendar.unselect();
      offerBlock(info.startStr, last);
    },
    dayMaxEvents: true,
    noEventsContent: 'No bookings this period',
    // A background event has no title now, so the reason reaches the cell this way.
    eventDidMount: function(info) {
      var p = info.event.extendedProps || {};
      if (p.reason && info.event.display === 'background') info.el.setAttribute('title', p.reason);
      // A truncated title is only acceptable if the whole thing is one hover away.
      if (p.full) info.el.setAttribute('title', p.full);
    },
    // The strip tracks the month on screen. Rendering every range unconditionally
    // would put last June's note above a November calendar -- the same noise this
    // item exists to remove, moved somewhere else.
    datesSet: function(info) { renderBlocked(info.startStr, info.endStr); },
    windowResize: function() {
      var m = window.matchMedia('(max-width: 767px)').matches;
      if (m && calendar.view.type === 'dayGridMonth') calendar.changeView('listMonth');
      else if (!m && calendar.view.type === 'listMonth') calendar.changeView('dayGridMonth');
    }
  });
  // Built as DOM nodes with textContent: the reason is operator-entered text and must
  // never be parsed as markup, for the same reason the event arrays above are escaped.
  function renderBlocked(viewStart, viewEnd) {
    var host = document.getElementById('bmBlocked');
    if (!host) return;
    var from = viewStart.slice(0, 10), to = viewEnd.slice(0, 10);   // to is exclusive
    var shown = blockedRanges.filter(function(r) { return r.start < to && r.end >= from; });
    host.textContent = '';
    if (!shown.length) { host.hidden = true; return; }
    shown.forEach(function(r) {
      var row = document.createElement('div');
      row.className = 'bm-blocked-row';
      var when = document.createElement('span');
      when.className = 'bm-blocked-when';
      when.textContent = r.start === r.end ? fmtDay(r.start) : fmtDay(r.start) + ' \u2013 ' + fmtDay(r.end);
      var what = document.createElement('span');
      what.className = 'bm-blocked-what';
      what.textContent = r.unit ? r.unit + ' unavailable' : 'No bookings taken';
      row.appendChild(when); row.appendChild(what);
      if (r.reason) {
        var why = document.createElement('span');
        why.className = 'bm-blocked-why';
        why.textContent = r.reason;
        row.appendChild(why);
      }
      // Lifting a block is the safe direction -- it gives a day back rather than taking
      // one away -- so it is one click and a confirmation, not a form.
      var lift = document.createElement('button');
      lift.type = 'button';
      lift.className = 'btn btn-sm btn-outline-secondary bm-blocked-lift';
      lift.textContent = 'Unblock';
      lift.addEventListener('click', function() { offerUnblock(r); });
      row.appendChild(lift);
      host.appendChild(row);
    });
    host.hidden = false;
  }
  // NOTE. Everything below lives inside a JavaScript template literal, so a backslash
  // escape written in this file is resolved by Node before the browser sees it. A '\\n'
  // here reaches the browser as '\\n'; a single one reaches it as a real newline and
  // splits whatever string literal it was inside. Same family as the closing-script-tag
  // and EJS-delimiter traps already recorded at the top of this file.
  function spanWords(a, b) {
    var days = Math.round((new Date(b + 'T12:00:00') - new Date(a + 'T12:00:00')) / 86400000) + 1;
    return a === b
      ? fmtFull(a) + ' \u2014 1 day'
      : fmtFull(a) + ' through ' + fmtFull(b) + ' \u2014 ' + days + ' days';
  }
  function fmtFull(iso) {
    return new Date(iso + 'T12:00:00')
      .toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  }

  function offerBlock(start, end) {
    fetch('/api/blocked-dates/conflicts?start=' + start + '&end=' + end,
      { headers: { Accept: 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.error) throw new Error(d.error);
        var msg = 'Block ' + spanWords(start, end) + '.';
        if (d.bookings && d.bookings.length) {
          // Named, not counted. "3 bookings in this range" is a number; "Liz Leaming,
          // Sat Nov 21" is something you can act on before you decide.
          msg += '\\n\\nAlready booked in that range:\\n' + d.bookings.map(function(b) {
            return '\u2022 ' + fmtFull(b.event_date) + ' \u2014 ' +
              (b.first_name || '') + ' ' + (b.last_name || '') +
              (b.items ? ' (' + b.items + ')' : '');
          }).join('\\n') + '\\n\\nThose stay booked. The days stop being offered to anyone else.';
        }
        msg += '\\n\\nCustomers will not be able to book these days.';
        return bmPrompt({
          title: d.bookings && d.bookings.length ? 'Block days that already have bookings?' : 'Block these days?',
          message: msg,
          placeholder: 'Why? e.g. new unit, awaiting inspection',
          confirmLabel: 'Block',
          danger: !!(d.bookings && d.bookings.length)
        });
      })
      .then(function(reason) {
        if (reason === null || reason === undefined) return;   // cancelled
        return fetch('/api/blocked-dates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ start: start, end: end, reason: reason || null })
        }).then(function(r) { return r.json(); }).then(function(d) {
          if (d.error) throw new Error(d.error);
          showToast(d.created ? d.created + ' day' + (d.created === 1 ? '' : 's') + ' blocked'
                              : 'Those days were already blocked', 'success');
          if (d.created) location.reload();
        });
      })
      .catch(function(e) { showToast(e.message || 'Could not block those days', 'error'); });
  }

  function offerUnblock(r) {
    var what = r.unit ? r.unit : 'bookings';
    bmConfirm({
      title: 'Unblock these days?',
      message: spanWords(r.start, r.end) + '.\\n\\n' +
        (r.unit ? r.unit + ' becomes available again on those days.'
                : 'Those days start being offered to customers again.'),
      confirmLabel: 'Unblock'
    }).then(function(ok) {
      if (!ok) return;
      return fetch('/api/blocked-dates/range', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ start: r.start, end: r.end, equipment_id: r.equipmentId })
      }).then(function(res) { return res.json(); }).then(function(d) {
        if (d.error) throw new Error(d.error);
        showToast(d.removed + ' day' + (d.removed === 1 ? '' : 's') + ' unblocked', 'success');
        location.reload();
      });
    }).catch(function(e) { showToast(e.message || 'Could not unblock those days', 'error'); });
  }

  function fmtDay(iso) {
    return new Date(iso + 'T12:00:00')
      .toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  calendar.render();
});
</script>
` }) %>
