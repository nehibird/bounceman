<%- include('../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0"><i class="fas fa-ad me-2"></i>Ad Management</h4>
  <div>
    <a href="/admin/ads/reports" class="btn btn-sm btn-outline-secondary me-2"><i class="fas fa-chart-line me-1"></i>Reports</a>
    <a href="/admin/ads/rules" class="btn btn-sm btn-outline-secondary"><i class="fas fa-robot me-1"></i>Rules</a>
  </div>
</div>


<!-- Stats Row -->
<div class="row g-4 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="stat-label">Ad Spend (${win.clamped ? 'since ' + win.since : days + 'd'})</div>
          <div class="stat-value" id="statSpend"><span class="text-muted"><i class="fas fa-spinner fa-spin"></i></span></div>
        </div>
        <div class="stat-icon" style="background:rgba(255,107,53,0.1);color:#FF6B35"><i class="fas fa-dollar-sign"></i></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="stat-label">Bookings from Ads</div>
          <div class="stat-value">${stats.paidBookings}</div>
          <div class="text-muted small">of ${stats.totalBookings} total</div>
        </div>
        <div class="stat-icon" style="background:rgba(46,204,113,0.1);color:#2ECC71"><i class="fas fa-calendar-check"></i></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="stat-label">Cost per Booking</div>
          <div class="stat-value" id="statCpb"><span class="text-muted"><i class="fas fa-spinner fa-spin"></i></span></div>
        </div>
        <div class="stat-icon" style="background:rgba(0,78,137,0.1);color:#004E89"><i class="fas fa-tag"></i></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="stat-label">ROAS</div>
          <div class="stat-value" id="statRoas"><span class="text-muted"><i class="fas fa-spinner fa-spin"></i></span></div>
          <div class="text-muted small">$${parseFloat(stats.paidRevenue).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})} attributed revenue</div>
        </div>
        <div class="stat-icon" style="background:rgba(243,156,18,0.1);color:#F39C12"><i class="fas fa-chart-line"></i></div>
      </div>
    </div>
  </div>
</div>

<!-- Attribution: spend vs. bookings actually produced -->
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="fas fa-crosshairs me-2"></i>Attribution — what the spend actually produced</span>
    <div class="btn-group btn-group-sm">
      ${[7, 30, 90].map(d => `<a href="/admin/ads?days=${d}" class="btn btn-outline-secondary ${d === days ? 'active' : ''}">${d}d</a>`).join('')}
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 rtable">
        <thead><tr><th>Channel</th><th class="text-end">Spend</th><th class="text-end">Clicks</th><th class="text-end">Bookings</th><th class="text-end">Revenue</th><th class="text-end">Cost / Booking</th><th class="text-end">ROAS</th></tr></thead>
        <tbody id="attribBody">
          <tr><td colspan="7" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-1"></i>Pulling live spend from Google and Meta...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
  ${win.clamped ? `
  <div class="alert alert-warning mb-0 rounded-0 small">
    <i class="fas fa-circle-info me-1"></i>
    Showing <strong>${win.since} to ${win.until}</strong>, not the full ${days} days.
    Attribution only started ${attributionStart}, and spend is clamped to match — otherwise
    ${days} days of spend would be compared against a few days of tracked bookings and every
    channel would look worse than it is.
  </div>` : ''}
  <div class="card-footer small text-muted">
    Bookings are attributed from a first-touch <code>bm_attrib</code> cookie (90 days) captured on the visitor's first page view.
    Attribution started ${attributionStart} — bookings before that read <code>unknown_pre_tracking</code> and are excluded from every channel.
  </div>
</div>

<!-- Every channel, paid or not -->
<div class="card mb-4">
  <div class="card-header"><i class="fas fa-signs-post me-2"></i>All booking sources — ${win.since} to ${win.until}</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 rtable">
        <thead><tr><th>Source</th><th class="text-end">Bookings</th><th class="text-end">Revenue</th></tr></thead>
        <tbody>
          ${sources.map(s => `
          <tr>
            <td class="rt-primary"><code>${s.src}</code></td>
            <td class="text-end" data-label="Bookings">${s.bookings}</td>
            <td class="text-end" data-label="Revenue">$${(s.revenue || 0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}</td>
          </tr>`).join('')}
          ${sources.length === 0 ? '<tr><td colspan="3" class="text-center text-muted py-3">No bookings in this window</td></tr>' : ''}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Google Ads -->
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fab fa-google me-2" style="color:#4285F4"></i>Google Ads</span>
        <span class="badge bg-success">Active</span>
      </div>
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <div class="text-muted small">Status</div>
            <span id="dashGoogleStatus"><span class="text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Checking...</span></span>
          </div>
        </div>
        <div class="d-flex justify-content-between mb-3">
          <div>
            <div class="text-muted small">Campaigns</div>
            <strong>${campaigns.filter(c => c.platform === 'google').length}</strong>
          </div>
          <div>
            <div class="text-muted small">Budget</div>
            <strong>$${campaigns.filter(c => c.platform === 'google').reduce((a,b) => a + b.daily_budget, 0).toFixed(2)}/day</strong>
          </div>
        </div>
        <a href="/admin/ads/google" class="btn btn-sm btn-outline-primary w-100">
          <i class="fas fa-cog me-1"></i>Manage Google Ads
        </a>
      </div>
    </div>
  </div>

  <!-- Facebook Ads -->
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fab fa-facebook me-2" style="color:#1877F2"></i>Facebook / Instagram Ads</span>
        <span class="badge bg-success">Active</span>
      </div>
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <div class="text-muted small">Status</div>
            <span id="dashFbStatus"><span class="text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Checking...</span></span>
          </div>
        </div>
        <div class="d-flex justify-content-between mb-3">
          <div>
            <div class="text-muted small">Campaigns</div>
            <strong>${campaigns.filter(c => c.platform === 'facebook').length}</strong>
          </div>
          <div>
            <div class="text-muted small">Budget</div>
            <strong>$${campaigns.filter(c => c.platform === 'facebook').reduce((a,b) => a + b.daily_budget, 0).toFixed(2)}/day</strong>
          </div>
        </div>
        <a href="/admin/ads/facebook" class="btn btn-sm btn-outline-primary w-100">
          <i class="fas fa-cog me-1"></i>Manage Facebook Ads
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Quick Links & Rules -->
<div class="row g-4">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header"><i class="fas fa-robot me-2"></i>Smart Rules
        <span class="badge bg-secondary ms-2">${rules.filter(r => r.enabled).length} active</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover mb-0 rtable">
          <thead><tr><th>Rule</th><th>Type</th><th>Status</th><th></th></tr></thead>
          <tbody>
            ${rules.map(r => `
            <tr>
              <td class="rt-primary">
                <strong>${r.name}</strong>
                <div class="text-muted small">${r.description || ''}</div>
              </td>
              <td data-label="Type"><span class="badge bg-light text-dark">${r.rule_type}</span></td>
              <td data-label="Status">
                ${r.enabled
                  ? '<span class="badge" style="background:#d4edda;color:#155724">Active</span>'
                  : '<span class="badge bg-secondary">Disabled</span>'
                }
              </td>
              <td class="rt-actions"><a href="/admin/ads/rules" class="btn btn-sm btn-outline-secondary">Edit</a></td>
            </tr>
            `).join('')}
            ${rules.length === 0 ? '<tr><td colspan="4" class="text-center text-muted py-3">No rules configured</td></tr>' : ''}
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-header"><i class="fas fa-bolt me-2"></i>Quick Links</div>
      <div class="card-body d-grid gap-2">
        <a href="/admin/ads/google" class="btn btn-outline-primary btn-sm">
          <i class="fab fa-google me-2"></i>Google Ads Manager
        </a>
        <a href="/admin/ads/facebook" class="btn btn-outline-primary btn-sm">
          <i class="fab fa-facebook me-2"></i>Facebook Ads Manager
        </a>
        <a href="/admin/ads/rules" class="btn btn-outline-secondary btn-sm">
          <i class="fas fa-robot me-2"></i>Smart Rules
        </a>
        <a href="/admin/ads/reports" class="btn btn-outline-secondary btn-sm">
          <i class="fas fa-chart-bar me-2"></i>Reports
        </a>
      </div>
    </div>
    <div class="card mt-3">
      <div class="card-header"><i class="fas fa-chart-area me-2"></i>Performance Chart</div>
      <div class="card-body text-center text-muted py-4">
        <i class="fas fa-chart-line fa-3x mb-3" style="opacity:0.2"></i>
        <p class="mb-0">Chart will appear once campaigns are active and syncing data.</p>
      </div>
    </div>
  </div>
</div>

`, scripts: `<script>
async function loadDashboardStatus() {
  try {
    const [gr, fr] = await Promise.all([
      fetch('/admin/api/ads/google/status').then(r=>r.json()).catch(()=>({connected:false})),
      fetch('/admin/api/ads/facebook/status').then(r=>r.json()).catch(()=>({connected:false}))
    ]);
    const gEl = document.getElementById('dashGoogleStatus');
    const fEl = document.getElementById('dashFbStatus');
    if (gEl) gEl.innerHTML = gr.connected
      ? '<strong class="text-success"><i class="fas fa-check-circle me-1"></i>Connected</strong>'
      : '<strong class="text-warning"><i class="fas fa-unlink me-1"></i>Not Connected</strong>';
    if (fEl) fEl.innerHTML = fr.connected
      ? '<strong class="text-success"><i class="fas fa-check-circle me-1"></i>Connected</strong>'
      : '<strong class="text-warning"><i class="fas fa-unlink me-1"></i>Not Connected</strong>';
  } catch(e) { console.error('Dashboard status check failed', e); }
}
loadDashboardStatus();

// NOTE: this block lives inside a JS template literal, so backtick strings and stray
// dollar-braces get evaluated at render time instead of reaching the browser. The one
// line below is the only deliberate interpolation; keep the rest on plain concatenation.
var ATTRIB_DAYS = ${days};

function money(n) {
  return '$' + Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

// Channel names are ours, but the error string is raw text from Google or Meta and
// goes into innerHTML. Escape it rather than trust a third party's error formatting.
function esc(s) {
  return String(s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

async function loadAttribution() {
  var body = document.getElementById('attribBody');
  try {
    var r = await fetch('/admin/api/ads/attribution?days=' + ATTRIB_DAYS);
    var d = await r.json();

    var rows = '', totalSpend = 0, totalBookings = 0, totalRevenue = 0, haveSpend = false;
    d.channels.forEach(function (c) {
      if (c.spend !== null) { totalSpend += c.spend; haveSpend = true; }
      totalBookings += c.bookings;
      totalRevenue += c.revenue;
      rows += '<tr>' +
        '<td class="rt-primary"><strong>' + esc(c.channel) + '</strong>' +
          (c.error ? '<div class="text-danger small"><i class="fas fa-triangle-exclamation me-1"></i>' + esc(c.error) + '</div>'
                   : '<div class="text-muted small"><code>' + esc(c.source) + '</code></div>') + '</td>' +
        '<td class="text-end" data-label="Spend">' + (c.spend === null ? '<span class="text-muted">—</span>' : money(c.spend)) + '</td>' +
        '<td class="text-end" data-label="Clicks">' + (c.clicks === null ? '<span class="text-muted">—</span>' : c.clicks) + '</td>' +
        '<td class="text-end" data-label="Bookings">' + c.bookings + '</td>' +
        '<td class="text-end" data-label="Revenue">' + money(c.revenue) + '</td>' +
        '<td class="text-end" data-label="Cost / Booking">' + (c.costPerBooking === null ? '<span class="text-muted">—</span>' : money(c.costPerBooking)) + '</td>' +
        '<td class="text-end" data-label="ROAS">' +
          (c.roas === null ? '<span class="text-muted">—</span>'
            : '<span class="badge ' + (c.roas >= 1 ? 'bg-success' : 'bg-danger') + '">' + c.roas.toFixed(2) + 'x</span>') +
        '</td></tr>';
    });
    body.innerHTML = rows;

    document.getElementById('statSpend').textContent = haveSpend ? money(totalSpend) : 'N/A';
    document.getElementById('statCpb').textContent =
      haveSpend && totalBookings > 0 ? money(totalSpend / totalBookings) : 'N/A';
    document.getElementById('statRoas').textContent =
      haveSpend && totalSpend > 0 ? (totalRevenue / totalSpend).toFixed(2) + 'x' : 'N/A';
  } catch (e) {
    body.innerHTML = '<tr><td colspan="7" class="text-center text-danger py-3">Could not load attribution: ' + esc(e.message) + '</td></tr>';
    ['statSpend', 'statCpb', 'statRoas'].forEach(function (id) {
      document.getElementById(id).textContent = 'N/A';
    });
  }
}
loadAttribution();
</script>` }) %>
