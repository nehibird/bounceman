<%- include('../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0"><i class="fas fa-robot me-2"></i>Smart Ad Rules</h4>
  <a href="/admin/ads" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back to Ad Dashboard</a>
</div>

<div class="alert alert-info mb-4" style="border-radius:10px">
  <i class="fas fa-info-circle me-2"></i>
  Smart rules automate your ad campaigns based on inventory, schedule, and performance. All rules are <strong>disabled by default</strong> until you're ready to activate.
</div>

<div class="card">
  <div class="card-header"><i class="fas fa-list-alt me-2"></i>Automation Rules</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 rtable">
        <thead>
          <tr>
            <th style="width:30px"></th>
            <th>Rule</th>
            <th>Type</th>
            <th>Description</th>
            <th class="d-none d-md-table-cell">Last Triggered</th>
            <th style="width:100px">Enabled</th>
          </tr>
        </thead>
        <tbody>
          ${rules.length > 0 ? rules.map(r => `
          <tr id="rule-row-${r.id}">
            <td class="rt-hide">
              ${r.rule_type === 'availability'
                ? '<i class="fas fa-castle text-warning"></i>'
                : r.rule_type === 'schedule'
                ? '<i class="fas fa-calendar-alt text-primary"></i>'
                : '<i class="fas fa-boxes text-danger"></i>'
              }
            </td>
            <td class="rt-primary">
              <strong>${r.name}</strong>
            </td>
            <td data-label="Type">
              <span class="badge bg-light text-dark border">${r.rule_type}</span>
            </td>
            <td class="text-muted small" style="max-width:280px" data-label="Description">${r.description || '—'}</td>
            <td class="text-muted small d-none d-md-table-cell">${r.last_triggered ? r.last_triggered : 'Never'}</td>
            <td data-label="Enabled">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="toggle-${r.id}"
                  ${r.enabled ? 'checked' : ''}
                  data-rule-id="${r.id}">
              </div>
            </td>
          </tr>
          `).join('') : `
          <tr><td colspan="6" class="text-center text-muted py-4">No rules defined</td></tr>
          `}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="row g-4 mt-2">
  <div class="col-md-6">
    <div class="card border-warning">
      <div class="card-header bg-warning bg-opacity-10"><i class="fas fa-exclamation-triangle me-2 text-warning"></i>Before Enabling Rules</div>
      <div class="card-body">
        <ul class="mb-0 text-muted small">
          <li class="mb-1">Ensure insurance verification is complete</li>
          <li class="mb-1">Complete ODOL inspection paperwork</li>
          <li class="mb-1">Connect Google Ads and/or Facebook accounts</li>
          <li class="mb-1">Set a baseline daily budget in your campaigns</li>
          <li>Test each rule individually before enabling all</li>
        </ul>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><i class="fas fa-question-circle me-2"></i>How Rules Work</div>
      <div class="card-body text-muted small">
        <p><strong>Availability rules</strong> check your booking calendar — when equipment is fully booked, ads pause automatically to avoid taking unbookable requests.</p>
        <p><strong>Schedule rules</strong> run on a timer — boosting budgets before your busy weekend period.</p>
        <p class="mb-0"><strong>Inventory rules</strong> monitor available units and reduce spend when stock is low.</p>
      </div>
    </div>
  </div>
</div>

`, scripts: `
<script>
// CSP-safe: event delegation for rule toggle checkboxes
document.addEventListener('change', function(e) {
  var el = e.target;
  if (el.type === 'checkbox' && el.dataset.ruleId) {
    toggleRule(el.dataset.ruleId, el.checked);
  }
});

function toggleRule(id, enabled) {
  fetch('/admin/api/ads/rules/' + id, {
    method: 'PATCH',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ enabled: enabled })
  }).then(r => r.json()).then(d => {
    if (!d.success) {
      showToast('Error updating rule', 'error');
      document.getElementById('toggle-' + id).checked = !enabled;
    }
  }).catch(() => {
    showToast('Error updating rule', 'error');
    document.getElementById('toggle-' + id).checked = !enabled;
  });
}
</script>
` }) %>
