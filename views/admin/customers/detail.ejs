<%- include('../../layouts/admin', { body: `

${typeof error !== "undefined" && error === "has_bookings" ? '<div class="alert alert-danger mb-3"><i class="fas fa-exclamation-triangle me-2"></i>Cannot delete this customer because they have active bookings. Delete the bookings first.</div>' : ""}
<a href="/admin/customers" class="text-decoration-none mb-3 d-inline-block">
  <i class="fas fa-arrow-left me-1"></i> Back to Customers
</a>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">${esc(customer.first_name)} ${esc(customer.last_name)}</h4>
  <form method="POST" action="/admin/customers/${customer.id}/delete" class="confirm-delete" data-confirm="Delete this customer? This will only work if they have no bookings? This cannot be undone.">
    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash me-1"></i> Delete Customer</button>
  </form>
</div>

<div class="row g-4">
  <!-- Left Column -->
  <div class="col-lg-4">

    <!-- Contact Info -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-user me-2"></i>Contact Information</div>
      <div class="card-body">
        <div class="mb-2"><i class="fas fa-envelope text-muted me-2"></i>${esc(customer.email) || 'No email'}</div>
        <div class="mb-2"><i class="fas fa-phone text-muted me-2"></i>${esc(customer.phone) || 'No phone'}</div>
        <div class="mb-2">
          <i class="fas fa-map-marker-alt text-muted me-2"></i>
          ${esc(customer.address)}
          ${customer.city ? ', ' + esc(customer.city) : ''}
          ${customer.state ? ', ' + esc(customer.state) : ''}
          ${esc(customer.zip)}
          ${!customer.address && !customer.city ? 'No address on file' : ''}
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-chart-pie me-2"></i>Customer Stats</div>
      <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
          <span>Total Bookings</span>
          <strong>${bookings.length}</strong>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span>Total Revenue</span>
          <strong>$${payments.reduce((sum, p) => sum + parseFloat(p.amount || 0), 0).toFixed(2)}</strong>
        </div>
        <div class="d-flex justify-content-between">
          <span>Member Since</span>
          <strong>${customer.created_at || 'N/A'}</strong>
        </div>
      </div>
    </div>

    <!-- Tax Exempt -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-file-invoice-dollar me-2"></i>Tax Exempt Status</div>
      <div class="card-body">
        <form method="POST" action="/admin/customers/${customer.id}/tax-exempt">
          <div class="mb-3">
            <div class="form-check form-switch">
              <input type="hidden" name="tax_exempt" value="0">
              <input class="form-check-input" type="checkbox" name="tax_exempt" value="1" id="taxExemptToggle" ${customer.tax_exempt ? 'checked' : ''}>
              <label class="form-check-label" for="taxExemptToggle">
                ${customer.tax_exempt ? '<span class="badge bg-success">Tax Exempt</span>' : '<span class="text-muted">Not exempt</span>'}
              </label>
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label small text-muted">Exemption Certificate #</label>
            <input type="text" name="tax_exempt_cert" class="form-control form-control-sm" placeholder="OK exemption cert number" value="${esc(customer.tax_exempt_cert)}">
          </div>
          <button type="submit" class="btn btn-sm btn-outline-secondary w-100"><i class="fas fa-save me-1"></i> Save</button>
        </form>
      </div>
    </div>

    <!-- Add Note -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-sticky-note me-2"></i>Notes</div>
      <div class="card-body">
        ${customer.notes ? `<div class="small text-muted mb-3 p-2 rounded" style="white-space:pre-wrap;background:#f8f9fa">${esc(customer.notes)}</div>` : ''}
        <form method="POST" action="/admin/customers/${customer.id}/notes">
          <textarea name="note" class="form-control mb-2" rows="3" placeholder="Add a note about this customer..."></textarea>
          <button type="submit" class="btn btn-sm btn-bm w-100"><i class="fas fa-save me-1"></i> Save Note</button>
        </form>
      </div>
    </div>

  </div>

  <!-- Right Column -->
  <div class="col-lg-8">

    <!-- Bookings -->
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-calendar-check me-2"></i>Bookings</span>
        <span class="badge bg-primary">${bookings.length}</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 rtable">
            <thead><tr><th>Booking #</th><th>Date</th><th>Status</th><th>Total</th><th></th></tr></thead>
            <tbody>
              ${bookings.length > 0 ? bookings.map(b => `
              <tr>
                <td class="rt-primary"><strong>${b.booking_number}</strong></td>
                <td data-label="Date">${b.event_date}${(function(s,e){if(!e||e===s)return'';try{var d=Math.round((new Date(e+'T12:00:00')-new Date(s+'T12:00:00'))/86400000)+1;return ' <span class="badge bg-secondary" title="'+s+' to '+e+'">'+d+'d</span>';}catch(_){return''}})(b.event_date,b.event_end_date)}</td>
                <td data-label="Status"><span class="badge-status badge-${b.status}">${b.status}</span></td>
                <td data-label="Total">$${parseFloat(b.total || 0).toFixed(2)}</td>
                <td class="rt-actions"><a href="/admin/bookings/${b.id}" class="btn btn-sm btn-outline-secondary">View</a></td>
              </tr>
              `).join('') : '<tr><td colspan="5" class="text-center text-muted py-3">No bookings yet</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Payments -->
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-credit-card me-2"></i>Payments</span>
        <span class="badge bg-success">${payments.length}</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 rtable">
            <thead><tr><th>Date</th><th>Amount</th><th>Method</th><th>Booking</th></tr></thead>
            <tbody>
              ${payments.length > 0 ? payments.map(p => `
              <tr>
                <td class="rt-primary">${p.paid_at || p.created_at || ''}</td>
                <td data-label="Amount"><strong>$${parseFloat(p.amount || 0).toFixed(2)}</strong></td>
                <td data-label="Method">${p.method || ''}</td>
                <td data-label="Booking">${p.booking_number ? '<a href="/admin/bookings/' + p.booking_id + '">' + p.booking_number + '</a>' : ''}</td>
              </tr>
              `).join('') : '<tr><td colspan="4" class="text-center text-muted py-3">No payments</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Communications -->
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-envelope me-2"></i>Communications</span>
        <span class="badge bg-secondary">${comms.length}</span>
      </div>
      <div class="card-body p-0">
        ${comms.length > 0 ? '<div class="list-group list-group-flush">' + comms.map(c => `
          <div class="list-group-item">
            <div class="d-flex justify-content-between">
              <strong>
                <i class="fas fa-${c.direction === 'outbound' ? 'paper-plane text-primary' : 'inbox text-success'} me-1"></i>
                ${esc(c.subject || c.type || 'Message')}
              </strong>
              <small class="text-muted">${c.sent_at || c.created_at || ''}</small>
            </div>
            <p class="mb-0 mt-1 small text-muted">${esc((c.body || '').substring(0, 200))}${(c.body || '').length > 200 ? '...' : ''}</p>
          </div>
        `).join('') + '</div>' : '<div class="text-center text-muted py-3">No communications</div>'}
      </div>
    </div>

  </div>
</div>
<script>
  (function(){
    var t = document.getElementById('taxExemptToggle');
    if (t) t.addEventListener('change', function(){ t.form.submit(); });
  })();
</script>
`, scripts: '' }) %>
