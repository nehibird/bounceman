<%- include('../../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Customers</h4>
    <p class="text-muted mb-0">${customers.length} customer${customers.length !== 1 ? 's' : ''} found</p>
  </div>
</div>

<!-- Bulk Actions Bar -->
<div id="bulkActions" class="alert alert-warning d-flex align-items-center justify-content-between mb-3" style="display:none !important">
  <span><i class="fas fa-check-square me-2"></i><strong id="selectedCount">0</strong> customer(s) selected</span>
  <div>
    <button type="button" id="bulkDeleteBtn" class="btn btn-sm btn-danger"><i class="fas fa-trash me-1"></i>Delete Selected</button>
    <button type="button" id="bulkCancelSelect" class="btn btn-sm btn-outline-secondary ms-2">Cancel</button>
  </div>
</div>

<!-- Search -->
<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/admin/customers" class="d-flex gap-2">
      <div class="input-group">
        <span class="input-group-text"><i class="fas fa-search"></i></span>
        <input type="text" name="q" class="form-control" placeholder="Search by name, email, or phone..." value="${search || ''}">
      </div>
      <button type="submit" class="btn btn-bm">Search</button>
      ${search ? '<a href="/admin/customers" class="btn btn-outline-secondary">Clear</a>' : ''}
    </form>
  </div>
</div>

<!-- Customers Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0" id="customersTable">
        <thead>
          <tr>
            <th style="width:40px"><input type="checkbox" id="selectAll" class="form-check-input"></th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Bookings</th>
            <th>Total Revenue</th>
            <th>Joined</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          ${customers.length > 0 ? customers.map(c => `
          <tr style="cursor:pointer" data-row-href="/admin/customers/${c.id}">
            <td onclick="event.stopPropagation()"><input type="checkbox" class="form-check-input customer-check" value="${c.id}" data-customer-name="${c.first_name} ${c.last_name}" data-booking-count="${c.total_bookings || 0}"></td>
            <td><strong>${c.first_name} ${c.last_name}</strong></td>
            <td>${c.email || ''}</td>
            <td>${c.phone || ''}</td>
            <td><span class="badge bg-primary">${c.total_bookings || 0}</span></td>
            <td>$${parseFloat(c.total_revenue || 0).toFixed(2)}</td>
            <td>${c.created_at || ''}</td>
            <td>
              <a href="/admin/customers/${c.id}" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-eye"></i> View
              </a>
            </td>
          </tr>
          `).join('') : '<tr><td colspan="8" class="text-center text-muted py-4">No customers found</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>

`, scripts: `
<script>
  // Bulk select/delete for customers
  (function() {
    var selectAll = document.getElementById('selectAll');
    var bulkActions = document.getElementById('bulkActions');
    var selectedCount = document.getElementById('selectedCount');
    var bulkDeleteBtn = document.getElementById('bulkDeleteBtn');
    var bulkCancelSelect = document.getElementById('bulkCancelSelect');

    function updateBulkBar() {
      var checked = document.querySelectorAll('.customer-check:checked');
      if (checked.length > 0) {
        bulkActions.style.cssText = 'display:flex !important';
        selectedCount.textContent = checked.length;
      } else {
        bulkActions.style.cssText = 'display:none !important';
      }
    }

    if (selectAll) {
      selectAll.addEventListener('change', function() {
        document.querySelectorAll('.customer-check').forEach(function(cb) { cb.checked = selectAll.checked; });
        updateBulkBar();
      });
    }

    document.querySelectorAll('.customer-check').forEach(function(cb) {
      cb.addEventListener('change', updateBulkBar);
    });

    if (bulkCancelSelect) {
      bulkCancelSelect.addEventListener('click', function() {
        document.querySelectorAll('.customer-check').forEach(function(cb) { cb.checked = false; });
        if (selectAll) selectAll.checked = false;
        updateBulkBar();
      });
    }

    if (bulkDeleteBtn) {
      bulkDeleteBtn.addEventListener('click', function() {
        var checked = document.querySelectorAll('.customer-check:checked');
        var ids = [];
        var names = [];
        var hasBookings = [];
        checked.forEach(function(cb) {
          ids.push(cb.value);
          names.push(cb.dataset.customerName);
          if (parseInt(cb.dataset.bookingCount) > 0) {
            hasBookings.push(cb.dataset.customerName + ' (' + cb.dataset.bookingCount + ' bookings)');
          }
        });
        if (ids.length === 0) return;
        
        if (hasBookings.length > 0) {
          alert('Cannot delete customers with active bookings:\n\n' + hasBookings.join('\n') + '\n\nDelete their bookings first.');
          return;
        }
        
        if (!confirm('Delete ' + ids.length + ' customer(s)?\n\n' + names.join(', ') + '\n\nThis cannot be undone.')) return;
        
        fetch('/admin/api/customers/bulk-delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: ids })
        }).then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) {
              showToast(data.deleted + ' customer(s) deleted', 'success');
              setTimeout(function() { window.location.reload(); }, 1000);
            } else {
              showToast('Error: ' + (data.error || 'Unknown'), 'error');
            }
          }).catch(function() { showToast('Network error', 'error'); });
      });
    }
  })();

  // Row click navigation
  (function() {
    var tbody = document.querySelector('#customersTable tbody');
    if (tbody) {
      tbody.addEventListener('click', function(e) {
        if (e.target.closest('a') || e.target.closest('button') || e.target.closest('input') || e.target.closest('form')) return;
        var row = e.target.closest('[data-row-href]');
        if (row) window.location.href = row.dataset.rowHref;
      });
    }
  })();
</script>
` }) %>
