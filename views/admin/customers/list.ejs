<%- include('../../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Customers</h4>
    <p class="text-muted mb-0">${pageInfo.total} customer${pageInfo.total !== 1 ? 's' : ''} found</p>
  </div>
</div>

<!-- Bulk Actions Bar - hidden by default -->
<div id="bulkBar" class="alert alert-warning d-none mb-3">
  <div class="d-flex align-items-center justify-content-between">
    <span><i class="fas fa-check-square me-2"></i><span id="selCount">0</span> customer(s) selected</span>
    <div>
      <button type="button" id="delBtn" class="btn btn-sm btn-danger"><i class="fas fa-trash me-1"></i>Delete Selected</button>
      <button type="button" id="clearBtn" class="btn btn-sm btn-outline-secondary ms-2">Cancel</button>
    </div>
  </div>
</div>

<!-- Search -->
<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/admin/customers" class="d-flex gap-2 flex-wrap">
      <div class="input-group">
        <span class="input-group-text"><i class="fas fa-search"></i></span>
        <input type="text" name="q" class="form-control" placeholder="Search by name, email, or phone..." value="${esc(search)}">
      </div>
      <button type="submit" class="btn btn-bm">Search</button>
      ${search ? '<a href="/admin/customers" class="btn btn-outline-secondary">Clear</a>' : ''}
    </form>
  </div>
</div>

<!-- Customers Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 rtable">
        <thead>
          <tr>
            <th style="width:40px"><input type="checkbox" class="form-check-input" id="selAll"></th>
            ${listing.sortHeader('Name', 'name', sort, link)}
            ${listing.sortHeader('Email', 'email', sort, link)}
            ${listing.sortHeader('Phone', 'phone', sort, link)}
            ${listing.sortHeader('Bookings', 'bookings', sort, link)}
            ${listing.sortHeader('Total Revenue', 'revenue', sort, link)}
            ${listing.sortHeader('Joined', 'joined', sort, link)}
            <th></th>
          </tr>
        </thead>
        <tbody id="custBody">
          ${customers.length > 0 ? customers.map(c => `
          <tr data-href="/admin/customers/${c.id}">
            <td class="rt-hide"><input type="checkbox" class="form-check-input rowCb" value="${c.id}" data-name="${esc(c.first_name)} ${esc(c.last_name)}" data-bookings="${c.total_bookings || 0}"></td>
            <td class="rt-primary"><strong>${esc(c.first_name)} ${esc(c.last_name)}</strong></td>
            <td data-label="Email">${esc(c.email)}</td>
            <td data-label="Phone">${esc(c.phone)}</td>
            <td data-label="Bookings"><span class="badge bg-primary">${c.booking_count || 0}</span></td>
            <td data-label="Total Revenue">$${parseFloat(c.revenue_total || 0).toFixed(2)}</td>
            <td data-label="Joined">${fmtStamp(c.created_at, false)}</td>
            <td class="rt-actions rt-hide">
              <a href="/admin/customers/${c.id}" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-eye"></i> View
              </a>
            </td>
          </tr>
          `).join('') : (search
  ? '<tr><td colspan="8"><div class="bm-empty">' +
      '<i class="fas fa-magnifying-glass bm-empty-icon"></i>' +
      '<p class="bm-empty-title">Nobody matches &ldquo;' + esc(search) + '&rdquo;</p>' +
      '<p class="bm-empty-line">Try part of a surname, or a phone number.</p>' +
      '<a href="/admin/customers" class="btn btn-sm btn-bm">Show everyone</a>' +
    '</div></td></tr>'
  : '<tr><td colspan="8"><div class="bm-empty">' +
      '<i class="fas fa-users bm-empty-icon"></i>' +
      '<p class="bm-empty-title">No customers yet</p>' +
      '<p class="bm-empty-line">A customer record is created automatically the first time somebody books.</p>' +
      '<a href="/admin/bookings/new" class="btn btn-sm btn-bm">New booking</a>' +
    '</div></td></tr>')}
        </tbody>
      </table>
      ${listing.pager(pageInfo, link)}
    </div>
  </div>
</div>

`, scripts: `
<script>
document.addEventListener('DOMContentLoaded', function() {
  var bar = document.getElementById('bulkBar');
  var count = document.getElementById('selCount');
  var selAll = document.getElementById('selAll');
  var delBtn = document.getElementById('delBtn');
  var clearBtn = document.getElementById('clearBtn');
  var tbody = document.getElementById('custBody');

  function getChecked() {
    return document.querySelectorAll('.rowCb:checked');
  }

  function updateBar() {
    var n = getChecked().length;
    if (n > 0) {
      bar.classList.remove('d-none');
      count.textContent = n;
    } else {
      bar.classList.add('d-none');
    }
  }

  // Select all
  selAll.addEventListener('change', function() {
    document.querySelectorAll('.rowCb').forEach(function(cb) {
      cb.checked = selAll.checked;
    });
    updateBar();
  });

  // Individual checkbox change
  tbody.addEventListener('change', function(e) {
    if (e.target.classList.contains('rowCb')) {
      updateBar();
    }
  });

  // Clear selection
  clearBtn.addEventListener('click', function() {
    document.querySelectorAll('.rowCb').forEach(function(cb) { cb.checked = false; });
    selAll.checked = false;
    updateBar();
  });

  // Delete selected
  delBtn.addEventListener('click', async function() {
    var checked = getChecked();
    var ids = [], names = [], hasBookings = [];
    checked.forEach(function(cb) {
      ids.push(cb.value);
      names.push(cb.dataset.name);
      if (parseInt(cb.dataset.bookings) > 0) {
        hasBookings.push(cb.dataset.name + ' (' + cb.dataset.bookings + ')');
      }
    });
    
    if (hasBookings.length > 0) {
      // Was an alert(). This is information, not a decision, so it is a toast.
      showToast('Cannot delete customers who have bookings: ' + hasBookings.join(', ') +
                '. Delete their bookings first.', 'warning');
      return;
    }

    if (!await bmConfirm({
      title: 'Delete ' + ids.length + ' customer' + (ids.length === 1 ? '' : 's') + '?',
      message: names.join(', ') + '\n\nThis cannot be undone.',
      confirmLabel: 'Delete', danger: true
    })) return;
    
    fetch('/admin/api/customers/bulk-delete', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ids: ids})
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        showToast(data.deleted + ' customer(s) deleted', 'success');
        setTimeout(function() { location.reload(); }, 800);
      } else {
        showToast('Error: ' + (data.error || 'Unknown'), 'error');
      }
    })
    .catch(function() { showToast('Network error', 'error'); });
  });

  // Row click navigation (exclude checkbox clicks)
  tbody.addEventListener('click', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.closest('a') || e.target.closest('button')) return;
    var row = e.target.closest('[data-href]');
    if (row) location.href = row.dataset.href;
  });
});
</script>
` }) %>
