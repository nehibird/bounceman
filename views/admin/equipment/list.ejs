<%- include('../../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Equipment</h4>
    <p class="text-muted mb-0">${equipment.length} item${equipment.length !== 1 ? 's' : ''} total</p>
  </div>
  <a href="/admin/equipment/new" class="btn btn-bm">
    <svg class="bm-i me-1" aria-hidden="true"><use href="#i-plus"/></svg> Add Equipment
  </a>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 rtable" id="equipmentTable">
        <thead>
          <tr>
            <th style="width:64px"></th>
            <th>Name</th>
            <th>Category</th>
            <th>Daily Price</th>
            <th>Status</th>
            <th>Condition</th>
            <th>Featured</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          ${equipment.length > 0 ? equipment.map(e => `
          <tr style="cursor:pointer" data-row-href="/admin/equipment/${e.id}/edit">
            <td class="rt-hide">
              ${e.image ? '<img src="' + e.image + '" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px">' : '<div style="width:48px;height:48px;background:#eee;border-radius:8px;display:flex;align-items:center;justify-content:center"><svg class="bm-i text-muted" aria-hidden="true"><use href="#i-image"/></svg></div>'}
            </td>
            <td class="rt-primary">
              ${e.name}
              ${e.dimensions ? '<br><small class="text-muted">' + e.dimensions + '</small>' : ''}
              ${e.capacity_kids ? '<br><small class="text-muted"><svg class="bm-i" aria-hidden="true"><use href="#i-child"/></svg> Up to ' + e.capacity_kids + ' kids</small>' : ''}
            </td>
            <td data-label="Category"><span class="badge bg-secondary">${e.category || 'Uncategorized'}</span></td>
            <td data-label="Daily Price"><strong>$${parseFloat(e.price_daily || 0).toFixed(2)}</strong></td>
            <td data-label="Status">
              <span class="badge bg-${e.status === 'available' ? 'success' : e.status === 'maintenance' ? 'warning' : 'danger'}">
                ${e.status || 'unknown'}
              </span>
            </td>
            <td data-label="Condition">${e.condition || 'N/A'}</td>
            <td data-label="Featured">
              ${e.featured ? '<svg class="bm-i text-warning" aria-hidden="true"><use href="#i-star"/></svg>' : '<svg class="bm-i text-muted" aria-hidden="true"><use href="#i-star"/></svg>'}
            </td>
            <td class="rt-actions">
              <a href="/admin/equipment/${e.id}/edit" class="btn btn-sm btn-outline-secondary me-1">
                <svg class="bm-i" aria-hidden="true"><use href="#i-edit"/></svg> Edit
              </a>
              <form method="POST" action="/admin/equipment/${e.id}/delete" style="display:inline" class="confirm-delete" data-confirm="Delete this equipment and all its images? This cannot be undone.">
                <button type="submit" class="btn btn-sm btn-outline-danger"><svg class="bm-i" aria-hidden="true"><use href="#i-trash"/></svg></button>
              </form>
            </td>
          </tr>
          `).join('') : '<tr><td colspan="8"><div class="bm-empty">' +
  '<svg class="bm-i bm-empty-icon" aria-hidden="true"><use href="#i-chess-rook"/></svg>' +
  '<p class="bm-empty-title">No equipment yet</p>' +
  '<p class="bm-empty-line">Add each unit once and it becomes bookable on the website, with its own ' +
  'photos, price and availability.</p>' +
  '<a href="/admin/equipment/new" class="btn btn-sm btn-bm">Add equipment</a>' +
'</div></td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>

`, scripts: `
<script>
  // Row click navigation for equipment table
  (function() {
    var tbody = document.querySelector('#equipmentTable tbody');
    if (tbody) {
      tbody.addEventListener('click', function(e) {
        if (e.target.closest('a') || e.target.closest('button') || e.target.closest('input') || e.target.closest('form')) return;
        var row = e.target.closest('[data-row-href]');
        if (row) window.location.href = row.dataset.rowHref;
      });
    }
  })();
</script>
` }) %>
