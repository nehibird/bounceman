<%- include('../../layouts/admin', { body: `

<a href="/admin/bookings" class="text-decoration-none mb-3 d-inline-block">
  <i class="fas fa-arrow-left me-1"></i> Back to Bookings
</a>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">
    Booking #${booking.booking_number}
    <span class="badge-status badge-${booking.status} ms-2">${booking.status}</span>
  </h4>
  <form method="POST" action="/admin/bookings/${booking.id}/delete" class="confirm-delete" data-confirm="Delete this booking and all related data? This cannot be undone.">
    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash me-1"></i> Delete Booking</button>
  </form>
</div>

<div class="row g-4">
  <!-- Left Column -->
  <div class="col-lg-8">

    <!-- Event Details -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-calendar me-2"></i>Event Details</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-sm-4">
            <small class="text-muted d-block">Event Date</small>
            <strong>${booking.event_date}${booking.event_end_date && booking.event_end_date !== booking.event_date ? ' – ' + booking.event_end_date : ''}</strong>
          </div>
          <div class="col-sm-4">
            <small class="text-muted d-block">Time</small>
            <strong>${(function(t){if(!t)return'';var p=t.split(':');var h=parseInt(p[0]);var m=p[1]||'00';var a=h>=12?'PM':'AM';h=h>12?h-12:(h==0?12:h);return h+':'+m+' '+a})(booking.event_start_time)} - ${(function(t){if(!t)return'';var p=t.split(':');var h=parseInt(p[0]);var m=p[1]||'00';var a=h>=12?'PM':'AM';h=h>12?h-12:(h==0?12:h);return h+':'+m+' '+a})(booking.event_end_time)}</strong>
          </div>
          <div class="col-sm-4">
            <small class="text-muted d-block">Duration</small>
            <strong>${items[0]?.duration_type === '4hr' ? '4 Hours' : 'Full Day'}${(parseInt(items[0]?.rental_days) || 1) > 1 ? ' · ' + items[0].rental_days + ' days' : ''}</strong>
          </div>
          <div class="col-sm-4">
            <small class="text-muted d-block">Event Type</small>
            <strong>${esc(booking.event_type) || 'N/A'}</strong>
          </div>
          <div class="col-sm-4">
            <small class="text-muted d-block">Venue / Location</small>
            <strong>${esc(booking.venue_type) || 'N/A'}</strong>
          </div>
          <div class="col-sm-4">
            <small class="text-muted d-block">Surface Type</small>
            <strong>${esc(booking.surface_type) || 'N/A'}</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Delivery Info -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-truck me-2"></i>Delivery Information</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-sm-8">
            <small class="text-muted d-block">Delivery Address</small>
            <strong>${esc(booking.delivery_address)}</strong>
            ${booking.delivery_city ? ', ' + esc(booking.delivery_city) : ''}
            ${booking.delivery_state ? ', ' + esc(booking.delivery_state) : ''}
            ${esc(booking.delivery_zip)}
          </div>
          <div class="col-12">
            <small class="text-muted d-block">Delivery Notes</small>
            <span>${esc(booking.delivery_notes) || 'None'}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Items -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-castle me-2"></i>Booked Items</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 rtable">
            <thead><tr><th></th><th>Item</th><th class="d-none d-md-table-cell">Category</th><th>Unit Price</th><th>Total</th></tr></thead>
            <tbody>
              ${items.length > 0 ? items.map(item => `
              <tr>
                <td class="rt-hide" style="width:60px">
                  ${item.image ? '<img src="' + item.image + '" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px">' : '<div style="width:48px;height:48px;background:#eee;border-radius:8px;display:flex;align-items:center;justify-content:center"><i class="fas fa-image text-muted"></i></div>'}
                </td>
                <td class="rt-primary"><strong>${esc(item.item_name)}</strong></td>
                <td class="d-none d-md-table-cell">${esc(item.category)}</td>
                <td data-label="Unit Price">$${parseFloat(item.unit_price || 0).toFixed(2)}</td>
                <td data-label="Total">$${parseFloat(item.total_price || 0).toFixed(2)}</td>
              </tr>
              `).join('') : '<tr><td colspan="5" class="text-center text-muted py-3">No items</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Internal Notes -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-sticky-note me-2"></i>Internal Notes</div>
      <div class="card-body">
        <form method="POST" action="/admin/bookings/${booking.id}/notes">
          <textarea name="internal_notes" class="form-control mb-2" rows="3" placeholder="Add internal notes...">${esc(booking.internal_notes)}</textarea>
          <button type="submit" class="btn btn-sm btn-bm"><i class="fas fa-save me-1"></i> Save Notes</button>
        </form>
      </div>
    </div>

    <!-- Communications Log -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-envelope me-2"></i>Communications</div>
      <div class="card-body p-0">
        ${comms.length > 0 ? '<div class="list-group list-group-flush">' + comms.map(c => `
          <div class="list-group-item">
            <div class="d-flex justify-content-between">
              <strong>
                <i class="fas fa-${c.direction === 'outbound' ? 'paper-plane text-primary' : 'inbox text-success'} me-1"></i>
                ${esc(c.subject || c.type || 'Message')}
              </strong>
              <small class="text-muted">${c.sent_at || c.created_at || ''}</small>
            </div>
            <p class="mb-0 mt-1 small">${esc((c.body || '').substring(0, 200))}${(c.body || '').length > 200 ? '...' : ''}</p>
          </div>
        `).join('') + '</div>' : '<div class="text-center text-muted py-3">No communications yet</div>'}
      </div>
    </div>

  </div>

  <!-- Right Column -->
  <div class="col-lg-4">

    <!-- Customer Card -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-user me-2"></i>Customer</div>
      <div class="card-body">
        <h6 class="mb-2">${esc(booking.first_name)} ${esc(booking.last_name)}</h6>
        <div class="mb-1"><i class="fas fa-envelope text-muted me-2"></i>${esc(booking.email) || 'N/A'}</div>
        <div class="mb-1 d-flex align-items-center gap-2">
          <i class="fas fa-phone text-muted"></i>
          <span>${esc(booking.phone) || 'N/A'}</span>
          ${booking.phone ? '<button class="btn btn-sm btn-outline-success rounded-pill py-0 px-2 call-btn" data-phone="' + booking.phone + '" title="Click to call"><i class="fas fa-phone-alt me-1"></i>Call</button>' : ''}
        </div>
        ${booking.customer_id ? '<a href="/admin/customers/' + booking.customer_id + '" class="btn btn-sm btn-outline-secondary mt-2"><i class="fas fa-external-link-alt me-1"></i> View Customer</a>' : ''}
      </div>
    </div>

    <!-- Pricing Breakdown -->
    <div class="card mb-4">
      ${booking.tax_exempt_claimed && !booking.tax_exempt ? '<div class="alert alert-warning mb-0 rounded-0 border-0 border-bottom"><i class="fas fa-exclamation-triangle me-2"></i><strong>Tax Exempt Claimed</strong> — Customer claims tax-exempt status. Verify certificate before collecting balance due. <a href="/admin/customers/' + booking.customer_id + '">Mark as verified on customer record.</a></div>' : ''}
      ${booking.tax_exempt_claimed && booking.tax_exempt ? '<div class="alert alert-success mb-0 rounded-0 border-0 border-bottom"><i class="fas fa-check-circle me-2"></i>Tax exempt — verified.</div>' : ''}
      <div class="card-header"><i class="fas fa-dollar-sign me-2"></i>Pricing</div>
      <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
          <span>Subtotal</span><span>$${parseFloat(booking.subtotal || 0).toFixed(2)}</span>
        </div>
        ${booking.delivery_fee ? '<div class="d-flex justify-content-between mb-2"><span>Delivery Fee</span><span>$' + parseFloat(booking.delivery_fee).toFixed(2) + '</span></div>' : ''}
        ${booking.tax_amount ? '<div class="d-flex justify-content-between mb-2"><span>Tax</span><span>$' + parseFloat(booking.tax_amount).toFixed(2) + '</span></div>' : ''}
        ${booking.damage_waiver_fee ? '<div class="d-flex justify-content-between mb-2"><span>Damage Waiver</span><span>$' + parseFloat(booking.damage_waiver_fee).toFixed(2) + '</span></div>' : ''}
        ${booking.discount_amount ? '<div class="d-flex justify-content-between mb-2 text-success"><span>Discount</span><span>-$' + parseFloat(booking.discount_amount).toFixed(2) + '</span></div>' : ''}
        <hr>
        <div class="d-flex justify-content-between mb-2">
          <strong>Total</strong><strong>$${parseFloat(booking.total || 0).toFixed(2)}</strong>
        </div>
        <div class="d-flex justify-content-between mb-2 text-success">
          <span>Paid</span><span>$${parseFloat(booking.amount_paid || 0).toFixed(2)}</span>
        </div>
        <div class="d-flex justify-content-between">
          <strong>Balance</strong>
          <strong class="${parseFloat(booking.total || 0) - parseFloat(booking.amount_paid || 0) > 0 ? 'text-danger' : 'text-success'}">
            $${(parseFloat(booking.total || 0) - parseFloat(booking.amount_paid || 0)).toFixed(2)}
          </strong>
        </div>
      </div>
    </div>

    <!-- Status Change -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-exchange-alt me-2"></i>Change Status</div>
      <div class="card-body">
        <form method="POST" action="/admin/bookings/${booking.id}/status">
          <select name="status" class="form-select mb-2">
            <option value="pending" ${booking.status === 'pending' ? 'selected' : ''}>Pending</option>
            <option value="confirmed" ${booking.status === 'confirmed' ? 'selected' : ''}>Confirmed</option>
            <option value="completed" ${booking.status === 'completed' ? 'selected' : ''}>Completed</option>
            <option value="cancelled" ${booking.status === 'cancelled' ? 'selected' : ''}>Cancelled</option>
          </select>
          <button type="submit" class="btn btn-sm btn-bm w-100"><i class="fas fa-check me-1"></i> Update Status</button>
        </form>
      </div>
    </div>

    <!-- Crew Assignment -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-hard-hat me-2"></i>Crew Assignment</div>
      <div class="card-body">
        <form method="POST" action="/admin/bookings/${booking.id}/crew">
          <input type="text" name="crew_assigned" class="form-control mb-2" placeholder="Crew member names" value="${esc(booking.crew_assigned)}">
          <button type="submit" class="btn btn-sm btn-bm-outline w-100"><i class="fas fa-save me-1"></i> Assign Crew</button>
        </form>
      </div>
    </div>

    <!-- Contract Status -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-file-contract me-2"></i>Contract</div>
      <div class="card-body">
        ${contract ? `
          <div class="d-flex align-items-center mb-2">
            <i class="fas fa-${contract.signed_at ? 'check-circle text-success' : 'times-circle text-warning'} me-2 fa-lg"></i>
            <span>${contract.signed_at ? 'Signed on ' + contract.signed_at : 'Unsigned'}</span>
          </div>
          <a href="/admin/bookings/${booking.id}/contract" class="btn btn-sm btn-outline-secondary w-100">
            <i class="fas fa-eye me-1"></i> View Contract
          </a>
        ` : '<p class="text-muted mb-0">No contract generated</p>'}
      </div>
    </div>

    <!-- Payment History -->
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-credit-card me-2"></i>Payment History</span>
        <button class="btn btn-sm btn-success" type="button" data-bs-toggle="collapse" data-bs-target="#recordPaymentForm">
          <i class="fas fa-plus me-1"></i>Record Payment
        </button>
      </div>
      <div class="collapse" id="recordPaymentForm">
        <div class="card-body border-bottom" style="background:#f8f9fa">
          <form method="POST" action="/admin/bookings/${booking.id}/payment" class="row g-2 align-items-end">
            <div class="col-6 col-md-auto">
              <label class="form-label small mb-1">Amount</label>
              <div class="input-group input-group-sm">
                <span class="input-group-text">$</span>
                <input type="number" step="0.01" name="amount" class="form-control" value="${parseFloat(booking.balance_due || 0).toFixed(2)}" required>
              </div>
            </div>
            <div class="col-6 col-md-auto">
              <label class="form-label small mb-1">Method</label>
              <select name="payment_method" class="form-select form-select-sm">
                <option value="cash">Cash</option>
                <option value="check">Check</option>
                <option value="card">Card (Terminal)</option>
                <option value="venmo">Venmo</option>
                <option value="zelle">Zelle</option>
              </select>
            </div>
            <div class="col-6 col-md-auto">
              <label class="form-label small mb-1">Notes</label>
              <input type="text" name="notes" class="form-control form-control-sm" placeholder="Optional">
            </div>
            <div class="col-6 col-md-auto">
              <button type="submit" class="btn btn-sm btn-success"><i class="fas fa-check me-1"></i>Save</button>
            </div>
          </form>
        </div>
      </div>
      <div class="card-body p-0">
        ${payments.length > 0 ? '<div class="list-group list-group-flush">' + payments.map(p => `
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <strong>$${parseFloat(p.amount || 0).toFixed(2)}</strong>
              <small class="text-muted d-block">${esc(p.payment_method)} ${p.stripe_payment_id ? '(' + esc(p.stripe_payment_id) + ')' : ''}</small>
            </div>
            <small class="text-muted">${p.created_at || ''}</small>
          </div>
        `).join('') + '</div>' : '<div class="text-center text-muted py-3">No payments recorded</div>'}
      </div>
    </div>

  </div>
</div>

`, scripts: `
<script>
(function() {
  var MY_PHONE_KEY = 'bm_my_phone';
  document.querySelectorAll('.call-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var customerPhone = btn.getAttribute('data-phone');
      var myPhone = localStorage.getItem(MY_PHONE_KEY) || '';
      myPhone = prompt('Your cell number to call from:', myPhone);
      if (!myPhone) return;
      localStorage.setItem(MY_PHONE_KEY, myPhone);
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Calling...';
      fetch('/api/call/dial', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to: customerPhone, your_phone: myPhone })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success) {
          btn.innerHTML = '<i class="fas fa-check me-1"></i>Ringing!';
          setTimeout(function() { btn.disabled = false; btn.innerHTML = '<i class="fas fa-phone-alt me-1"></i>Call'; }, 5000);
        } else {
          alert('Error: ' + (d.error || 'Unknown error'));
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-phone-alt me-1"></i>Call';
        }
      }).catch(function() {
        alert('Request failed');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-phone-alt me-1"></i>Call';
      });
    });
  });
})();
</script>
` }) %>
