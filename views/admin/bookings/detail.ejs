<%- include('../../layouts/admin', { body: `
<style>
  .bk-head { margin-bottom: var(--bm-space-5); }
  .bk-head-title { margin: 0; font-size: 26px; letter-spacing: -0.02em; color: var(--bm-n-900); }
  .bk-head-sep { color: var(--bm-n-300); margin: 0 10px; font-weight: 400; }
  .bk-head-meta { display: flex; align-items: center; gap: var(--bm-space-3);
    margin-top: var(--bm-space-2); flex-wrap: wrap; }
  .bk-copy { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--bm-n-100);
    background: var(--bm-n-50); color: var(--bm-n-500); border-radius: var(--bm-radius-sm);
    font-size: 11px; font-weight: 600; padding: 3px 8px; cursor: pointer;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .bk-copy:hover { background: var(--bm-n-100); color: var(--bm-n-700); }
  .bk-copy i { font-size: 10px; opacity: 0.6; }
</style>

<a href="/admin/bookings" class="text-decoration-none mb-3 d-inline-block">
  <i class="fas fa-arrow-left me-1"></i> Back to Bookings
</a>

${(function () {
  var name = [booking.first_name, booking.last_name].filter(Boolean).join(' ') || 'No name on file';
  var when = fmtDayDate(booking.event_date);
  return '<div class="bk-head">' +
    '<h4 class="bk-head-title">' + esc(name) +
      (when ? '<span class="bk-head-sep">\u00b7</span>' + when : '') + '</h4>' +
    '<div class="bk-head-meta">' +
      '<span class="badge-status badge-' + booking.status + '">' + booking.status + '</span>' +
      '<button type="button" class="bk-copy" data-copy="' + esc(booking.booking_number || '') + '" ' +
        'title="Copy booking number">' + esc(booking.booking_number || '') +
        '<i class="fas fa-copy"></i></button>' +
    '</div>' +
  '</div>';
})()}

${(function () {
  /* V5 gave the admin four button ROLES; this page still rendered three filled
     primaries at once (Update Status, Send for signature, Save Notes), which is the
     same problem one level down -- if everything is primary, nothing is. Pick the one
     thing this particular booking needs next, and demote the rest to secondary. */
  var unsigned = (typeof contract !== 'undefined' && contract) && Number(contract.signed) !== 1;
  var owes = Number(booking.balance_due) > 0;
  var live = booking.status !== 'cancelled' && booking.status !== 'completed';
  globalThis.__bmPrimary = !live ? 'none' : unsigned ? 'contract' : owes ? 'payment' : 'status';
  return '';
})()}
<div class="row g-4">
  <!-- Left Column -->
  <div class="col-lg-7">

    <!-- Event Details -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-calendar me-2"></i>Event Details</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-sm-4">
            <small class="text-muted d-block">Event Date</small>
            <strong>${fmtDayDate(booking.event_date)}${booking.event_end_date && booking.event_end_date !== booking.event_date ? ' – ' + fmtDayDate(booking.event_end_date) : ''}</strong>
          </div>
          <div class="col-sm-4">
            <small class="text-muted d-block">Time</small>
            <strong>${fmtTime12(booking.event_start_time)} - ${fmtTime12(booking.event_end_time)}</strong>
          </div>
          <div class="col-sm-4">
            <small class="text-muted d-block">Duration</small>
            <strong>${items[0]?.duration_type === '4hr' ? '4 Hours' : 'Full Day'}${(parseInt(items[0]?.rental_days) || 1) > 1 ? ' · ' + items[0].rental_days + ' days' : ''}</strong>
          </div>
          <div class="col-sm-4">
            <small class="text-muted d-block">Event Type</small>
            <strong>${esc(booking.event_type) || 'N/A'}</strong>
          </div>
          <div class="col-sm-4">
            <small class="text-muted d-block">Venue / Location</small>
            <strong>${esc(booking.venue_type) || 'N/A'}</strong>
          </div>
          <div class="col-sm-4">
            <small class="text-muted d-block">Surface Type</small>
            <strong>${esc(booking.surface_type) || 'N/A'}</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Delivery Info -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-truck me-2"></i>Delivery Information</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-sm-8">
            <small class="text-muted d-block">Delivery Address</small>
            <strong>${esc(booking.delivery_address)}</strong>
            ${booking.delivery_city ? ', ' + esc(booking.delivery_city) : ''}
            ${booking.delivery_state ? ', ' + esc(booking.delivery_state) : ''}
            ${esc(booking.delivery_zip)}
          </div>
          <div class="col-12">
            <small class="text-muted d-block">Delivery Notes</small>
            <span>${esc(booking.delivery_notes) || 'None'}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Items -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-chess-rook me-2"></i>Booked Items</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 rtable">
            <thead><tr><th></th><th>Item</th><th class="d-none d-md-table-cell">Category</th><th>Unit Price</th><th>Total</th></tr></thead>
            <tbody>
              ${items.length > 0 ? items.map(item => `
              <tr>
                <td class="rt-hide" style="width:60px">
                  ${item.image ? '<img src="' + item.image + '" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px">' : '<div style="width:48px;height:48px;background:#eee;border-radius:8px;display:flex;align-items:center;justify-content:center"><i class="fas fa-image text-muted"></i></div>'}
                </td>
                <td class="rt-primary"><strong>${esc(item.item_name)}</strong></td>
                <td class="d-none d-md-table-cell">${esc(item.category)}</td>
                <td data-label="Unit Price">$${parseFloat(item.unit_price || 0).toFixed(2)}</td>
                <td data-label="Total">$${parseFloat(item.total_price || 0).toFixed(2)}</td>
              </tr>
              `).join('') : '<tr><td colspan="5" class="text-center text-muted py-3">No items</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Internal Notes -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-sticky-note me-2"></i>Internal Notes</div>
      <div class="card-body">
        <form method="POST" action="/admin/bookings/${booking.id}/notes">
          <textarea name="internal_notes" class="form-control mb-2" rows="3" placeholder="Add internal notes...">${esc(booking.internal_notes)}</textarea>
          <button type="submit" class="btn btn-sm btn-bm-outline"><i class="fas fa-save me-1"></i> Save Notes</button>
        </form>
      </div>
    </div>

    <!-- Communications Log -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-envelope me-2"></i>Communications</div>
      <div class="card-body p-0">
        ${comms.length > 0 ? '<div class="list-group list-group-flush">' + comms.map(c => `
          <div class="list-group-item">
            <div class="d-flex justify-content-between">
              <strong>
                <i class="fas fa-${c.direction === 'outbound' ? 'paper-plane text-primary' : 'inbox text-success'} me-1"></i>
                ${esc(c.subject || c.type || 'Message')}
              </strong>
              <small class="text-muted">${fmtStamp(c.sent_at || c.created_at)}</small>
            </div>
            <p class="mb-0 mt-1 small">${esc((c.body || '').substring(0, 200))}${(c.body || '').length > 200 ? '...' : ''}</p>
          </div>
        `).join('') + '</div>' : '<div class="text-center text-muted py-3">No communications yet</div>'}
      </div>
    </div>

  </div>

  <!-- Right Column -->
  <div class="col-lg-5">

    <!-- Customer Card -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-user me-2"></i>Customer</div>
      <div class="card-body">
        <h6 class="mb-2">${esc(booking.first_name)} ${esc(booking.last_name)}</h6>
        <div class="mb-1"><i class="fas fa-envelope text-muted me-2"></i>${esc(booking.email) || 'N/A'}</div>
        <div class="mb-1 d-flex align-items-center gap-2">
          <i class="fas fa-phone text-muted"></i>
          <span>${esc(booking.phone) || 'N/A'}</span>
          ${booking.phone ? '<button class="btn btn-sm btn-outline-success rounded-pill py-0 px-2 call-btn" data-phone="' + booking.phone + '" title="Click to call"><i class="fas fa-phone-alt me-1"></i>Call</button>' : ''}
        </div>
        ${booking.customer_id ? '<a href="/admin/customers/' + booking.customer_id + '" class="btn btn-sm btn-outline-secondary mt-2"><i class="fas fa-external-link-alt me-1"></i> View Customer</a>' : ''}
      </div>
    </div>

    <!-- Pricing Breakdown -->
    <div class="card mb-4">
      ${booking.tax_exempt_claimed && !booking.tax_exempt ? '<div class="alert alert-warning mb-0 rounded-0 border-0 border-bottom"><i class="fas fa-exclamation-triangle me-2"></i><strong>Tax Exempt Claimed</strong> — Customer claims tax-exempt status. Verify certificate before collecting balance due. <a href="/admin/customers/' + booking.customer_id + '">Mark as verified on customer record.</a></div>' : ''}
      ${booking.tax_exempt_claimed && booking.tax_exempt ? '<div class="alert alert-success mb-0 rounded-0 border-0 border-bottom"><i class="fas fa-check-circle me-2"></i>Tax exempt — verified.</div>' : ''}
      <div class="card-header"><i class="fas fa-dollar-sign me-2"></i>Pricing</div>
      <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
          <span>Subtotal</span><span>$${parseFloat(booking.subtotal || 0).toFixed(2)}</span>
        </div>
        ${booking.delivery_fee ? '<div class="d-flex justify-content-between mb-2"><span>Delivery Fee</span><span>$' + parseFloat(booking.delivery_fee).toFixed(2) + '</span></div>' : ''}
        ${booking.tax_amount ? '<div class="d-flex justify-content-between mb-2"><span>Tax</span><span>$' + parseFloat(booking.tax_amount).toFixed(2) + '</span></div>' : ''}
        ${booking.damage_waiver_fee ? '<div class="d-flex justify-content-between mb-2"><span>Damage Waiver</span><span>$' + parseFloat(booking.damage_waiver_fee).toFixed(2) + '</span></div>' : ''}
        ${booking.discount_amount ? '<div class="d-flex justify-content-between mb-2 text-success"><span>Discount</span><span>-$' + parseFloat(booking.discount_amount).toFixed(2) + '</span></div>' : ''}
        <hr>
        <div class="d-flex justify-content-between mb-2">
          <strong>Total</strong><strong>$${parseFloat(booking.total || 0).toFixed(2)}</strong>
        </div>
        <div class="d-flex justify-content-between mb-2 text-success">
          <span>Paid</span><span>$${parseFloat(booking.amount_paid || 0).toFixed(2)}</span>
        </div>
        <div class="d-flex justify-content-between">
          <strong>Balance</strong>
          <strong class="${parseFloat(booking.total || 0) - parseFloat(booking.amount_paid || 0) > 0 ? 'text-danger' : 'text-success'}">
            $${(parseFloat(booking.total || 0) - parseFloat(booking.amount_paid || 0)).toFixed(2)}
          </strong>
        </div>
      </div>
    </div>

    <!-- Status Change -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-exchange-alt me-2"></i>Change Status</div>
      <div class="card-body">
        <form method="POST" action="/admin/bookings/${booking.id}/status">
          <select name="status" class="form-select mb-2">
            <option value="pending" ${booking.status === 'pending' ? 'selected' : ''}>Pending</option>
            <option value="confirmed" ${booking.status === 'confirmed' ? 'selected' : ''}>Confirmed</option>
            <option value="completed" ${booking.status === 'completed' ? 'selected' : ''}>Completed</option>
            <option value="cancelled" ${booking.status === 'cancelled' ? 'selected' : ''}>Cancelled</option>
          </select>
          <button type="submit" class="btn btn-sm ${globalThis.__bmPrimary === 'status' ? 'btn-bm' : 'btn-bm-outline'} w-100"><i class="fas fa-check me-1"></i> Update Status</button>
        </form>
      </div>
    </div>

    <!-- Crew Assignment -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-hard-hat me-2"></i>Crew Assignment</div>
      <div class="card-body">
        ${(function () {
          /* booking.crew_assigned does not exist -- the column is assigned_crew. The box
             has therefore always rendered empty even when a value was stored. */
          var current = booking.assigned_crew || '';
          var list = (typeof roster !== 'undefined' && roster) ? roster : [];
          var onRoster = list.some(function (u) { return u.name === current; });
          var opts = '<option value="">Nobody assigned</option>' +
            list.map(function (u) {
              return '<option value="' + esc(u.name) + '"' +
                     (u.name === current ? ' selected' : '') + '>' + esc(u.name) + '</option>';
            }).join('') +
            '<option value="__other__"' + (current && !onRoster ? ' selected' : '') +
            '>Someone not on the roster\u2026</option>';
          return '<form method="POST" action="/admin/bookings/' + booking.id + '/crew">' +
            '<select name="crew" id="crewSelect" class="form-select form-select-sm mb-2">' + opts + '</select>' +
            '<input type="text" name="crew_other" id="crewOther" class="form-control form-control-sm mb-2"' +
              ' placeholder="Who is running this one?" value="' +
              (current && !onRoster ? esc(current) : '') + '"' +
              (current && !onRoster ? '' : ' hidden') + '>' +
            '<button type="submit" class="btn btn-sm btn-bm-outline w-100">' +
              '<i class="fas fa-save me-1"></i> Assign crew</button>' +
          '</form>';
        })()}
      </div>
    </div>

    <!-- Contract Status -->
    <div class="card mb-4">
      <div class="card-header"><i class="fas fa-file-contract me-2"></i>Contract</div>
      <div class="card-body">
        ${contract ? `
          <div class="d-flex align-items-center mb-2">
            <i class="fas fa-${contract.signed_at ? 'check-circle text-success' : 'times-circle text-warning'} me-2 fa-lg"></i>
            <span>${contract.signed_at ? 'Signed ' + fmtStamp(contract.signed_at) : 'Unsigned'}</span>
          </div>
          <a href="/admin/bookings/${booking.id}/contract" class="btn btn-sm btn-outline-secondary w-100">
            <i class="fas fa-eye me-1"></i> View Contract
          </a>
          ${contract.signed_at ? '' : `
          <form method="POST" action="/admin/bookings/${booking.id}/contract/send" class="mt-2 mb-0">
            <button type="submit" class="btn btn-sm ${globalThis.__bmPrimary === 'contract' ? 'btn-bm' : 'btn-bm-outline'} w-100">
              <i class="fas fa-paper-plane me-1"></i> Send for signature
            </button>
          </form>
          <small class="text-muted d-block mt-1">Emails just the signing link — not another booking confirmation.</small>`}
        ` : '<p class="text-muted mb-0">No contract generated</p>'}
      </div>
    </div>

    <!-- Payment History -->
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-credit-card me-2"></i>Payment History</span>
        <button class="btn btn-sm ${globalThis.__bmPrimary === 'payment' ? 'btn-bm' : 'btn-bm-outline'}" type="button" data-bs-toggle="collapse" data-bs-target="#recordPaymentForm">
          <i class="fas fa-plus me-1"></i>Record Payment
        </button>
      </div>
      <div class="collapse" id="recordPaymentForm">
        <div class="card-body border-bottom" style="background:#f8f9fa">
          <form method="POST" action="/admin/bookings/${booking.id}/payment" class="row g-2 align-items-end">
            <div class="col-6 col-md-auto">
              <label class="form-label small mb-1">Amount</label>
              <div class="input-group input-group-sm">
                <span class="input-group-text">$</span>
                <input type="number" step="0.01" name="amount" class="form-control" value="${parseFloat(booking.balance_due || 0).toFixed(2)}" required>
              </div>
            </div>
            <div class="col-6 col-md-auto">
              <label class="form-label small mb-1">Method</label>
              <select name="payment_method" class="form-select form-select-sm">
                <option value="cash">Cash</option>
                <option value="check">Check</option>
                <option value="card">Card (Terminal)</option>
                <option value="venmo">Venmo</option>
                <option value="zelle">Zelle</option>
              </select>
            </div>
            <div class="col-6 col-md-auto">
              <label class="form-label small mb-1">Notes</label>
              <input type="text" name="notes" class="form-control form-control-sm" placeholder="Optional">
            </div>
            <div class="col-6 col-md-auto">
              <button type="submit" class="btn btn-sm btn-success"><i class="fas fa-check me-1"></i>Save</button>
            </div>
          </form>
        </div>
      </div>
      <div class="card-body p-0">
        ${payments.length > 0 ? '<div class="list-group list-group-flush">' + payments.map(p => `
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <strong>$${parseFloat(p.amount || 0).toFixed(2)}</strong>
              <small class="text-muted d-block">${esc(p.payment_method)} ${p.stripe_payment_id ? '(' + esc(p.stripe_payment_id) + ')' : ''}</small>
            </div>
            <small class="text-muted">${fmtStamp(p.created_at)}</small>
          </div>
        `).join('') + '</div>' : '<div class="text-center text-muted py-3">No payments recorded</div>'}
      </div>
    </div>

  </div>
</div>

<div class="bm-danger-zone">
  <p>Deleting removes this booking and everything attached to it. It cannot be undone.</p>
  <form method="POST" action="/admin/bookings/${booking.id}/delete" class="confirm-delete m-0" data-confirm="Delete this booking and all related data? This cannot be undone.">
    <button type="submit" class="btn btn-sm btn-outline-danger">
      <i class="fas fa-trash me-1"></i> Delete booking
    </button>
  </form>
</div>

`, scripts: `
<script>
(function() {
  document.querySelectorAll('.call-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      bmCall(btn.getAttribute('data-phone'), btn, '<i class="fas fa-phone-alt me-1"></i>Call');
    });
  });
})();

/* Outcome of POST /contract/send, carried back on the redirect. Every branch of that
   route sets one, so the button can never look like it silently did nothing. */
(function () {
  var MSG = {
    ok:         ['success', 'Signing link emailed.'],
    already:    ['info',    'That contract is already signed.'],
    nocontract: ['warning', 'This booking has no contract to send.'],
    noemail:    ['warning', 'No email address on this customer — text them the link instead.'],
    failed:     ['error',   'The email did not go out. Check the mail settings and try again.']
  };
  var sent = new URLSearchParams(window.location.search).get('sent');
  if (!sent || !MSG[sent]) return;
  if (typeof showToast === 'function') showToast(MSG[sent][1], MSG[sent][0]);
  /* Drop the parameter so a refresh does not re-announce it. */
  var u = new URL(window.location.href);
  u.searchParams.delete('sent');
  window.history.replaceState({}, '', u.toString());
})();

/* Copy the booking number. It is the one thing on this page worth copying and the one
   thing nobody wants to retype off a screen. */
(function () {
  var btn = document.querySelector('.bk-copy');
  if (!btn) return;
  btn.addEventListener('click', function () {
    var value = btn.getAttribute('data-copy') || '';
    if (!value) return;
    var done = function () {
      if (typeof showToast === 'function') showToast('Copied ' + value, 'success');
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(value).then(done).catch(function () {
        if (typeof showToast === 'function') showToast('Could not copy — select it by hand.', 'warning');
      });
    } else if (typeof showToast === 'function') {
      showToast('Copying is not available in this browser.', 'warning');
    }
  });
})();

/* The roster is the users table, which has one person in it. A dropdown of one would
   make it impossible to record that a friend or a day-hire ran a delivery, so there is
   an escape hatch -- and it is a real input, not a prompt(), because what gets typed
   there is data. */
(function () {
  var sel = document.getElementById('crewSelect');
  var other = document.getElementById('crewOther');
  if (!sel || !other) return;
  function sync() {
    var isOther = sel.value === '__other__';
    other.hidden = !isOther;
    if (isOther) other.focus();
  }
  sel.addEventListener('change', sync);
})();
</script>
` }) %>
