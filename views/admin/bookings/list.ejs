<%- include('../../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Bookings</h4>
    <p class="text-muted mb-0">${bookings.length} booking${bookings.length !== 1 ? 's' : ''} found</p>
  </div>
  <a href="/admin/bookings/new" class="btn btn-bm"><i class="fas fa-plus me-1"></i> New Booking</a>
</div>

<!-- Bulk Actions Bar (fixed at top when visible) -->
<div id="bulkActions" class="alert alert-warning d-flex align-items-center justify-content-between mb-3" style="display:none !important">
  <span><i class="fas fa-check-square me-2"></i><strong id="selectedCount">0</strong> booking(s) selected</span>
  <div>
    <button type="button" id="bulkDeleteBtn" class="btn btn-sm btn-danger"><i class="fas fa-trash me-1"></i>Delete Selected</button>
    <button type="button" id="bulkCancelSelect" class="btn btn-sm btn-outline-secondary ms-2">Cancel</button>
  </div>
</div>

<!-- Filter Bar -->
<div class="card mb-4">
  <div class="card-body d-flex flex-wrap align-items-center gap-3">
    <div class="d-flex flex-wrap gap-2">
      <a href="/admin/bookings" class="btn btn-sm ${!activeStatus ? 'btn-bm' : 'btn-bm-outline'}">All</a>
      <a href="/admin/bookings?status=pending${activeDate ? '&date=' + activeDate : ''}" class="btn btn-sm ${activeStatus === 'pending' ? 'btn-bm' : 'btn-bm-outline'}">Pending</a>
      <a href="/admin/bookings?status=confirmed${activeDate ? '&date=' + activeDate : ''}" class="btn btn-sm ${activeStatus === 'confirmed' ? 'btn-bm' : 'btn-bm-outline'}">Confirmed</a>
      <a href="/admin/bookings?status=completed${activeDate ? '&date=' + activeDate : ''}" class="btn btn-sm ${activeStatus === 'completed' ? 'btn-bm' : 'btn-bm-outline'}">Completed</a>
      <a href="/admin/bookings?status=cancelled${activeDate ? '&date=' + activeDate : ''}" class="btn btn-sm ${activeStatus === 'cancelled' ? 'btn-bm' : 'btn-bm-outline'}">Cancelled</a>
    </div>
    <div class="ms-auto">
      <input type="date" class="form-control form-control-sm" value="${activeDate || ''}" id="dateFilter" data-status="${activeStatus || ''}">
    </div>
  </div>
</div>

<!-- Bookings Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th style="width:40px"><input type="checkbox" id="selectAll" class="form-check-input"></th>
            <th>Booking #</th>
            <th>Customer</th>
            <th>Event Date</th>
            <th>Time</th>
            <th>Status</th>
            <th>Total</th>
            <th>Payment</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          ${bookings.length > 0 ? bookings.map(b => `
          <tr style="cursor:pointer" data-booking-href="/admin/bookings/${b.id}">
            <td onclick="event.stopPropagation()"><input type="checkbox" class="form-check-input booking-check" value="${b.id}" data-booking-number="${b.booking_number}"></td>
            <td><strong>${b.booking_number}</strong></td>
            <td>
              <div>${b.first_name} ${b.last_name}</div>
              <small class="text-muted">${b.email || ''}</small>
            </td>
            <td>${b.event_date}</td>
            <td>${(function(t){if(!t)return'';var p=t.split(':');var h=parseInt(p[0]);var m=p[1]||'00';var a=h>=12?'PM':'AM';h=h>12?h-12:(h==0?12:h);return h+':'+m+' '+a})(b.event_start_time)} - ${(function(t){if(!t)return'';var p=t.split(':');var h=parseInt(p[0]);var m=p[1]||'00';var a=h>=12?'PM':'AM';h=h>12?h-12:(h==0?12:h);return h+':'+m+' '+a})(b.event_end_time)}</td>
            <td><span class="badge-status badge-${b.status}">${b.status}</span></td>
            <td>
              <div><strong>$${parseFloat(b.total || 0).toFixed(2)}</strong></div>
              <small class="text-muted">Deposit: $${parseFloat(b.deposit_amount || 0).toFixed(2)}</small>
            </td>
            <td>
              <span class="badge bg-${b.payment_status === 'paid' ? 'success' : b.payment_status === 'deposit_paid' ? 'info' : b.payment_status === 'partial' ? 'warning' : 'secondary'}">
                ${b.payment_status || 'unpaid'}
              </span>
            </td>
            <td>
              <a href="/admin/bookings/${b.id}" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-eye"></i> View
              </a>
            </td>
          </tr>
          `).join('') : '<tr><td colspan="9" class="text-center text-muted py-4">No bookings found</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>

`, scripts: `
<script>
  // Date filter navigation
  (function() {
    var df = document.getElementById('dateFilter');
    if (df) {
      df.addEventListener('change', function() {
        var statusParam = df.dataset.status ? 'status=' + df.dataset.status + '&' : '';
        window.location = '/admin/bookings?' + statusParam + 'date=' + this.value;
      });
    }
  })();

  // Bulk select/delete
  (function() {
    var selectAll = document.getElementById('selectAll');
    var bulkActions = document.getElementById('bulkActions');
    var selectedCount = document.getElementById('selectedCount');
    var bulkDeleteBtn = document.getElementById('bulkDeleteBtn');
    var bulkCancelSelect = document.getElementById('bulkCancelSelect');

    function updateBulkBar() {
      var checked = document.querySelectorAll('.booking-check:checked');
      if (checked.length > 0) {
        bulkActions.style.cssText = 'display:flex !important';
        selectedCount.textContent = checked.length;
      } else {
        bulkActions.style.cssText = 'display:none !important';
      }
    }

    if (selectAll) {
      selectAll.addEventListener('change', function() {
        document.querySelectorAll('.booking-check').forEach(function(cb) { cb.checked = selectAll.checked; });
        updateBulkBar();
      });
    }

    document.querySelectorAll('.booking-check').forEach(function(cb) {
      cb.addEventListener('change', updateBulkBar);
    });

    if (bulkCancelSelect) {
      bulkCancelSelect.addEventListener('click', function() {
        document.querySelectorAll('.booking-check').forEach(function(cb) { cb.checked = false; });
        if (selectAll) selectAll.checked = false;
        updateBulkBar();
      });
    }

    if (bulkDeleteBtn) {
      bulkDeleteBtn.addEventListener('click', function() {
        var checked = document.querySelectorAll('.booking-check:checked');
        var ids = Array.from(checked).map(function(cb) { return cb.value; });
        var numbers = Array.from(checked).map(function(cb) { return cb.dataset.bookingNumber; });
        if (ids.length === 0) return;
        if (!confirm('Delete ' + ids.length + ' booking(s)?\n\n' + numbers.join(', ') + '\n\nThis cannot be undone.')) return;
        fetch('/admin/api/bookings/bulk-delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: ids })
        }).then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) {
              showToast(data.deleted + ' booking(s) deleted', 'success');
              setTimeout(function() { window.location.reload(); }, 1000);
            } else {
              showToast('Error: ' + (data.error || 'Unknown'), 'error');
            }
          }).catch(function() { showToast('Network error', 'error'); });
      });
    }
  })();

  // Row click navigation
  document.querySelector('table tbody') && document.querySelector('table tbody').addEventListener('click', function(e) {
    if (e.target.closest('a') || e.target.closest('button') || e.target.closest('input')) return;
    var row = e.target.closest('[data-booking-href]');
    if (row) window.location.href = row.dataset.bookingHref;
  });
</script>
` }) %>
