<%- include('../../layouts/admin', { body: `
<style>
  .bk-scope { display: inline-flex; background: var(--bm-n-50); border-radius: var(--bm-radius-pill);
    padding: 3px; gap: 2px; }
  .bk-scope-tab { display: inline-flex; align-items: center; gap: 7px; padding: 5px 14px;
    border-radius: var(--bm-radius-pill); font-size: 14px; font-weight: 700;
    color: var(--bm-n-600); text-decoration: none; white-space: nowrap; }
  .bk-scope-tab:hover { color: var(--bm-n-900); }
  .bk-scope-tab span { font-size: 12px; font-weight: 700; color: var(--bm-n-700);
    background: var(--bm-n-100); border-radius: var(--bm-radius-pill); padding: 0 7px; }
  .bk-scope-tab.is-on { background: var(--bm-accent); color: var(--bm-on-accent);
    box-shadow: var(--bm-shadow-1); }
  .bk-scope-tab.is-on span { background: rgba(0, 0, 0, 0.14); color: var(--bm-on-accent); }
  .bk-name { font-weight: 700; color: var(--bm-n-900); }
  .bk-when { font-weight: 600; color: var(--bm-n-800); }
  .bk-span { font-size: 11px; font-weight: 700; color: var(--bm-n-600);
    background: var(--bm-n-100); border-radius: var(--bm-radius-pill); padding: 1px 7px; }
  .bk-chip { display: inline-block; font-size: 12px; font-weight: 700;
    padding: 3px 11px; border-radius: var(--bm-radius-pill); white-space: nowrap; }
  .bk-active  { background: var(--bm-state-active-bg);  color: var(--bm-state-active-fg); }
  .bk-done    { background: var(--bm-state-done-bg);    color: var(--bm-state-done-fg); }
  .bk-void    { background: var(--bm-state-void-bg);    color: var(--bm-state-void-fg); }
  .bk-pending { background: var(--bm-state-pending-bg); color: var(--bm-state-pending-fg); }
  .bk-owed { color: var(--bm-money-out); font-weight: 700; }
  .bk-no { font-size: 11px; color: var(--bm-n-500); background: var(--bm-n-50);
    border: 1px solid var(--bm-n-100); border-radius: var(--bm-radius-sm);
    padding: 2px 6px; }
  /* A cancelled booking is history. It should not compete with the 42 live ones. */
  .bk-dim td { opacity: 0.55; }
  .bk-dim:hover td { opacity: 1; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Bookings</h4>
    <p class="text-muted mb-0">${
      activeWhen === 'upcoming'
        ? (pageInfo.total === 1 ? '1 booking still ahead' : pageInfo.total + ' bookings still ahead')
        : activeWhen === 'past'
          ? pageInfo.total + ' in the past'
          : pageInfo.total + ' booking' + (pageInfo.total !== 1 ? 's' : '') + ' in total'
    }</p>
  </div>
  <a href="/admin/bookings/new" class="btn btn-bm"><i class="fas fa-plus me-1"></i> New Booking</a>
</div>

<!-- Bulk Actions Bar - hidden by default -->
<div id="bulkBar" class="alert alert-warning d-none mb-3">
  <div class="d-flex align-items-center justify-content-between">
    <span><i class="fas fa-check-square me-2"></i><span id="selCount">0</span> booking(s) selected</span>
    <div>
      <button type="button" id="delBtn" class="btn btn-sm btn-danger"><i class="fas fa-trash me-1"></i>Delete Selected</button>
      <button type="button" id="clearBtn" class="btn btn-sm btn-outline-secondary ms-2">Cancel</button>
    </div>
  </div>
</div>

<!-- Filter Bar -->
<div class="card mb-4">
  <div class="card-body d-flex flex-wrap align-items-center gap-3">
    <div class="bk-scope">
      ${['upcoming', 'past', 'all'].map(function (w) {
        var label = w === 'upcoming' ? 'Upcoming' : w === 'past' ? 'Past' : 'All';
        var qs = [];
        if (w !== 'upcoming' || activeStatus !== 'all' || activeDate) qs.push('when=' + w);
        if (activeStatus && activeStatus !== 'all') qs.push('status=' + activeStatus);
        if (activeDate) qs.push('date=' + activeDate);
        return '<a href="/admin/bookings' + (qs.length ? '?' + qs.join('&') : '') + '"' +
               ' class="bk-scope-tab' + (activeWhen === w ? ' is-on' : '') + '">' +
               label + '<span>' + scopeCounts[w] + '</span></a>';
      }).join('')}
    </div>
    <div class="d-flex flex-wrap gap-2">
      ${
        /* activeStatus is 'all' when nothing is filtered -- the route sets it that way --
           so the old test (!activeStatus) was never true and the All button could never
           light up. Compare to the value the route actually sends. */
        ['all', 'pending', 'confirmed', 'completed', 'cancelled'].map(function (st) {
          var label = st === 'all' ? 'All' : st.charAt(0).toUpperCase() + st.slice(1);
          var qs = [];
          if (st !== 'all') qs.push('status=' + st);
          if (activeWhen && activeWhen !== 'upcoming') qs.push('when=' + activeWhen);
          if (activeDate) qs.push('date=' + activeDate);
          return '<a href="/admin/bookings' + (qs.length ? '?' + qs.join('&') : '') + '"' +
                 ' class="btn btn-sm ' + (activeStatus === st ? 'btn-bm' : 'btn-bm-outline') + '">' +
                 label + '</a>';
        }).join('')
      }
    </div>
    <div class="ms-auto">
      <input type="date" class="form-control form-control-sm" value="${esc(activeDate)}" id="dateFilter" data-status="${esc(activeStatus)}">
    </div>
  </div>
</div>

<!-- Bookings Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 rtable">
        <thead>
          <tr>
            <th style="width:40px"><input type="checkbox" class="form-check-input" id="selAll"></th>
            ${listing.sortHeader('Customer', 'customer', sort, link)}
            ${listing.sortHeader('When', 'when', sort, link)}
            ${listing.sortHeader('Status', 'status', sort, link)}
            ${listing.sortHeader('Total', 'total', sort, link)}
            ${listing.sortHeader('Booking', 'booking', sort, link)}
          </tr>
        </thead>
        <tbody id="bookingsBody">
          ${(function () {
            /* V3 wrote local copies of these; V7 folded them into lib/helpers so the
               admin has exactly one date formatter and one time formatter. */
            var t12 = fmtTime12;
            var humanDate = function (iso) { return fmtDayDate(iso) || 'No date'; };
            /* status and payment_status were two columns, and across all 78 bookings they
               only ever form five combinations. One chip says the same thing, and says
               the part that matters -- whether money is still owed. */
            function state(b) {
              var owed = Number(b.balance_due) > 0;
              if (b.status === 'cancelled') {
                return b.payment_status === 'refunded'
                  ? { text: 'Cancelled, refunded', cls: 'void' }
                  : { text: 'Cancelled', cls: 'void' };
              }
              if (b.status === 'completed') return { text: 'Completed', cls: 'done' };
              if (owed) return { text: 'Balance due', cls: 'active' };
              if (b.status === 'confirmed') return { text: 'Confirmed', cls: 'active' };
              return { text: b.status || 'unknown', cls: 'pending' };
            }

            if (!bookings.length) {
              /* Filtered to nothing, or genuinely none? The answers are opposite. */
              var filtered = (activeStatus && activeStatus !== 'all') || activeDate ||
                             (activeWhen && activeWhen !== 'all');
              if (filtered) {
                return '<tr><td colspan="6"><div class="bm-empty">' +
                  '<i class="fas fa-filter bm-empty-icon"></i>' +
                  '<p class="bm-empty-title">Nothing matches this filter</p>' +
                  '<p class="bm-empty-line">There are bookings here, just none that fit what you have asked for.</p>' +
                  '<a href="/admin/bookings?when=all" class="btn btn-sm btn-bm">Show all bookings</a>' +
                  '</div></td></tr>';
              }
              return '<tr><td colspan="6"><div class="bm-empty">' +
                '<i class="fas fa-calendar-check bm-empty-icon"></i>' +
                '<p class="bm-empty-title">No bookings yet</p>' +
                '<p class="bm-empty-line">Every booking taken on the website or over the phone lands here.</p>' +
                '<a href="/admin/bookings/new" class="btn btn-sm btn-bm">New booking</a>' +
                '</div></td></tr>';
            }

            return bookings.map(function (b) {
              var st = state(b);
              var owed = Number(b.balance_due) > 0 ? Number(b.balance_due) : 0;
              var span = '';
              if (b.event_end_date && b.event_end_date !== b.event_date) {
                try {
                  var days = Math.round((new Date(b.event_end_date + 'T12:00:00') -
                                         new Date(b.event_date + 'T12:00:00')) / 86400000) + 1;
                  span = ' <span class="bk-span" title="' + b.event_date + ' to ' + b.event_end_date + '">' + days + 'd</span>';
                } catch (_) { span = ''; }
              }
              var times = [t12(b.event_start_time), t12(b.event_end_time)].filter(Boolean).join(' \u2013 ');
              var name = [b.first_name, b.last_name].filter(Boolean).join(' ') || 'No name on file';

              return '<tr data-href="/admin/bookings/' + b.id + '"' +
                     (b.status === 'cancelled' ? ' class="bk-dim"' : '') + '>' +
                '<td class="rt-hide"><input type="checkbox" class="form-check-input rowCb" value="' + b.id + '" data-num="' + b.booking_number + '"></td>' +
                '<td class="rt-primary"><div class="bk-name">' + esc(name) + '</div>' +
                  (b.email ? '<small class="text-muted">' + esc(b.email) + '</small>' : '') + '</td>' +
                '<td data-label="When"><div class="bk-when">' + humanDate(b.event_date) + span + '</div>' +
                  (times ? '<small class="text-muted">' + times + '</small>' : '') + '</td>' +
                '<td data-label="Status"><span class="bk-chip bk-' + st.cls + '">' + st.text + '</span></td>' +
                '<td data-label="Total"><div><strong>$' + parseFloat(b.total || 0).toFixed(2) + '</strong></div>' +
                  (owed ? '<small class="bk-owed">$' + owed.toFixed(2) + ' due</small>' : '') + '</td>' +
                '<td data-label="Booking"><code class="bk-no">' + esc(b.booking_number || '') + '</code></td>' +
                '</tr>';
            }).join('');
          })()}
        </tbody>
      </table>
      ${listing.pager(pageInfo, link)}
    </div>
  </div>
</div>

`, scripts: `
<script>
document.addEventListener('DOMContentLoaded', function() {
  var bar = document.getElementById('bulkBar');
  var count = document.getElementById('selCount');
  var selAll = document.getElementById('selAll');
  var delBtn = document.getElementById('delBtn');
  var clearBtn = document.getElementById('clearBtn');
  var dateFilter = document.getElementById('dateFilter');
  var tbody = document.getElementById('bookingsBody');

  function getChecked() {
    return document.querySelectorAll('.rowCb:checked');
  }

  function updateBar() {
    var n = getChecked().length;
    if (n > 0) {
      bar.classList.remove('d-none');
      count.textContent = n;
    } else {
      bar.classList.add('d-none');
    }
  }

  // Select all
  selAll.addEventListener('change', function() {
    document.querySelectorAll('.rowCb').forEach(function(cb) {
      cb.checked = selAll.checked;
    });
    updateBar();
  });

  // Individual checkbox change
  tbody.addEventListener('change', function(e) {
    if (e.target.classList.contains('rowCb')) {
      updateBar();
    }
  });

  // Clear selection
  clearBtn.addEventListener('click', function() {
    document.querySelectorAll('.rowCb').forEach(function(cb) { cb.checked = false; });
    selAll.checked = false;
    updateBar();
  });

  // Delete selected
  delBtn.addEventListener('click', async function() {
    var checked = getChecked();
    var ids = [], nums = [];
    checked.forEach(function(cb) {
      ids.push(cb.value);
      nums.push(cb.dataset.num);
    });
    if (!await bmConfirm({
      title: 'Delete ' + ids.length + ' booking' + (ids.length === 1 ? '' : 's') + '?',
      message: nums.join(', ') + '\n\nThis cannot be undone.',
      confirmLabel: 'Delete', danger: true
    })) return;
    
    fetch('/admin/api/bookings/bulk-delete', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ids: ids})
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        showToast(data.deleted + ' booking(s) deleted', 'success');
        setTimeout(function() { location.reload(); }, 800);
      } else {
        showToast('Error: ' + (data.error || 'Unknown'), 'error');
      }
    })
    .catch(function() { showToast('Network error', 'error'); });
  });

  // Date filter
  if (dateFilter) {
    dateFilter.addEventListener('change', function() {
      var s = dateFilter.dataset.status;
      location.href = '/admin/bookings?' + (s ? 'status=' + s + '&' : '') + 'date=' + this.value;
    });
  }

  // Row click navigation (exclude checkbox clicks)
  tbody.addEventListener('click', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.closest('a') || e.target.closest('button')) return;
    var row = e.target.closest('[data-href]');
    if (row) location.href = row.dataset.href;
  });
});
</script>
` }) %>
