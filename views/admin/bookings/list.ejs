<%- include('../../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Bookings</h4>
    <p class="text-muted mb-0">${bookings.length} booking${bookings.length !== 1 ? 's' : ''} found</p>
  </div>
  <a href="/admin/bookings/new" class="btn btn-bm"><i class="fas fa-plus me-1"></i> New Booking</a>
</div>

<!-- Bulk Actions Bar - hidden by default -->
<div id="bulkBar" class="alert alert-warning d-none mb-3">
  <div class="d-flex align-items-center justify-content-between">
    <span><i class="fas fa-check-square me-2"></i><span id="selCount">0</span> booking(s) selected</span>
    <div>
      <button type="button" id="delBtn" class="btn btn-sm btn-danger"><i class="fas fa-trash me-1"></i>Delete Selected</button>
      <button type="button" id="clearBtn" class="btn btn-sm btn-outline-secondary ms-2">Cancel</button>
    </div>
  </div>
</div>

<!-- Filter Bar -->
<div class="card mb-4">
  <div class="card-body d-flex flex-wrap align-items-center gap-3">
    <div class="d-flex flex-wrap gap-2">
      <a href="/admin/bookings" class="btn btn-sm ${!activeStatus ? 'btn-bm' : 'btn-bm-outline'}">All</a>
      <a href="/admin/bookings?status=pending${activeDate ? '&date=' + activeDate : ''}" class="btn btn-sm ${activeStatus === 'pending' ? 'btn-bm' : 'btn-bm-outline'}">Pending</a>
      <a href="/admin/bookings?status=confirmed${activeDate ? '&date=' + activeDate : ''}" class="btn btn-sm ${activeStatus === 'confirmed' ? 'btn-bm' : 'btn-bm-outline'}">Confirmed</a>
      <a href="/admin/bookings?status=completed${activeDate ? '&date=' + activeDate : ''}" class="btn btn-sm ${activeStatus === 'completed' ? 'btn-bm' : 'btn-bm-outline'}">Completed</a>
      <a href="/admin/bookings?status=cancelled${activeDate ? '&date=' + activeDate : ''}" class="btn btn-sm ${activeStatus === 'cancelled' ? 'btn-bm' : 'btn-bm-outline'}">Cancelled</a>
    </div>
    <div class="ms-auto">
      <input type="date" class="form-control form-control-sm" value="${esc(activeDate)}" id="dateFilter" data-status="${esc(activeStatus)}">
    </div>
  </div>
</div>

<!-- Bookings Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 rtable">
        <thead>
          <tr>
            <th style="width:40px"><input type="checkbox" class="form-check-input" id="selAll"></th>
            <th>Booking #</th>
            <th>Customer</th>
            <th>Event Date</th>
            <th>Time</th>
            <th>Status</th>
            <th>Total</th>
            <th>Payment</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="bookingsBody">
          ${bookings.length > 0 ? bookings.map(b => `
          <tr data-href="/admin/bookings/${b.id}">
            <td class="rt-hide"><input type="checkbox" class="form-check-input rowCb" value="${b.id}" data-num="${b.booking_number}"></td>
            <td class="rt-primary"><strong>${b.booking_number}</strong></td>
            <td data-label="Customer">
              <div>${esc(b.first_name)} ${esc(b.last_name)}</div>
              <small class="text-muted">${esc(b.email)}</small>
            </td>
            <td data-label="Date">${b.event_date}${(function(s,e){if(!e||e===s)return'';try{var d=Math.round((new Date(e+'T12:00:00')-new Date(s+'T12:00:00'))/86400000)+1;return ' <span class="badge bg-secondary" title="'+s+' to '+e+'">'+d+'d</span>';}catch(_){return''}})(b.event_date,b.event_end_date)}</td>
            <td data-label="Time">${(function(t){if(!t)return'';var p=t.split(':');var h=parseInt(p[0]);var m=p[1]||'00';var a=h>=12?'PM':'AM';h=h>12?h-12:(h==0?12:h);return h+':'+m+' '+a})(b.event_start_time)} - ${(function(t){if(!t)return'';var p=t.split(':');var h=parseInt(p[0]);var m=p[1]||'00';var a=h>=12?'PM':'AM';h=h>12?h-12:(h==0?12:h);return h+':'+m+' '+a})(b.event_end_time)}</td>
            <td data-label="Status"><span class="badge-status badge-${b.status}">${b.status}</span></td>
            <td data-label="Total">
              <div><strong>$${parseFloat(b.total || 0).toFixed(2)}</strong></div>
              <small class="text-muted">Deposit: $${parseFloat(b.deposit_amount || 0).toFixed(2)}</small>
            </td>
            <td data-label="Payment">
              <span class="badge bg-${b.payment_status === 'paid' ? 'success' : b.payment_status === 'deposit_paid' ? 'info' : b.payment_status === 'partial' ? 'warning' : 'secondary'}">
                ${b.payment_status || 'unpaid'}
              </span>
            </td>
            <td class="rt-actions rt-hide">
              <a href="/admin/bookings/${b.id}" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-eye"></i> View
              </a>
            </td>
          </tr>
          `).join('') : '<tr><td colspan="9" class="text-center text-muted py-4">No bookings found</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>

`, scripts: `
<script>
document.addEventListener('DOMContentLoaded', function() {
  var bar = document.getElementById('bulkBar');
  var count = document.getElementById('selCount');
  var selAll = document.getElementById('selAll');
  var delBtn = document.getElementById('delBtn');
  var clearBtn = document.getElementById('clearBtn');
  var dateFilter = document.getElementById('dateFilter');
  var tbody = document.getElementById('bookingsBody');

  function getChecked() {
    return document.querySelectorAll('.rowCb:checked');
  }

  function updateBar() {
    var n = getChecked().length;
    if (n > 0) {
      bar.classList.remove('d-none');
      count.textContent = n;
    } else {
      bar.classList.add('d-none');
    }
  }

  // Select all
  selAll.addEventListener('change', function() {
    document.querySelectorAll('.rowCb').forEach(function(cb) {
      cb.checked = selAll.checked;
    });
    updateBar();
  });

  // Individual checkbox change
  tbody.addEventListener('change', function(e) {
    if (e.target.classList.contains('rowCb')) {
      updateBar();
    }
  });

  // Clear selection
  clearBtn.addEventListener('click', function() {
    document.querySelectorAll('.rowCb').forEach(function(cb) { cb.checked = false; });
    selAll.checked = false;
    updateBar();
  });

  // Delete selected
  delBtn.addEventListener('click', function() {
    var checked = getChecked();
    var ids = [], nums = [];
    checked.forEach(function(cb) {
      ids.push(cb.value);
      nums.push(cb.dataset.num);
    });
    if (!confirm('Delete ' + ids.length + ' booking(s)?\\n\\n' + nums.join(', ') + '\\n\\nThis cannot be undone.')) return;
    
    fetch('/admin/api/bookings/bulk-delete', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ids: ids})
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        showToast(data.deleted + ' booking(s) deleted', 'success');
        setTimeout(function() { location.reload(); }, 800);
      } else {
        showToast('Error: ' + (data.error || 'Unknown'), 'error');
      }
    })
    .catch(function() { showToast('Network error', 'error'); });
  });

  // Date filter
  if (dateFilter) {
    dateFilter.addEventListener('change', function() {
      var s = dateFilter.dataset.status;
      location.href = '/admin/bookings?' + (s ? 'status=' + s + '&' : '') + 'date=' + this.value;
    });
  }

  // Row click navigation (exclude checkbox clicks)
  tbody.addEventListener('click', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.closest('a') || e.target.closest('button')) return;
    var row = e.target.closest('[data-href]');
    if (row) location.href = row.dataset.href;
  });
});
</script>
` }) %>
