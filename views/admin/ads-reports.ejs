<%- include('../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0"><svg class="bm-i me-2" aria-hidden="true"><use href="#i-chart-bar"/></svg>Ad Reports</h4>
  <a href="/admin/ads" class="btn btn-sm btn-outline-secondary"><svg class="bm-i me-1" aria-hidden="true"><use href="#i-arrow-left"/></svg>Back to Ad Dashboard</a>
</div>

<!-- Date Range & Filters -->
<div class="card mb-4">
  <div class="card-body">
    <div class="row g-3 align-items-end">
      <div class="col-6 col-md-3">
        <label class="form-label small text-muted">From Date</label>
        <input type="date" class="form-control form-control-sm" id="fromDate" value="${filter.from}">
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label small text-muted">To Date</label>
        <input type="date" class="form-control form-control-sm" id="toDate" value="${filter.to}">
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label small text-muted">Channel</label>
        <select class="form-select form-select-sm" id="channelFilter">
          <option value="all" ${filter.platform === 'all' ? 'selected' : ''}>All Channels</option>
          <option value="google" ${filter.platform === 'google' ? 'selected' : ''}>Google</option>
          <option value="facebook" ${filter.platform === 'facebook' ? 'selected' : ''}>Facebook / Instagram</option>
        </select>
      </div>
      <div class="col-6 col-md-3">
        <button class="btn btn-sm btn-bm w-100" id="applyFiltersBtn">
          <svg class="bm-i me-1" aria-hidden="true"><use href="#i-filter"/></svg>Apply Filters
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Channel Tabs -->
<ul class="nav nav-tabs mb-4" id="channelTabs">
  <li class="nav-item"><button class="nav-link active" data-channel="all">All</button></li>
  <li class="nav-item"><button class="nav-link" data-channel="google"><svg class="bm-i me-1" aria-hidden="true"><use href="#i-google"/></svg>Google</button></li>
  <li class="nav-item"><button class="nav-link" data-channel="facebook"><svg class="bm-i me-1" aria-hidden="true"><use href="#i-facebook"/></svg>Facebook</button></li>
</ul>

${rows.length === 0 ? `
<!-- Empty State -->
<div class="card">
  <div class="card-body text-center py-5 text-muted">
    <svg class="bm-i bm-i-4x mb-4" style="opacity:0.15" aria-hidden="true"><use href="#i-chart-line"/></svg>
    <h5>No Ad Data Yet</h5>
    <p>Reports will appear once campaigns are active and syncing data.</p>
    <a href="/admin/ads" class="btn btn-bm btn-sm mt-2">Set Up Campaigns</a>
  </div>
</div>
` : `
<!-- Chart Placeholder -->
<div class="card mb-4">
  <div class="card-header"><svg class="bm-i me-2" aria-hidden="true"><use href="#i-chart-area"/></svg>Spend Over Time</div>
  <div class="card-body text-center text-muted py-4">
    <svg class="bm-i bm-i-3x mb-3" style="opacity:0.2" aria-hidden="true"><use href="#i-chart-area"/></svg>
    <p class="mb-0">Chart visualization coming soon.</p>
  </div>
</div>

<!-- Data Table -->
<div class="card">
  <div class="card-header"><svg class="bm-i me-2" aria-hidden="true"><use href="#i-table"/></svg>Performance Data</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0 rtable" id="perfTable">
        <thead>
          <tr>
            <th>Date</th>
            <th>Channel</th>
            <th>Campaign</th>
            <th class="text-end d-none d-md-table-cell">Impressions</th>
            <th class="text-end d-none d-md-table-cell">Clicks</th>
            <th class="text-end">Spend</th>
            <th class="text-end">Conversions</th>
            <th class="text-end d-none d-md-table-cell">CPC</th>
            <th class="text-end">Cost/Booking</th>
          </tr>
        </thead>
        <tbody>
          ${rows.map(r => `
          <tr class="channel-row" data-channel="${r.platform || 'unknown'}">
            <td class="rt-primary">${fmtDateShort(r.date)}</td>
            <td data-label="Channel">
              ${r.platform === 'google'
                ? '<svg class="bm-i text-primary me-1" aria-hidden="true"><use href="#i-google"/></svg>Google'
                : r.platform === 'facebook'
                ? '<svg class="bm-i" style="color:#1877F2" aria-hidden="true"><use href="#i-facebook"/></svg> Facebook'
                : r.platform || '—'
              }
            </td>
            <td class="text-muted small" data-label="Campaign">${r.campaign_name || '—'}</td>
            <td class="text-end d-none d-md-table-cell">${(r.impressions||0).toLocaleString()}</td>
            <td class="text-end d-none d-md-table-cell">${(r.clicks||0).toLocaleString()}</td>
            <td class="text-end" data-label="Spend">$${parseFloat(r.spend||0).toFixed(2)}</td>
            <td class="text-end" data-label="Conversions">${r.conversions||0}</td>
            <td class="text-end d-none d-md-table-cell">$${parseFloat(r.cost_per_click||0).toFixed(2)}</td>
            <td class="text-end" data-label="Cost/Booking">${r.cost_per_conversion > 0 ? '$'+parseFloat(r.cost_per_conversion).toFixed(2) : '—'}</td>
          </tr>
          `).join('')}
        </tbody>
      </table>
    </div>
  </div>
</div>
`}

`, scripts: `
<script>
// Tab switching
document.querySelectorAll('#channelTabs .nav-link').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('#channelTabs .nav-link').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    const ch = this.dataset.channel;
    document.querySelectorAll('.channel-row').forEach(row => {
      row.style.display = (ch === 'all' || row.dataset.channel === ch) ? '' : 'none';
    });
  });
});

function applyFilters() {
  const from = document.getElementById('fromDate').value;
  const to = document.getElementById('toDate').value;
  const ch = document.getElementById('channelFilter').value;
  const params = new URLSearchParams();
  if (from) params.set('from', from);
  if (to) params.set('to', to);
  if (ch && ch !== 'all') params.set('platform', ch);
  const qs = params.toString();
  window.location.href = '/admin/ads/reports' + (qs ? '?' + qs : '');
}
var _applyBtn = document.getElementById('applyFiltersBtn');
if (_applyBtn) _applyBtn.addEventListener('click', applyFilters);
</script>
` }) %>
