<%- include('../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Reviews</h4>
    <p class="text-muted mb-0">
      ${reviews.length} review${reviews.length !== 1 ? 's' : ''}
      <span class="badge bg-warning text-dark ms-2">
        ${reviews.filter(r => !r.approved).length} pending approval
      </span>
    </p>
  </div>
</div>

${reviews.length > 0 ? reviews.map(r => `
<div class="card mb-3 ${!r.approved ? 'border-start border-warning border-3' : ''}">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
      <div>
        <div class="mb-1">
          ${Array.from({length: 5}, (_, i) => i < (r.rating || 0) ? '<i class="fas fa-star text-warning"></i>' : '<i class="far fa-star text-muted"></i>').join('')}
          <span class="ms-2 fw-bold">${r.rating || 0}/5</span>
        </div>
        <h6 class="mb-0">${r.customer_name || 'Anonymous'}</h6>
        ${r.booking_number ? '<small class="text-muted">Booking #' + r.booking_number + '</small>' : ''}
      </div>
      <div class="text-end">
        <small class="text-muted d-block">${r.created_at || ''}</small>
        <span class="badge bg-${r.approved ? 'success' : 'warning text-dark'} mt-1">
          ${r.approved ? 'Approved' : 'Pending'}
        </span>
      </div>
    </div>

    <p class="mb-3">${r.comment || 'No comment'}</p>

    ${r.response ? `
    <div class="bg-light rounded p-3 mb-3">
      <small class="text-muted d-block mb-1"><i class="fas fa-reply me-1"></i> Your Response</small>
      <p class="mb-0">${r.response}</p>
    </div>
    ` : ''}

    <div class="d-flex gap-2 flex-wrap">
      ${!r.approved ? `
      <form method="POST" action="/admin/reviews/${r.id}/approve" class="d-inline">
        <button type="submit" class="btn btn-sm btn-success">
          <i class="fas fa-check me-1"></i> Approve
        </button>
      </form>
      ` : ''}

      <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#respond-${r.id}">
        <i class="fas fa-reply me-1"></i> ${r.response ? 'Update Response' : 'Respond'}
      </button>

      <form method="POST" action="/admin/reviews/${r.id}/delete" style="display:inline" class="confirm-delete" data-confirm="Are you sure you want to delete this review?">
        <button type="submit" class="btn btn-sm btn-outline-danger">
          <i class="fas fa-trash me-1"></i> Delete
        </button>
      </form>
    </div>

    <div class="collapse mt-3" id="respond-${r.id}">
      <form method="POST" action="/admin/reviews/${r.id}/respond">
        <textarea name="response" class="form-control mb-2" rows="3" placeholder="Write your response...">${r.response || ''}</textarea>
        <button type="submit" class="btn btn-sm btn-bm"><i class="fas fa-paper-plane me-1"></i> Submit Response</button>
      </form>
    </div>
  </div>
</div>
`).join('') : `
<div class="card">
  <div class="card-body text-center py-5">
    <i class="fas fa-star fa-3x text-muted mb-3"></i>
    <h5 class="text-muted">No reviews yet</h5>
    <p class="text-muted">Reviews will appear here once customers submit them.</p>
  </div>
</div>
`}

`, scripts: '' }) %>
