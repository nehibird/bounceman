<%- include('../layouts/admin', { body: `

<div class="d-flex justify-content-between align-items-center mb-4">
<!-- R18. The heading that stood here repeated the breadcrumb, word for word. The
     header has carried the page name since P2-5. Described in words rather than
     quoted: ci/verify-titles.sh greps this file for a heading holding the page's
     name, and on R7 a comment quoting the markup it deleted failed that gate. -->
  <div>
    <p class="text-muted mb-0">
      ${reviews.length} review${reviews.length !== 1 ? 's' : ''}
      <span class="badge bg-warning text-dark ms-2">
        ${reviews.filter(r => !r.approved).length} pending approval
      </span>
    </p>
  </div>
</div>

${reviews.length > 0 ? reviews.map(r => `
<div class="card mb-3 ${!r.approved ? 'border-start border-warning border-3' : ''}">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
      <div>
        <div class="mb-1">
          ${Array.from({length: 5}, (_, i) => i < (r.rating || 0) ? '<svg class="bm-i text-warning" aria-hidden="true"><use href="#i-star"/></svg>' : '<svg class="bm-i text-muted" aria-hidden="true"><use href="#i-star"/></svg>').join('')}
          <span class="ms-2 fw-bold">${r.rating || 0}/5</span>
        </div>
        <h6 class="mb-0">${esc(r.customer_name) || 'Anonymous'}</h6>
        ${r.booking_number ? '<small class="text-muted">Booking #' + r.booking_number + '</small>' : ''}
      </div>
      <div class="text-end">
        <small class="text-muted d-block">${fmtStamp(r.created_at, false)}</small>
        <span class="badge bg-${r.approved ? 'success' : 'warning text-dark'} mt-1">
          ${r.approved ? 'Approved' : 'Pending'}
        </span>
      </div>
    </div>

    <p class="mb-3">${esc(r.comment) || 'No comment'}</p>

    ${r.response ? `
    <div class="bg-light rounded p-3 mb-3">
      <small class="text-muted d-block mb-1"><svg class="bm-i me-1" aria-hidden="true"><use href="#i-reply"/></svg> Your Response</small>
      <p class="mb-0">${esc(r.response)}</p>
    </div>
    ` : ''}

    <div class="d-flex gap-2 flex-wrap">
      ${!r.approved ? `
      <form method="POST" action="/admin/reviews/${r.id}/approve" class="d-inline">
        <button type="submit" class="btn btn-sm btn-success">
          <svg class="bm-i me-1" aria-hidden="true"><use href="#i-check"/></svg> Approve
        </button>
      </form>
      ` : ''}

      <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#respond-${r.id}">
        <svg class="bm-i me-1" aria-hidden="true"><use href="#i-reply"/></svg> ${r.response ? 'Update Response' : 'Respond'}
      </button>

      <form method="POST" action="/admin/reviews/${r.id}/delete" style="display:inline" class="confirm-delete" data-confirm="Are you sure you want to delete this review?">
        <button type="submit" class="btn btn-sm btn-outline-danger">
          <svg class="bm-i me-1" aria-hidden="true"><use href="#i-trash"/></svg> Delete
        </button>
      </form>
    </div>

    <div class="collapse mt-3" id="respond-${r.id}">
      <form method="POST" action="/admin/reviews/${r.id}/respond">
        <textarea name="response" class="form-control mb-2" rows="3" placeholder="Write your response...">${esc(r.response)}</textarea>
        <button type="submit" class="btn btn-sm btn-bm"><svg class="bm-i me-1" aria-hidden="true"><use href="#i-paper-plane"/></svg> Submit Response</button>
      </form>
    </div>
  </div>
</div>
`).join('') : `
<div class="card">
  <div class="card-body text-center py-5">
    <svg class="bm-i bm-i-3x text-muted mb-3" aria-hidden="true"><use href="#i-star"/></svg>
    <h5 class="text-muted">No reviews yet</h5>
    <p class="text-muted">Reviews will appear here once customers submit them.</p>
  </div>
</div>
`}

`, scripts: '' }) %>
