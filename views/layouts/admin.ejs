      <a href="/admin/bookings" class="<%= page === 'bookings' ? 'active' : '' %>">
        <i class="fas fa-calendar-check"></i> Bookings
      </a>
      <a href="/admin/calendar" class="<%= page === 'calendar' ? 'active' : '' %>">
        <i class="fas fa-calendar-alt"></i> Calendar
      </a>
      <a href="/admin/equipment" class="<%= page === 'equipment' ? 'active' : '' %>">
        <i class="fas fa-chess-rook"></i> Equipment
      </a>
      <a href="/admin/customers" class="<%= page === 'customers' ? 'active' : '' %>">
        <i class="fas fa-users"></i> Customers
      </a>
      <div class="section-label">Operations</div>
      <a href="/admin/events" class="<%= page === 'events' ? 'active' : '' %>">
        <i class="fas fa-ticket-alt"></i> Walk-Up Events
      </a>
      <a href="/admin/delivery" class="<%= page === 'delivery' ? 'active' : '' %>">
        <i class="fas fa-truck"></i> Delivery
      </a>
      <a href="/admin/maintenance" class="<%= page === 'maintenance' ? 'active' : '' %>">
        <i class="fas fa-wrench"></i> Maintenance
      </a>
      <a href="/admin/inbox" class="<%= page === 'inbox' ? 'active' : '' %>">
        <i class="fas fa-inbox"></i> Inbox
      </a>
      <div class="section-label">Advertising</div>
      <a href="/admin/ads" class="<%= page === 'ads' ? 'active' : '' %>">
        <i class="fas fa-ad"></i> Ad Dashboard
      </a>
      <div class="section-label">Insights</div>
      <a href="/admin/expenses" class="<%= page === 'expenses' ? 'active' : '' %>">
        <i class="fas fa-receipt"></i> Expenses
      </a>
      <a href="/admin/obligations" class="<%= page === 'obligations' ? 'active' : '' %>">
        <i class="fas fa-rotate"></i> Recurring Costs
      </a>
      <a href="/admin/banks" class="<%= page === 'banks' ? 'active' : '' %>">
        <i class="fas fa-university"></i> Connected Banks
      </a>
      <a href="/admin/reports" class="<%= page === 'reports' ? 'active' : '' %>">
        <i class="fas fa-chart-bar"></i> Reports
      </a>
      <a href="/admin/reviews" class="<%= page === 'reviews' ? 'active' : '' %>">
        <i class="fas fa-star"></i> Reviews
      </a>
      <div class="divider"></div>
      <a href="/admin/settings" class="<%= page === 'settings' ? 'active' : '' %>">
        <i class="fas fa-cog"></i> Settings
      </a>
      <a href="/" target="_blank">
        <i class="fas fa-external-link-alt"></i> View Website
      </a>
      <a href="/auth/logout">
        <i class="fas fa-sign-out-alt"></i> Logout
      </a>
    </nav>
  </aside>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <button class="btn btn-sm btn-outline-secondary d-md-none" id="sidebarToggleBtn">
          <i class="fas fa-bars"></i>
        </button>
        <strong><%= title.replace(' - Bounce Man Admin', '').replace(' - Admin', '') %></strong>
      </div>
      <div class="d-flex align-items-center gap-3">
        <div class="bm-search" id="bmSearch">
          <i class="fas fa-magnifying-glass bm-search-icon"></i>
          <input type="search" id="bmSearchInput" autocomplete="off" spellcheck="false"
                 placeholder="Search bookings, customers, phone numbers"
                 aria-label="Search" aria-autocomplete="list" aria-expanded="false"
                 aria-controls="bmSearchResults" role="combobox">
          <kbd class="bm-search-kbd">/</kbd>
          <div class="bm-search-panel" id="bmSearchResults" role="listbox" hidden></div>
        </div>
        <span class="text-muted small"><i class="fas fa-user"></i> <%= user.name %></span>
      </div>
    </header>
    <div class="admin-content">
      <%- body %>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <% if (typeof page !== 'undefined' && page === 'calendar') { %>
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
  <% } %>
  <% if (typeof page !== 'undefined' && (page === 'reports' || page === 'dashboard')) { %>
  <%
     /* The dashboard used to pull its own copy from a FLOATING major (chart.js@4) while
        this one is pinned to 4.4.1 -- two versions of the same library on one admin,
        one of which could change under us without a deploy. One pinned load, both
        pages, and the theme right behind it. */
  %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
  <script src="/assets/js/chart-theme.js?v=p21"></script>
  <% } %>
  <%- typeof scripts !== 'undefined' ? scripts : '' %>
<script>
/* P0-3 global search. scriptSrcAttr is 'none' in the CSP, so every handler is bound
   with addEventListener and every result is built with textContent -- never innerHTML
   with a customer's name in it. */
(function () {
  var box   = document.getElementById('bmSearch');
  var input = document.getElementById('bmSearchInput');
  var panel = document.getElementById('bmSearchResults');
  if (!box || !input || !panel) return;

  var items = [];
  var active = -1;
  var timer = null;
  var seq = 0;

  function close() {
    panel.hidden = true;
    panel.textContent = '';
    input.setAttribute('aria-expanded', 'false');
    items = [];
    active = -1;
  }

  function msg(text) {
    panel.textContent = '';
    var d = document.createElement('div');
    d.className = 'bm-search-msg';
    d.textContent = text;
    panel.appendChild(d);
    panel.hidden = false;
    input.setAttribute('aria-expanded', 'true');
    items = [];
    active = -1;
  }

  function mark(i) {
    for (var k = 0; k < items.length; k++) items[k].classList.remove('is-active');
    active = i;
    if (i >= 0 && items[i]) {
      items[i].classList.add('is-active');
      items[i].scrollIntoView({ block: 'nearest' });
    }
  }

  function render(results, q) {
    if (!results.length) { msg('Nothing matches \u201c' + q + '\u201d'); return; }
    panel.textContent = '';
    items = [];
    results.forEach(function (r) {
      var a = document.createElement('a');
      a.className = 'bm-hit';
      a.href = r.url;
      a.setAttribute('role', 'option');

      var top = document.createElement('div');
      top.className = 'bm-hit-top';
      var t = document.createElement('span');
      t.className = 'bm-hit-title';
      t.textContent = r.title;
      var k = document.createElement('span');
      k.className = 'bm-hit-kind';
      k.textContent = r.kind;
      top.appendChild(t);
      top.appendChild(k);

      var sub = document.createElement('div');
      sub.className = 'bm-hit-sub';
      sub.textContent = r.subtitle || '';

      a.appendChild(top);
      a.appendChild(sub);
      panel.appendChild(a);
      items.push(a);
    });
    panel.hidden = false;
    input.setAttribute('aria-expanded', 'true');
    mark(0);
  }

  function run() {
    var q = input.value.trim();
    if (q.length < 2) { close(); return; }
    var mine = ++seq;
    fetch('/admin/search.json?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : { results: [] }; })
      .then(function (d) {
        /* An earlier keystroke's response must never overwrite a later one's. */
        if (mine !== seq) return;
        render(d.results || [], q);
      })
      .catch(function () { if (mine === seq) msg('Search is not responding.'); });
  }

  input.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(run, 140);
  });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { close(); input.blur(); return; }
    if (!items.length) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); mark((active + 1) % items.length); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); mark((active - 1 + items.length) % items.length); }
    else if (e.key === 'Enter') {
      if (active >= 0 && items[active]) { e.preventDefault(); window.location = items[active].href; }
    }
  });

  input.addEventListener('focus', function () { if (input.value.trim().length >= 2) run(); });

  document.addEventListener('click', function (e) { if (!box.contains(e.target)) close(); });

  /* "/" focuses search, the way it does everywhere else -- but never while the
     operator is typing into something. */
  document.addEventListener('keydown', function (e) {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    var t = e.target;
    var tag = t && t.tagName ? t.tagName.toUpperCase() : '';
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (t && t.isContentEditable)) return;
    e.preventDefault();
    input.focus();
    input.select();
  });
})();
</script>
<script>
  var sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
  if (sidebarToggleBtn) {
    sidebarToggleBtn.addEventListener('click', function() {
      document.getElementById('sidebar').classList.toggle('open');
    });
  }
  // Global confirm-delete handler. Always cancels the native submit, asks in our own
  // dialog, and resubmits only on a yes -- a <dialog> cannot block a synchronous event
  // the way window.confirm could, so the flow has to be async.
  document.addEventListener("submit", function(e) {
    var form = e.target;
    if (!form.classList || !form.classList.contains("confirm-delete")) return;
    if (form.dataset.bmConfirmed === "1") { delete form.dataset.bmConfirmed; return; }
    e.preventDefault();
    var msg = form.dataset.confirm || "Are you sure?";
    bmConfirm({ message: msg, confirmLabel: "Delete", danger: true }).then(function (ok) {
      if (!ok) return;
      form.dataset.bmConfirmed = "1";
      if (typeof form.requestSubmit === "function") form.requestSubmit();
      else form.submit();
    });
  });
  // Global clickable rows handler - any table row with data-row-href becomes clickable
  document.addEventListener("click", function(e) {
    // Skip if clicking on interactive elements
    if (e.target.closest("a") || e.target.closest("button") || e.target.closest("input") || e.target.closest("form") || e.target.closest("select") || e.target.closest("textarea")) return;
    var row = e.target.closest("[data-row-href]");
    if (row) window.location.href = row.dataset.rowHref;
    // Also support data-booking-href for backwards compatibility
    var bookingRow = e.target.closest("[data-booking-href]");
    if (bookingRow) window.location.href = bookingRow.dataset.bookingHref;
  });
</script>
<dialog id="bmDialog" class="bm-dialog" aria-labelledby="bmDialogTitle">
  <form method="dialog" id="bmDialogForm">
    <div class="bm-dialog-body">
      <h2 class="bm-dialog-title" id="bmDialogTitle"></h2>
      <p class="bm-dialog-msg" id="bmDialogMsg"></p>
      <input type="text" id="bmDialogInput" hidden>
    </div>
    <div class="bm-dialog-foot">
      <button type="button" class="btn btn-sm btn-bm-outline" id="bmDialogCancel">Cancel</button>
      <button type="submit" class="btn btn-sm btn-bm" id="bmDialogOk">OK</button>
    </div>
  </form>
</dialog>
<script>
/* window.confirm / prompt / alert, replaced.
   The native ones are unstyleable, truncated on phones, prefixed with
   "bouncemanrentals.com says", and they freeze the entire page while open -- including
   any request already in flight. Both of these resolve a promise instead. */
(function () {
  var dlg = document.getElementById("bmDialog");
  var form = document.getElementById("bmDialogForm");
  var titleEl = document.getElementById("bmDialogTitle");
  var msgEl = document.getElementById("bmDialogMsg");
  var input = document.getElementById("bmDialogInput");
  var okBtn = document.getElementById("bmDialogOk");
  var cancelBtn = document.getElementById("bmDialogCancel");
  var settle = null;

  function finish(value) {
    var fn = settle; settle = null;
    if (dlg.open) dlg.close();
    if (fn) fn(value);
  }

  function open(opts) {
    opts = opts || {};
    /* textContent, never innerHTML: these messages carry customer names and
       addresses. */
    titleEl.textContent = opts.title || "";
    titleEl.hidden = !opts.title;
    msgEl.textContent = opts.message || "";
    okBtn.textContent = opts.confirmLabel || "OK";
    cancelBtn.textContent = opts.cancelLabel || "Cancel";
    okBtn.className = "btn btn-sm " + (opts.danger ? "btn-outline-danger" : "btn-bm");

    if (opts.withInput) {
      input.hidden = false;
      input.value = opts.value || "";
      input.placeholder = opts.placeholder || "";
      input.type = opts.inputType || "text";
    } else {
      input.hidden = true;
      input.value = "";
    }

    if (typeof dlg.showModal === "function") dlg.showModal();
    else dlg.setAttribute("open", "");          /* ancient browser: still usable */
    setTimeout(function () { (opts.withInput ? input : okBtn).focus(); }, 0);
  }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    finish(input.hidden ? true : input.value);
  });
  cancelBtn.addEventListener("click", function () { finish(input.hidden ? false : null); });
  /* Escape and the backdrop both mean no. */
  dlg.addEventListener("cancel", function (e) { e.preventDefault(); finish(input.hidden ? false : null); });
  dlg.addEventListener("click", function (e) { if (e.target === dlg) finish(input.hidden ? false : null); });

  window.bmConfirm = function (opts) {
    return new Promise(function (resolve) {
      if (settle) { resolve(false); return; }   /* never stack dialogs */
      settle = resolve;
      open(Object.assign({}, opts, { withInput: false }));
    });
  };

  /* Click-to-call, which existed three times over -- inbox.ejs, call-detail.ejs and
     bookings/detail.ejs each had their own copy of this, and each copy carried its own
     prompt() and alert(). One implementation, used by all three.

     The cell number is remembered in localStorage, so after the first call the dialog
     opens pre-filled and it is one keystroke. */
  var BM_PHONE_KEY = 'bm_my_phone';
  window.bmCall = function (customerPhone, btn, restoreHtml) {
    if (!customerPhone) { showToast('No number on this record to call.', 'warning'); return; }
    var remembered = '';
    try { remembered = localStorage.getItem(BM_PHONE_KEY) || ''; } catch (e) { remembered = ''; }
    return bmPrompt({
      title: 'Call this number',
      message: 'We ring your phone first, then connect them.',
      value: remembered, placeholder: '(580) 555-0123', inputType: 'tel',
      confirmLabel: 'Call'
    }).then(function (mine) {
      if (!mine) return;
      try { localStorage.setItem(BM_PHONE_KEY, mine); } catch (e) { /* private window */ }
      var original = restoreHtml || (btn ? btn.innerHTML : '');
      if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Calling...'; }
      function reset() { if (btn) { btn.disabled = false; btn.innerHTML = original; } }
      return fetch('/api/call/dial', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to: customerPhone, your_phone: mine })
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (d && d.success) {
          showToast('Ringing your phone now.', 'success');
          if (btn) { btn.innerHTML = '<i class="fas fa-check me-1"></i>Ringing'; setTimeout(reset, 5000); }
        } else {
          showToast('Could not place the call: ' + ((d && d.error) || 'unknown error'), 'error');
          reset();
        }
      }).catch(function () {
        showToast('Could not reach the calling service.', 'error');
        reset();
      });
    });
  };

  window.bmPrompt = function (opts) {
    return new Promise(function (resolve) {
      if (settle) { resolve(null); return; }
      settle = resolve;
      open(Object.assign({}, opts, { withInput: true }));
    });
  };
})();
</script>
<div id="toast-container"></div>
<script>
function showToast(message, type) {
  type = type || "error";
  var icons = { error: "fa-exclamation-circle", warning: "fa-exclamation-triangle", success: "fa-check-circle", info: "fa-info-circle" };
  var container = document.getElementById("toast-container");
  var toast = document.createElement("div");
  var known = { error: 1, warning: 1, success: 1, info: 1 };
  toast.className = "bm-toast is-" + (known[type] ? type : "error");
  var icon = document.createElement("i");
  icon.className = "bm-toast-icon fas " + (icons[type] || icons.error);
  var body = document.createElement("div");
  body.className = "bm-toast-body";
  // textContent, not innerHTML -- toast messages carry customer names and addresses.
  body.textContent = message;
  var closeBtn = document.createElement("span");
  closeBtn.className = "toast-close";
  closeBtn.textContent = "\u00d7";
  closeBtn.addEventListener("click", function() { toast.remove(); });
  toast.appendChild(icon);
  toast.appendChild(body);
  toast.appendChild(closeBtn);
  container.appendChild(toast);
  setTimeout(function() { toast.style.opacity = "0"; toast.style.transition = "opacity 0.3s"; setTimeout(function() { toast.remove(); }, 300); }, 6000);
}
</script>
</body>
</html>
