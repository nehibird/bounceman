<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <% if (typeof page !== 'undefined' && page === 'calendar') { %>
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
  <% } %>
  <link href="/assets/css/admin.css?v=p27c" rel="stylesheet">
<script>
  /* Inline and synchronous, before the first paint. A stored choice applied from a
     deferred script would show the light page first and then repaint dark, which is
     worse than not offering the choice. Wrapped because localStorage throws in a
     private window rather than returning null. */
  (function () {
    try {
      var t = localStorage.getItem('bm_theme');
      if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
    } catch (e) { /* no stored preference available; the OS setting still applies */ }
  })();
</script>
<style>
  /* P0-3 global search. Tokens only -- literal colours live in admin.css (D0). */
  .bm-search { position: relative; width: 340px; max-width: 42vw; }
  .bm-search-icon { position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
    color: var(--bm-n-400); font-size: 13px; pointer-events: none; }
  .bm-search input { width: 100%; padding: 7px 34px 7px 32px; font-size: 14px;
    border: 1px solid var(--bm-n-200); border-radius: var(--bm-radius-pill);
    background: var(--bm-n-25); color: var(--bm-n-900); outline: none; }
  .bm-search input:focus { background: var(--bm-n-0); border-color: var(--bm-accent);
    box-shadow: 0 0 0 3px var(--bm-accent-tint); }
  .bm-search input::-webkit-search-cancel-button { display: none; }
  .bm-search-kbd { position: absolute; right: 9px; top: 50%; transform: translateY(-50%);
    font-size: 11px; font-weight: 700; color: var(--bm-n-600); background: var(--bm-n-100);
    border-radius: var(--bm-radius-sm); padding: 1px 6px; pointer-events: none; }
  .bm-search input:focus ~ .bm-search-kbd { display: none; }
  .bm-search-panel { position: absolute; top: calc(100% + 6px); left: 0; right: 0;
    background: var(--bm-n-0); border: 1px solid var(--bm-n-100);
    border-radius: var(--bm-radius-md); box-shadow: var(--bm-shadow-3);
    max-height: 70vh; overflow: auto; z-index: 1080; padding: 4px; }
  .bm-hit { display: block; padding: 7px 10px; border-radius: var(--bm-radius-sm);
    text-decoration: none; color: var(--bm-n-900); }
  .bm-hit:hover, .bm-hit.is-active { background: var(--bm-accent-tint); }
  .bm-hit-top { display: flex; align-items: center; gap: 8px; }
  .bm-hit-title { font-weight: 700; font-size: 14px; }
  .bm-hit-kind { font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: var(--bm-n-500); background: var(--bm-n-50);
    border-radius: var(--bm-radius-pill); padding: 1px 7px; }
  .bm-hit-sub { font-size: 12px; color: var(--bm-n-500); margin-top: 1px; }
  .bm-search-msg { padding: 14px 12px; font-size: 13px; color: var(--bm-n-500);
    text-align: center; }
  @media (max-width: 767px) { .bm-search { width: 190px; } .bm-search-kbd { display: none; } }
</style>
  <%
     /* Brand colours come from the settings table — the same two values the
        customer site reads. admin.css consumes these with the live values as
        fallbacks, so a colour change in Admin -> Settings moves both sites. */
     var _s = (typeof settings !== 'undefined' && settings) ? settings : {};
  %>
  <style>
    :root {
      --bm-brand-primary: <%= _s.primary_color || '#d77c42' %>;
      --bm-brand-secondary: <%= _s.secondary_color || '#1a212d' %>;
    }
  </style>
</head>
<body>
  <aside class="admin-sidebar" id="sidebar">
    <div class="logo">
      <img src="/assets/images/logo-full.png" alt="Bounce Man" style="height:56px;">
      <small>Admin Dashboard</small>
    </div>
    <%
       /* On Saturdays GET /admin redirects to the Today screen (P0-2). Without
          ?home=1 this link would bounce straight back there and the dashboard would
          be unreachable on the one day of the week that matters most. */
       var _satHome = (new Date()).getDay() === 6 ? '/admin?home=1' : '/admin';

       /* P2-3. Was 18 links under four headings named after nouns -- Management,
          Operations, Advertising, Insights -- which put Expenses, Recurring Costs and
          Connected Banks (money) in the same bucket as Reviews (reputation) and Reports
          (both). Grouped by WHEN instead: what he opens most days stays at the top
          level; the rest collapses behind three groups. Ten items at rest.

          <details> rather than a hand-rolled accordion: it expands on click and on
          Enter, it is announced correctly, and it works with JavaScript off. A group
          containing the current page is open on arrival. */
       var _nav = {
         daily: [
           { href: _satHome,          key: 'dashboard',  icon: 'fa-gauge-high',      label: 'Dashboard' },
           { href: '/admin/delivery', key: 'delivery',   icon: 'fa-truck',           label: 'Today' },
           { href: '/admin/inbox',    key: 'inbox',      icon: 'fa-inbox',           label: 'Inbox' },
           { href: '/admin/bookings', key: 'bookings',   icon: 'fa-calendar-check',  label: 'Bookings' },
           { href: '/admin/calendar', key: 'calendar',   icon: 'fa-calendar-alt',    label: 'Calendar' },
           { href: '/admin/customers',key: 'customers',  icon: 'fa-users',           label: 'Customers' },
           { href: '/admin/equipment',key: 'equipment',  icon: 'fa-chess-rook',      label: 'Equipment' }
         ],
         groups: [
           { id: 'money', icon: 'fa-sack-dollar', label: 'Money', items: [
             { href: '/admin/reports',     key: 'reports',     icon: 'fa-chart-bar', label: 'Reports' },
             { href: '/admin/expenses',    key: 'expenses',    icon: 'fa-receipt',   label: 'Expenses' },
             { href: '/admin/obligations', key: 'obligations', icon: 'fa-rotate',    label: 'Recurring costs' },
             { href: '/admin/banks',       key: 'banks',       icon: 'fa-university',label: 'Connected banks' }
           ]},
           { id: 'growth', icon: 'fa-bullhorn', label: 'Marketing', items: [
             { href: '/admin/ads',     key: 'ads',     icon: 'fa-ad',   label: 'Ad dashboard' },
             { href: '/admin/reviews', key: 'reviews', icon: 'fa-star', label: 'Reviews' }
           ]},
           { id: 'yard', icon: 'fa-screwdriver-wrench', label: 'Yard & events', items: [
             { href: '/admin/events',      key: 'events',      icon: 'fa-ticket-alt', label: 'Walk-up events' },
             { href: '/admin/maintenance', key: 'maintenance', icon: 'fa-wrench',     label: 'Maintenance' }
           ]}
         ]
       };
       function _isOn(k) { return typeof page !== 'undefined' && page === k; }
    %>
    <nav>
      <% _nav.daily.forEach(function (it) { %>
      <a href="<%= it.href %>" class="<%= _isOn(it.key) ? 'active' : '' %>">
        <i class="fas <%= it.icon %>"></i> <%= it.label %>
      </a>
      <% }); %>

      <% _nav.groups.forEach(function (g) {
           var openHere = g.items.some(function (it) { return _isOn(it.key); }); %>
      <details class="nav-group" data-nav-group="<%= g.id %>" <%= openHere ? 'open' : '' %>>
        <summary>
          <i class="fas <%= g.icon %>"></i> <%= g.label %>
          <i class="fas fa-chevron-down nav-caret"></i>
        </summary>
        <% g.items.forEach(function (it) { %>
        <a href="<%= it.href %>" class="<%= _isOn(it.key) ? 'active' : '' %>">
          <i class="fas <%= it.icon %>"></i> <%= it.label %>
        </a>
        <% }); %>
      </details>
      <% }); %>
    </nav>
  </aside>
  <div class="admin-backdrop" id="sidebarBackdrop" hidden></div>

  <main class="admin-main">
    <header class="admin-header">
      <div>
        <button class="btn btn-sm btn-outline-secondary d-md-none" id="sidebarToggleBtn"
                aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">
          <i class="fas fa-bars"></i>
        </button>
        <%
           /* The header used to read the page's name by cutting suffixes off the
              browser title: title.replace(' - Bounce Man Admin','').replace(' - Admin','').
              That is a guess about a string written for a different purpose, and on a
              nested page it said only where you ARE, never how you got there.

              Routes now pass `crumbs` -- [{label, href}, ...], last entry current. The
              munge survives ONLY as the fallback for pages that pass none, so nothing
              had to be migrated in one go. */
           var _crumbs = (typeof crumbs !== 'undefined' && crumbs && crumbs.length)
             ? crumbs
             : [{ label: title.replace(' - Bounce Man Admin', '').replace(' - Admin', '') }];
        %>
        <nav class="bm-crumbs" aria-label="Breadcrumb">
          <% _crumbs.forEach(function (c, i) {
               var last = i === _crumbs.length - 1; %>
            <% if (!last && c.href) { %>
              <a href="<%= c.href %>"><%= c.label %></a>
              <i class="fas fa-chevron-right bm-crumb-sep" aria-hidden="true"></i>
            <% } else if (!last) { %>
              <span><%= c.label %></span>
              <i class="fas fa-chevron-right bm-crumb-sep" aria-hidden="true"></i>
            <% } else { %>
              <strong aria-current="page"><%= c.label %></strong>
            <% } %>
          <% }); %>
        </nav>
      </div>
      <div class="d-flex align-items-center gap-3">
        <div class="bm-search" id="bmSearch">
          <i class="fas fa-magnifying-glass bm-search-icon"></i>
          <input type="search" id="bmSearchInput" autocomplete="off" spellcheck="false"
                 placeholder="Search bookings, customers, phone numbers"
                 aria-label="Search" aria-autocomplete="list" aria-expanded="false"
                 aria-controls="bmSearchResults" role="combobox">
          <kbd class="bm-search-kbd">/</kbd>
          <div class="bm-search-panel" id="bmSearchResults" role="listbox" hidden></div>
        </div>
        <%
           /* Settings, View Website and Logout were sidebar links. None of them is
              navigation around the business -- they are things you do to the account,
              a handful of times a year. The header already showed a name and did
              nothing; now it is the menu that holds them. */
        %>
        <div class="bm-usermenu" id="bmUserMenu">
          <button type="button" class="bm-usermenu-btn" id="bmUserBtn"
                  aria-haspopup="true" aria-expanded="false">
            <i class="fas fa-user"></i> <%= user.name %>
            <i class="fas fa-chevron-down"></i>
          </button>
          <div class="bm-usermenu-panel" id="bmUserPanel" role="menu" hidden>
            <button type="button" class="bm-theme-btn" id="bmThemeBtn" role="menuitem">
              <i class="fas fa-circle-half-stroke"></i> <span id="bmThemeLabel">Theme: system</span>
            </button>
            <a href="/admin/settings" role="menuitem"><i class="fas fa-cog"></i> Settings</a>
            <a href="/" target="_blank" rel="noopener" role="menuitem"><i class="fas fa-external-link-alt"></i> View website</a>
            <a href="/auth/logout" role="menuitem" class="is-leave"><i class="fas fa-sign-out-alt"></i> Log out</a>
          </div>
        </div>
      </div>
    </header>
    <div class="admin-content">
      <%- body %>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <% if (typeof page !== 'undefined' && page === 'calendar') { %>
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
  <% } %>
  <% if (typeof page !== 'undefined' && (page === 'reports' || page === 'dashboard')) { %>
  <%
     /* The dashboard used to pull its own copy from a FLOATING major (chart.js@4) while
        this one is pinned to 4.4.1 -- two versions of the same library on one admin,
        one of which could change under us without a deploy. One pinned load, both
        pages, and the theme right behind it. */
  %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
  <script src="/assets/js/chart-theme.js?v=p21"></script>
  <% } %>
  <%- typeof scripts !== 'undefined' ? scripts : '' %>
<script>
/* P0-3 global search. scriptSrcAttr is 'none' in the CSP, so every handler is bound
   with addEventListener and every result is built with textContent -- never innerHTML
   with a customer's name in it. */
(function () {
  var box   = document.getElementById('bmSearch');
  var input = document.getElementById('bmSearchInput');
  var panel = document.getElementById('bmSearchResults');
  if (!box || !input || !panel) return;

  var items = [];
  var active = -1;
  var timer = null;
  var seq = 0;

  function close() {
    panel.hidden = true;
    panel.textContent = '';
    input.setAttribute('aria-expanded', 'false');
    items = [];
    active = -1;
  }

  function msg(text) {
    panel.textContent = '';
    var d = document.createElement('div');
    d.className = 'bm-search-msg';
    d.textContent = text;
    panel.appendChild(d);
    panel.hidden = false;
    input.setAttribute('aria-expanded', 'true');
    items = [];
    active = -1;
  }

  function mark(i) {
    for (var k = 0; k < items.length; k++) items[k].classList.remove('is-active');
    active = i;
    if (i >= 0 && items[i]) {
      items[i].classList.add('is-active');
      items[i].scrollIntoView({ block: 'nearest' });
    }
  }

  function render(results, q) {
    if (!results.length) { msg('Nothing matches \u201c' + q + '\u201d'); return; }
    panel.textContent = '';
    items = [];
    results.forEach(function (r) {
      var a = document.createElement('a');
      a.className = 'bm-hit';
      a.href = r.url;
      a.setAttribute('role', 'option');

      var top = document.createElement('div');
      top.className = 'bm-hit-top';
      var t = document.createElement('span');
      t.className = 'bm-hit-title';
      t.textContent = r.title;
      var k = document.createElement('span');
      k.className = 'bm-hit-kind';
      k.textContent = r.kind;
      top.appendChild(t);
      top.appendChild(k);

      var sub = document.createElement('div');
      sub.className = 'bm-hit-sub';
      sub.textContent = r.subtitle || '';

      a.appendChild(top);
      a.appendChild(sub);
      panel.appendChild(a);
      items.push(a);
    });
    panel.hidden = false;
    input.setAttribute('aria-expanded', 'true');
    mark(0);
  }

  function run() {
    var q = input.value.trim();
    if (q.length < 2) { close(); return; }
    var mine = ++seq;
    fetch('/admin/search.json?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : { results: [] }; })
      .then(function (d) {
        /* An earlier keystroke's response must never overwrite a later one's. */
        if (mine !== seq) return;
        render(d.results || [], q);
      })
      .catch(function () { if (mine === seq) msg('Search is not responding.'); });
  }

  input.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(run, 140);
  });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { close(); input.blur(); return; }
    if (!items.length) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); mark((active + 1) % items.length); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); mark((active - 1 + items.length) % items.length); }
    else if (e.key === 'Enter') {
      if (active >= 0 && items[active]) { e.preventDefault(); window.location = items[active].href; }
    }
  });

  input.addEventListener('focus', function () { if (input.value.trim().length >= 2) run(); });

  document.addEventListener('click', function (e) { if (!box.contains(e.target)) close(); });

  /* "/" focuses search, the way it does everywhere else -- but never while the
     operator is typing into something. */
  document.addEventListener('keydown', function (e) {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    var t = e.target;
    var tag = t && t.tagName ? t.tagName.toUpperCase() : '';
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (t && t.isContentEditable)) return;
    e.preventDefault();
    input.focus();
    input.select();
  });
})();
</script>
<script>
  // The mobile sidebar. It used to toggle a class and nothing else: no backdrop, no
  // way to dismiss it except finding the same small button again, the page scrolling
  // underneath it, and -- because nothing closed it on navigation -- it stayed open
  // over the page you had just asked for.
  (function () {
    var btn = document.getElementById('sidebarToggleBtn');
    var sidebar = document.getElementById('sidebar');
    var backdrop = document.getElementById('sidebarBackdrop');
    if (!btn || !sidebar || !backdrop) return;

    function isOpen() { return sidebar.classList.contains('open'); }

    function open() {
      sidebar.classList.add('open');
      backdrop.hidden = false;
      /* A frame between unhide and the class, or the opacity transition never runs. */
      requestAnimationFrame(function () { backdrop.classList.add('is-on'); });
      document.body.classList.add('bm-nav-open');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Close navigation');
    }

    function close() {
      if (!isOpen()) return;
      sidebar.classList.remove('open');
      backdrop.classList.remove('is-on');
      document.body.classList.remove('bm-nav-open');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Open navigation');
      /* Hide only once it has faded, or it vanishes instantly. */
      setTimeout(function () { if (!isOpen()) backdrop.hidden = true; }, 300);
    }

    btn.addEventListener('click', function () { isOpen() ? close() : open(); });
    backdrop.addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

    /* Tapping a destination should take you there AND put the panel away. Without
       this it stays open on top of the page it just loaded. A group header is not a
       destination, so it must not close anything. */
    sidebar.addEventListener('click', function (e) {
      if (e.target.closest('summary')) return;
      if (e.target.closest('a')) close();
    });

    /* Rotating to landscape can cross the breakpoint while it is open, which would
       leave the body locked and a backdrop over a permanent sidebar. */
    window.addEventListener('resize', function () {
      if (window.innerWidth >= 768) close();
    });
  })();
  // Remember which sidebar groups are open. A group holding the current page is
  // rendered open server-side, so this only has to carry deliberate choices.
  (function () {
    var KEY = 'bm_nav_open';
    var saved = {};
    try { saved = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { saved = {}; }
    document.querySelectorAll('[data-nav-group]').forEach(function (d) {
      var id = d.getAttribute('data-nav-group');
      if (!d.open && saved[id]) d.open = true;
      d.addEventListener('toggle', function () {
        saved[id] = d.open;
        try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) { /* private window */ }
      });
    });
  })();

  // Theme: system -> light -> dark -> system. Three states, because "follow the
  // operating system" is a real answer and not having it means a person who changes
  // their desktop at sunset has to change this too.
  (function () {
    var btn = document.getElementById('bmThemeBtn');
    var label = document.getElementById('bmThemeLabel');
    if (!btn || !label) return;
    var ORDER = ['system', 'light', 'dark'];

    function current() {
      var t = document.documentElement.getAttribute('data-theme');
      return (t === 'light' || t === 'dark') ? t : 'system';
    }
    function paint() { label.textContent = 'Theme: ' + current(); }

    function apply(next) {
      if (next === 'system') {
        document.documentElement.removeAttribute('data-theme');
        try { localStorage.removeItem('bm_theme'); } catch (e) { /* private window */ }
      } else {
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('bm_theme', next); } catch (e) { /* private window */ }
      }
      paint();
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();   /* choosing a theme should not close the menu */
      apply(ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length]);
    });
    paint();
  })();

  // The account menu in the header.
  (function () {
    var wrap = document.getElementById('bmUserMenu');
    var btn = document.getElementById('bmUserBtn');
    var panel = document.getElementById('bmUserPanel');
    if (!wrap || !btn || !panel) return;
    function close() { panel.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var opening = panel.hidden;
      panel.hidden = !opening;
      btn.setAttribute('aria-expanded', opening ? 'true' : 'false');
    });
    document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();

  // Global confirm-delete handler. Always cancels the native submit, asks in our own
  // dialog, and resubmits only on a yes -- a <dialog> cannot block a synchronous event
  // the way window.confirm could, so the flow has to be async.
  document.addEventListener("submit", function(e) {
    var form = e.target;
    if (!form.classList || !form.classList.contains("confirm-delete")) return;
    if (form.dataset.bmConfirmed === "1") { delete form.dataset.bmConfirmed; return; }
    e.preventDefault();
    var msg = form.dataset.confirm || "Are you sure?";
    bmConfirm({ message: msg, confirmLabel: "Delete", danger: true }).then(function (ok) {
      if (!ok) return;
      form.dataset.bmConfirmed = "1";
      if (typeof form.requestSubmit === "function") form.requestSubmit();
      else form.submit();
    });
  });
  // Global clickable rows handler - any table row with data-row-href becomes clickable
  document.addEventListener("click", function(e) {
    // Skip if clicking on interactive elements
    if (e.target.closest("a") || e.target.closest("button") || e.target.closest("input") || e.target.closest("form") || e.target.closest("select") || e.target.closest("textarea")) return;
    var row = e.target.closest("[data-row-href]");
    if (row) window.location.href = row.dataset.rowHref;
    // Also support data-booking-href for backwards compatibility
    var bookingRow = e.target.closest("[data-booking-href]");
    if (bookingRow) window.location.href = bookingRow.dataset.bookingHref;
  });
</script>
<dialog id="bmDialog" class="bm-dialog" aria-labelledby="bmDialogTitle">
  <form method="dialog" id="bmDialogForm">
    <div class="bm-dialog-body">
      <h2 class="bm-dialog-title" id="bmDialogTitle"></h2>
      <p class="bm-dialog-msg" id="bmDialogMsg"></p>
      <input type="text" id="bmDialogInput" hidden>
    </div>
    <div class="bm-dialog-foot">
      <button type="button" class="btn btn-sm btn-bm-outline" id="bmDialogCancel">Cancel</button>
      <button type="submit" class="btn btn-sm btn-bm" id="bmDialogOk">OK</button>
    </div>
  </form>
</dialog>
<script>
/* window.confirm / prompt / alert, replaced.
   The native ones are unstyleable, truncated on phones, prefixed with
   "bouncemanrentals.com says", and they freeze the entire page while open -- including
   any request already in flight. Both of these resolve a promise instead. */
(function () {
  var dlg = document.getElementById("bmDialog");
  var form = document.getElementById("bmDialogForm");
  var titleEl = document.getElementById("bmDialogTitle");
  var msgEl = document.getElementById("bmDialogMsg");
  var input = document.getElementById("bmDialogInput");
  var okBtn = document.getElementById("bmDialogOk");
  var cancelBtn = document.getElementById("bmDialogCancel");
  var settle = null;

  function finish(value) {
    var fn = settle; settle = null;
    if (dlg.open) dlg.close();
    if (fn) fn(value);
  }

  function open(opts) {
    opts = opts || {};
    /* textContent, never innerHTML: these messages carry customer names and
       addresses. */
    titleEl.textContent = opts.title || "";
    titleEl.hidden = !opts.title;
    msgEl.textContent = opts.message || "";
    okBtn.textContent = opts.confirmLabel || "OK";
    cancelBtn.textContent = opts.cancelLabel || "Cancel";
    okBtn.className = "btn btn-sm " + (opts.danger ? "btn-outline-danger" : "btn-bm");

    if (opts.withInput) {
      input.hidden = false;
      input.value = opts.value || "";
      input.placeholder = opts.placeholder || "";
      input.type = opts.inputType || "text";
    } else {
      input.hidden = true;
      input.value = "";
    }

    if (typeof dlg.showModal === "function") dlg.showModal();
    else dlg.setAttribute("open", "");          /* ancient browser: still usable */
    setTimeout(function () { (opts.withInput ? input : okBtn).focus(); }, 0);
  }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    finish(input.hidden ? true : input.value);
  });
  cancelBtn.addEventListener("click", function () { finish(input.hidden ? false : null); });
  /* Escape and the backdrop both mean no. */
  dlg.addEventListener("cancel", function (e) { e.preventDefault(); finish(input.hidden ? false : null); });
  dlg.addEventListener("click", function (e) { if (e.target === dlg) finish(input.hidden ? false : null); });

  window.bmConfirm = function (opts) {
    return new Promise(function (resolve) {
      if (settle) { resolve(false); return; }   /* never stack dialogs */
      settle = resolve;
      open(Object.assign({}, opts, { withInput: false }));
    });
  };

  /* Click-to-call, which existed three times over -- inbox.ejs, call-detail.ejs and
     bookings/detail.ejs each had their own copy of this, and each copy carried its own
     prompt() and alert(). One implementation, used by all three.

     The cell number is remembered in localStorage, so after the first call the dialog
     opens pre-filled and it is one keystroke. */
  var BM_PHONE_KEY = 'bm_my_phone';
  window.bmCall = function (customerPhone, btn, restoreHtml) {
    if (!customerPhone) { showToast('No number on this record to call.', 'warning'); return; }
    var remembered = '';
    try { remembered = localStorage.getItem(BM_PHONE_KEY) || ''; } catch (e) { remembered = ''; }
    return bmPrompt({
      title: 'Call this number',
      message: 'We ring your phone first, then connect them.',
      value: remembered, placeholder: '(580) 555-0123', inputType: 'tel',
      confirmLabel: 'Call'
    }).then(function (mine) {
      if (!mine) return;
      try { localStorage.setItem(BM_PHONE_KEY, mine); } catch (e) { /* private window */ }
      var original = restoreHtml || (btn ? btn.innerHTML : '');
      if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Calling...'; }
      function reset() { if (btn) { btn.disabled = false; btn.innerHTML = original; } }
      return fetch('/api/call/dial', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to: customerPhone, your_phone: mine })
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (d && d.success) {
          showToast('Ringing your phone now.', 'success');
          if (btn) { btn.innerHTML = '<i class="fas fa-check me-1"></i>Ringing'; setTimeout(reset, 5000); }
        } else {
          showToast('Could not place the call: ' + ((d && d.error) || 'unknown error'), 'error');
          reset();
        }
      }).catch(function () {
        showToast('Could not reach the calling service.', 'error');
        reset();
      });
    });
  };

  window.bmPrompt = function (opts) {
    return new Promise(function (resolve) {
      if (settle) { resolve(null); return; }
      settle = resolve;
      open(Object.assign({}, opts, { withInput: true }));
    });
  };
})();
</script>
<div id="toast-container"></div>
<script>
function showToast(message, type) {
  type = type || "error";
  var icons = { error: "fa-exclamation-circle", warning: "fa-exclamation-triangle", success: "fa-check-circle", info: "fa-info-circle" };
  var container = document.getElementById("toast-container");
  var toast = document.createElement("div");
  var known = { error: 1, warning: 1, success: 1, info: 1 };
  toast.className = "bm-toast is-" + (known[type] ? type : "error");
  var icon = document.createElement("i");
  icon.className = "bm-toast-icon fas " + (icons[type] || icons.error);
  var body = document.createElement("div");
  body.className = "bm-toast-body";
  // textContent, not innerHTML -- toast messages carry customer names and addresses.
  body.textContent = message;
  var closeBtn = document.createElement("span");
  closeBtn.className = "toast-close";
  closeBtn.textContent = "\u00d7";
  closeBtn.addEventListener("click", function() { toast.remove(); });
  toast.appendChild(icon);
  toast.appendChild(body);
  toast.appendChild(closeBtn);
  container.appendChild(toast);
  setTimeout(function() { toast.style.opacity = "0"; toast.style.transition = "opacity 0.3s"; setTimeout(function() { toast.remove(); }, 300); }, 6000);
}
</script>
</body>
</html>
