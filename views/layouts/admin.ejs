  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <% if (typeof page !== 'undefined' && page === 'calendar') { %>
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
  <% } %>
  <link href="/assets/css/admin.css?v=p22" rel="stylesheet">
<style>
  /* P0-3 global search. Tokens only -- literal colours live in admin.css (D0). */
  .bm-search { position: relative; width: 340px; max-width: 42vw; }
  .bm-search-icon { position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
    color: var(--bm-n-400); font-size: 13px; pointer-events: none; }
  .bm-search input { width: 100%; padding: 7px 34px 7px 32px; font-size: 14px;
    border: 1px solid var(--bm-n-200); border-radius: var(--bm-radius-pill);
    background: var(--bm-n-25); color: var(--bm-n-900); outline: none; }
  .bm-search input:focus { background: var(--bm-n-0); border-color: var(--bm-accent);
    box-shadow: 0 0 0 3px var(--bm-accent-tint); }
  .bm-search input::-webkit-search-cancel-button { display: none; }
  .bm-search-kbd { position: absolute; right: 9px; top: 50%; transform: translateY(-50%);
    font-size: 11px; font-weight: 700; color: var(--bm-n-400); background: var(--bm-n-100);
    border-radius: var(--bm-radius-sm); padding: 1px 6px; pointer-events: none; }
  .bm-search input:focus ~ .bm-search-kbd { display: none; }
  .bm-search-panel { position: absolute; top: calc(100% + 6px); left: 0; right: 0;
    background: var(--bm-n-0); border: 1px solid var(--bm-n-100);
    border-radius: var(--bm-radius-md); box-shadow: var(--bm-shadow-3);
    max-height: 70vh; overflow: auto; z-index: 1080; padding: 4px; }
  .bm-hit { display: block; padding: 7px 10px; border-radius: var(--bm-radius-sm);
    text-decoration: none; color: var(--bm-n-900); }
  .bm-hit:hover, .bm-hit.is-active { background: var(--bm-accent-tint); }
  .bm-hit-top { display: flex; align-items: center; gap: 8px; }
  .bm-hit-title { font-weight: 700; font-size: 14px; }
  .bm-hit-kind { font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: var(--bm-n-500); background: var(--bm-n-50);
    border-radius: var(--bm-radius-pill); padding: 1px 7px; }
  .bm-hit-sub { font-size: 12px; color: var(--bm-n-500); margin-top: 1px; }
  .bm-search-msg { padding: 14px 12px; font-size: 13px; color: var(--bm-n-500);
    text-align: center; }
  @media (max-width: 767px) { .bm-search { width: 190px; } .bm-search-kbd { display: none; } }
</style>
  <%
     /* Brand colours come from the settings table — the same two values the
        customer site reads. admin.css consumes these with the live values as
        fallbacks, so a colour change in Admin -> Settings moves both sites. */
     var _s = (typeof settings !== 'undefined' && settings) ? settings : {};
  %>
  <style>
    :root {
      --bm-brand-primary: <%= _s.primary_color || '#d77c42' %>;
      --bm-brand-secondary: <%= _s.secondary_color || '#1a212d' %>;
    }
  </style>
</head>
<body>
