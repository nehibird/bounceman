<div id="toast-container" style="position:fixed;top:20px;right:20px;z-index:9999;max-width:400px"></div>
<script>
function showToast(message, type) {
  type = type || 'error';
  var colors = { error: '#EF476F', warning: '#f59e0b', success: '#059669', info: '#118AB2' };
  var icons = { error: 'fa-exclamation-circle', warning: 'fa-exclamation-triangle', success: 'fa-check-circle', info: 'fa-info-circle' };
  var container = document.getElementById('toast-container');
  var toast = document.createElement('div');
  toast.style.cssText = 'background:' + (colors[type] || colors.error) + ';color:white;padding:16px 20px;border-radius:12px;margin-bottom:10px;box-shadow:0 4px 20px rgba(0,0,0,0.2);display:flex;align-items:flex-start;gap:10px;animation:slideIn 0.3s ease;font-size:14px;line-height:1.4';
  toast.innerHTML = '<i class="fas ' + (icons[type] || icons.error) + '" style="margin-top:2px"></i><div style="flex:1">' + message + '</div><span class="toast-close" style="cursor:pointer;font-size:18px;line-height:1;opacity:0.8">&times;</span>';
  container.appendChild(toast);
  setTimeout(function() { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.3s'; setTimeout(function() { toast.remove(); }, 300); }, 6000);
}
document.getElementById("toast-container").addEventListener("click", function(e) { if (e.target.classList.contains("toast-close")) e.target.parentElement.remove(); });
</script>
<style>
@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
</style>
<script>
// Sticky CTA: show on mobile when scrolled past 400px, hide on booking pages
(function() {
  var sticky = document.getElementById('stickyCta');
  if (!sticky) return;
  // Don't show on booking pages (user is already booking)
  if (window.location.pathname.startsWith('/booking')) { sticky.remove(); return; }
  // Don't show on admin pages
  if (window.location.pathname.startsWith('/admin')) { sticky.remove(); return; }
  var shown = false;
  window.addEventListener('scroll', function() {
    if (window.scrollY > 400 && window.innerWidth < 992) {
      if (!shown) { sticky.style.display = 'block'; shown = true; }
    } else {
      if (shown) { sticky.style.display = 'none'; shown = false; }
    }
  });
})();
</script>
<!-- ===== Lead-capture coupon popup ($10 off -> text -> Sarah) ===== -->
<div id="bml-root" style="display:none">
  <button class="bml-x" id="bml-x" type="button" aria-label="Close">&times;</button>
  <div id="bml-teaser" class="bml-step">
    <div class="bml-burst">$10<span>OFF</span></div>
    <div class="bml-head">Your Bounce!</div>
    <p class="bml-sub">Book any bounce house, water slide, or combo and take $10 off.</p>
    <button class="bml-cta" id="bml-open" type="button">Click Here!</button>
  </div>
  <div id="bml-form" class="bml-step" style="display:none">
    <h3 class="bml-fh">Enter your info to get your $10 code</h3>
    <form id="bml-f" novalidate>
      <div style="position:absolute;left:-9999px" aria-hidden="true"><input type="text" name="website_url" tabindex="-1" autocomplete="off"></div>
      <input type="hidden" name="_ts" id="bml-ts">
      <input class="bml-in" type="text" name="name" required placeholder="Full name *">
      <input class="bml-in" type="tel" name="phone" required placeholder="Phone *">
      <input class="bml-in" type="email" name="email" required placeholder="Email *">
      <label class="bml-chk"><input type="checkbox" name="sms_optin" value="1" required> Text me my code &amp; occasional specials. Msg &amp; data rates may apply; reply STOP to opt out.</label>
      <button class="bml-cta bml-go" type="submit">Get My $10 Code</button>
      <p class="bml-err" id="bml-err"></p>
      <p class="bml-fine">By submitting, you agree to be contacted by Bounce Man by text, call, or email at the number provided &mdash; even if it's on a Do Not Call list &mdash; including via automated systems. Consent isn't a condition of purchase. Reply STOP to opt out.</p>
    </form>
  </div>
  <div id="bml-done" class="bml-step" style="display:none">
    <div class="bml-tick">&#10003;</div>
    <h3 class="bml-fh">Check your phone!</h3>
    <p class="bml-sub">We just texted your <b>$10 code</b>. Reply with your event date and we'll get you set up!</p>
  </div>
</div>
<style>
#bml-root{position:fixed;left:20px;bottom:20px;z-index:99999;width:340px;max-width:calc(100vw - 32px);background:#fff;border-radius:20px;box-shadow:0 18px 50px rgba(0,0,0,.28);overflow:hidden;font-family:inherit;animation:bmlIn .4s cubic-bezier(.18,.89,.32,1.28)}
@keyframes bmlIn{from{transform:translateY(40px) scale(.9);opacity:0}to{transform:none;opacity:1}}
.bml-x{position:absolute;top:8px;right:10px;z-index:2;background:rgba(0,0,0,.15);color:#fff;border:none;width:28px;height:28px;border-radius:50%;font-size:20px;line-height:1;cursor:pointer}
.bml-x:hover{background:rgba(0,0,0,.35)}
.bml-step{padding:26px 22px 22px;text-align:center}
#bml-teaser{background:linear-gradient(160deg,var(--bm-orange,#f68b1e),#e0740a);color:#fff}
.bml-burst{font-weight:900;font-size:58px;line-height:.9;letter-spacing:-1px;text-shadow:0 3px 0 rgba(0,0,0,.15)}
.bml-burst span{display:block;font-size:26px;letter-spacing:6px}
.bml-head{font-weight:900;font-size:24px;margin-top:6px;text-transform:uppercase}
.bml-sub{font-size:14px;margin:10px 4px 16px;opacity:.95;line-height:1.4}
.bml-cta{display:inline-block;background:var(--bm-blue,#1a73c7);color:#fff;font-weight:800;font-size:18px;text-transform:uppercase;letter-spacing:.5px;border:none;border-radius:999px;padding:13px 30px;cursor:pointer;box-shadow:0 4px 0 rgba(0,0,0,.18);transition:transform .1s}
.bml-cta:hover{transform:translateY(-1px)}
.bml-cta:active{transform:translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,.18)}
.bml-fh{font-weight:800;font-size:18px;color:#222;margin:2px 6px 14px}
.bml-in{display:block;width:100%;box-sizing:border-box;margin:0 0 10px;padding:12px 14px;border:1.5px solid #e0e0e0;border-radius:12px;font-size:15px;background:#f7f7f8}
.bml-in:focus{outline:none;border-color:var(--bm-orange,#f68b1e);background:#fff}
.bml-chk{display:flex;gap:8px;text-align:left;font-size:11.5px;color:#666;line-height:1.35;margin:2px 2px 14px;cursor:pointer}
.bml-chk input{margin-top:2px;flex:none}
.bml-go{width:100%}
.bml-err{color:#c0392b;font-size:13px;margin:10px 0 0;display:none}
.bml-fine{font-size:9.5px;color:#aaa;line-height:1.4;margin:12px 2px 0;text-align:left}
.bml-tick{width:56px;height:56px;margin:4px auto 10px;border-radius:50%;background:#2ecc71;color:#fff;font-size:32px;line-height:56px;font-weight:900}
@media(max-width:520px){#bml-root{left:12px;right:12px;bottom:12px;width:auto}.bml-burst{font-size:52px}}
</style>
<script>
(function(){
  var KEY='bml_seen_v1', DAYS=7;
  function seen(){ try{ var t=+localStorage.getItem(KEY)||0; return Date.now()-t < DAYS*864e5; }catch(e){ return false; } }
  function mark(){ try{ localStorage.setItem(KEY, Date.now()); }catch(e){} }
  var root=document.getElementById('bml-root'); if(!root) return;
  var opened=false;
  function closePopup(){ root.style.display='none'; mark(); }
  function showForm(){ document.getElementById('bml-teaser').style.display='none'; document.getElementById('bml-form').style.display='block'; document.getElementById('bml-ts').value=Date.now(); }
  function open(){ if(opened||seen()) return; opened=true; root.style.display='block'; }
  document.getElementById('bml-x').addEventListener('click', closePopup);
  document.getElementById('bml-open').addEventListener('click', showForm);
  setTimeout(open, 8000);
  document.addEventListener('mouseout', function(e){ if(e.clientY<=0) open(); });
  var f=document.getElementById('bml-f');
  f.addEventListener('submit', function(ev){
    ev.preventDefault();
    var err=document.getElementById('bml-err'); err.style.display='none';
    var btn=f.querySelector('.bml-go'); var orig=btn.textContent;
    var data={ name:f.name.value.trim(), phone:f.phone.value.trim(), email:f.email.value.trim(), sms_optin:f.sms_optin.checked?'1':'', website_url:f.website_url.value, _ts:document.getElementById('bml-ts').value };
    if(!data.name||!data.phone||!data.email){ err.textContent='Please fill in your name, phone, and email.'; err.style.display='block'; return; }
    if(!data.sms_optin){ err.textContent='Please check the box so we can text you your code.'; err.style.display='block'; return; }
    btn.textContent='Sending...'; btn.disabled=true;
    fetch('/api/lead',{method:'POST',body:new URLSearchParams(data)})
      .then(function(r){return r.json();})
      .then(function(j){
        if(j&&j.ok){ document.getElementById('bml-form').style.display='none'; document.getElementById('bml-done').style.display='block'; mark(); }
        else { err.textContent=(j&&j.error)||'Something went wrong — please try again.'; err.style.display='block'; btn.textContent=orig; btn.disabled=false; }
      })
      .catch(function(){ err.textContent='Network error — please try again.'; err.style.display='block'; btn.textContent=orig; btn.disabled=false; });
  });
})();
</script>
<!-- ===== /Lead-capture coupon popup ===== -->
</body>
</html>
