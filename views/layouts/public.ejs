<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= settings.meta_description || '' %>">
  <% if (settings.google_analytics_id) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.google_analytics_id %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','<%= settings.google_analytics_id %>');</script>
  <% } %>
  <% if (settings.facebook_pixel_id) { %>
  <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','<%= settings.facebook_pixel_id %>');fbq('track','PageView');</script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=<%= settings.facebook_pixel_id %>&ev=PageView&noscript=1"/></noscript>
  <% } %>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏰</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
  <style>
    :root {
      --bm-orange: <%= settings.primary_color || '#FF6B35' %>;
      --bm-blue: <%= settings.secondary_color || '#004E89' %>;
      --bm-yellow: #FFD166;
      --bm-green: #06D6A0;
      --bm-pink: #EF476F;
      --bm-purple: #7B2D8E;
      --bm-light-bg: #FFF9F0;
      --bm-gradient: linear-gradient(135deg, var(--bm-orange) 0%, var(--bm-pink) 100%);
      --bm-gradient-cool: linear-gradient(135deg, var(--bm-blue) 0%, var(--bm-purple) 100%);
    }

    * { box-sizing: border-box; }
    body {
      font-family: 'Nunito', sans-serif; color: #333;
      background: var(--bm-light-bg); margin: 0;
    }
    h1, h2, h3, h4, h5, h6 { font-family: 'Fredoka', sans-serif; }

    /* === TOP BAR === */
    .top-bar {
      background: var(--bm-blue); color: white; padding: 8px 0; font-size: 14px;
    }
    .top-bar a { color: var(--bm-yellow); text-decoration: none; }
    .top-bar a:hover { color: white; }

    /* === HEADER === */
    .main-header {
      background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.08);
      position: sticky; top: 0; z-index: 1000;
    }
    .main-header .navbar-brand {
      font-family: 'Fredoka', sans-serif; font-weight: 700; font-size: 28px;
      color: var(--bm-orange) !important;
    }
    .main-header .navbar-brand span { color: var(--bm-blue); }
    .main-header .nav-link {
      font-weight: 600; color: #333 !important; padding: 10px 18px !important;
      position: relative; transition: color 0.3s;
    }
    .main-header .nav-link:hover, .main-header .nav-link.active {
      color: var(--bm-orange) !important;
    }
    .main-header .nav-link.active::after {
      content: ''; position: absolute; bottom: 0; left: 18px; right: 18px;
      height: 3px; background: var(--bm-orange); border-radius: 3px 3px 0 0;
    }
    .btn-book-now {
      background: var(--bm-gradient); color: white !important; font-weight: 700;
      border: none; padding: 10px 28px; border-radius: 50px;
      text-transform: uppercase; letter-spacing: 1px; font-size: 14px;
      transition: transform 0.3s, box-shadow 0.3s;
    }
    .btn-book-now:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(255,107,53,0.4);
      color: white;
    }

    /* === HERO === */
    .hero-section {
      background: var(--bm-gradient-cool);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
      color: white;
    }
    .hero-logo {
      width: 420px; height: auto;
      filter: drop-shadow(2px 4px 8px rgba(0,0,0,0.2));
    }
    .hero-section::before {
      content: '';
      position: absolute; top: -50px; right: -50px;
      width: 400px; height: 400px;
      background: var(--bm-yellow);
      border-radius: 50%;
      opacity: 0.1;
      pointer-events: none;
    }
    .hero-section::after {
      content: '';
      position: absolute; bottom: -80px; left: -80px;
      width: 300px; height: 300px;
      background: var(--bm-pink);
      border-radius: 50%;
      opacity: 0.1;
      pointer-events: none;
    }
    .hero-section h1 {
      font-size: 52px; font-weight: 700; margin-bottom: 20px;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }
    .hero-section h1 span { color: var(--bm-yellow); }
    .hero-section p { font-size: 20px; opacity: 0.9; max-width: 600px; }

    /* === SECTIONS === */
    .section-title {
      text-align: center; margin-bottom: 50px;
    }
    .section-title h2 {
      font-size: 38px; font-weight: 700; color: var(--bm-blue);
      position: relative; display: inline-block;
    }
    .section-title h2::after {
      content: ''; display: block; width: 60px; height: 4px;
      background: var(--bm-orange); margin: 12px auto 0;
      border-radius: 2px;
    }
    .section-title p { color: #666; font-size: 18px; margin-top: 10px; }

    /* === EQUIPMENT CARDS === */
    .equipment-card {
      background: white; border-radius: 20px; overflow: hidden;
      box-shadow: 0 8px 30px rgba(0,0,0,0.08); transition: transform 0.3s, box-shadow 0.3s;
      height: 100%;
    }
    .equipment-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.15);
    }
    .equipment-card .card-img-top {
      height: 240px; object-fit: cover; background: #f0f0f0;
    }
    .equipment-card .card-body { padding: 24px; }
    .equipment-card .card-title {
      font-weight: 700; font-size: 20px; color: var(--bm-blue);
    }
    .equipment-card .price-tag {
      background: var(--bm-gradient); color: white; font-weight: 700;
      padding: 6px 16px; border-radius: 30px; font-size: 18px;
      display: inline-block;
    }
    .equipment-card .badge-category {
      background: var(--bm-yellow); color: #333; font-weight: 600;
      padding: 4px 12px; border-radius: 20px; font-size: 12px;
    }

    /* === FUN SHAPES (from KidsCamp) === */
    .fun-bg {
      position: relative;
    }
    .fun-bg .shape-circle {
      position: absolute;
      border-radius: 50%;
      opacity: 0.06;
      pointer-events: none;
    }
    .fun-bg .shape-1 { width: 200px; height: 200px; background: var(--bm-orange); top: 10%; right: 5%; }
    .fun-bg .shape-2 { width: 150px; height: 150px; background: var(--bm-pink); bottom: 15%; left: 3%; }
    .fun-bg .shape-3 { width: 100px; height: 100px; background: var(--bm-yellow); top: 40%; left: 10%; }

    /* === HOW IT WORKS (from Entox) === */
    .how-it-works-step {
      text-align: center; padding: 30px;
    }
    .how-it-works-step .step-number {
      width: 80px; height: 80px; border-radius: 50%;
      background: var(--bm-gradient); color: white;
      font-size: 32px; font-weight: 700; line-height: 80px;
      margin: 0 auto 20px; box-shadow: 0 8px 20px rgba(255,107,53,0.3);
    }
    .how-it-works-step h4 { color: var(--bm-blue); font-weight: 700; }

    /* === TESTIMONIALS (from Balloo) === */
    .testimonial-card {
      background: white; border-radius: 20px; padding: 30px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.06); position: relative;
    }
    .testimonial-card::before {
      content: '\201C'; font-size: 80px; color: var(--bm-orange);
      opacity: 0.2; position: absolute; top: -10px; left: 20px;
      font-family: Georgia, serif;
    }
    .testimonial-card .stars { color: var(--bm-yellow); font-size: 18px; }

    /* === CTA BANNER === */
    .cta-banner {
      background: var(--bm-gradient); padding: 60px 0; color: white; text-align: center;
    }
    .cta-banner h2 { font-size: 36px; font-weight: 700; margin-bottom: 15px; }
    .cta-banner .btn-cta {
      background: white; color: var(--bm-orange); font-weight: 700;
      padding: 14px 40px; border-radius: 50px; font-size: 18px;
      border: none; transition: transform 0.3s;
    }
    .cta-banner .btn-cta:hover { transform: scale(1.05); }

    /* === FOOTER === */
    .main-footer {
      background: var(--bm-blue); color: white; padding: 50px 0 20px;
    }
    .main-footer h5 { color: var(--bm-yellow); font-weight: 700; margin-bottom: 20px; }
    .main-footer a { color: rgba(255,255,255,0.7); text-decoration: none; }
    .main-footer a:hover { color: var(--bm-yellow); }
    .main-footer .footer-bottom {
      border-top: 1px solid rgba(255,255,255,0.1);
      padding-top: 20px; margin-top: 30px; text-align: center;
      color: rgba(255,255,255,0.5); font-size: 14px;
    }
    .main-footer .social-links a {
      width: 40px; height: 40px; border-radius: 50%; display: inline-flex;
      align-items: center; justify-content: center;
      background: rgba(255,255,255,0.1); margin: 0 5px;
      transition: background 0.3s;
    }
    .main-footer .social-links a:hover { background: var(--bm-orange); color: white; }

    /* === AVAILABILITY BADGE === */
    .available-badge { background: var(--bm-green); color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .booked-badge { background: var(--bm-pink); color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }

    /* === RESPONSIVE === */
    @media (max-width: 991px) {
      .hero-section h1 { font-size: 36px; }
      .hero-section { padding: 50px 0; }
      .section-title h2 { font-size: 30px; }
      .how-it-works-step { padding: 20px 10px; }
      .how-it-works-step .step-number { width: 60px; height: 60px; font-size: 26px; line-height: 60px; }
    }

    @media (max-width: 768px) {
      /* === HEADER MOBILE PADDING === */
      .main-header .navbar { padding-left: 16px; padding-right: 16px; }
      .main-header .navbar-brand { font-size: 24px; }

      /* === HERO === */
      .hero-section { padding: 40px 0; }
      .hero-section h1 { font-size: 28px; line-height: 1.2; }
      .hero-section p { font-size: 16px; }
      .hero-section .container { padding-left: 20px; padding-right: 20px; }

      /* === HERO STATS ROW === */
      .hero-section .d-flex.gap-4 { gap: 1rem !important; justify-content: flex-start; }
      .hero-section .d-flex.gap-4 > div strong { font-size: 20px !important; }
      .hero-section .d-flex.gap-4 > div small { font-size: 12px; }

      /* === HERO BUTTONS === */
      .hero-section .d-flex.gap-3 { flex-direction: column; gap: 0.75rem !important; }
      .hero-section .d-flex.gap-3 .btn { width: 100%; text-align: center; }

      /* === SECTION TITLES === */
      .section-title { margin-bottom: 30px; }
      .section-title h2 { font-size: 26px; }
      .section-title p { font-size: 15px; }

      /* === CONTAINER PADDING === */
      .py-5 > .container { padding-left: 20px; padding-right: 20px; }

      /* === EQUIPMENT CARDS === */
      .equipment-card .card-img-top { height: 200px; }
      .equipment-card .card-body { padding: 16px; }
      .equipment-card .card-title { font-size: 17px; }
      .equipment-card .price-tag { font-size: 16px; padding: 5px 14px; }
      .equipment-card .card-body .btn { min-height: 44px; min-width: 70px; font-size: 13px; }

      /* === HOW IT WORKS === */
      .how-it-works-step { padding: 16px 8px; }
      .how-it-works-step .step-number { width: 56px; height: 56px; font-size: 24px; line-height: 56px; margin-bottom: 12px; }
      .how-it-works-step h4 { font-size: 16px; }
      .how-it-works-step p { font-size: 13px; }

      /* === TESTIMONIALS === */
      .testimonial-card { padding: 20px; }
      .testimonial-card::before { font-size: 50px; }

      /* === CTA BANNER === */
      .cta-banner { padding: 40px 0; }
      .cta-banner h2 { font-size: 26px; }
      .cta-banner .btn-cta { padding: 12px 30px; font-size: 16px; }

      /* === FOOTER MOBILE === */
      .main-footer { padding: 35px 0 15px; }
      .main-footer .container { padding-left: 20px; padding-right: 20px; }
      .main-footer h5 { font-size: 16px; margin-bottom: 12px; }
      .main-footer .col-md-4, .main-footer .col-md-2, .main-footer .col-md-3 { margin-bottom: 8px !important; }
      .main-footer p, .main-footer li { font-size: 14px; line-height: 2.2; }
      .main-footer a { min-height: 44px; display: inline-block; }
      .main-footer .footer-bottom { margin-top: 16px; padding-top: 16px; }

      /* === MOBILE NAV MENU === */
      .navbar-collapse { background: white; border-radius: 0 0 16px 16px; padding: 16px 20px; box-shadow: 0 8px 30px rgba(0,0,0,0.12); margin-top: 8px; }
      .navbar-collapse .nav-link { padding: 14px 8px !important; font-size: 16px; border-bottom: 1px solid #f0f0f0; min-height: 44px; }
      .navbar-collapse .nav-link:last-child { border-bottom: none; }
      .navbar-collapse .btn-book-now { width: 100%; text-align: center; margin-top: 8px; padding: 14px 20px; font-size: 16px; }

      /* === BOOK NOW BUTTON === */
      .btn-book-now { padding: 12px 24px; font-size: 14px; }

      /* === TOUCH TARGETS (44px minimum) === */
      .btn, .nav-link, a.btn { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
      .form-control, .form-select { min-height: 44px; font-size: 16px; }
      .form-check { min-height: 44px; display: flex; align-items: center; }
      .form-check-input { width: 22px; height: 22px; }
      .navbar-toggler { min-height: 44px; min-width: 44px; }

      /* === CATEGORY FILTER PILLS (horizontal scroll) === */
      .text-center.mb-4:has(.rounded-pill), #categoryFilters {
        display: flex; overflow-x: auto; -webkit-overflow-scrolling: touch;
        gap: 8px; padding: 4px 0 12px; justify-content: flex-start; text-align: left;
        scrollbar-width: none; -ms-overflow-style: none;
      }
      .text-center.mb-4:has(.rounded-pill)::-webkit-scrollbar, #categoryFilters::-webkit-scrollbar { display: none; }
      .text-center.mb-4 .rounded-pill, #categoryFilters .filter-pill { white-space: nowrap; flex-shrink: 0; }

      /* === PAGE HERO SECTIONS (FAQ, Contact, etc.) === */
      .hero-section[style*="padding:60px"] { padding: 40px 0 !important; }

      /* === SERVICE AREA PILLS === */
      .row.g-3.justify-content-center { gap: 0.5rem; }
      .row.g-3 .col-auto .bg-white { padding: 8px 16px !important; font-size: 14px; }
    }

    @media (max-width: 576px) {
      .main-header .navbar { padding-left: 12px; padding-right: 12px; }
      .main-header .navbar-brand { font-size: 22px; }
      .hero-section h1 { font-size: 24px; }
      .hero-section p { font-size: 15px; }
      .section-title h2 { font-size: 22px; }
      .equipment-card .card-img-top { height: 180px; }
      .cta-banner h2 { font-size: 22px; }
      .main-footer .row { gap: 0; }
    }
  </style>
</head>
<body>
  <!-- Top Bar -->
  <div class="top-bar d-none d-md-block">
    <div class="container d-flex justify-content-between">
      <span><i class="fas fa-map-marker-alt me-2"></i>Serving Tonkawa, Ponca City, Stillwater & surrounding areas</span>
      <div>
        <% if (settings.company_phone) { %>
          <a href="tel:<%= settings.company_phone %>" class="me-3"><i class="fas fa-phone me-1"></i><%= settings.company_phone %></a>
        <% } %>
        <a href="mailto:<%= settings.company_email %>"><i class="fas fa-envelope me-1"></i><%= settings.company_email %></a>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="main-header">
    <nav class="navbar navbar-expand-lg container">
      <a class="navbar-brand" href="/"><img src="/assets/images/navbar-wordmark.svg" alt="Bounce Man" style="height:40px"></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav mx-auto">
          <li class="nav-item"><a class="nav-link <%= page === 'home' ? 'active' : '' %>" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link <%= page === 'equipment' ? 'active' : '' %>" href="/equipment">Equipment</a></li>
          <li class="nav-item"><a class="nav-link <%= page === 'packages' ? 'active' : '' %>" href="/packages">Packages</a></li>
          <li class="nav-item"><a class="nav-link <%= page === 'how-it-works' ? 'active' : '' %>" href="/how-it-works">How It Works</a></li>
          <li class="nav-item"><a class="nav-link <%= page === 'about' ? 'active' : '' %>" href="/about">About</a></li>
          <li class="nav-item"><a class="nav-link <%= page === 'contact' ? 'active' : '' %>" href="/contact">Contact</a></li>
        </ul>
        <a href="/booking" class="btn btn-book-now"><i class="fas fa-calendar-check me-2"></i>Book Now</a>
      </div>
    </nav>
  </header>

  <!-- Page Content -->
  <%- body %>

  <!-- CTA Banner -->
  <% if (typeof page !== 'undefined' && page !== 'booking' && page !== 'contract') { %>
  <section class="cta-banner">
    <div class="container">
      <h2>Ready to Bounce?</h2>
      <p class="mb-4" style="font-size:18px;opacity:0.9">Book your party equipment today and make your event unforgettable!</p>
      <a href="/booking" class="btn btn-cta"><i class="fas fa-calendar-check me-2"></i>Book Your Rental</a>
    </div>
  </section>
  <% } %>

  <!-- Footer -->
  <footer class="main-footer">
    <div class="container">
      <div class="row">
        <div class="col-md-4 mb-4">
          <h5><img src="/assets/images/navbar-wordmark.svg" alt="Bounce Man" style="height:30px"></h5>
          <p style="opacity:0.7">Making your events unforgettable with safe, clean, and fun party equipment rentals in Tonkawa, OK and surrounding areas.</p>
          <% if (settings.facebook_url || settings.instagram_url) { %>
          <div class="social-links">
            <% if (settings.facebook_url) { %><a href="<%= settings.facebook_url %>" target="_blank"><i class="fab fa-facebook-f"></i></a><% } %>
            <% if (settings.instagram_url) { %><a href="<%= settings.instagram_url %>" target="_blank"><i class="fab fa-instagram"></i></a><% } %>
          </div>
          <% } %>
        </div>
        <div class="col-md-2 mb-4">
          <h5>Quick Links</h5>
          <ul class="list-unstyled">
            <li class="mb-2"><a href="/equipment">Equipment</a></li>
            <li class="mb-2"><a href="/packages">Packages</a></li>
            <li class="mb-2"><a href="/booking">Book Now</a></li>
            <li class="mb-2"><a href="/reviews">Reviews</a></li>
            <li class="mb-2"><a href="/faq">FAQ</a></li>
          </ul>
        </div>
        <div class="col-md-3 mb-4">
          <h5><a href="/service-areas" style="color:var(--bm-yellow);text-decoration:none">Service Areas</a></h5>
          <ul class="list-unstyled" style="opacity:0.7">
            <li class="mb-1"><a href="/service-areas" style="color:inherit;text-decoration:none">Tonkawa (FREE)</a></li>
            <li class="mb-1"><a href="/service-areas" style="color:inherit;text-decoration:none">Ponca City (FREE)</a></li>
            <li class="mb-1"><a href="/service-areas" style="color:inherit;text-decoration:none">Blackwell (FREE)</a></li>
            <li class="mb-1"><a href="/service-areas" style="color:inherit;text-decoration:none">Stillwater &amp; more</a></li>
          </ul>
        </div>
        <div class="col-md-3 mb-4">
          <h5>Contact Us</h5>
          <ul class="list-unstyled" style="opacity:0.7">
            <% if (settings.company_phone) { %>
              <li class="mb-2"><i class="fas fa-phone me-2"></i><%= settings.company_phone %></li>
            <% } %>
            <li class="mb-2"><i class="fas fa-envelope me-2"></i><%= settings.company_email %></li>
            <li class="mb-2"><i class="fas fa-map-marker-alt me-2"></i>Tonkawa, OK 74653</li>
            <li class="mb-2"><i class="fas fa-clock me-2"></i>Season: April–November</li>
            <li class="mb-2"><i class="fas fa-cross me-2"></i>Closed Sundays</li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        &copy; 2026 Bounce Man LLC. All rights reserved.
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <%- typeof scripts !== 'undefined' ? scripts : '' %>
</body>
</html>
